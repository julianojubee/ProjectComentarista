@model ControleFutebolWeb.Models.ViewModels.EstatisticasAvancadasViewModel
@{
    ViewData["Title"] = $"{Model.JogadorNome} — estatísticas avançadas";
}

@*
    Tela de leitura pura: tudo aqui foi buscado durante esta requisição e nada é
    gravado — ver FotMobPerfilService.

    A ORIGEM DOS DADOS NÃO APARECE para o usuário: nem no texto, nem em nome de fonte,
    nem em URL de imagem (os escudos passam por /MediaProxy/Escudo/{id}, que monta o
    endereço no servidor). É decisão de produto. O que continua fora por decisão
    técnica é a NOTA da fonte externa: a nota do jogador é a que o site calcula, e duas
    réguas concorrentes na mesma tela seria ruim independentemente de crédito.
*@

<style>
    .ea-page { background: var(--p-0); margin: 0 -12px; padding: 24px 16px 48px; border-radius: 14px; }
    .ea-wrap { max-width: 1000px; margin: 0 auto; }

    .ea-voltar {
        display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px;
        font-size: .78rem; font-weight: 600; color: var(--text-muted);
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        padding: 8px 14px; text-decoration: none;
    }
    .ea-voltar:hover { border-color: #c084fc; color: #c084fc; text-decoration: none; }

    /* Totalizador logo abaixo de quem o jogador é. Fica antes de tudo porque é a
       resposta mais procurada da tela ("quantos gols ele tem?") e antes dela só havia
       número dentro de uma competição de uma temporada por vez. */
    .ea-tot { margin: -8px 0 22px; }
    .ea-tot-seletor { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
    .ea-tot-seletor-rot {
        font-size: .7rem; font-weight: 700; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: .05em;
    }
    .ea-tot-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .ea-tot-chip {
        padding: 6px 12px; border-radius: 8px; font-size: .74rem; font-weight: 600;
        background: var(--p-2); border: 1px solid var(--line-strong);
        color: var(--text-muted); cursor: pointer; font-family: inherit;
    }
    .ea-tot-chip:hover { color: #c084fc; border-color: rgba(168,85,247,.4); }
    .ea-tot-chip.ativa { background: rgba(168,85,247,.18); border-color: rgba(168,85,247,.5); color: #c084fc; }

    .ea-tot-cards { display: flex; align-items: stretch; gap: 10px; flex-wrap: wrap; }
    .ea-tot-card {
        flex: 1 1 130px; min-width: 120px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 12px;
        padding: 12px 14px;
    }
    .ea-tot-card.destaque { border-color: var(--gold-ink); }
    .ea-tot-rot {
        font-size: .66rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
        color: var(--text-dim);
    }
    .ea-tot-val { font-size: 1.7rem; font-weight: 800; color: var(--text-strong); line-height: 1.15; }
    .ea-tot-card.destaque .ea-tot-val { color: var(--gold-ink); }
    .ea-tot-det { font-size: .68rem; color: var(--text-muted); margin-top: 2px; min-height: .9em; }

    .ea-tot-comps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .ea-tot-comp {
        font-size: .7rem; color: var(--text-muted);
        background: var(--p-1); border: 1px solid var(--line); border-radius: 8px; padding: 4px 9px;
    }
    .ea-tot-comp strong { color: var(--text-2); font-weight: 700; }
    .ea-tot-comp span { color: var(--text-dim); }
    .ea-tot-nota { font-size: .7rem; color: var(--text-dim); margin-top: 9px; }

    .ea-head { margin-bottom: 22px; }
    .ea-titulo { font-size: 1.5rem; font-weight: 800; color: var(--text-strong); margin: 0; }
    .ea-sub { font-size: .82rem; color: var(--text-muted); margin-top: 6px; }

    .ea-erro {
        background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3);
        color: var(--bad); border-radius: 10px; padding: 14px; font-size: .85rem;
    }

    @* Mesmo selo do cabeçalho da página do jogador, para a lesão ser reconhecível
       nas duas telas em vez de virar dois avisos diferentes do mesmo fato. *@
    .ea-lesao {
        display: inline-flex; align-items: center; gap: .35rem; margin-top: 10px;
        font-size: .78rem; font-weight: 700; color: var(--bad);
        background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3);
        border-radius: 999px; padding: .18rem .65rem;
    }
    .ea-lesao span { font-weight: 500; opacity: .85; }
    .ea-secao { margin-bottom: 30px; }
    .ea-secao-tit {
        font-size: .95rem; font-weight: 700; color: var(--text-strong);
        margin: 0 0 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }
    .ea-secao-nota { font-size: .72rem; font-weight: 500; color: var(--text-dim); }

    /* Filtro em dois níveis: a temporada abre a lista de competições dela. A troca é
       no cliente porque as competições já vieram todas — só a estatística escolhida
       custa uma ida ao servidor. */
    .ea-filtro { margin-bottom: 18px; }
    .ea-filtro-linha { display: flex; flex-wrap: wrap; gap: 8px; }
    .ea-filtro-rot {
        font-size: .7rem; font-weight: 700; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 7px;
    }
    .ea-temp, .ea-comp {
        padding: 7px 13px; border-radius: 8px; font-size: .76rem; font-weight: 600;
        background: var(--p-2); border: 1px solid var(--line-strong);
        color: var(--text-muted); text-decoration: none; cursor: pointer;
    }
    .ea-temp:hover, .ea-comp:hover { color: #c084fc; text-decoration: none; }
    .ea-temp.ativa { background: rgba(168,85,247,.15); border-color: rgba(168,85,247,.4); color: #c084fc; }
    .ea-comp.ativa { background: rgba(168,85,247,.2); border-color: rgba(168,85,247,.5); color: #c084fc; }
    .ea-comp.rasa { opacity: .62; }
    .ea-comps { display: none; margin-top: 12px; }
    .ea-comps.aberta { display: block; }

    .ea-grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
    .ea-grupo { background: var(--p-1); border: 1px solid var(--line-strong); border-radius: 12px; padding: 16px; }
    .ea-grupo-tit {
        font-size: .8rem; font-weight: 700; color: var(--text-strong);
        text-transform: uppercase; letter-spacing: .04em; margin: 0 0 12px;
    }

    .ea-metrica { padding: 9px 0; border-bottom: 1px solid var(--line); }
    .ea-metrica:last-child { border-bottom: none; }
    .ea-metrica-topo { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .ea-metrica-nome { font-size: .8rem; color: var(--text-2); }
    .ea-metrica-val { font-size: .95rem; font-weight: 700; color: var(--text-strong); white-space: nowrap; }
    .ea-metrica-p90 { font-size: .68rem; color: var(--text-dim); font-weight: 500; margin-left: 6px; }

    /* A barra é o percentil, não o valor: ela responde "isso é bom para esta liga?",
       que é a pergunta que a nossa base não consegue responder. */
    .ea-barra { height: 4px; background: var(--p-3); border-radius: 3px; margin-top: 7px; overflow: hidden; }
    .ea-barra-fill { height: 100%; border-radius: 3px; }
    .ea-percentil { font-size: .67rem; color: var(--text-dim); margin-top: 4px; }

    .ea-tabela { width: 100%; border-collapse: collapse; font-size: .8rem; }
    .ea-tabela th {
        text-align: left; padding: 8px 10px; font-size: .7rem; font-weight: 700;
        color: var(--text-dim); text-transform: uppercase; letter-spacing: .04em;
        border-bottom: 1px solid var(--line-strong); white-space: nowrap;
    }
    .ea-tabela td { padding: 9px 10px; border-bottom: 1px solid var(--line); color: var(--text-2); }
    .ea-tabela tr:last-child td { border-bottom: none; }
    .ea-num { text-align: right; font-variant-numeric: tabular-nums; }
    .ea-scroll { overflow-x: auto; background: var(--p-1); border: 1px solid var(--line-strong); border-radius: 12px; }

    /* Escudo + nome andam juntos; o escudo tem tamanho fixo para as linhas da tabela
       não dançarem quando uma imagem falha. */
    .ea-time { display: inline-flex; align-items: center; gap: 8px; }
    .ea-escudo {
        width: 20px; height: 20px; object-fit: contain; flex: 0 0 20px;
        background: transparent;
    }

    .ea-tag { display: inline-block; padding: 2px 7px; border-radius: 5px; font-size: .66rem; font-weight: 700; }
    .ea-tag-atual { background: rgba(74,222,128,.15); color: #4ade80; }
    .ea-tag-sel { background: rgba(59,130,246,.15); color: var(--info); }

    .ea-vazio { font-size: .82rem; color: var(--text-dim); padding: 14px; }

    /* Cabeçalho de identificação — o MESMO da página do jogador (.je-header lá), com
       os mesmos dados vindos da mesma linha do banco. Repetido aqui, e não extraído
       para uma partial, porque é assim que as outras telas de jogador fazem: cada uma
       carrega o seu cabeçalho e o seu estilo (ver EstatisticasJogo.cshtml). */
    .ea-jog {
        display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
        background: linear-gradient(135deg, #090909 0%, #161616 100%);
        border: 1px solid var(--line-strong); border-radius: 14px;
        padding: 18px 22px; margin-bottom: 20px;
    }
    .ea-jog-escudo {
        width: 56px; height: 56px; border-radius: 50%;
        background: var(--p-0); border: 1px solid var(--line-strong);
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; flex-shrink: 0;
    }
    .ea-jog-escudo img { width: 82%; height: 82%; object-fit: contain; }
    a.ea-jog-escudo:hover { border-color: var(--gold-ink); }

    .ea-jog-foto {
        width: 64px; height: 64px; border-radius: 12px;
        background: var(--p-alt-2); border: 2px solid var(--p-alt-3);
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; flex-shrink: 0;
    }
    .ea-jog-foto img { width: 100%; height: 100%; object-fit: cover; }

    .ea-jog-info { flex: 1; min-width: 200px; }
    .ea-jog-nome { font-size: 1.9rem; font-weight: 800; color: var(--text-strong); margin: 0 0 6px; line-height: 1; }
    .ea-jog-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .ea-jog-pos {
        display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 6px;
        background: rgba(34,197,94,.15); border: 1px solid rgba(34,197,94,.35);
        color: var(--ok); font-size: .72rem; font-weight: 700; letter-spacing: .06em;
    }
    .ea-jog-item { font-size: .8rem; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
    .ea-jog-item img { width: 16px; height: 16px; object-fit: contain; }
    a.ea-jog-item { color: var(--text-muted); text-decoration: none; }
    a.ea-jog-item:hover { color: var(--gold-ink); text-decoration: underline; }

    .ea-sync { margin: 0 0 0 auto; align-self: flex-start; }
    .ea-sync-btn {
        font-size: .72rem; font-weight: 700; padding: 5px 10px; border-radius: 7px;
        background: transparent; border: 1px solid var(--line-strong); color: var(--text-muted);
        cursor: pointer; white-space: nowrap;
    }
    .ea-sync-btn:hover { border-color: var(--gold-ink); color: var(--gold-ink); }
    .ea-sync-btn:disabled { opacity: .6; cursor: wait; }
</style>

@*
    Escudo do time. Devolve string vazia sem id, e a view omite a imagem em vez de
    pedir uma que não existe. onerror esconde o <img> quando a imagem não vem: o
    alt de um escudo ausente polui mais do que ajuda.
*@
@functions {
    string Escudo(long? timeId) =>
        timeId is > 0 ? $"/MediaProxy/Escudo/{timeId}" : "";
}

<div class="ea-page">
    <div class="ea-wrap">

        <a href="/Jogadores/Estatisticas/@Model.JogadorId" class="ea-voltar">← Voltar para @Model.JogadorNome</a>

        @* Quem o jogador é, do nosso cadastro — o mesmo cabeçalho da página dele.
           Aparece aqui porque esta tela é cheia de número e nada dizia de quem eram:
           só o nome, no botão de voltar. Nada disto vem da fonte externa; é a linha do
           banco que a outra tela também lê, então as duas não podem discordar. *@
        @if (Model.Cadastro is { } jogador)
        {
            <div class="ea-jog theme-dark-zone">
                @if (!string.IsNullOrEmpty(jogador.Time?.EscudoUrl))
                {
                    <a class="ea-jog-escudo" asp-controller="Times" asp-action="Details" asp-route-id="@jogador.TimeId" title="Ver @jogador.Time.Nome">
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogador.Time.EscudoUrl })" alt="" />
                    </a>
                }

                <div class="ea-jog-foto">
                    <img src="@(string.IsNullOrWhiteSpace(jogador.FotoUrl) ? "/images/placeholder-jogador.png" : Url.FotoSrc(jogador.FotoUrl))"
                         alt="@jogador.NomeExibicao"
                         onerror="this.onerror=null; this.src='/images/placeholder-jogador.png'" />
                </div>

                <div class="ea-jog-info">
                    <h1 class="ea-jog-nome">@jogador.NomeExibicao</h1>
                    <div class="ea-jog-meta">
                        @if (!string.IsNullOrWhiteSpace(jogador.Posicao))
                        {
                            <span class="ea-jog-pos">@PosicaoJogadorHelper.Sigla(jogador.Posicao)</span>
                        }
                        @if (jogador.NumeroCamisa.HasValue)
                        {
                            <span class="ea-jog-item">Nº @jogador.NumeroCamisa</span>
                        }
                        @* Idade zero é "sem data de nascimento" (Jogador.Idade), e
                           "0 anos" no cabeçalho seria pior do que não dizer nada. *@
                        @if (jogador.Idade > 0)
                        {
                            <span class="ea-jog-item">@jogador.Idade anos</span>
                        }
                        @if (jogador.Altura.HasValue)
                        {
                            <span class="ea-jog-item">@jogador.Altura cm</span>
                        }
                        @if (jogador.Peso.HasValue)
                        {
                            <span class="ea-jog-item">@jogador.Peso kg</span>
                        }
                        @if (jogador.Time != null)
                        {
                            <a class="ea-jog-item" asp-controller="Times" asp-action="Details" asp-route-id="@jogador.TimeId" title="Ver @jogador.Time.Nome">
                                @if (!string.IsNullOrEmpty(jogador.Time.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogador.Time.EscudoUrl })" alt="" />
                                }
                                @jogador.Time.Nome
                            </a>
                        }
                        @if (jogador.Nacionalidade != null)
                        {
                            var bandeira = FlagHelper.GetFlagImageUrl(jogador.Nacionalidade.Nome);
                            <span class="ea-jog-item" title="País de nascimento: @jogador.Nacionalidade.Nome">
                                @if (bandeira != null)
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = bandeira })" alt="" />
                                }
                                @jogador.Nacionalidade.Nome
                            </span>
                        }
                        @if (jogador.Selecao != null)
                        {
                            <a class="ea-jog-item" asp-controller="Times" asp-action="Details" asp-route-id="@jogador.SelecaoId" title="Seleção que defende: @jogador.Selecao.Nome">
                                @if (!string.IsNullOrEmpty(jogador.Selecao.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogador.Selecao.EscudoUrl })" alt="" />
                                }
                                @jogador.Selecao.Nome
                            </a>
                        }
                    </div>
                </div>

                <form asp-action="SincronizarFotMob" asp-route-id="@jogador.Id" method="post" class="ea-sync">
                    <button type="submit" class="ea-sync-btn"
                            title="Atualiza foto, nome, altura, idade e nacionalidade com o perfil do FotMob (só o que estiver diferente)"
                            onclick="this.disabled=true; this.textContent='Sincronizando…'; this.form.submit();">
                        ⟳ Sincronizar com FotMob
                    </button>
                </form>
            </div>
        }

        @* Totalizador de gols e assistências, com seletor de recorte: a carreira toda
           ou uma temporada. Tudo o que ele mostra veio na MESMA resposta que monta o
           resto da tela (a carreira do jogador), então trocar de recorte é instantâneo
           e não custa busca nenhuma — por isso a troca é no cliente, e não por link.

           Antes daqui a tela só respondia "quantos gols nesta competição desta
           temporada"; o total do jogador ficava para quem somasse as linhas de olho. *@
        @{
            var opcoesTot = Model.OpcoesTotalizador;
        }
        @if (opcoesTot.Count > 0)
        {
            <div class="ea-tot" id="ea-tot">
                <div class="ea-tot-seletor">
                    <span class="ea-tot-seletor-rot">Recorte</span>
                    <div class="ea-tot-chips">
                        @foreach (var (op, i) in opcoesTot.Select((o, i) => (o, i)))
                        {
                            <button type="button" class="ea-tot-chip @(i == 0 ? "ativa" : "")"
                                    data-tot="@op.Id">@op.Rotulo</button>
                        }
                    </div>
                </div>

                <div class="ea-tot-cards">
                    <div class="ea-tot-card destaque">
                        <div class="ea-tot-rot">Gols</div>
                        <div class="ea-tot-val" data-tot-val="gols">@opcoesTot[0].Gols</div>
                        <div class="ea-tot-det" data-tot-det="gols"></div>
                    </div>
                    <div class="ea-tot-card destaque">
                        <div class="ea-tot-rot">Assistências</div>
                        <div class="ea-tot-val" data-tot-val="assistencias">@opcoesTot[0].Assistencias</div>
                        <div class="ea-tot-det" data-tot-det="assistencias"></div>
                    </div>
                    <div class="ea-tot-card">
                        <div class="ea-tot-rot">Participações em gol</div>
                        <div class="ea-tot-val" data-tot-val="participacoes">@opcoesTot[0].Participacoes</div>
                        <div class="ea-tot-det">gols + assistências</div>
                    </div>
                    <div class="ea-tot-card">
                        <div class="ea-tot-rot">Jogos</div>
                        <div class="ea-tot-val" data-tot-val="jogos">@opcoesTot[0].Jogos</div>
                        <div class="ea-tot-det" data-tot-det="media"></div>
                    </div>
                </div>

                @* Quebra por competição da temporada escolhida. Fica vazia na carreira
                   toda, onde o recorte que faz sentido é o de clubes — e esse já está na
                   tabela "Carreira" mais abaixo. *@
                <div class="ea-tot-comps" data-tot-comps hidden></div>

                <div class="ea-tot-nota" data-tot-nota></div>
            </div>

            <script type="application/json" id="ea-tot-dados">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(opcoesTot, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))</script>
            <script>
                (function () {
                    var raiz = document.getElementById('ea-tot');
                    var fonte = document.getElementById('ea-tot-dados');
                    var dados = JSON.parse((fonte && fonte.textContent) || '[]');
                    if (!raiz || !dados.length) return;

                    var porId = {};
                    dados.forEach(function (o) { porId[o.id] = o; });

                    function texto(seletor, valor) {
                        var el = raiz.querySelector(seletor);
                        if (el) el.textContent = valor;
                    }

                    // Nome de competição entra como texto, nunca como marcação: veio de
                    // fora e não tem por que poder escrever HTML nesta página.
                    function chipCompeticao(c) {
                        var chip = document.createElement('span');
                        chip.className = 'ea-tot-comp';

                        var nome = document.createElement('strong');
                        nome.textContent = c.nome;
                        chip.appendChild(nome);

                        chip.appendChild(document.createTextNode(
                            ' ' + c.gols + 'G ' + c.assistencias + 'A '));

                        var jogos = document.createElement('span');
                        jogos.textContent = 'em ' + c.jogos + ' jogo(s)';
                        chip.appendChild(jogos);

                        return chip;
                    }

                    function aplicar(id) {
                        var o = porId[id];
                        if (!o) return;

                        texto('[data-tot-val="gols"]', o.gols);
                        texto('[data-tot-val="assistencias"]', o.assistencias);
                        texto('[data-tot-val="participacoes"]', o.participacoes);
                        texto('[data-tot-val="jogos"]', o.jogos);

                        // A quebra clube/seleção só vem preenchida na carreira; na
                        // temporada o clube daquele ano fica na nota do rodapé.
                        texto('[data-tot-det="gols"]', o.detalheGols || '');
                        texto('[data-tot-det="assistencias"]', o.detalheAssistencias || '');
                        texto('[data-tot-det="media"]', o.jogos > 0
                            ? (o.participacoes / o.jogos).toFixed(2).replace('.', ',') + ' participações por jogo'
                            : '');

                        var comps = raiz.querySelector('[data-tot-comps]');
                        if (comps) {
                            comps.textContent = '';
                            (o.competicoes || []).forEach(function (c) {
                                comps.appendChild(chipCompeticao(c));
                            });
                            comps.hidden = comps.children.length === 0;
                        }

                        texto('[data-tot-nota]', o.id === 'carreira'
                            ? 'Carreira inteira — soma de todas as passagens listadas em “Carreira” mais abaixo.'
                            : 'Temporada ' + o.rotulo + (o.detalhe ? ' · ' + o.detalhe : ''));

                        raiz.querySelectorAll('[data-tot]').forEach(function (b) {
                            b.classList.toggle('ativa', b.dataset.tot === id);
                        });
                    }

                    raiz.querySelectorAll('[data-tot]').forEach(function (b) {
                        b.addEventListener('click', function () { aplicar(b.dataset.tot); });
                    });

                    aplicar(dados[0].id);
                })();
            </script>
        }

        <div class="ea-head">
            <h2 class="ea-titulo">Estatísticas avançadas</h2>
            @if (Model.PosicaoPrincipal != null || Model.ValorDeMercado != null)
            {
                <div class="ea-sub">
                    @if (Model.PosicaoPrincipal != null)
                    {
                        <span>Posição principal: <strong>@Model.PosicaoPrincipal</strong></span>
                    }
                    @if (Model.ValorDeMercado != null)
                    {
                        <span> · Valor de mercado: <strong>@Model.ValorDeMercado</strong></span>
                    }
                </div>
            }
            @if (Model.Situacao != null)
            {
                <div class="ea-lesao"
                     title="@(Model.Situacao.AtualizadoEm.HasValue ? $"Informado pelo FotMob, atualizado em {Model.Situacao.AtualizadoEm.Value:dd/MM/yyyy}." : "Informado pelo FotMob.")">
                    🩹 @Model.Situacao.Lesao
                    @if (Model.Situacao.Retorno != null)
                    {
                        <span>· @Model.Situacao.Retorno</span>
                    }
                </div>
            }
        </div>

        @if (Model.Erro != null)
        {
            <div class="ea-erro">@Model.Erro</div>
        }
        else
        {
            @* ── Desempenho na temporada ─────────────────────────────── *@
            <div class="ea-secao">
                <h2 class="ea-secao-tit">
                    Desempenho na temporada
                    <span class="ea-secao-nota">— totais, média por 90' e posição na competição</span>
                </h2>

                @if (Model.Temporadas.Count > 0)
                {
                    <div class="ea-filtro">
                        <div class="ea-filtro-rot">Temporada</div>
                        <div class="ea-filtro-linha">
                            @foreach (var t in Model.Temporadas)
                            {
                                <button type="button"
                                        class="ea-temp @(t.Nome == Model.TemporadaSelecionada ? "ativa" : "")"
                                        data-temporada="@t.Nome">
                                    @t.Nome
                                </button>
                            }
                        </div>

                        @foreach (var t in Model.Temporadas)
                        {
                            <div class="ea-comps @(t.Nome == Model.TemporadaSelecionada ? "aberta" : "")"
                                 data-comps="@t.Nome">
                                <div class="ea-filtro-rot">Competição</div>
                                <div class="ea-filtro-linha">
                                    @foreach (var c in t.Competicoes)
                                    {
                                        <a href="/Jogadores/EstatisticasAvancadas/@Model.JogadorId?temporadaId=@c.Id"
                                           class="ea-comp @(c.Id == Model.CompeticaoSelecionada ? "ativa" : "") @(c.TemDadosDetalhados ? "" : "rasa")"
                                           title="@(c.TemDadosDetalhados ? c.Nome : $"{c.Nome} — só dados básicos")">
                                            @c.Nome
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Model.TemDesempenho)
                {
                    <div class="ea-grupos">
                        @foreach (var g in Model.Grupos)
                        {
                            <div class="ea-grupo">
                                <h3 class="ea-grupo-tit">@g.Nome</h3>
                                @foreach (var m in g.Metricas)
                                {
                                    <div class="ea-metrica">
                                        <div class="ea-metrica-topo">
                                            <span class="ea-metrica-nome">@m.Nome</span>
                                            <span class="ea-metrica-val">
                                                @m.Valor@(m.EhPercentual ? "%" : "")
                                                @if (m.Por90 is double p90)
                                                {
                                                    <span class="ea-metrica-p90">@p90.ToString("0.##")/90'</span>
                                                }
                                            </span>
                                        </div>
                                        @if (m.Percentil is double pc)
                                        {
                                            @* Verde no topo, âmbar no meio, vermelho embaixo — a leitura
                                               tem que ser possível sem ler o número. *@
                                            var cor = pc >= 70 ? "#4ade80" : pc >= 40 ? "#facc15" : "#f87171";
                                            <div class="ea-barra">
                                                <div class="ea-barra-fill" style="width:@pc.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%; background:@cor"></div>
                                            </div>
                                            <div class="ea-percentil">Melhor que @pc.ToString("0")% dos jogadores da competição</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ea-vazio">
                        Não há estatística detalhada desta competição.
                        @if (Model.Temporadas.Sum(t => t.Competicoes.Count) > 1)
                        {
                            <text>Escolha outra acima.</text>
                        }
                    </div>
                }
            </div>

            @* ── Carreira ────────────────────────────────────────────── *@
            @if (Model.Carreira.Count > 0)
            {
                <div class="ea-secao">
                    <h2 class="ea-secao-tit">
                        Carreira
                        <span class="ea-secao-nota">— carreira inteira, não só os jogos importados</span>
                    </h2>
                    <div class="ea-scroll">
                        <table class="ea-tabela">
                            <thead>
                                <tr>
                                    <th>Time</th><th>Período</th>
                                    <th class="ea-num">Jogos</th><th class="ea-num">Gols</th><th class="ea-num">Assist.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Carreira)
                                {
                                    <tr>
                                        <td>
                                            <span class="ea-time">
                                                @if (Escudo(c.TimeId) is { Length: > 0 } src)
                                                {
                                                    <img class="ea-escudo" src="@src" alt=""
                                                         loading="lazy" onerror="this.style.display='none'" />
                                                }
                                                <span>@c.Time</span>
                                            </span>
                                            @if (c.Categoria == "Seleção") { <span class="ea-tag ea-tag-sel">seleção</span> }
                                            @if (c.Atual) { <span class="ea-tag ea-tag-atual">atual</span> }
                                        </td>
                                        <td>@c.Periodo</td>
                                        <td class="ea-num">@c.Jogos</td>
                                        <td class="ea-num">@c.Gols</td>
                                        <td class="ea-num">@c.Assistencias</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* ── Títulos ─────────────────────────────────────────────── *@
            @if (Model.Titulos.Count > 0)
            {
                <div class="ea-secao">
                    <h2 class="ea-secao-tit">Títulos</h2>
                    <div class="ea-scroll">
                        <table class="ea-tabela">
                            <thead>
                                <tr><th>Competição</th><th>Time</th><th class="ea-num">Vezes</th><th>Temporadas</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Titulos.OrderByDescending(x => x.Quantidade))
                                {
                                    <tr>
                                        <td>@t.Competicao</td>
                                        <td>
                                            <span class="ea-time">
                                                @if (Escudo(t.TimeId) is { Length: > 0 } src)
                                                {
                                                    <img class="ea-escudo" src="@src" alt=""
                                                         loading="lazy" onerror="this.style.display='none'" />
                                                }
                                                <span>@t.Time</span>
                                            </span>
                                        </td>
                                        <td class="ea-num">@t.Quantidade</td>
                                        <td>@t.Temporadas</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* ── Últimos jogos ───────────────────────────────────────── *@
            @if (Model.Jogos.Count > 0)
            {
                <div class="ea-secao">
                    <h2 class="ea-secao-tit">
                        Últimos jogos
                        <span class="ea-secao-nota">
                            — @Model.Jogos.Count jogo(s), incluindo partidas fora da nossa base
                        </span>
                    </h2>
                    <div class="ea-scroll">
                        <table class="ea-tabela">
                            <thead>
                                <tr>
                                    <th>Data</th><th>Competição</th><th>Adversário</th><th>Placar</th>
                                    <th class="ea-num">Min.</th><th class="ea-num">G</th><th class="ea-num">A</th><th class="ea-num">Cartões</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in Model.Jogos.OrderByDescending(x => x.Data).Take(30))
                                {
                                    <tr>
                                        <td>@(j.Data?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@j.Competicao</td>
                                        <td>
                                            <span class="ea-time">
                                                @if (Escudo(j.AdversarioId) is { Length: > 0 } src)
                                                {
                                                    <img class="ea-escudo" src="@src" alt=""
                                                         loading="lazy" onerror="this.style.display='none'" />
                                                }
                                                <span>@(j.Mandante ? "vs " : "@ ")@j.Adversario</span>
                                            </span>
                                        </td>
                                        <td>@(j.Placar ?? "—")</td>
                                        <td class="ea-num">@(j.Minutos?.ToString() ?? "—")</td>
                                        <td class="ea-num">@j.Gols</td>
                                        <td class="ea-num">@j.Assistencias</td>
                                        <td class="ea-num">
                                            @if (j.CartoesAmarelos > 0) { <text>🟨@j.CartoesAmarelos</text> }
                                            @if (j.CartoesVermelhos > 0) { <text>🟥@j.CartoesVermelhos</text> }
                                            @if (j.CartoesAmarelos == 0 && j.CartoesVermelhos == 0) { <text>—</text> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>

<script>
    // Troca a temporada aberta sem recarregar: as competições de todas já estão no
    // HTML. Só a escolha da competição vai ao servidor, porque é ela que define de
    // quais estatísticas a página é feita.
    document.querySelectorAll('.ea-temp').forEach(function (botao) {
        botao.addEventListener('click', function () {
            var alvo = botao.dataset.temporada;
            document.querySelectorAll('.ea-temp').forEach(function (b) {
                b.classList.toggle('ativa', b === botao);
            });
            document.querySelectorAll('.ea-comps').forEach(function (bloco) {
                bloco.classList.toggle('aberta', bloco.dataset.comps === alvo);
            });
        });
    });
</script>
