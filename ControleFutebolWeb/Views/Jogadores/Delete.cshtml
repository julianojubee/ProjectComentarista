@using ControleFutebolWeb.Helpers
@model ControleFutebolWeb.Models.Jogador
@{
    ViewData["Title"] = $"Excluir {Model.Nome}";
    // Preserva os filtros da listagem de origem ao excluir/cancelar.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var voltar = string.IsNullOrEmpty(returnUrl) ? Url.Action("Estatisticas", new { id = Model.Id }) : returnUrl;
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a href="@Url.Action("Estatisticas", new { id = Model.Id })" class="af-voltar">@Model.Nome</a>
        <h1 class="af-title">Excluir jogador</h1>

        @if (TempData["Erro"] != null)
        {
            <div class="af-alerta" role="alert">@TempData["Erro"]</div>
        }

        <div class="af-alerta">
            O cadastro de <strong>@Model.Nome</strong> será apagado. Essa ação não pode ser desfeita.
        </div>

        <div class="af-resumo">
            <img src="@(Url.FotoSrc(Model.FotoUrl) ?? Url.Content("~/images/placeholder-treinador.png"))" alt="" />
            <div>
                <div class="af-resumo-nome">@Model.Nome</div>
                <div class="af-resumo-meta">
                    @string.Join(", ", new[]
                    {
                        PosicaoJogadorHelper.Sigla(Model.Posicao),
                        Model.NumeroCamisa.HasValue ? $"camisa {Model.NumeroCamisa}" : null,
                        Model.Time?.Nome,
                        Model.Nacionalidade?.Nome
                    }.Where(x => !string.IsNullOrWhiteSpace(x)))
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="af-actions">
                <button type="submit" class="af-danger">Excluir jogador</button>
                <a href="@voltar" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
