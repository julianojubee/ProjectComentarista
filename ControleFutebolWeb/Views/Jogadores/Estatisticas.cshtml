@model ControleFutebolWeb.Models.ViewModels.JogadorEstatisticasViewModel
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models
@{
    ViewData["Title"] = $"Estatísticas — {Model.Jogador.NomeExibicao}";

    // Escala única de nota (mesma usada nos cards de jogo) — cor e rótulo.
    string CorNota(double nota) => nota switch
    {
        >= 8.5 => "#f59e0b",
        >= 7.5 => "#22c55e",
        >= 6.5 => "#3b82f6",
        >= 5.5 => "var(--text-dim)",
        >= 4.5 => "#f97316",
        _      => "#ef4444"
    };

    string LabelNota(double nota) => nota switch
    {
        >= 8.5 => "Elite",
        >= 7.5 => "Ótimo",
        >= 6.5 => "Bom",
        >= 5.5 => "Regular",
        >= 4.5 => "Abaixo",
        _      => "Fraco"
    };

    // Escalacao.Posicao pode ser o genérico da API ("Goleiro", "Defensor", "Meia",
    // "Atacante"), o nome granular da formação ("Lateral Direito", "Ponta Esquerda")
    // ou siglas antigas (GL/ZG/MC/AT) — abrevia por palavra-chave.
    string SiglaPosicao(string pos)
    {
        var p = (pos ?? "").Trim().ToLowerInvariant();
        if (p.Length == 0) return "";
        if (p is "gl" or "zg" or "ld" or "le" or "mc" or "at") return p.ToUpperInvariant();
        if (p.Contains("gol"))        return "GL";
        if (p.StartsWith("zag"))      return "ZG";
        if (p.StartsWith("lateral"))  return p.Contains("esq") ? "LE" : "LD";
        if (p.StartsWith("ala"))      return "AL";
        if (p.StartsWith("volante"))  return "VL";
        if (p.StartsWith("meia"))     return p.Contains("ofensiv") ? "MO" : "ME";
        if (p.StartsWith("ponta"))    return p.Contains("esq") ? "PE" : "PD";
        if (p.StartsWith("centro"))   return "CA";
        if (p.StartsWith("ata"))      return "AT";
        if (p.StartsWith("def"))      return "DF";
        return p.Length > 3 ? p[..3].ToUpperInvariant() : p.ToUpperInvariant();
    }

    string NomePosicao(string p) => p switch
    {
        "GL" => "Goleiro",
        "ZG" => "Zagueiro",
        "LD" => "Lateral direito",
        "LE" => "Lateral esquerdo",
        "MC" => "Meia",
        "AT" => "Atacante",
        _ => p
    };

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    var competicoes = ViewBag.Competicoes as List<Competicao> ?? new();
    var competicaoAtual = ViewBag.CompeticaoId as int?;

    // Temporadas já vêm rotuladas pelo controller: "2025/26" nas ligas de calendário
    // europeu, "2025" nas que coincidem com o ano civil (Brasileirão, Libertadores…).
    var temporadas = ViewBag.Temporadas as List<(int Valor, string Rotulo)> ?? new();
    var temporadaAtual = ViewBag.Temporada as int?;
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<style>
    .je, .je *, .je *::before, .je *::after { box-sizing: border-box; }

    .je {
        margin: 0 -12px;
        background: var(--p-0);
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        border-radius: 14px;
        overflow: hidden;
    }
    .je a { text-decoration: none; color: inherit; }
    .je h1 { font-family: 'Barlow Condensed', Arial, sans-serif; }

    /* ── Voltar ── */
    /* Topo, cabeçalho e conteúdo usam a MESMA largura útil (1164px), para foto,
       cards e tabelas começarem na mesma margem. */
    .je-top { padding: 20px 2.5rem 0; max-width: 1244px; margin: 0 auto; }
    .je-voltar {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 14px;
    }
    .je-voltar:hover { color: var(--gold-ink); text-decoration: underline; }
    .je :is(a, button, select, summary):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Header do jogador ── */
    .je-header {
        background: linear-gradient(135deg, #090909 0%, #161616 100%);
        border-bottom: 1px solid var(--line);
        padding: 32px 2.5rem 28px;
    }
    .je-header-inner {
        max-width: 1164px; margin: 0 auto;
        display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    }

    .je-escudo-wrap {
        width: 64px; height: 64px; border-radius: 50%;
        background: var(--p-0); border: 1px solid var(--line-strong);
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; flex-shrink: 0;
    }
    .je-escudo-wrap img { width: 82%; height: 82%; object-fit: contain; }
    a.je-escudo-wrap:hover { border-color: var(--gold-ink); }

    .je-foto-wrap {
        width: 72px; height: 72px; border-radius: 12px;
        background: var(--p-alt-2); border: 2px solid var(--p-alt-3);
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; flex-shrink: 0;
    }
    .je-foto-wrap img { width: 100%; height: 100%; object-fit: cover; }

    .je-info { flex: 1; min-width: 200px; }
    .je-nome {
        font-size: 2.4rem; font-weight: 800; color: var(--text-strong);
        margin: 0 0 6px; line-height: 1;
    }
    .je-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .je-pos-badge {
        display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 6px;
        background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.35);
        color: var(--ok); font-size: .72rem; font-weight: 700; letter-spacing: .06em;
    }
    .je-meta-item { font-size: .8rem; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
    .je-meta-item img { width: 16px; height: 16px; object-fit: contain; }
    .je-meta-item.je-meta-clube { color: var(--text-muted); }
    /* Clube/seleção clicáveis → página do time */
    a.je-meta-clube { text-decoration: none; }
    a.je-meta-clube:hover { color: var(--gold-ink); text-decoration: underline; }

    /* ── Filtros e ações ─────────────────────────────────────────────────
       Linha inteira embaixo da identificação, que QUEBRA: antes não quebrava e, no
       celular, os cinco botões ficavam fora da tela (cortados pelo cabeçalho).
       Uma cor só para todos — a cor não significava nada. Os dois atalhos mais
       usados ficam à vista; os outros três num menu "Mais". */
    .je-acoes { flex-basis: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 4px; }
    .je-filtros { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; }
    .je-acoes-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-left: auto; }
    .je .je-acao {
        display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 8px;
        border: 1px solid #3a3a3a; background: transparent; color: #e7e5df;
        font-family: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; white-space: nowrap;
        text-decoration: none;
    }
    .je .je-acao:hover { border-color: #d4a520; color: #f3d27a; }
    .je .je-acao.principal { border-color: rgba(212,165,32,.65); color: #f3d27a; }
    .je-mais { position: relative; }
    .je-mais > summary { list-style: none; }
    .je-mais:not([open]) .je-mais-menu { display: none; }
    .je-mais > summary::-webkit-details-marker { display: none; }
    .je-mais-menu {
        position: absolute; right: 0; top: calc(100% + 6px); z-index: 30; min-width: 210px;
        display: flex; flex-direction: column; padding: 6px;
        background: #1a1a1a; border: 1px solid #333; border-radius: 10px; box-shadow: 0 10px 28px rgba(0,0,0,.45);
    }
    .je .je-mais-menu .je-acao { border: none; width: 100%; justify-content: flex-start; padding: 9px 10px; }
    .je .je-mais-menu .je-acao:hover { background: #262626; }
    @@media (max-width: 640px) {
        .je-acoes-links { margin-left: 0; }
        .je-filtros, .je-filtros .je-select-wrap { width: 100%; }
        .je-filtros .je-select { width: 100%; }
        .je-mais-menu { right: 0; left: auto; }
    }
    .je-select-wrap { position: relative; }
    .je-select {
        appearance: none; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text-muted); font-size: .82rem; padding: 8px 28px 8px 12px; cursor: pointer; outline: none;
    }
    .je-select:focus { border-color: #d4a520; }
    .je-select-arrow { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); color: #555; pointer-events: none; }
    .je-clear { font-size: .75rem; color: var(--text-dim); }
    .je-clear:hover { color: var(--gold-ink); }

    .je-btn-semelhantes {
        display: flex; align-items: center; gap: 7px; padding: 8px 16px;
        background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.28); border-radius: 8px;
        color: var(--ok); font-size: .8rem; font-weight: 700; cursor: pointer;
    }
    .je-btn-semelhantes:hover { background: rgba(34,197,94,0.2); }

    .je-btn-observacoes {
        display: flex; align-items: center; gap: 7px; padding: 8px 16px;
        background: rgba(212,165,32,0.1); border: 1px solid rgba(212,165,32,0.28); border-radius: 8px;
        color: var(--gold-ink); font-size: .8rem; font-weight: 700; cursor: pointer;
        text-decoration: none;
    }
    .je-btn-observacoes:hover { color: var(--gold-ink); text-decoration: none; }

    /* Roxo para separar do resto da barra: leva para um painel de outra natureza
       (métricas avançadas, buscadas na hora), e a cor sinaliza isso antes do clique. */
    .je-btn-avancadas {
        display: flex; align-items: center; gap: 7px; padding: 8px 16px;
        background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.3); border-radius: 8px;
        color: #c084fc; font-size: .8rem; font-weight: 700; cursor: pointer;
        text-decoration: none;
    }
    .je-btn-avancadas:hover { color: #c084fc; text-decoration: none; opacity: .85; }
    .je-btn-observacoes:hover { background: rgba(212,165,32,0.2); }

    .je-btn-transferencias {
        display: flex; align-items: center; gap: 7px; padding: 8px 16px;
        background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.28); border-radius: 8px;
        color: var(--purple); font-size: .8rem; font-weight: 700; cursor: pointer;
    }
    .je-btn-transferencias:hover { background: rgba(168,85,247,0.2); }

    /* ── Conteúdo principal ── */
    .je-main { padding: 28px 2.5rem 64px; max-width: 1244px; margin: 0 auto; }

    .je-resumo { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px; }
    /* Resumo: neutro, com um destaque só (a média). O índice de desempenho, que
       repetia a média numa faixa própria, virou a régua dentro deste card. */
    .je-resumo-card {
        background: var(--p-1); border: 1px solid var(--line); border-radius: 12px;
        padding: 14px 16px; position: relative; overflow: hidden;
    }
    .je-resumo-card.destaque { border-color: rgba(212,165,32,.6); background: rgba(212,165,32,.07); }
    .je-resumo-label { font-size: .85rem; color: var(--text-muted); font-weight: 600; }
    .je-resumo-valor {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 2.4rem; font-weight: 800; line-height: 1.05; color: var(--text-strong);
        font-variant-numeric: tabular-nums;
    }
    .je-resumo-det { font-size: .78rem; color: var(--text-dim); margin-top: 2px; }
    .je-resumo-regua { height: 5px; border-radius: 3px; background: var(--p-3); margin-top: 8px; overflow: hidden; }
    .je-resumo-regua > span { display: block; height: 100%; border-radius: 3px; background: #d4a520; }

    .je-perf { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; }
    .je-perf-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; flex-wrap: wrap; gap: 6px; }
    .je-perf-label { font-size: .68rem; font-weight: 700; letter-spacing: .14em; color: var(--text-dim); text-transform: uppercase; }
    .je-perf-valor { font-size: 1rem; font-weight: 800; }
    .je-perf-track { background: var(--p-3); border-radius: 999px; height: 10px; overflow: hidden; }
    .je-perf-fill { height: 100%; border-radius: 999px; transition: width .8s ease; }
    .je-perf-escala { display: flex; justify-content: space-between; margin-top: 6px; font-size: .68rem; color: #374151; }

    .je-perfil-grid { display: grid; grid-template-columns: 280px 1fr 320px; gap: 16px; margin-bottom: 24px; align-items: start; }
    @@media (max-width: 1100px) { .je-perfil-grid { grid-template-columns: 1fr; } }

    .je-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 20px; position: relative; }
    /* padding-right reservado pro botão "Ampliar", que é posicionado no canto
       (em vez de entrar no fluxo do título, que varia de card pra card). */
    .je-card-titulo {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 1.15rem; font-weight: 700; color: var(--text-strong);
        margin-bottom: 14px; padding-right: 92px;
    }
    .je-card-nota { font-family: 'Barlow', Arial, sans-serif; font-size: .78rem; font-weight: 400; color: var(--text-dim); }

    /* ── Ampliar card (tela cheia) ──────────────────────────────────────────
       O card é movido para um overlay em document.body (position:fixed puro
       quebraria dentro de ancestral com transform), com um placeholder
       guardando o lugar dele no grid. */
    .je-zoom {
        position: absolute; top: 16px; right: 16px; z-index: 3; cursor: pointer;
        background: var(--p-0); border: 1px solid var(--line-strong); color: var(--text-dim); border-radius: 8px;
        font-family: 'Barlow', Arial, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0;
        text-transform: none; padding: .25rem .6rem; display: inline-flex; align-items: center; gap: 5px;
    }
    .je-zoom:hover { color: var(--text-strong); border-color: var(--line-strong); }

    .je-overlay { position: fixed; inset: 0; z-index: 2000; background: rgba(6,6,6,.93); padding: 2.5vh 2.5vw; overflow: auto; }
    .je-card.je-ampliado { margin: 0; height: 95vh; display: flex; flex-direction: column; overflow: auto; }
    .je-ampliado > .je-card-titulo { flex-shrink: 0; font-size: .8rem; }

    /* Posições em campo: no lugar dos 130px fixos, a largura vira uma fração da
       tela (o aspect-ratio deriva a altura). Dimensionar pela largura — e não
       por height:100% — garante que o campo nunca fique mais largo que o card
       em telas baixas/estreitas, onde a altura disponível é maior que a
       largura disponível. */
    .je-ampliado .je-campo-row { flex: 1 1 auto; min-height: 0; gap: 28px; }
    .je-ampliado .je-campo { width: min(45%, 50vh); height: auto; }
    .je-ampliado .je-campo-dot { width: 44px; height: 44px; font-size: 13px; }
    .je-ampliado .je-campo-circulo { width: 22%; height: 14.7%; }
    .je-ampliado .je-pos-lista { gap: 14px; }
    .je-ampliado .je-pos-sigla { width: 46px; font-size: .9rem; padding: 5px 0; }
    .je-ampliado .je-pos-nome { font-size: 1rem; }
    .je-ampliado .je-pos-sub { font-size: .8rem; }

    /* Mapa de calor: idem — a altura manda e o canvas é redesenhado no tamanho novo. */
    .je-ampliado .je-heatmap-body { flex: 1 1 auto; min-height: 0; justify-content: center; }
    .je-ampliado .je-heatmap-pitch { width: min(100%, 52vh); max-width: none; height: auto; }
    .je-ampliado .je-heatmap-legend { max-width: 420px; }
    .je-ampliado .je-heatmap-legend span { font-size: .75rem; }

    /* Médias por jogo: donuts e chips maiores; o que não couber rola no card. */
    .je-ampliado .je-donuts { gap: 28px; margin-bottom: 28px; }
    .je-ampliado .je-donut-ring { width: 150px; height: 150px; }
    .je-ampliado .je-donut-hole { width: 110px; height: 110px; font-size: 1.7rem; }
    .je-ampliado .je-donut-label { font-size: 1.05rem; margin-top: 10px; }
    .je-ampliado .je-donut-sub { font-size: .82rem; }
    .je-ampliado .je-chips { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
    .je-ampliado .je-chip { padding: 14px 8px; }
    .je-ampliado .je-chip-valor { font-size: 1.6rem; }
    .je-ampliado .je-chip-label { font-size: .7rem; }

    @@media (max-width: 768px) {
        .je-overlay { padding: 1rem .6rem; }
        .je-card.je-ampliado { height: calc(100vh - 2rem); }
        /* Lado a lado não cabe no celular: campo em cima, lista de posições embaixo. */
        .je-ampliado .je-campo-row { flex-direction: column; align-items: center; }
        .je-ampliado .je-campo { width: min(100%, 42vh); }
        .je-ampliado .je-pos-lista { width: 100%; }
        .je-ampliado .je-heatmap-pitch { width: min(100%, 42vh); }
    }

    .je-campo-row { display: flex; gap: 16px; align-items: flex-start; }
    .je-campo {
        position: relative; width: 130px; flex-shrink: 0; aspect-ratio: 2/3;
        background: linear-gradient(180deg, #14532d 0%, #166534 100%);
        border: 2px solid rgba(255,255,255,.2); border-radius: 8px; overflow: hidden;
    }
    .je-campo-linha { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(255,255,255,.2); }
    .je-campo-circulo {
        position: absolute; left: 50%; top: 50%; width: 44px; height: 44px;
        border: 1.5px solid rgba(255,255,255,.2); border-radius: 50%; transform: translate(-50%, -50%);
    }
    .je-campo-area-sup, .je-campo-area-inf {
        position: absolute; left: 22%; width: 56%; height: 15%; border: 1.5px solid rgba(255,255,255,.2);
    }
    .je-campo-area-sup { top: -1px; border-top: none; }
    .je-campo-area-inf { bottom: -1px; border-bottom: none; }
    .je-campo-dot {
        position: absolute; transform: translate(-50%, -50%); width: 28px; height: 28px; border-radius: 50%;
        color: #0f172a; display: flex; align-items: center; justify-content: center;
        font-size: 9px; font-weight: 800; border: 2px solid rgba(255,255,255,.7);
        box-shadow: 0 2px 6px rgba(0,0,0,.5); z-index: 1; background: #22c55e;
    }
    .je-campo-dot-principal { background: #facc15; z-index: 2; }

    .je-heatmap-badge {
        font-size: .6rem; font-weight: 700; padding: 2px 8px; border-radius: 999px;
        background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.25);
        text-transform: none; letter-spacing: 0;
    }
    .je-heatmap-body { display: flex; flex-direction: column; align-items: center; }
    .je-heatmap-pitch { position: relative; width: 100%; max-width: 210px; aspect-ratio: 68/105; border-radius: 6px; overflow: hidden; }
    .je-heatmap-legend { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; width: 100%; max-width: 210px; }
    .je-heatmap-legend span { font-size: .72rem; color: var(--text-dim); font-weight: 600; }
    .je-heatmap-legend-bar { flex: 1; margin: 0 10px; height: 5px; border-radius: 3px; background: linear-gradient(90deg, #4ade80, #facc15, #f97316, #ef4444); }

    .je-pos-lista { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; padding-top: 4px; }
    .je-pos-item { display: flex; align-items: center; gap: 8px; }
    .je-pos-sigla {
        flex-shrink: 0; width: 34px; text-align: center; padding: 2px 0; border-radius: 6px;
        font-size: .72rem; font-weight: 800; background: var(--p-alt-3); color: var(--text-strong);
    }
    .je-pos-item-principal .je-pos-sigla { background: #facc15; color: #0f172a; }
    .je-pos-nome { font-size: .85rem; font-weight: 600; color: var(--text); line-height: 1.2; }
    .je-pos-sub { font-size: .75rem; color: var(--text-dim); }

    .je-destaques-label { font-size: .82rem; font-weight: 600; color: var(--text-muted); margin-bottom: 10px; }
    .je-donuts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
    .je-donut { text-align: center; min-width: 0; }
    .je-donut-ring { width: 74px; height: 74px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; }
    .je-donut-hole { width: 54px; height: 54px; border-radius: 50%; background: var(--p-2); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .9rem; color: var(--text-strong); }
    .je-donut-label { font-size: .82rem; font-weight: 600; color: var(--text); margin-top: 6px; }
    .je-donut-sub { font-size: .68rem; color: var(--text-dim); margin-top: 2px; }

    .je-chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 8px; }
    @@media (max-width: 560px) { .je-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .je-chip { background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 10px; padding: 8px 4px; text-align: center; min-width: 0; }
    .je-chip-valor { font-size: 1.05rem; font-weight: 800; color: var(--text-strong); line-height: 1; }
    .je-chip-label { font-size: .74rem; color: var(--text-dim); margin-top: 3px; line-height: 1.2; hyphens: auto; }

    .je-section { margin-bottom: 24px; }
    .je-section-row { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; cursor: pointer; background: none; border: none; width: 100%; padding: 0 0 16px; border-bottom: 1px solid transparent; }
    .je-section-row.je-com-linha { border-bottom-color: var(--line); }
    .je-section-titulo { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.35rem; font-weight: 700; color: var(--text-strong); white-space: nowrap; }
    .je-section-linha { flex: 1; height: 1px; background: var(--p-3); }
    .je-section-badge { font-size: .68rem; padding: 2px 10px; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 999px; color: var(--text-dim); font-weight: 600; }
    .je-section-chevron { color: var(--text-dim); flex-shrink: 0; transition: transform .15s; }

    .je-season-selector { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .je-season-btn {
        background: var(--p-1); border: 1px solid var(--line); color: var(--text-muted);
        font-size: .8rem; font-weight: 600; padding: 6px 14px; border-radius: 999px; cursor: pointer; transition: all .15s;
    }
    .je-season-btn.active, .je-season-btn:hover { background: #d4a520; border-color: #d4a520; color: #141414; }

    .je-temporada-grid { display: grid; gap: 1rem; }
    .je-temporada-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .je-temporada-header { display: flex; align-items: center; gap: .75rem; padding: 14px 20px; border-bottom: 1px solid var(--line-soft); background: var(--p-0); }
    .je-temporada-logo { width: 28px; height: 28px; object-fit: contain; }
    .je-temporada-nome { font-size: 1rem; font-weight: 700; color: var(--text-strong); flex: 1; min-width: 0; }
    .je-temporada-pais { font-size: .75rem; color: var(--text-dim); display: flex; align-items: center; gap: 5px; }
    .je-rating-badge {
        font-size: .9rem; font-weight: 800; padding: 2px 10px; border-radius: 999px;
        background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.25); flex-shrink: 0;
    }
    .je-rating-badge.je-rating-sistema {
        background: rgba(59,130,246,.12); color: var(--info); border-color: rgba(59,130,246,.3);
    }
    .je-rating-grupo { display: flex; gap: .4rem; align-items: center; flex-shrink: 0; }
    .je-rating-item { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .je-rating-fonte { font-size: .7rem; font-weight: 600; color: var(--text-dim); }
    .je-temporada-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); }
    .je-stat-box { padding: 14px 8px; text-align: center; border-right: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
    .je-stat-val { font-size: 1.5rem; font-weight: 800; line-height: 1; color: var(--text-strong); }
    .je-stat-lbl { font-size: .74rem; color: var(--text-dim); margin-top: 3px; font-weight: 600; }
    .je-stat-val.hl-green  { color: var(--ok); }
    .je-stat-val.hl-blue   { color: var(--info); }
    .je-stat-val.hl-orange { color: var(--warn); }
    .je-stat-val.hl-yellow { color: var(--warn); }
    .je-temporada-footer { display: flex; gap: .5rem; flex-wrap: wrap; padding: 10px 20px; background: rgba(0,0,0,.15); font-size: .72rem; color: var(--text-dim); }
    .je-temporada-chip { background: rgba(255,255,255,.06); border-radius: 999px; padding: 2px 10px; display: flex; align-items: center; gap: .3rem; }

    /* ── Histórico por jogo ── */
    .je-jogos-lista { display: flex; flex-direction: column; gap: 8px; }
    .je-jogo-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; transition: border-color .15s; }
    .je-jogo-card:hover { border-color: var(--line-strong); }
    .je-jogo-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; flex-wrap: wrap; cursor: pointer; }
    .je-jogo-row:hover .je-jogo-adv { color: var(--gold-ink); }
    .je-jogo-badge { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; color: #fff; flex-shrink: 0; }
    .je-jogo-info { flex: 1; min-width: 0; }
    .je-jogo-linha1 { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; flex-wrap: wrap; }
    .je-jogo-escudo { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; border-radius: 50%; }
    /* Adversário clicável → página do time (sem disparar o clique do card) */
    .je-jogo-adv-link { color: inherit; text-decoration: none; }
    .je-jogo-adv-link:hover { color: var(--gold-ink); text-decoration: underline; }
    .je-jogo-adv { font-size: .9rem; font-weight: 600; color: var(--text-strong); }
    .je-jogo-placar { font-size: .82rem; color: var(--text-dimmer); font-weight: 500; margin-left: .3rem; }
    .je-tag { display: inline-flex; align-items: center; gap: 3px; font-size: .68rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; }
    .je-tag-gol { background: rgba(34,197,94,.12); color: var(--ok); border: 1px solid rgba(34,197,94,.25); }
    .je-tag-assist { background: rgba(251,146,60,.12); color: var(--warn); border: 1px solid rgba(251,146,60,.25); }
    .je-tag-craque { background: rgba(245,158,11,.14); border: 1px solid rgba(245,158,11,.35); }
    .je-tag-auto { font-size: .62rem; font-weight: 600; color: var(--info); padding: 1px 8px; border-radius: 999px; background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.25); }
    .je-tag-sem { background: rgba(148,163,184,.12); color: var(--text-muted); font-size: .62rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; border: 1px solid rgba(148,163,184,.25); }
    .je-jogo-data { font-size: .68rem; color: var(--text-dimmer); }

    .je-nota-circle { width: 52px; height: 52px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
    .je-nota-val { font-size: 1rem; font-weight: 800; line-height: 1; }
    .je-nota-label { font-size: .52rem; font-weight: 600; opacity: .75; letter-spacing: .04em; margin-top: 1px; }

    .je-ver-analise {
        font-size: .7rem; padding: 6px 12px; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text-muted); font-weight: 600; flex-shrink: 0; cursor: pointer;
    }
    .je-ver-analise:hover { border-color: #d4a520; color: var(--gold-ink); }
    .je-ver-analise.aberto { border-color: #d4a520; color: var(--gold-ink); }

    .je-stats-mini { display: flex; gap: 0; padding: 8px 18px; background: var(--p-0); border-top: 1px solid var(--line-soft); flex-wrap: wrap; }
    .je-stat-mini { flex: 1; text-align: center; padding: 0 4px; border-right: 1px solid var(--line-soft); min-width: 64px; }
    .je-stat-mini:last-child { border-right: none; }
    .je-stat-mini-val { font-size: 1rem; font-weight: 800; color: var(--text-strong); line-height: 1; }
    .je-stat-mini-lbl { font-size: .58rem; color: var(--text-dimmer); text-transform: uppercase; margin-top: 1px; }

    .je-analise-panel { display: none; border-top: 1px solid var(--line-soft); background: var(--p-0); }
    .je-analise-panel.aberto { display: block; }
    .je-analise-comp { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 10px 18px; border-bottom: 1px solid var(--line-soft); font-size: 11px; }
    .je-analise-comp-titulo { color: rgba(255,255,255,.35); font-size: 10px; letter-spacing: .4px; text-transform: uppercase; width: 100%; margin-bottom: 2px; }
    .je-analise-comp span { color: rgba(255,255,255,.5); }
    .je-detalhes { padding: 10px 18px; display: flex; flex-wrap: wrap; gap: 6px; }
    .je-detalhe-chip { font-size: 10px; font-weight: 600; padding: 2px 9px; border-radius: 999px; border: 1px solid; }
    .je-comentario { padding: 0 18px 10px; font-size: .78rem; color: var(--text-dim); font-style: italic; }
    .je-obs { padding: 0 18px 10px; display: flex; flex-direction: column; gap: 4px; }
    .je-obs-item { font-size: 12.5px; color: #a7f3d0; background: rgba(5,150,105,.12); border: 1px solid rgba(5,150,105,.4); border-radius: 8px; padding: 6px 10px; }

    .je-historico-collapsed .je-jogo-card:nth-child(n+4) { display: none; }
    .je-btn-expand {
        display: block; width: 100%; background: var(--p-1); border: 1px dashed var(--line); border-radius: 10px;
        color: var(--text-dim); font-size: .85rem; padding: .65rem 1rem; cursor: pointer; text-align: center; margin-top: .4rem;
        transition: background .2s, color .2s;
    }
    .je-btn-expand:hover { background: var(--p-4); color: var(--text); }

    .je-sem-dados { text-align: center; color: var(--text-dim); padding: 3rem; font-size: .95rem; }

    /* ── Modal: jogadores semelhantes ── */
    .je-modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(3px);
        display: none; align-items: flex-start; justify-content: center; z-index: 1000; padding: 2rem 1rem; overflow-y: auto;
    }
    .je-modal-overlay.open { display: flex; }
    .je-modal-box { background: var(--p-0); border: 1px solid var(--line); border-radius: 16px; width: 100%; max-width: 720px; box-shadow: 0 20px 60px rgba(0,0,0,.6); overflow: hidden; font-family: 'Barlow', sans-serif; color: var(--text); }
    .je-modal-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem; border-bottom: 1px solid var(--line); }
    .je-modal-titulo { font-size: 1.4rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; margin: 0; }
    .je-modal-close { background: var(--p-1); border: 1px solid var(--line); color: var(--text); width: 34px; height: 34px; border-radius: 8px; font-size: 1.1rem; cursor: pointer; flex-shrink: 0; }
    .je-modal-close:hover { background: var(--p-4); }
    .je-modal-criterios { display: flex; flex-wrap: wrap; gap: .4rem; padding: .9rem 1.4rem; border-bottom: 1px solid var(--line); background: rgba(0,0,0,.15); }
    .je-criterio-chip { background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3); color: var(--ok); font-size: .72rem; font-weight: 600; padding: .2rem .65rem; border-radius: 999px; }
    .je-modal-body { padding: 1rem 1.4rem 1.4rem; display: grid; gap: .6rem; }
    .je-sem-card { display: flex; align-items: center; gap: .9rem; background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: .7rem .9rem; transition: border-color .2s, background .2s; }
    .je-sem-card:hover { border-color: #4ade80; background: var(--p-2); }
    .je-sem-foto { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: var(--p-4); border: 1px solid var(--line); flex-shrink: 0; }
    .je-sem-info { flex: 1; min-width: 0; }
    .je-sem-nome { font-size: 1.15rem; font-weight: 700; color: var(--text-strong); text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; }
    .je-sem-nome:hover { color: var(--ok); text-decoration: underline; }
    .je-sem-meta { display: flex; flex-wrap: wrap; gap: .35rem .8rem; font-size: .75rem; color: var(--text-dim); margin-top: .2rem; }
    .je-sem-meta span { display: inline-flex; align-items: center; gap: .25rem; }
    .je-sem-stats { display: flex; gap: .4rem; flex-shrink: 0; justify-content: flex-end; flex-wrap: wrap; max-width: 190px; }
    .je-sem-stat { text-align: center; min-width: 36px; }
    .je-sem-stat-val { font-size: 1.2rem; font-weight: 800; line-height: 1; color: var(--text-strong); }
    .je-sem-stat-lbl { font-size: .6rem; text-transform: uppercase; color: var(--text-dim); letter-spacing: .05em; margin-top: .15rem; }
    .je-sem-escudo { width: 14px; height: 14px; object-fit: contain; vertical-align: middle; }
    /* Clube clicável dentro dos modais (semelhantes / comparar) */
    .je-clube-link { color: inherit; text-decoration: none; }
    .je-clube-link:hover { color: var(--gold-ink); text-decoration: underline; }

    /* ── Modal: comparar jogadores ── */
    .je-btn-comparar {
        display: flex; align-items: center; gap: 7px; padding: 8px 16px;
        background: rgba(96,165,250,0.1); border: 1px solid rgba(96,165,250,0.28); border-radius: 8px;
        color: var(--info); font-size: .8rem; font-weight: 700; cursor: pointer;
    }
    .je-btn-comparar:hover { background: rgba(96,165,250,0.2); }

    /* ── Modal: transferência para clube fora do sistema ── */
    .je-tr-box { max-width: 760px; }
    .je-tr-box .je-modal-body { display: block; }
    .je-tr-atual {
        padding: .9rem 1.4rem; border-bottom: 1px solid var(--line); background: rgba(0,0,0,.15);
        font-size: .8rem; color: var(--text-muted); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
    }
    .je-tr-atual img { width: 18px; height: 18px; object-fit: contain; }
    .je-tr-atual strong { color: var(--text); }
    .je-tr-picker {
        padding: .9rem 1.4rem; border-bottom: 1px solid var(--line);
        display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    }
    .je-tr-picker .je-select { max-width: 240px; }
    .je-tr-buscar {
        padding: 8px 16px; background: rgba(168,85,247,.12); border: 1px solid rgba(168,85,247,.32);
        border-radius: 8px; color: var(--purple); font-size: .8rem; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    .je-tr-buscar:hover:not(:disabled) { background: rgba(168,85,247,.22); }
    .je-tr-buscar:disabled { opacity: .4; cursor: not-allowed; }
    .je-tr-aposentou {
        margin-left: auto; padding: 8px 16px; background: rgba(251,191,36,.1);
        border: 1px solid rgba(251,191,36,.3); border-radius: 8px; color: var(--warn);
        font-size: .8rem; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap;
    }
    .je-tr-aposentou:hover:not(:disabled) { background: rgba(251,191,36,.2); }
    .je-tr-aposentou:disabled { opacity: .45; cursor: not-allowed; }
    .je-tr-badge-aposentado {
        display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; font-weight: 700;
        color: var(--warn); background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.28);
        border-radius: 999px; padding: .1rem .55rem;
    }
    .je-badge-lesao {
        display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; font-weight: 700;
        color: var(--bad); background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3);
        border-radius: 999px; padding: .1rem .55rem;
    }
    .je-badge-lesao .je-badge-lesao-retorno { font-weight: 500; opacity: .85; }
    .je-tr-filtro {
        width: 100%; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text); font-size: .82rem; padding: 8px 12px; outline: none; font-family: inherit; margin-bottom: .8rem;
    }
    .je-tr-filtro:focus { border-color: #c084fc; }
    .je-tr-lista { display: grid; gap: .5rem; max-height: 420px; overflow-y: auto; }
    .je-tr-clube {
        display: flex; align-items: center; gap: .8rem; background: var(--p-1); border: 1px solid var(--line);
        border-radius: 10px; padding: .6rem .8rem; cursor: pointer; text-align: left; width: 100%;
        font-family: inherit; color: inherit; transition: border-color .2s, background .2s;
    }
    .je-tr-clube:hover { border-color: #c084fc; background: var(--p-2); }
    .je-tr-clube img { width: 30px; height: 30px; object-fit: contain; flex-shrink: 0; }
    .je-tr-clube-nome { font-size: .92rem; font-weight: 700; color: var(--text-strong); }
    .je-tr-clube-meta { font-size: .7rem; color: var(--text-dim); margin-top: .1rem; }
    .je-tr-tag {
        margin-left: auto; flex-shrink: 0; font-size: .65rem; font-weight: 700; padding: .18rem .55rem;
        border-radius: 999px; text-transform: uppercase; letter-spacing: .04em;
    }
    .je-tr-tag.cadastrado { background: rgba(74,222,128,.12); border: 1px solid rgba(74,222,128,.3); color: var(--ok); }
    .je-tr-tag.novo { background: rgba(168,85,247,.12); border: 1px solid rgba(168,85,247,.3); color: var(--purple); }
    .je-tr-msg { text-align: center; color: var(--text-dim); padding: 2rem 1rem; font-size: .88rem; }
    .je-tr-msg.erro { color: var(--bad); }

    .je-cmp-box { max-width: 880px; }
    .je-cmp-box .je-modal-body { display: block; }
    .je-cmp-picker {
        padding: .9rem 1.4rem; border-bottom: 1px solid var(--line); background: rgba(0,0,0,.15);
        display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    }
    .je-cmp-picker .je-select { max-width: 210px; }
    .je-cmp-picker #cmpTemporada { max-width: 160px; }
    .je-cmp-ou { font-size: .68rem; color: var(--text-dimmer); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
    .je-cmp-busca-wrap { position: relative; flex: 1; min-width: 190px; }
    .je-cmp-busca {
        width: 100%; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text); font-size: .82rem; padding: 8px 12px; outline: none; font-family: inherit;
    }
    .je-cmp-busca:focus { border-color: #60a5fa; }
    .je-cmp-busca-resultados {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 10;
        background: var(--p-1); border: 1px solid var(--line-strong); border-radius: 10px;
        max-height: 260px; overflow-y: auto; display: none; box-shadow: 0 12px 30px rgba(0,0,0,.5);
    }
    .je-cmp-busca-resultados.open { display: block; }
    .je-cmp-busca-item { display: flex; align-items: center; gap: .6rem; padding: .5rem .7rem; cursor: pointer; }
    .je-cmp-busca-item:hover { background: var(--p-3); }
    .je-cmp-busca-item img { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; background: var(--p-4); flex-shrink: 0; }
    .je-cmp-busca-nome { font-size: .85rem; font-weight: 600; color: var(--text-strong); }
    .je-cmp-busca-sub { font-size: .68rem; color: var(--text-dim); }

    .je-cmp-vazio { text-align: center; color: var(--text-dim); padding: 2.5rem 1rem; font-size: .9rem; }

    .je-cmp-head { display: grid; grid-template-columns: 1fr auto 1fr; gap: .8rem; align-items: stretch; margin-bottom: 1rem; }
    @@media (max-width: 640px) { .je-cmp-head { grid-template-columns: 1fr; } .je-cmp-vs { text-align: center; } }
    .je-cmp-jog {
        background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: .8rem;
        display: flex; align-items: center; gap: .7rem; border-top: 3px solid var(--cor, #4b5563);
    }
    .je-cmp-jog img.foto { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: var(--p-4); flex-shrink: 0; }
    .je-cmp-jog-nome { font-size: 1.05rem; font-weight: 800; color: var(--text-strong); line-height: 1.15; }
    .je-cmp-jog-nome:hover { color: var(--cor, var(--gold-ink)); text-decoration: underline; }
    .je-cmp-jog-sub { font-size: .7rem; color: var(--text-dim); margin-top: .25rem; display: flex; flex-wrap: wrap; gap: .2rem .6rem; }
    .je-cmp-vs { align-self: center; font-size: 1rem; font-weight: 800; color: var(--text-dimmer); }

    .je-cmp-aviso {
        font-size: .74rem; color: var(--warn); background: rgba(251,191,36,.08);
        border: 1px solid rgba(251,191,36,.25); border-radius: 8px; padding: .45rem .7rem; margin-bottom: .5rem;
    }
    .je-cmp-veredito {
        background: rgba(212,165,32,.08); border: 1px solid rgba(212,165,32,.3); border-radius: 12px;
        padding: .8rem 1rem; font-size: .88rem; color: var(--text); margin-bottom: .8rem;
    }
    .je-cmp-veredito strong { color: var(--gold-ink); }
    .je-cmp-insights { display: grid; gap: .5rem; margin-bottom: .6rem; }
    .je-cmp-insight {
        display: flex; gap: .6rem; align-items: flex-start; background: var(--p-1);
        border: 1px solid var(--line); border-left: 3px solid #4b5563; border-radius: 10px;
        padding: .6rem .8rem; font-size: .82rem; color: var(--text-2); line-height: 1.45;
    }
    .je-cmp-insight.vence-a { border-left-color: #facc15; }
    .je-cmp-insight.vence-b { border-left-color: #60a5fa; }
    .je-cmp-insight strong { color: var(--text-strong); }

    .je-cmp-grupo-titulo { font-size: .68rem; font-weight: 700; letter-spacing: .14em; color: var(--text-dim); text-transform: uppercase; margin: 1.1rem 0 .5rem; }
    .je-cmp-row { display: grid; grid-template-columns: 64px 1fr 64px; gap: .7rem; align-items: center; padding: .3rem 0; }
    .je-cmp-val { font-size: .92rem; font-weight: 700; color: var(--text-dim); text-align: center; }
    .je-cmp-val.vence.lado-a { color: var(--warn); }
    .je-cmp-val.vence.lado-b { color: var(--info); }
    .je-cmp-mid { min-width: 0; }
    .je-cmp-metrica-label { font-size: .72rem; color: var(--text-muted); text-align: center; margin-bottom: .25rem; }
    .je-cmp-bar { display: flex; height: 7px; border-radius: 999px; overflow: hidden; background: var(--p-3); }
    .je-cmp-bar .seg-a { background: rgba(250,204,21,.3); }
    .je-cmp-bar .seg-b { background: rgba(96,165,250,.3); }
    .je-cmp-bar .seg-a.vence { background: #facc15; }
    .je-cmp-bar .seg-b.vence { background: #60a5fa; }

    /* ── Cabeçalho de seção (histórico) — fixo, não recolhe mais ── */
    .je-sec-cab { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 14px; margin-bottom: 12px; }
    .je-sec-cab .je-section-titulo { margin: 0; }
    .je-sec-nota { font-size: .82rem; color: var(--text-dim); }

    /* Filtro do histórico: todos os jogos com escalação ou só os que jogou */
    .je-hist-filtro { display: inline-flex; gap: 4px; margin-left: auto; }
    .je-hist-filtro button {
        padding: 5px 12px; border-radius: 8px; border: 1px solid var(--line-strong); background: var(--p-2);
        color: var(--text-2); font-family: inherit; font-size: .8rem; font-weight: 600; cursor: pointer;
    }
    .je-hist-filtro button[aria-pressed="true"] { background: #d4a520; border-color: #d4a520; color: #141414; }

    /* ── Histórico por jogo: uma linha por partida ── */
    /* position: relative prende o rótulo visually-hidden (absoluto) dentro da caixa
       que rola; sem isso ele escapava e alargava a página inteira no celular. */
    .je-hist-scroll { position: relative; overflow-x: auto; background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; }
    .je-hist { width: 100%; border-collapse: collapse; font-size: .88rem; }
    .je-hist th {
        text-align: left; padding: 9px 10px; font-size: .78rem; font-weight: 600; color: var(--text-muted);
        border-bottom: 1px solid var(--line-strong); white-space: nowrap;
    }
    .je-hist td { padding: 8px 10px; border-bottom: 1px solid var(--line-soft); color: var(--text-2); vertical-align: middle; white-space: nowrap; }
    .je-hist .num { text-align: right; font-variant-numeric: tabular-nums; }
    .je-hist tr.je-hist-jogo { cursor: pointer; }
    .je-hist tr.je-hist-jogo:hover td { background: var(--p-3); }
    .je-hist tr.banco td { color: var(--text-dim); }
    .je-hist tr.banco .je-hist-adv { font-weight: 500; }
    /* Filtro "em campo" esconde as linhas de banco; "ver todos" (classe .todos)
       libera as linhas além das primeiras 20 de cada filtro. */
    .je-hist.so-campo tr.banco, .je-hist.so-campo tr.banco + tr.je-hist-analise { display: none; }
    .je-hist:not(.so-campo):not(.todos) tr.mais-todos { display: none; }
    .je-hist.so-campo:not(.todos) tr.mais-campo { display: none; }

    .je-hist-adv { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text-strong); }
    .je .je-hist-adv a:hover { color: var(--gold-ink); text-decoration: underline; }
    .je-hist-adv img { width: 18px; height: 18px; object-fit: contain; }
    .je-hist-adv .vazio { width: 18px; height: 18px; border-radius: 50%; background: var(--p-3); display: inline-block; }
    .je-hist-fora { font-size: .75rem; color: var(--text-dim); font-weight: 500; }
    .je-hist-tags { display: inline-flex; gap: 4px; margin-left: 6px; }

    .je-res { display: inline-flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; }
    .je-res-tag { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; font-size: .75rem; font-weight: 800; }
    .je-res-tag.v { background: rgba(34,197,94,.18); color: var(--ok); }
    .je-res-tag.e { background: var(--p-3); color: var(--text-muted); }
    .je-res-tag.d { background: rgba(239,68,68,.15); color: var(--bad); }
    .je-res-tag.x { background: var(--p-3); color: var(--text-dim); }
    .je-res-pen { font-size: .75rem; color: var(--text-dim); }

    .je-hist-nota { display: inline-flex; align-items: baseline; gap: 6px; }
    .je-hist-nota strong { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.15rem; font-weight: 800; }
    .je-hist-nota small { font-size: .72rem; color: var(--text-dim); }
    .je-hist-acoes { display: inline-flex; gap: 6px; }
    .je-hist-acoes .je-ver-analise { font-size: .78rem; padding: 4px 10px; }
    .je-hist tr.je-hist-analise > td { padding: 0; white-space: normal; background: var(--p-0); }
    .je-hist tr.je-hist-analise .je-analise-panel { border-top: none; }
    .je-hist-mostrar {
        display: block; width: 100%; padding: 10px; border: none; border-top: 1px solid var(--line);
        background: transparent; color: var(--gold-ink); font-family: inherit; font-weight: 600; font-size: .85rem; cursor: pointer;
    }
    .je-hist-mostrar:hover { background: var(--p-3); }

    /* Na composição da nota os textos eram brancos fixos (sumiam no tema claro) */
    .je-analise-comp-titulo { color: var(--text-dim) !important; text-transform: none !important; font-size: .78rem !important; letter-spacing: 0 !important; }
    .je-analise-comp span { color: var(--text-muted) !important; }
</style>

<div class="je">
    <div class="je-top">
        @* Para a lista de verdade: history.back() levava de volta para onde quer que a
           pessoa tivesse vindo (a busca da home, o campinho da análise), não para "a lista". *@
        <a asp-controller="Jogadores" asp-action="Index" class="je-voltar">← Jogadores</a>
    </div>

    <!-- ── Header do jogador ─────────────────────────────────────────── -->
    <div class="je-header theme-dark-zone">
        <div class="je-header-inner">

            @if (Model.Jogador.Time?.EscudoUrl != null)
            {
                <a class="je-escudo-wrap" asp-controller="Times" asp-action="Details" asp-route-id="@Model.Jogador.TimeId" title="Ver @Model.Jogador.Time.Nome">
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogador.Time.EscudoUrl })" alt="" />
                </a>
            }

            <div class="je-foto-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.Jogador.FotoUrl))
                {
                    <img src="@Url.FotoSrc(Model.Jogador.FotoUrl)" onerror="this.onerror=null; this.src='/images/placeholder-jogador.png'" />
                }
                else
                {
                    <img src="/images/placeholder-jogador.png" />
                }
            </div>

            <div class="je-info">
                <h1 class="je-nome">@Model.Jogador.NomeExibicao</h1>
                <div class="je-meta">
                    <span class="je-pos-badge">@PosicaoJogadorHelper.Sigla(Model.Jogador.Posicao)</span>
                    @if (Model.Jogador.NumeroCamisa.HasValue)
                    {
                        <span class="je-meta-item">Nº @Model.Jogador.NumeroCamisa</span>
                    }
                    <span class="je-meta-item">@Model.Jogador.Idade anos</span>
                    @if (Model.Jogador.Altura.HasValue)
                    {
                        <span class="je-meta-item">@Model.Jogador.Altura cm</span>
                    }
                    @if (Model.Jogador.Peso.HasValue)
                    {
                        <span class="je-meta-item">@Model.Jogador.Peso kg</span>
                    }
                    @if (Model.Jogador.Time != null)
                    {
                        <a class="je-meta-item je-meta-clube" asp-controller="Times" asp-action="Details" asp-route-id="@Model.Jogador.TimeId" title="Ver @Model.Jogador.Time.Nome">
                            @if (!string.IsNullOrEmpty(Model.Jogador.Time.EscudoUrl))
                            {
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogador.Time.EscudoUrl })" alt="" />
                            }
                            @Model.Jogador.Time.Nome
                        </a>
                    }
                    @if (Model.Jogador.Nacionalidade != null)
                    {
                        var bandeiraUrl = FlagHelper.GetFlagImageUrl(Model.Jogador.Nacionalidade.Nome);
                        <span class="je-meta-item" title="País de nascimento: @Model.Jogador.Nacionalidade.Nome">
                            @if (bandeiraUrl != null)
                            {
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = bandeiraUrl })" alt="" />
                            }
                            @Model.Jogador.Nacionalidade.Nome
                        </span>
                    }
                    @if (Model.Jogador.Selecao != null)
                    {
                        <a class="je-meta-item je-meta-clube" asp-controller="Times" asp-action="Details" asp-route-id="@Model.Jogador.SelecaoId" title="Seleção que defende: @Model.Jogador.Selecao.Nome">
                            @if (!string.IsNullOrEmpty(Model.Jogador.Selecao.EscudoUrl))
                            {
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogador.Selecao.EscudoUrl })" alt="" />
                            }
                            @Model.Jogador.Selecao.Nome
                        </a>
                    }
                    @* Lesão em curso, informada pelo FotMob. Nasce vazio e some se não
                       houver lesão: quem preenche é /Jogadores/SituacaoFisica, chamado
                       depois que a tela já carregou — esta página não espera fonte
                       externa nenhuma para aparecer. *@
                    @if (Model.Jogador.IdFotMob != null)
                    {
                        <span class="je-badge-lesao" id="jeLesao" hidden></span>
                    }
                    @if (Model.Jogador.Aposentado)
                    {
                        <span class="je-tr-badge-aposentado"
                              title="@(Model.Jogador.AposentadoEm.HasValue ? $"Marcado como aposentado em {Model.Jogador.AposentadoEm.Value.ToLocalTime():dd/MM/yyyy}" : "Marcado como aposentado")">
                            🏁 Aposentado
                        </span>
                    }
                </div>
            </div>

            <div class="je-acoes">
                @if (competicoes.Count > 1 || temporadas.Count > 1)
                {
                    <form method="get" class="je-filtros">
                        <input type="hidden" name="id" value="@Model.Jogador.Id" />
                        @if (competicoes.Count > 1)
                        {
                            <div class="je-select-wrap">
                                <select name="competicaoId" class="je-select" aria-label="Competição" onchange="this.form.submit()">
                                    <option value="">Todas as competições</option>
                                    @foreach (var c in competicoes)
                                    {
                                        <option value="@c.Id" selected="@(competicaoAtual == c.Id)">@c.Nome</option>
                                    }
                                </select>
                                <div class="je-select-arrow">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </div>
                        }
                        else if (competicaoAtual.HasValue)
                        {
                            <input type="hidden" name="competicaoId" value="@competicaoAtual" />
                        }
                        @if (temporadas.Count > 1)
                        {
                            <div class="je-select-wrap">
                                <select name="temporada" class="je-select" aria-label="Temporada" onchange="this.form.submit()">
                                    <option value="">Todas as temporadas</option>
                                    @foreach (var t in temporadas)
                                    {
                                        <option value="@t.Valor" selected="@(temporadaAtual == t.Valor)">@t.Rotulo</option>
                                    }
                                </select>
                                <div class="je-select-arrow">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </div>
                        }
                    </form>
                    @if (competicaoAtual.HasValue || temporadaAtual.HasValue)
                    {
                        <a href="/Jogadores/Estatisticas/@Model.Jogador.Id" class="je-clear">Limpar filtros</a>
                    }
                }

                <div class="je-acoes-links">
                    @* Único ponto da tela que leva a dados externos. A busca no FotMob só
                       acontece depois do clique — esta página não chama ninguém. Sem
                       vínculo o botão fica visível e leva à identificação: sumir seria
                       pior, porque ninguém descobriria que a função existe. *@
                    @{
                        var temVinculoFotMob = Model.Jogador.IdFotMob != null;
                    }
                    <a href="@(temVinculoFotMob
                                ? $"/Jogadores/EstatisticasAvancadas/{Model.Jogador.Id}"
                                : $"/Jogadores/VincularEstatisticas/{Model.Jogador.Id}")"
                       class="je-acao principal"
                       title="@(temVinculoFotMob
                                ? "xG, xGOT e a posição do jogador entre os outros da competição."
                                : "Este jogador ainda não está identificado na base avançada — clique para escolher.")">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                        @(temVinculoFotMob ? "Estatísticas avançadas" : "Identificar para estatísticas avançadas")
                    </a>
                    <a href="/AnotacoesJogador?jogadorId=@Model.Jogador.Id" class="je-acao">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        Observações
                    </a>
                    <details class="je-mais" id="jeMais">
                        <summary class="je-acao">Mais ▾</summary>
                        <div class="je-mais-menu">
                            <button type="button" class="je-acao" onclick="fecharMais(); abrirSemelhantes()">Jogadores semelhantes</button>
                            <button type="button" class="je-acao" onclick="fecharMais(); abrirComparar()">Comparar com outro jogador</button>
                            <button type="button" class="je-acao" onclick="fecharMais(); abrirTransferencias()">Transferências</button>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Conteúdo principal ────────────────────────────────────────── -->
    <div class="je-main">

        <!-- Cards de resumo -->
        @{
            var temNota = Model.TotalJogos > 0;
            var convocadoEm = Model.TotalJogosParticipados;
        }
        <div class="je-resumo">
            <div class="je-resumo-card destaque">
                <div class="je-resumo-label">Média geral</div>
                <div class="je-resumo-valor">@(temNota ? Model.MediaNotas.ToString("0.0") : "–")</div>
                @if (temNota)
                {
                    <div class="je-resumo-regua" role="img" aria-label="Média @Model.MediaNotas.ToString("0.0") de 10">
                        <span style="width:@((Model.MediaNotas / 10.0 * 100).ToString("0", inv))%"></span>
                    </div>
                    <div class="je-resumo-det">@LabelNota(Model.MediaNotas) em @Model.TotalJogos @(Model.TotalJogos == 1 ? "jogo avaliado" : "jogos avaliados")</div>
                }
                else
                {
                    <div class="je-resumo-det">Nenhum jogo avaliado ainda</div>
                }
            </div>
            <div class="je-resumo-card">
                <div class="je-resumo-label">Jogos</div>
                <div class="je-resumo-valor">@Model.JogosEmCampo</div>
                <div class="je-resumo-det" title="Partidas com escalação, contando as em que ficou só no banco">
                    @(convocadoEm > Model.JogosEmCampo ? $"em campo, de {convocadoEm} relacionados" : "em campo")
                </div>
            </div>
            <div class="je-resumo-card">
                <div class="je-resumo-label">Minutos</div>
                <div class="je-resumo-valor">@Model.TotalMinutos.ToString("N0")</div>
                <div class="je-resumo-det">@(Model.MinutosPorJogo is int mpj ? $"{mpj} por jogo" : "sem minutagem importada")</div>
            </div>
            <div class="je-resumo-card">
                <div class="je-resumo-label">Gols</div>
                <div class="je-resumo-valor">@Model.TotalGols</div>
            </div>
            <div class="je-resumo-card">
                <div class="je-resumo-label">Assistências</div>
                <div class="je-resumo-valor">@Model.TotalAssistencias</div>
            </div>
        </div>

        <!-- Perfil tático: posições em campo + mapa de calor + médias por jogo -->
        @{
            var competicaoNomeAtual = competicaoAtual.HasValue
                ? competicoes.FirstOrDefault(c => c.Id == competicaoAtual)?.Nome
                : "Todas as competições";
        }
        @if (Model.PosicoesJogadas.Any() || Model.PontosHeatmap.Any() || Model.Medias != null)
        {
            <div class="je-perfil-grid">
                @if (Model.PosicoesJogadas.Any())
                {
                    <div class="je-card">
                        <div class="je-card-titulo">Posições em campo</div>
                        <div class="je-campo-row">
                            <div class="je-campo theme-dark-zone">
                                <div class="je-campo-linha"></div>
                                <div class="je-campo-circulo"></div>
                                <div class="je-campo-area-sup"></div>
                                <div class="je-campo-area-inf"></div>
                                @foreach (var p in Model.PosicoesJogadas)
                                {
                                    var principal = p == Model.PosicoesJogadas[0];
                                    <div class="je-campo-dot @(principal ? "je-campo-dot-principal" : "")"
                                         style="left:@p.X.ToString("0.#", inv)%; top:@p.Y.ToString("0.#", inv)%;"
                                         title="@NomePosicao(p.Posicao) — @p.Jogos jogo(s) (@p.Pct%)">
                                        @SiglaPosicao(p.Posicao)
                                    </div>
                                }
                            </div>
                            <div class="je-pos-lista">
                                @foreach (var p in Model.PosicoesJogadas)
                                {
                                    var principal = p == Model.PosicoesJogadas[0];
                                    <div class="je-pos-item @(principal ? "je-pos-item-principal" : "")">
                                        <span class="je-pos-sigla">@SiglaPosicao(p.Posicao)</span>
                                        <div style="flex:1; min-width:0;">
                                            <div class="je-pos-nome">@NomePosicao(p.Posicao)</div>
                                            <div class="je-pos-sub">@p.Jogos @(p.Jogos == 1 ? "jogo" : "jogos") (@p.Pct%)</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (Model.PontosHeatmap.Any())
                {
                    <div class="je-card">
                        <div class="je-card-titulo" style="display:flex; align-items:center; justify-content:space-between;">
                            <span>Mapa de calor</span>
                            <span class="je-heatmap-badge">@competicaoNomeAtual</span>
                        </div>
                        <div class="je-heatmap-body">
                        <div id="jeHeatmapCampo" class="je-heatmap-pitch theme-dark-zone">
                            <svg viewBox="0 0 680 1050" xmlns="http://www.w3.org/2000/svg" style="position:absolute; inset:0; width:100%; height:100%;">
                                <rect width="680" height="1050" fill="#0d3d1f" />
                                <rect x="0" y="0" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="150" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="300" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="450" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="600" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="750" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="0" y="900" width="680" height="75" fill="#0e4221" opacity="0.5" />
                                <rect x="5" y="5" width="670" height="1040" rx="2" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="3" />
                                <line x1="5" y1="525" x2="675" y2="525" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <circle cx="340" cy="525" r="91.5" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <circle cx="340" cy="525" r="4" fill="rgba(255,255,255,0.5)" />
                                <rect x="129" y="5" width="422" height="132" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <rect x="229" y="5" width="222" height="55" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <circle cx="340" cy="116" r="4" fill="rgba(255,255,255,0.5)" />
                                <path d="M 251 137 A 91.5 91.5 0 0 0 429 137" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <rect x="273" y="0" width="134" height="18" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.35)" stroke-width="2" />
                                <rect x="129" y="913" width="422" height="132" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <rect x="229" y="990" width="222" height="55" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <circle cx="340" cy="934" r="4" fill="rgba(255,255,255,0.5)" />
                                <path d="M 251 913 A 91.5 91.5 0 0 1 429 913" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" />
                                <rect x="273" y="1032" width="134" height="18" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.35)" stroke-width="2" />
                            </svg>
                        </div>
                        <div class="je-heatmap-legend">
                            <span>Baixa</span>
                            <div class="je-heatmap-legend-bar"></div>
                            <span>Alta</span>
                        </div>
                        </div>
                    </div>
                }

                @if (Model.Medias != null)
                {
                    var m = Model.Medias;
                    <div class="je-card">
                        <div class="je-card-titulo">Médias por jogo <span class="je-card-nota">em @m.Jogos jogo@(m.Jogos == 1 ? "" : "s") com estatísticas importadas</span></div>

                        @{
                            // Os donuts são os 3 fundamentos em que o jogador melhor
                            // se sai (ranking calculado no controller) — o restante
                            // do catálogo desce para os chips.
                            var destaques = m.Metricas.Take(3).ToList();
                            var demais = m.Metricas.Skip(3).ToList();
                        }

                        @if (destaques.Any())
                        {
                            <div class="je-destaques-label">Onde ele mais se destaca</div>
                            <div class="je-donuts">
                                @foreach (var met in destaques)
                                {
                                    <div class="je-donut">
                                        <div class="je-donut-ring" style="background: conic-gradient(@met.Cor 0 @(met.PreenchimentoPct)%, var(--p-3) @(met.PreenchimentoPct)% 100%);">
                                            <div class="je-donut-hole">@(met.Pct.HasValue ? $"{met.Pct}%" : met.Media.ToString("0.#"))</div>
                                        </div>
                                        <div class="je-donut-label">@met.Rotulo</div>
                                        <div class="je-donut-sub">
                                            @(met.Pct.HasValue
                                                ? $"{met.Media.ToString("0.#")} por jogo, {met.SufixoPct}"
                                                : "por jogo")
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (demais.Any())
                        {
                            <div class="je-chips">
                                @foreach (var met in demais)
                                {
                                    <div class="je-chip">
                                        <div class="je-chip-valor">@met.Media.ToString("0.#")</div>
                                        <div class="je-chip-label">@met.Rotulo</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }


        <!-- Histórico por Temporada (aberto: carrega junto com a página) -->
        @if (Model.Jogador.IdApi.HasValue)
        {
            <section class="je-section">
                <div class="je-sec-cab">
                    <h2 class="je-section-titulo">Histórico por temporada</h2>
                    <span class="je-sec-nota">Números de cada competição na temporada, segundo a importação.</span>
                </div>
                <div class="je-season-selector" id="seasonSelector" role="group" aria-label="Temporada">
                    @{
                        var anoAtual = DateTime.Now.Year;
                    }
                    @for (int ano = anoAtual; ano >= anoAtual - 3; ano--)
                    {
                        <button type="button" class="je-season-btn @(ano == anoAtual ? "active" : "")"
                                aria-pressed="@(ano == anoAtual ? "true" : "false")"
                                onclick="carregarTemporada(@Model.Jogador.Id, @ano, this)">
                            @ano
                        </button>
                    }
                </div>
                <div id="temporadaContainer"></div>
            </section>
        }

        <!-- Histórico por Jogo: uma linha por partida, aberto -->
        @{
            var jogosEmCampo = Model.NotasPorJogo.Count(x => x.EntrouEmCampo);
            var soBanco = Model.NotasPorJogo.Count - jogosEmCampo;
            const int linhasVisiveis = 20;
        }
        <section class="je-section">
            <div class="je-sec-cab">
                <h2 class="je-section-titulo">Histórico por jogo</h2>
                <span class="je-sec-nota">Clique numa linha para abrir a análise da partida.</span>
                @if (jogosEmCampo > 0)
                {
                    <a class="je-ver-analise" href="@Url.Action("SomaJogos", "Jogadores", new { id = Model.Jogador.Id })"
                       title="Escolher jogos (últimos N, contra um adversário...) e ver a soma das estatísticas">Somar jogos</a>
                }
                @if (soBanco > 0 && jogosEmCampo > 0)
                {
                    <div class="je-hist-filtro" role="group" aria-label="Quais jogos mostrar">
                        <button type="button" aria-pressed="true" data-hist="campo" onclick="filtrarHistorico('campo')">Em campo (@jogosEmCampo)</button>
                        <button type="button" aria-pressed="false" data-hist="todos" onclick="filtrarHistorico('todos')">Todos (@Model.NotasPorJogo.Count)</button>
                    </div>
                }
            </div>

            @if (!Model.NotasPorJogo.Any())
            {
                <div class="je-sem-dados">
                    Nenhum jogo registrado para este jogador ainda.
                </div>
            }
            else
            {
                <div class="je-hist-scroll">
                <table class="je-hist @(soBanco > 0 && jogosEmCampo > 0 ? "so-campo" : "")" id="historicoLista">
                    <thead>
                        <tr>
                            <th scope="col">Data</th>
                            <th scope="col">Adversário</th>
                            <th scope="col">Resultado</th>
                            <th scope="col">Posição</th>
                            <th scope="col" class="num">Min.</th>
                            <th scope="col" class="num">Gols</th>
                            <th scope="col" class="num">Assist.</th>
                            <th scope="col">Nota</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                @{ var idx = 0; var visiveisEmCampo = 0; var visiveisTodos = 0; }
                @foreach (var item in Model.NotasPorJogo)
                {
                    // Lado do jogador NAQUELE jogo (vem da escalação da época, via item.IsCasa)
                    // — usar o time atual inverteria os jogos do clube antigo após uma transferência.
                    bool isCasaJogador = item.IsCasa;

                    var adversario = isCasaJogador
                        ? item.Jogo.TimeVisitante?.Nome
                        : item.Jogo.TimeCasa?.Nome;

                    var adversarioEscudo = isCasaJogador
                        ? item.Jogo.TimeVisitante?.EscudoUrl
                        : item.Jogo.TimeCasa?.EscudoUrl;

                    var adversarioId = isCasaJogador
                        ? item.Jogo.TimeVisitanteId
                        : item.Jogo.TimeCasaId;

                    var temPlacar = item.Jogo.PlacarCasa.HasValue && item.Jogo.PlacarVisitante.HasValue;

                    var penaltis = (item.Jogo.PenaltisCasa.HasValue && item.Jogo.PenaltisVisitante.HasValue)
                        ? (isCasaJogador
                            ? $"({item.Jogo.PenaltisCasa}–{item.Jogo.PenaltisVisitante} nos pênaltis)"
                            : $"({item.Jogo.PenaltisVisitante}–{item.Jogo.PenaltisCasa} nos pênaltis)")
                        : null;

                    var resClasse = item.Resultado switch { "V" => "v", "E" => "e", "D" => "d", _ => "x" };
                    var resNome = item.Resultado switch { "V" => "Vitória", "E" => "Empate", "D" => "Derrota", _ => "Sem placar" };

                    string notaColor = item.Analisado ? CorNota(item.NotaFinal) : "var(--text-dim)";
                    string notaLabel = item.Analisado ? LabelNota(item.NotaFinal) : "Sem nota";
                    // Parcelas que entraram por cima de "base + ações" (pisos e bônus).
                    var ajustes = new List<(string Rotulo, double Valor, string Titulo)>
                    {
                        (item.Composicao.PisoMerecimento == CriteriosNotaHelper.PisoJogoEquilibrado
                            ? "Jogo equilibrado" : "Merecimento",
                            item.Composicao.Merecimento,
                            item.Composicao.PisoMerecimento == CriteriosNotaHelper.PisoJogoEquilibrado
                                ? $"Mesmo número de ações verdes e vermelhas: a nota sobe até {CriteriosNotaHelper.PisoJogoEquilibrado:0.0}"
                                : $"Mais ações verdes do que vermelhas: a nota sobe até {CriteriosNotaHelper.PisoJogoPositivo:0.0}"),
                        ("Pouco tempo", item.Composicao.ParticipacaoCurta,
                            $"Menos de {CriteriosNotaHelper.MinutosParticipacaoCurta} minutos: a nota sobe até {CriteriosNotaHelper.PisoParticipacaoCurta:0.0}"),
                        ("Goleiro decisivo", item.Composicao.GoleiroDecisivo,
                            $"Defendeu 100% do que foi no alvo e estava abaixo de {CriteriosNotaHelper.TetoGoleiroDecisivo:0.0}"),
                        ("Gol da vitória", item.Composicao.GolDaVitoria,
                            "Marcou o gol que decidiu a partida"),
                    }.Where(a => a.Valor > 0).ToList();

                    var temPosicao = !string.IsNullOrWhiteSpace(item.Posicao);
                    // Menções via "@Nome" (feature de /Jogos/Analisar) podem existir mesmo em
                    // jogos ainda não analisados (sem Nota/EstatisticaJogador) — por isso
                    // ObservacoesJogador.Any() precisa abrir o painel por conta própria,
                    // fora da condição "item.Analisado" que vale pro resto do painel.
                    var temAnalise = item.ObservacoesJogador.Any()
                        || (item.Analisado && (item.Detalhes.Any(d => d.Quantidade > 0) || !string.IsNullOrWhiteSpace(item.Comentario) || item.NotaManual.HasValue));

                    // "Ver todos": as primeiras linhas de cada filtro ficam à vista, o resto
                    // espera o clique. Conta separado para o filtro "em campo" e "todos".
                    var emCampo = item.EntrouEmCampo;
                    var maisCampo = emCampo && visiveisEmCampo++ >= linhasVisiveis;
                    var maisTodos = visiveisTodos++ >= linhasVisiveis;

                    <tr class="je-hist-jogo @(emCampo ? "" : "banco") @(maisTodos ? "mais-todos" : "") @(maisCampo ? "mais-campo" : "")"
                        onclick="irParaJogo(event, @item.Jogo.Id)" title="Abrir a análise da partida">
                        <td>@DateHelper.FormatarData(item.Jogo.Data, "dd/MM/yyyy")</td>
                        <td>
                            <span class="je-hist-adv">
                                @if (!string.IsNullOrEmpty(adversarioEscudo))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = adversarioEscudo })" alt="" />
                                }
                                else
                                {
                                    <span class="vazio" aria-hidden="true"></span>
                                }
                                <a href="/Times/Details/@adversarioId" onclick="event.stopPropagation()" title="Ver @adversario">@adversario</a>
                                @if (!isCasaJogador) { <span class="je-hist-fora">fora</span> }
                            </span>
                            @if (item.Craque || item.Gols > 0 || item.Assistencias > 0 || !emCampo)
                            {
                                <span class="je-hist-tags">
                                    @if (item.Craque) { <span class="je-tag je-tag-craque" title="Craque da partida: maior nota do jogo">👑</span> }
                                    @if (!emCampo) { <span class="je-tag-sem" title="Relacionado, mas não entrou em campo">banco</span> }
                                </span>
                            }
                        </td>
                        <td>
                            <span class="je-res">
                                <span class="je-res-tag @resClasse" title="@resNome" aria-label="@resNome">@(item.Resultado == "?" ? "–" : item.Resultado)</span>
                                @(temPlacar ? $"{item.GolsPro} – {item.GolsContra}" : "–")
                                @if (penaltis != null) { <span class="je-res-pen">@penaltis</span> }
                            </span>
                        </td>
                        <td>@(temPosicao ? PosicaoJogadorHelper.Sigla(item.Posicao) : "—")</td>
                        <td class="num">@(item.Minutos.HasValue ? $"{item.Minutos}'" : "—")</td>
                        <td class="num">@item.Gols</td>
                        <td class="num">@item.Assistencias</td>
                        <td>
                            @if (item.Analisado)
                            {
                                <span class="je-hist-nota" title="@(item.OrigemManual ? "Nota da sua análise" : "Nota automática, calculada das estatísticas importadas")">
                                    <strong style="color:@notaColor;">@item.NotaFinal.ToString("0.0")</strong>
                                    <small>@notaLabel@(item.OrigemManual ? "" : ", automática")</small>
                                </span>
                            }
                            else
                            {
                                <span class="je-hist-nota" title="Jogo ainda não analisado"><small>sem nota</small></span>
                            }
                        </td>
                        <td>
                            <span class="je-hist-acoes">
                                @if (temAnalise)
                                {
                                    <button type="button" class="je-ver-analise" aria-expanded="false"
                                            onclick="event.stopPropagation(); toggleAnalise(this, 'analise-@idx')">Ver análise</button>
                                }
                                <a class="je-ver-analise"
                                   href="@Url.Action("EstatisticasJogo", "Jogadores", new { id = Model.Jogador.Id, jogoId = item.Jogo.Id })"
                                   onclick="event.stopPropagation();" title="Todas as ações e estatísticas deste jogador nesta partida">Estatísticas</a>
                            </span>
                        </td>
                    </tr>

                    @if (temAnalise)
                    {
                        <tr class="je-hist-analise" data-analise-row="analise-@idx" hidden>
                            <td colspan="9">
                            <div class="je-analise-panel aberto" data-analise="analise-@idx">
                                @if (item.Analisado)
                                {
                                    <div class="je-analise-comp">
                                        <div class="je-analise-comp-titulo">Composição da nota</div>
                                        @if (item.NotaManual.HasValue)
                                        {
                                            <span>Nota manual <strong style="color:@notaColor;">@item.NotaFinal.ToString("0.00")</strong></span>
                                            <span style="font-size:11px;">ações registradas abaixo (sem peso na nota)</span>
                                        }
                                        else
                                        {
                                            <span>Base <strong style="color:var(--text-strong)">@item.NotaBaseFixa.ToString("0.0")</strong></span>
                                            <span>Ações <strong style="color:@(item.Nota >= 0 ? "var(--ok)" : "var(--bad)");">@(item.Nota >= 0 ? "+" : "")@item.Nota.ToString("0.##")</strong></span>
                                            @foreach (var ajuste in ajustes)
                                            {
                                                <span title="@ajuste.Titulo">
                                                    @ajuste.Rotulo <strong style="color:var(--ok)">+@ajuste.Valor.ToString("0.##")</strong>
                                                </span>
                                            }
                                            <span>= <strong style="color:@notaColor;">@item.NotaFinal.ToString("0.00")</strong></span>
                                        }
                                    </div>
                                }

                                @if (item.Detalhes.Any(d => d.Quantidade > 0))
                                {
                                    <div class="je-detalhes">
                                        @foreach (var d in item.Detalhes.Where(d => d.Quantidade > 0))
                                        {
                                            var dColor = d.Peso > 0 ? "var(--ok)" : "var(--bad)";
                                            var dBg = d.Peso > 0 ? "rgba(34,197,94,.1)" : "rgba(239,68,68,.1)";
                                            var sinal = d.Peso > 0 ? "+" : "";
                                            var pts = Math.Round(d.Peso * d.Quantidade, 2);
                                            <span class="je-detalhe-chip" style="background:@dBg; color:@dColor; border-color:@dColor;">
                                                @d.AcaoLabel × @d.Quantidade
                                                <span style="opacity:.7;">(@sinal@(pts.ToString("0.##", inv)) pts)</span>
                                            </span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Comentario))
                                {
                                    <div class="je-comentario">"@item.Comentario"</div>
                                }

                                @if (item.ObservacoesJogador.Any())
                                {
                                    <div class="je-obs">
                                        @foreach (var obs in item.ObservacoesJogador)
                                        {
                                            <div class="je-obs-item">📌 @obs</div>
                                        }
                                    </div>
                                }
                            </div>
                            </td>
                        </tr>
                    }
                    idx++;
                }
                    </tbody>
                </table>
                @if (Model.NotasPorJogo.Count > linhasVisiveis)
                {
                    <button type="button" class="je-hist-mostrar" id="btnExpandHistorico" onclick="expandirHistorico()"
                            data-campo="@jogosEmCampo" data-todos="@Model.NotasPorJogo.Count">
                        Ver todos os jogos
                    </button>
                }
                </div>
            }
        </section>

    </div>
</div>

<!-- ── Modal: Jogadores semelhantes ─────────────────────────────────────── -->
<div class="je-modal-overlay" id="semelhantesModal" onclick="if(event.target===this)fecharSemelhantes()">
    <div class="je-modal-box">
        <div class="je-modal-header">
            <h2 class="je-modal-titulo">Jogadores semelhantes</h2>
            <button type="button" class="je-modal-close" onclick="fecharSemelhantes()">✕</button>
        </div>
        <div class="je-modal-criterios" id="semelhantesCriterios"></div>
        <div class="je-modal-body" id="semelhantesBody"></div>
    </div>
</div>

<!-- ── Modal: Comparar jogadores ────────────────────────────────────────── -->
<div class="je-modal-overlay" id="compararModal" onclick="if(event.target===this)fecharComparar()">
    <div class="je-modal-box je-cmp-box">
        <div class="je-modal-header">
            <h2 class="je-modal-titulo">Comparar jogadores</h2>
            <button type="button" class="je-modal-close" onclick="fecharComparar()">✕</button>
        </div>
        <div class="je-cmp-picker">
            <div class="je-select-wrap">
                <select id="cmpTemporada" class="je-select">
                    <option value="">Carregando temporadas...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <div class="je-select-wrap">
                <select id="cmpLiga" class="je-select">
                    <option value="">Carregando ligas...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <div class="je-select-wrap">
                <select id="cmpTime" class="je-select" disabled>
                    <option value="">Time...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <div class="je-select-wrap">
                <select id="cmpJogador" class="je-select" disabled>
                    <option value="">Jogador...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <span class="je-cmp-ou">ou</span>
            <div class="je-cmp-busca-wrap">
                <input id="cmpBusca" class="je-cmp-busca" type="text" placeholder="Digite o nome do jogador..." autocomplete="off" />
                <div id="cmpBuscaResultados" class="je-cmp-busca-resultados"></div>
            </div>
        </div>
        <div class="je-modal-body" id="compararBody">
            <div class="je-cmp-vazio">Filtre por temporada → liga → time → jogador, ou digite um nome, para montar a comparação com <strong>@Model.Jogador.NomeExibicao</strong>.</div>
        </div>
    </div>
</div>

<!-- ── Modal: transferência para clube fora do sistema ──────────────────────
     As transferências automáticas só acontecem quando o jogador aparece na
     escalação de um jogo importado. Se ele foi para uma liga que ninguém
     cadastrou, isso nunca ocorre — aqui o usuário escolhe país → liga → clube
     (api-football) e a transferência entra no mesmo histórico. -->
<div class="je-modal-overlay" id="transferenciasModal" onclick="if(event.target===this)fecharTransferencias()">
    <div class="je-modal-box je-tr-box">
        <div class="je-modal-header">
            <h2 class="je-modal-titulo">Transferências</h2>
            <button type="button" class="je-modal-close" onclick="fecharTransferencias()">✕</button>
        </div>
        <div class="je-tr-atual">
            Clube atual:
            @if (Model.Jogador.Time != null)
            {
                if (!string.IsNullOrEmpty(Model.Jogador.Time.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogador.Time.EscudoUrl })" alt="" />
                }
                <a class="je-meta-clube" asp-controller="Times" asp-action="Details" asp-route-id="@Model.Jogador.TimeId" title="Ver @Model.Jogador.Time.Nome"><strong>@Model.Jogador.Time.Nome</strong></a>
            }
            else
            {
                <strong>sem clube</strong>
            }
            <span style="color:var(--text-dimmer)">·</span>
            @if (Model.Jogador.Aposentado)
            {
                <span class="je-tr-badge-aposentado">🏁 Aposentado</span>
                <span>escolha um clube se ele voltou a jogar</span>
            }
            else
            {
                <span>escolha o país e a liga do novo clube</span>
            }
            <a href="/Transferencias" style="margin-left:auto;color:var(--purple);font-weight:600;text-decoration:none">ver janela de transferências →</a>
        </div>
        <div class="je-tr-picker">
            <div class="je-select-wrap">
                <select id="trPais" class="je-select" onchange="trPaisMudou()">
                    <option value="">Carregando países...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <div class="je-select-wrap">
                <select id="trLiga" class="je-select" disabled onchange="trLigaMudou()">
                    <option value="">Liga...</option>
                </select>
                <div class="je-select-arrow">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
            </div>
            <button type="button" class="je-tr-buscar" id="trBtnBuscar" disabled onclick="trBuscarClubes()">Buscar clubes</button>
            @* Nem toda saída de clube é transferência: quem parou de jogar não tem
               destino, então a opção fica fora da cascata país → liga → clube. *@
            <button type="button" class="je-tr-aposentou" onclick="trAposentar()"
                    @(Model.Jogador.Aposentado ? "disabled" : "")>
                🏁 @(Model.Jogador.Aposentado ? "Já aposentado" : "Aposentou")
            </button>
        </div>
        <div class="je-modal-body">
            @Html.AntiForgeryToken()
            <input type="text" class="je-tr-filtro" id="trFiltro" placeholder="Filtrar clube pelo nome..." style="display:none" oninput="trAplicarFiltro()" />
            <div id="trBody">
                <div class="je-tr-msg">Escolha o país e a liga do novo clube e clique em <strong>Buscar clubes</strong>.</div>
            </div>
        </div>
    </div>
</div>

<script>
    @if (Model.PontosHeatmap.Any())
    {
        <text>
        // site.js (com desenharMapaCalor) carrega depois do RenderBody no _Layout,
        // então só existe no fim do carregamento — espera o load pra não chamar
        // uma função ainda indefinida.
        // Guardado em window: o canvas do heatmap é dimensionado em pixels a
        // partir do tamanho do campo, então ao ampliar/fechar o card ele precisa
        // ser redesenhado no tamanho novo (senão fica esticado e borrado).
        window.jePontosHeatmap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.PontosHeatmap.Select(p => new { x = p.X, y = p.Y, peso = p.Peso })));
        window.jeRedesenharHeatmap = function () {
            if (window.desenharMapaCalor) desenharMapaCalor('jeHeatmapCampo', window.jePontosHeatmap);
        };
        window.addEventListener('load', window.jeRedesenharHeatmap);
        </text>
    }

    // ── "Ampliar" nos cards do perfil tático ─────────────────────────────────
    (function () {
        let ampliado = null;

        function ajustarConteudo() {
            // Único conteúdo desta tela que não é puro CSS: o canvas do heatmap
            // é desenhado em pixels e precisa ser refeito no tamanho novo.
            if (window.jeRedesenharHeatmap) window.jeRedesenharHeatmap();
        }

        function ajustarAposLayout() {
            // 2 frames: o 1º aplica o novo layout, o 2º já tem o tamanho final.
            // O timer cobre aba de fundo, onde o rAF não roda.
            requestAnimationFrame(() => requestAnimationFrame(ajustarConteudo));
            setTimeout(ajustarConteudo, 250);
        }

        function ampliar(card, botao) {
            if (ampliado) restaurar();
            const placeholder = document.createElement('div');
            card.parentNode.insertBefore(placeholder, card);
            const overlay = document.createElement('div');
            overlay.className = 'je-overlay';
            overlay.appendChild(card);
            document.body.appendChild(overlay);
            card.classList.add('je-ampliado');
            document.body.style.overflow = 'hidden';
            overlay.addEventListener('click', (e) => { if (e.target === overlay) restaurar(); });
            botao.innerHTML = '✕ Fechar';
            ampliado = { card, placeholder, overlay, botao };
            ajustarAposLayout();
        }

        function restaurar() {
            if (!ampliado) return;
            const { card, placeholder, overlay, botao } = ampliado;
            ampliado = null;
            card.classList.remove('je-ampliado');
            placeholder.parentNode.insertBefore(card, placeholder);
            placeholder.remove();
            overlay.remove();
            document.body.style.overflow = '';
            botao.innerHTML = '⛶ Ampliar';
            ajustarAposLayout();
        }

        document.querySelectorAll('.je-perfil-grid > .je-card').forEach((card) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'je-zoom';
            b.title = 'Ampliar (Esc para fechar)';
            b.innerHTML = '⛶ Ampliar';
            b.addEventListener('click', () => {
                if (ampliado && ampliado.card === card) restaurar();
                else ampliar(card, b);
            });
            card.appendChild(b);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') restaurar(); });
    })();

    // ── Histórico por jogo: filtro "em campo / todos" e "ver todos" ──────────
    const LINHAS_VISIVEIS = 20;

    function atualizarBotaoHistorico() {
        const lista = document.getElementById('historicoLista');
        const btn = document.getElementById('btnExpandHistorico');
        if (!lista || !btn) return;
        const total = parseInt(lista.classList.contains('so-campo') ? btn.dataset.campo : btn.dataset.todos, 10);
        const todos = lista.classList.contains('todos');
        btn.hidden = total <= LINHAS_VISIVEIS;
        btn.textContent = todos ? `Mostrar só os ${LINHAS_VISIVEIS} mais recentes` : `Ver todos os ${total} jogos`;
    }

    function filtrarHistorico(modo) {
        const lista = document.getElementById('historicoLista');
        if (!lista) return;
        lista.classList.toggle('so-campo', modo === 'campo');
        document.querySelectorAll('[data-hist]').forEach(b =>
            b.setAttribute('aria-pressed', b.dataset.hist === modo ? 'true' : 'false'));
        atualizarBotaoHistorico();
    }

    function expandirHistorico() {
        const lista = document.getElementById('historicoLista');
        if (lista) lista.classList.toggle('todos');
        atualizarBotaoHistorico();
    }

    // ── Ir para a tela do jogo ao clicar na linha ───────────────────────────
    function irParaJogo(e, jogoId) {
        if (e.target.closest('a, button')) return;
        window.location.href = `/Jogos/Analisar/${jogoId}`;
    }

    // ── Ver análise (composição da nota) por jogo: linha logo abaixo ────────
    function toggleAnalise(btn, key) {
        const linha = document.querySelector(`tr[data-analise-row="${key}"]`);
        if (!linha) return;
        linha.hidden = !linha.hidden;
        const aberto = !linha.hidden;
        btn.classList.toggle('aberto', aberto);
        btn.setAttribute('aria-expanded', aberto ? 'true' : 'false');
        btn.textContent = aberto ? 'Ocultar análise' : 'Ver análise';
    }

    // ── Menu "Mais" do cabeçalho: fecha ao escolher e ao clicar fora ─────────
    function fecharMais() {
        const mais = document.getElementById('jeMais');
        if (mais) mais.open = false;
    }
    document.addEventListener('click', (e) => {
        const mais = document.getElementById('jeMais');
        if (mais && mais.open && !mais.contains(e.target)) mais.open = false;
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharMais(); });

    // ── Histórico por Temporada ───────────────────────────────────────────────
    const jogadorId = @Model.Jogador.Id;

    // Aberto por padrão: carrega a temporada atual assim que a página fica pronta
    // (antes só carregava ao abrir a seção recolhida).
    document.addEventListener('DOMContentLoaded', () => {
        atualizarBotaoHistorico();
        if (document.getElementById('temporadaContainer'))
            carregarTemporada(jogadorId, @DateTime.Now.Year, document.querySelector('.je-season-btn.active'));
    });

    function carregarTemporada(jogId, season, btnEl) {
        document.querySelectorAll('.je-season-btn').forEach(b => {
            b.classList.toggle('active', b === btnEl);
            b.setAttribute('aria-pressed', b === btnEl ? 'true' : 'false');
        });

        const container = document.getElementById('temporadaContainer');
        if (!container) return;
        container.innerHTML = '<div style="text-align:center;color:var(--text-dim);padding:2rem;font-size:.9rem">Carregando...</div>';

        fetch(`/Jogadores/EstatisticasTemporada?id=${jogId}&season=${season}`)
            .then(r => r.json())
            .then(data => {
                if (!data || data.error || data.length === 0) {
                    container.innerHTML = '<div style="text-align:center;color:var(--text-dim);padding:2rem;font-size:.9rem">Nenhuma estatística disponível para essa temporada.</div>';
                    return;
                }
                renderTemporada(data, container);
            })
            .catch(() => {
                container.innerHTML = '<div style="text-align:center;color:var(--bad);padding:2rem;font-size:.9rem">Erro ao carregar estatísticas.</div>';
            });
    }

    // Zero é zero: o "–" apagado que aparecia no lugar deixava em dúvida se era
    // "nenhum" ou "sem dado". Traço só quando o valor não veio.
    function statBox(val, label) {
        const display = (val === null || val === undefined || val === '') ? '<span style="opacity:.35">–</span>' : val;
        return `<div class="je-stat-box"><div class="je-stat-val">${display}</div><div class="je-stat-lbl">${label}</div></div>`;
    }

    function textoSeguro(s) {
        return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderTemporada(data, container) {
        const proxyBase = '/MediaProxy/Imagem?url=';

        const html = data.map(function(s) {
            const logoLeague = s.league.logo ? `<img src="${proxyBase}${encodeURIComponent(s.league.logo)}" class="je-temporada-logo" />` : '';
            const flag = s.league.flag ? `<img src="${proxyBase}${encodeURIComponent(s.league.flag)}" style="width:16px;height:12px;object-fit:cover;border-radius:2px;" />` : '';
            const logoTeam = s.team.logo ? `<img src="${proxyBase}${encodeURIComponent(s.team.logo)}" style="width:20px;height:20px;object-fit:contain;" />` : '';
            // Duas notas lado a lado: a do provedor (api-football) e a calculada
            // pelo sistema com os critérios do usuário — costumam divergir.
            const ratings = [];
            if (s.games.rating) {
                ratings.push(`<div class="je-rating-item">
                    <span class="je-rating-badge">${parseFloat(s.games.rating).toFixed(1)}</span>
                    <span class="je-rating-fonte">provedor</span>
                </div>`);
            }
            if (s.sistema) {
                ratings.push(`<div class="je-rating-item">
                    <span class="je-rating-badge je-rating-sistema" title="${s.sistema.jogos} jogo(s) avaliado(s) pelo sistema">${parseFloat(s.sistema.media).toFixed(1)}</span>
                    <span class="je-rating-fonte">sistema</span>
                </div>`);
            }
            const rating = ratings.length ? `<div class="je-rating-grupo">${ratings.join('')}</div>` : '';

            const duelPct = (s.duels.total > 0) ? Math.round(s.duels.won / s.duels.total * 100) + '%' : null;
            const dribPct = (s.dribbles.attempts > 0) ? Math.round(s.dribbles.success / s.dribbles.attempts * 100) + '%' : null;

            const chips = [];
            if (s.games.minutes > 0)   chips.push(`⏱️ ${s.games.minutes} min`);
            if (s.games.lineups > 0)   chips.push(`🏃 ${s.games.lineups} titulares`);
            if (s.substitutes.in > 0)  chips.push(`↗️ ${s.substitutes.in} entradas`);
            if (s.substitutes.out > 0) chips.push(`↘️ ${s.substitutes.out} saídas`);
            if (s.fouls.committed > 0) chips.push(`⚠️ ${s.fouls.committed} faltas`);
            if (s.cards.yellow > 0)    chips.push(`🟨 ${s.cards.yellow}`);
            if (s.cards.red > 0)       chips.push(`🟥 ${s.cards.red}`);

            const footerHtml = chips.length
                ? `<div class="je-temporada-footer">${chips.map(c => `<span class="je-temporada-chip">${c}</span>`).join('')}</div>`
                : '';

            return `
            <div class="je-temporada-card">
                <div class="je-temporada-header">
                    ${logoLeague}
                    <div style="flex:1;min-width:0;">
                        <div class="je-temporada-nome">${textoSeguro(s.league.name)}</div>
                        <div class="je-temporada-pais">
                            <span style="display:inline-flex;align-items:center;gap:5px;">${flag} ${textoSeguro(s.league.country || '')}</span>
                            <span style="display:inline-flex;align-items:center;gap:5px;margin-left:12px;">${logoTeam} ${textoSeguro(s.team.name)}</span>
                        </div>
                    </div>
                    ${rating}
                </div>
                <div class="je-temporada-stats">
                    ${statBox(s.games.appearences, 'Jogos')}
                    ${statBox(s.goals.total, 'Gols')}
                    ${statBox(s.goals.assists, 'Assistências')}
                    ${statBox(s.shots.total, 'Finalizações')}
                    ${statBox(s.shots.on, 'No gol')}
                    ${statBox(s.passes.total, 'Passes')}
                    ${statBox(s.passes.key, 'Passes-chave')}
                    ${statBox(s.passes.accuracy ? s.passes.accuracy + '%' : null, 'Precisão de passe')}
                    ${statBox(s.tackles.total, 'Desarmes')}
                    ${statBox(s.tackles.interceptions, 'Interceptações')}
                    ${statBox(duelPct, 'Duelos ganhos')}
                    ${statBox(dribPct, 'Dribles certos')}
                </div>
                ${footerHtml}
            </div>`;
        }).join('');

        container.innerHTML = `<div class="je-temporada-grid">${html}</div>`;
    }

    // ── Jogadores semelhantes ─────────────────────────────────────────────────
    let semelhantesCarregado = false;

    function abrirSemelhantes() {
        const modal = document.getElementById('semelhantesModal');
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        if (!semelhantesCarregado) {
            semelhantesCarregado = true;
            carregarSemelhantes();
        }
    }

    function fecharSemelhantes() {
        document.getElementById('semelhantesModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { fecharSemelhantes(); fecharComparar(); fecharTransferencias(); }
    });

    function carregarSemelhantes() {
        const body = document.getElementById('semelhantesBody');
        const criterios = document.getElementById('semelhantesCriterios');
        body.innerHTML = '<div style="text-align:center;color:var(--text-dim);padding:2rem;font-size:.9rem">Buscando jogadores semelhantes...</div>';
        criterios.innerHTML = '';

        fetch(`/Jogadores/JogadoresSemelhantes?id=${jogadorId}`)
            .then(r => r.json())
            .then(data => renderSemelhantes(data))
            .catch(() => {
                body.innerHTML = '<div style="text-align:center;color:var(--bad);padding:2rem;font-size:.9rem">Erro ao buscar jogadores semelhantes.</div>';
            });
    }

    // Espelha o helper Url.FotoSrc: fotos do api-sports.io passam pelo MediaProxy;
    // URLs manuais de outros hosts carregam direto (o proxy bloquearia por allowlist).
    function fotoSrc(url) {
        if (!url) return '/images/placeholder-jogador.png';
        let host = '';
        try { host = new URL(url).hostname; } catch (e) { host = ''; }
        return /(^|\.)api-sports\.io$/i.test(host)
            ? '/MediaProxy/Imagem?url=' + encodeURIComponent(url)
            : url;
    }

    function renderSemelhantes(data) {
        const body = document.getElementById('semelhantesBody');
        const criteriosEl = document.getElementById('semelhantesCriterios');
        const proxyBase = '/MediaProxy/Imagem?url=';

        // Chips dos critérios usados (já vêm prontos do servidor, conforme a posição)
        const chips = data.criterios || [];
        criteriosEl.innerHTML = chips.map(t => `<span class="je-criterio-chip">${t}</span>`).join('');

        const colunas = data.colunas || [];
        const jogadores = data.jogadores || [];
        if (jogadores.length === 0) {
            body.innerHTML = '<div style="text-align:center;color:var(--text-dim);padding:2rem;font-size:.9rem">Nenhum jogador com perfil semelhante foi encontrado na base.</div>';
            return;
        }

        body.innerHTML = jogadores.map(function (p) {
            const foto = fotoSrc(p.fotoUrl);
            const escudo = p.escudoUrl
                ? `<img src="${proxyBase}${encodeURIComponent(p.escudoUrl)}" class="je-sem-escudo" />`
                : '';
            // Clube leva para a página do time
            const clube = p.clube
                ? `<a class="je-clube-link" href="/Times/Details/${p.timeId}" title="Ver ${p.clube}">${escudo} ${p.clube}</a>`
                : '';
            const idade = p.idade > 0 ? `📅 ${p.idade} anos` : '';
            const pais = p.pais ? `🌍 ${p.pais}` : '';

            const metaParts = [];
            if (p.posicao) metaParts.push(`<span>🎽 ${p.posicao}</span>`);
            if (clube) metaParts.push(`<span>${clube}</span>`);
            if (idade) metaParts.push(`<span>${idade}</span>`);
            if (pais) metaParts.push(`<span>${pais}</span>`);

            const stats = p.stats || [];
            const statsHtml = colunas.map((label, i) =>
                `<div class="je-sem-stat"><div class="je-sem-stat-val">${stats[i] != null ? stats[i] : 0}</div><div class="je-sem-stat-lbl">${label}</div></div>`
            ).join('');

            return `
            <div class="je-sem-card">
                <img src="${foto}" class="je-sem-foto" onerror="this.onerror=null; this.src='/images/placeholder-jogador.png'" />
                <div class="je-sem-info">
                    <a class="je-sem-nome" href="/Jogadores/Estatisticas/${p.id}">${p.nome}</a>
                    <div class="je-sem-meta">${metaParts.join('')}</div>
                </div>
                <div class="je-sem-stats">${statsHtml}</div>
            </div>`;
        }).join('');
    }

    // ── Comparar com ──────────────────────────────────────────────────────────
    let cmpLigasCarregadas = false;
    let cmpBuscaTimer = null;
    // Jogador escolhido no momento: guardado para remontar a comparação quando a
    // temporada muda, sem obrigar o usuário a selecionar tudo de novo.
    let cmpOutroId = null;

    function cmpTemporada() {
        return document.getElementById('cmpTemporada').value;
    }

    function abrirComparar() {
        document.getElementById('compararModal').classList.add('open');
        document.body.style.overflow = 'hidden';
        if (!cmpLigasCarregadas) {
            cmpLigasCarregadas = true;
            fetch('/Jogadores/CompararTemporadas')
                .then(r => r.json())
                .then(temporadas => {
                    const sel = document.getElementById('cmpTemporada');
                    sel.innerHTML = '<option value="">Todas as temporadas</option>' +
                        temporadas.map(t => `<option value="${t.valor}">${t.rotulo}</option>`).join('');
                });
            carregarLigasComparar('');
        }
    }

    function carregarLigasComparar(temporada) {
        const sel = document.getElementById('cmpLiga');
        sel.disabled = true;
        sel.innerHTML = '<option value="">Carregando ligas...</option>';
        fetch('/Jogadores/CompararLigas' + (temporada ? `?temporada=${temporada}` : ''))
            .then(r => r.json())
            .then(ligas => {
                sel.innerHTML = '<option value="">Todas as ligas</option>' +
                    ligas.map(l => `<option value="${l.id}">${l.nome}</option>`).join('');
                sel.disabled = false;
                carregarTimesComparar('');
            });
    }

    function fecharComparar() {
        document.getElementById('compararModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function carregarTimesComparar(competicaoId) {
        const selTime = document.getElementById('cmpTime');
        const selJog = document.getElementById('cmpJogador');
        selTime.disabled = true;
        selTime.innerHTML = '<option value="">Carregando times...</option>';
        selJog.disabled = true;
        selJog.innerHTML = '<option value="">Jogador...</option>';
        const params = new URLSearchParams();
        if (competicaoId) params.set('competicaoId', competicaoId);
        if (cmpTemporada()) params.set('temporada', cmpTemporada());
        fetch('/Jogadores/CompararTimes' + (params.toString() ? `?${params}` : ''))
            .then(r => r.json())
            .then(times => {
                selTime.innerHTML = '<option value="">Time...</option>' +
                    times.map(t => `<option value="${t.id}">${t.nome}</option>`).join('');
                selTime.disabled = false;
            });
    }

    document.getElementById('cmpLiga').addEventListener('change', function () {
        carregarTimesComparar(this.value);
    });

    // Trocar de temporada refaz a cascata (liga → time → jogador) e, se já havia
    // uma comparação na tela, recarrega os números com o novo recorte.
    document.getElementById('cmpTemporada').addEventListener('change', function () {
        carregarLigasComparar(this.value);
        if (cmpOutroId) carregarComparacao(cmpOutroId);
    });

    document.getElementById('cmpTime').addEventListener('change', function () {
        const selJog = document.getElementById('cmpJogador');
        if (!this.value) {
            selJog.disabled = true;
            selJog.innerHTML = '<option value="">Jogador...</option>';
            return;
        }
        selJog.disabled = true;
        selJog.innerHTML = '<option value="">Carregando...</option>';
        fetch(`/Jogadores/CompararJogadoresLista?timeId=${this.value}`)
            .then(r => r.json())
            .then(jogs => {
                selJog.innerHTML = '<option value="">Jogador...</option>' +
                    jogs.filter(j => j.id !== jogadorId)
                        .map(j => `<option value="${j.id}">${j.nome} (${j.posicao || '—'})</option>`).join('');
                selJog.disabled = false;
            });
    });

    document.getElementById('cmpJogador').addEventListener('change', function () {
        if (this.value) carregarComparacao(parseInt(this.value));
    });

    // Busca por nome com debounce (mínimo 3 letras)
    document.getElementById('cmpBusca').addEventListener('input', function () {
        const termo = this.value.trim();
        const box = document.getElementById('cmpBuscaResultados');
        clearTimeout(cmpBuscaTimer);
        if (termo.length < 3) { box.classList.remove('open'); box.innerHTML = ''; return; }
        cmpBuscaTimer = setTimeout(() => {
            fetch(`/Jogadores/CompararJogadoresLista?nome=${encodeURIComponent(termo)}`)
                .then(r => r.json())
                .then(jogs => {
                    jogs = jogs.filter(j => j.id !== jogadorId);
                    if (jogs.length === 0) {
                        box.innerHTML = '<div class="je-cmp-busca-item" style="cursor:default;"><span class="je-cmp-busca-sub">Nenhum jogador encontrado.</span></div>';
                    } else {
                        box.innerHTML = jogs.map(j => `
                            <div class="je-cmp-busca-item" onclick="carregarComparacao(${j.id})">
                                <img src="${fotoSrc(j.fotoUrl)}" onerror="this.onerror=null; this.src='/images/placeholder-jogador.png'" />
                                <div>
                                    <div class="je-cmp-busca-nome">${j.nome}</div>
                                    <div class="je-cmp-busca-sub">${[j.posicao, j.clube, j.idade > 0 ? j.idade + ' anos' : ''].filter(Boolean).join(' · ')}</div>
                                </div>
                            </div>`).join('');
                    }
                    box.classList.add('open');
                });
        }, 300);
    });

    // Fecha o dropdown da busca ao clicar fora dele
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.je-cmp-busca-wrap'))
            document.getElementById('cmpBuscaResultados').classList.remove('open');
    });

    function carregarComparacao(outroId) {
        cmpOutroId = outroId;
        document.getElementById('cmpBuscaResultados').classList.remove('open');
        const body = document.getElementById('compararBody');
        body.innerHTML = '<div class="je-cmp-vazio">Montando comparação...</div>';
        const temporada = cmpTemporada();
        fetch(`/Jogadores/CompararDados?id=${jogadorId}&comId=${outroId}` + (temporada ? `&temporada=${temporada}` : ''))
            .then(r => r.json())
            .then(data => {
                if (data.error) { body.innerHTML = `<div class="je-cmp-vazio">${data.error}</div>`; return; }
                renderComparacao(data);
            })
            .catch(() => {
                body.innerHTML = '<div class="je-cmp-vazio" style="color:var(--bad)">Erro ao montar a comparação.</div>';
            });
    }

    function cmpCardJogador(p, cor) {
        const proxyBase = '/MediaProxy/Imagem?url=';
        const escudo = p.escudoUrl
            ? `<img src="${proxyBase}${encodeURIComponent(p.escudoUrl)}" style="width:13px;height:13px;object-fit:contain;vertical-align:middle;" /> `
            : '';
        const sub = [];
        if (p.posicao) sub.push(`🎽 ${p.posicao}`);
        // Clube leva para a página do time
        if (p.clube) sub.push(`<a class="je-clube-link" href="/Times/Details/${p.timeId}" title="Ver ${p.clube}">${escudo}${p.clube}</a>`);
        if (p.idade > 0) sub.push(`📅 ${p.idade} anos`);
        sub.push(`🏟️ ${p.jogos} jogo${p.jogos === 1 ? '' : 's'}`);
        if (p.notaMedia != null) sub.push(`⭐ nota ${p.notaMedia.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`);
        else if (p.rating != null) sub.push(`⭐ rating ${p.rating.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`);
        return `
        <div class="je-cmp-jog" style="--cor:${cor};">
            <img class="foto" src="${fotoSrc(p.fotoUrl)}" onerror="this.onerror=null; this.src='/images/placeholder-jogador.png'" />
            <div style="min-width:0;">
                <a class="je-cmp-jog-nome" href="/Jogadores/Estatisticas/${p.id}">${p.nome}</a>
                <div class="je-cmp-jog-sub">${sub.map(s => `<span>${s}</span>`).join('')}</div>
            </div>
        </div>`;
    }

    function renderComparacao(data) {
        const body = document.getElementById('compararBody');

        const avisos = (data.avisos || []).map(t => `<div class="je-cmp-aviso">⚠️ ${t}</div>`).join('');

        const insights = (data.insights || []).map(i =>
            `<div class="je-cmp-insight ${i.vencedor === 'a' ? 'vence-a' : i.vencedor === 'b' ? 'vence-b' : ''}">
                <span>${i.emoji}</span><div>${i.html}</div>
            </div>`).join('');

        const grupos = (data.grupos || []).map(g => `
            <div class="je-cmp-grupo-titulo">${g.titulo}</div>
            ${g.metricas.map(m => `
                <div class="je-cmp-row">
                    <div class="je-cmp-val lado-a ${m.vencedor === 'a' ? 'vence' : ''}">${m.fa}</div>
                    <div class="je-cmp-mid">
                        <div class="je-cmp-metrica-label">${m.label}</div>
                        <div class="je-cmp-bar">
                            <div class="seg-a ${m.vencedor === 'a' ? 'vence' : ''}" style="width:${m.pctA}%"></div>
                            <div class="seg-b ${m.vencedor === 'b' ? 'vence' : ''}" style="width:${100 - m.pctA}%"></div>
                        </div>
                    </div>
                    <div class="je-cmp-val lado-b ${m.vencedor === 'b' ? 'vence' : ''}">${m.fb}</div>
                </div>`).join('')}
        `).join('');

        body.innerHTML = `
            <div class="je-cmp-head">
                ${cmpCardJogador(data.a, '#facc15')}
                <div class="je-cmp-vs">VS</div>
                ${cmpCardJogador(data.b, '#60a5fa')}
            </div>
            ${avisos}
            ${data.veredito ? `<div class="je-cmp-veredito">🏆 ${data.veredito}</div>` : ''}
            ${insights ? `<div class="je-cmp-insights">${insights}</div>` : ''}
            ${grupos}
        `;
    }

    // ── Animação de preenchimento dos donuts (conic-gradient não responde a
    // transition CSS, então tween manual via requestAnimationFrame) ───────────
    document.querySelectorAll('.je-donut-ring').forEach(function (ring) {
        var m = ring.getAttribute('style').match(/(#[0-9a-f]{3,6})\s+0\s+([\d.]+)%/i);
        if (!m) return;
        var cor = m[1], alvo = parseFloat(m[2]);
        var dur = 900, t0 = performance.now();
        ring.style.background = 'conic-gradient(' + cor + ' 0 0%, #1e293b 0% 100%)';
        function tick(now) {
            var p = Math.min((now - t0) / dur, 1);
            var ease = 1 - Math.pow(1 - p, 3);
            var v = (alvo * ease).toFixed(1);
            ring.style.background = 'conic-gradient(' + cor + ' 0 ' + v + '%, #1e293b ' + v + '% 100%)';
            if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
    });

    // ── Transferência para clube fora do sistema ──────────────────────────────
    // País → liga (catálogo estático da api-football, o mesmo de
    // /Competicoes/CompeticoesApi) → clubes (consulta /teams na API). O clube
    // escolhido é criado no banco se ainda não existir, com a liga gravada, e a
    // transferência entra no mesmo histórico das automáticas.
    const trClubeAtual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Jogador.Time?.Nome ?? "sem clube"));
    const trJogadorNome = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Jogador.NomeExibicao));
    let trPaisesCarregados = false;
    let trClubes = [];

    function abrirTransferencias() {
        document.getElementById('transferenciasModal').classList.add('open');
        document.body.style.overflow = 'hidden';
        if (!trPaisesCarregados) {
            trPaisesCarregados = true;
            carregarTrPaises();
        }
    }

    function fecharTransferencias() {
        document.getElementById('transferenciasModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function carregarTrPaises() {
        const sel = document.getElementById('trPais');
        fetch('/Transferencias/ApiPaises')
            .then(r => r.json())
            .then(paises => {
                sel.innerHTML = '<option value="">Selecione o país...</option>' +
                    paises.map(p => `<option value="${escapeAttr(p.nome)}">${escapeHtml(p.nome)} (${p.ligas})</option>`).join('');
            })
            .catch(() => { sel.innerHTML = '<option value="">Erro ao carregar países</option>'; });
    }

    function trPaisMudou() {
        const pais = document.getElementById('trPais').value;
        const selLiga = document.getElementById('trLiga');
        const btn = document.getElementById('trBtnBuscar');

        trResetLista('Escolha a liga do novo clube e clique em <strong>Buscar clubes</strong>.');
        btn.disabled = true;

        if (!pais) {
            selLiga.disabled = true;
            selLiga.innerHTML = '<option value="">Liga...</option>';
            return;
        }

        selLiga.disabled = true;
        selLiga.innerHTML = '<option value="">Carregando ligas...</option>';

        fetch('/Transferencias/ApiLigas?pais=' + encodeURIComponent(pais))
            .then(r => r.json())
            .then(ligas => {
                selLiga.innerHTML = '<option value="">Selecione a liga...</option>' +
                    ligas.map(l => `<option value="${l.id}">${escapeHtml(l.nome)} (${escapeHtml(l.tipo || '')})</option>`).join('');
                selLiga.disabled = false;
            })
            .catch(() => { selLiga.innerHTML = '<option value="">Erro ao carregar ligas</option>'; });
    }

    function trLigaMudou() {
        document.getElementById('trBtnBuscar').disabled = !document.getElementById('trLiga').value;
        trResetLista('Clique em <strong>Buscar clubes</strong> para listar os clubes da liga.');
    }

    function trResetLista(mensagem) {
        trClubes = [];
        document.getElementById('trFiltro').style.display = 'none';
        document.getElementById('trFiltro').value = '';
        document.getElementById('trBody').innerHTML = `<div class="je-tr-msg">${mensagem}</div>`;
    }

    function trBuscarClubes() {
        const leagueId = document.getElementById('trLiga').value;
        if (!leagueId) return;

        const body = document.getElementById('trBody');
        body.innerHTML = '<div class="je-tr-msg">Consultando os clubes da liga na api-football...</div>';

        fetch('/Transferencias/ApiClubes?leagueId=' + encodeURIComponent(leagueId))
            .then(r => r.json())
            .then(data => {
                if (data.erro) {
                    body.innerHTML = `<div class="je-tr-msg erro">${escapeHtml(data.erro)}</div>`;
                    return;
                }
                trClubes = data.clubes || [];
                if (!trClubes.length) {
                    body.innerHTML = '<div class="je-tr-msg">Nenhum clube retornado para essa liga nesta temporada.</div>';
                    return;
                }
                document.getElementById('trFiltro').style.display = 'block';
                trRenderClubes(trClubes);
            })
            .catch(() => {
                body.innerHTML = '<div class="je-tr-msg erro">Erro ao consultar os clubes da liga.</div>';
            });
    }

    function trAplicarFiltro() {
        const termo = document.getElementById('trFiltro').value.trim().toLowerCase();
        trRenderClubes(termo ? trClubes.filter(c => (c.nome || '').toLowerCase().includes(termo)) : trClubes);
    }

    function trRenderClubes(lista) {
        const body = document.getElementById('trBody');
        if (!lista.length) {
            body.innerHTML = '<div class="je-tr-msg">Nenhum clube com esse nome.</div>';
            return;
        }

        const cards = lista.map(c => {
            const logo = c.logo
                ? `<img src="/MediaProxy/Imagem?url=${encodeURIComponent(c.logo)}" alt="" />`
                : '<div style="width:30px;height:30px;flex-shrink:0"></div>';
            const tag = c.timeId
                ? '<span class="je-tr-tag cadastrado">já cadastrado</span>'
                : '<span class="je-tr-tag novo">novo clube</span>';
            return `
                <button type="button" class="je-tr-clube" onclick="trTransferir(${c.idApi}, this)"
                        data-nome="${escapeAttr(c.nome)}" data-logo="${escapeAttr(c.logo || '')}"
                        data-pais="${escapeAttr(c.pais || '')}">
                    ${logo}
                    <div style="min-width:0">
                        <div class="je-tr-clube-nome">${escapeHtml(c.nome)}</div>
                        <div class="je-tr-clube-meta">${escapeHtml(c.pais || '')} · id ${c.idApi}</div>
                    </div>
                    ${tag}
                </button>`;
        }).join('');

        body.innerHTML = `<div class="je-tr-lista">${cards}</div>`;
    }

    function trTransferir(idApi, btnEl) {
        const nome = btnEl.dataset.nome;
        if (!confirm(`Transferir ${trJogadorNome} de ${trClubeAtual} para ${nome}?`)) return;

        const leagueId = document.getElementById('trLiga').value;
        const token = document.querySelector('#transferenciasModal input[name="__RequestVerificationToken"]').value;

        const dados = new FormData();
        dados.append('jogadorId', jogadorId);
        dados.append('idApi', idApi);
        dados.append('nome', nome);
        dados.append('logo', btnEl.dataset.logo);
        dados.append('leagueId', leagueId);
        dados.append('pais', btnEl.dataset.pais);
        dados.append('__RequestVerificationToken', token);

        document.getElementById('trBody').innerHTML = '<div class="je-tr-msg">Registrando a transferência...</div>';

        fetch('/Transferencias/TransferirParaClubeApi', { method: 'POST', body: dados })
            .then(r => r.json())
            .then(res => {
                if (res.ok) {
                    // Recarrega para o cabeçalho já mostrar o novo clube.
                    window.location.reload();
                } else {
                    document.getElementById('trBody').innerHTML =
                        `<div class="je-tr-msg erro">${escapeHtml(res.mensagem || 'Não foi possível transferir.')}</div>`;
                }
            })
            .catch(() => {
                document.getElementById('trBody').innerHTML =
                    '<div class="je-tr-msg erro">Erro ao registrar a transferência.</div>';
            });
    }

    // Aposentadoria: sai do futebol em vez de trocar de clube. Vai para o mesmo
    // histórico, com destino vazio, e o jogador fica marcado como aposentado.
    function trAposentar() {
        if (!confirm(`Marcar ${trJogadorNome} como aposentado? Ele continua no histórico de ${trClubeAtual}, mas deixa de contar como jogador em atividade.`)) return;

        const token = document.querySelector('#transferenciasModal input[name="__RequestVerificationToken"]').value;
        const dados = new FormData();
        dados.append('jogadorId', jogadorId);
        dados.append('__RequestVerificationToken', token);

        document.getElementById('trBody').innerHTML = '<div class="je-tr-msg">Registrando a aposentadoria...</div>';

        fetch('/Transferencias/Aposentar', { method: 'POST', body: dados })
            .then(r => r.json())
            .then(res => {
                if (res.ok) {
                    window.location.reload();
                } else {
                    document.getElementById('trBody').innerHTML =
                        `<div class="je-tr-msg erro">${escapeHtml(res.mensagem || 'Não foi possível marcar como aposentado.')}</div>`;
                }
            })
            .catch(() => {
                document.getElementById('trBody').innerHTML =
                    '<div class="je-tr-msg erro">Erro ao registrar a aposentadoria.</div>';
            });
    }

    // ── Selo de lesão (FotMob) ────────────────────────────────────────────────
    // Enfeite tardio de propósito: se a fonte demorar ou cair, a página já está
    // inteira na tela e o único efeito é o selo não aparecer. Nada de spinner —
    // um "carregando lesão?" ao lado do nome sugeriria uma dúvida que não existe.
    (function carregarLesao() {
        const selo = document.getElementById('jeLesao');
        if (!selo) return;

        fetch(`/Jogadores/SituacaoFisica?id=${jogadorId}`)
            .then(r => r.json())
            .then(d => {
                if (!d || !d.lesionado) return;

                const detalhe = [d.retorno, d.atualizado ? 'atualizado em ' + d.atualizado : null]
                    .filter(Boolean).join(' · ');

                selo.innerHTML = '🩹 ' + escapeHtml(d.lesao) +
                    (d.retorno ? ` <span class="je-badge-lesao-retorno">· ${escapeHtml(d.retorno)}</span>` : '');
                selo.title = detalhe ? `${d.lesao} — ${detalhe}. Fonte: FotMob.` : `${d.lesao}. Fonte: FotMob.`;
                selo.hidden = false;
            })
            .catch(() => { });
    })();

    function escapeHtml(txt) {
        const d = document.createElement('div');
        d.textContent = txt == null ? '' : txt;
        return d.innerHTML;
    }

    function escapeAttr(txt) {
        return escapeHtml(txt).replace(/"/g, '&quot;');
    }
</script>
