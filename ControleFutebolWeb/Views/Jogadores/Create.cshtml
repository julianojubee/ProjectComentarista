@model ControleFutebolWeb.Models.Jogador
@{ ViewData["Title"] = "Novo jogador"; }

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select-buscavel.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Index" class="af-voltar">Jogadores</a>
        <h1 class="af-title">Novo jogador</h1>
        <div class="af-sub">
            A maioria dos jogadores chega pela importação do elenco do time. Use o cadastro manual
            para quem a importação não alcança.
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="af-alerta"></div>
            <partial name="_CamposJogador" model="Model" />

            <div class="af-actions">
                <button type="submit" class="af-save">Cadastrar jogador</button>
                <a asp-action="Index" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
