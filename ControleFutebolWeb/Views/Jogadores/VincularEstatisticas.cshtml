@model ControleFutebolWeb.Models.ViewModels.VincularFotMobViewModel
@{
    ViewData["Title"] = $"Identificar {Model.JogadorNome} na base avançada";
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<style>
    .vf-busca { display: flex; gap: 8px; margin-bottom: 18px; }
    .vf-busca .af-input { flex: 1; }
    .vf-busca button {
        padding: 0 18px; border-radius: 8px; border: none; cursor: pointer; flex-shrink: 0;
        background: var(--text-strong); color: var(--p-0); font-family: inherit; font-size: .9rem; font-weight: 700;
    }
    .vf-busca button:hover { opacity: .88; }
    .vf-lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
    .vf-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 4px; border-bottom: 1px solid var(--line-soft); }
    .vf-item.atual { background: rgba(212,165,32,.08); padding-left: 10px; padding-right: 10px; border-radius: 8px; }
    .vf-nome { font-size: .95rem; font-weight: 700; color: var(--text-strong); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .vf-tag { font-size: .74rem; font-weight: 600; color: var(--gold-ink); background: rgba(212,165,32,.14); border: 1px solid rgba(212,165,32,.4); border-radius: 999px; padding: 1px 9px; }
    .vf-time { font-size: .84rem; color: var(--text-dim); margin-top: 2px; }
    .vf-acoes { display: flex; gap: 12px; align-items: center; flex-shrink: 0; }
    .af .vf-conferir { font-size: .84rem; font-weight: 600; color: var(--text-muted); text-decoration: underline; }
    .af .vf-conferir:hover { color: var(--gold-ink); }
    .vf-btn {
        padding: 7px 14px; border-radius: 8px; cursor: pointer; font-family: inherit; font-size: .86rem; font-weight: 700;
        background: transparent; border: 1px solid var(--line-strong); color: var(--text-strong);
    }
    .vf-btn:hover { border-color: #d4a520; color: var(--gold-ink); }
    .vf-vazio { font-size: .9rem; color: var(--text-dim); padding: 16px; background: var(--p-0); border: 1px solid var(--line); border-radius: 10px; line-height: 1.55; }
    .vf-remover { margin-top: 22px; }
    .vf-remover button { background: none; border: none; padding: 0; color: var(--bad); font-family: inherit; font-size: .86rem; font-weight: 600; cursor: pointer; }
    .vf-remover button:hover { text-decoration: underline; }
</style>

<div class="af">
    <div class="af-card">
        <a href="/Jogadores/Estatisticas/@Model.JogadorId" class="af-voltar">@Model.JogadorNome</a>
        <h1 class="af-title">Identificar na base avançada</h1>
        <p class="af-sub" style="margin-top:-1rem">
            Escolha qual registro é <strong>@Model.JogadorNome</strong>. O vínculo é gravado uma vez e só
            serve para abrir as estatísticas avançadas, sem copiar outros dados para o cadastro.
            @* A conferência é do usuário porque a busca por nome não é confiável o
               bastante para decidir sozinha: homônimos são comuns. O clube ao lado de
               cada nome é o que resolve na prática. *@
            Confira o clube antes de vincular, porque nomes se repetem.
        </p>

        <form method="get" class="vf-busca" role="search">
            <input type="search" name="termo" value="@Model.Termo" class="af-input" placeholder="Nome do jogador na base externa" aria-label="Nome do jogador na base externa" autofocus />
            <button type="submit">Buscar</button>
        </form>

        @if (Model.Candidatos.Count == 0)
        {
            <div class="vf-vazio">
                @if (string.IsNullOrWhiteSpace(Model.Termo))
                {
                    <text>Digite um nome para buscar.</text>
                }
                else
                {
                    <text>
                        Nenhum jogador encontrado para "@Model.Termo". A base externa costuma usar o nome curto:
                        tente só o primeiro e o último nome, ou o apelido.
                    </text>
                }
            </div>
        }
        else
        {
            <ul class="vf-lista">
                @foreach (var c in Model.Candidatos)
                {
                    var atual = c.Id == Model.IdFotMobAtual;
                    <li class="vf-item @(atual ? "atual" : "")">
                        <div>
                            <div class="vf-nome">
                                @c.Nome
                                @if (atual) { <span class="vf-tag">Vinculado</span> }
                            </div>
                            <div class="vf-time">@(c.Time ?? "Sem clube")</div>
                        </div>
                        <div class="vf-acoes">
                            @* Abre a página do FotMob em aba nova para conferir antes de
                               gravar — é mais rápido do que vincular, olhar e desfazer. *@
                            <a href="https://www.fotmob.com/players/@c.Id" target="_blank"
                               rel="noopener noreferrer" class="vf-conferir">Conferir</a>
                            @if (!atual)
                            {
                                <form method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.JogadorId" />
                                    <input type="hidden" name="idExterno" value="@c.Id" />
                                    <button type="submit" class="vf-btn">Vincular</button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        }

        @if (Model.IdFotMobAtual != null)
        {
            <form method="post" class="vf-remover"
                  onsubmit="return confirm('Remover a identificação? As estatísticas avançadas deixam de abrir para este jogador.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.JogadorId" />
                <input type="hidden" name="idExterno" value="0" />
                <button type="submit">Remover a identificação atual</button>
            </form>
        }
    </div>
</div>
