@model ControleFutebolWeb.Models.Jogador
@using ControleFutebolWeb.Helpers
@{
    ViewData["Title"] = $"Editar {Model.Nome}";
    // Preserva os filtros da listagem de origem ao salvar/voltar.
    var returnUrl = ViewData["ReturnUrl"] as string;
    var voltar = string.IsNullOrEmpty(returnUrl) ? Url.Action("Estatisticas", new { id = Model.Id }) : returnUrl;
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select-buscavel.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a href="@Url.Action("Estatisticas", new { id = Model.Id })" class="af-voltar">@Model.Nome</a>
        <h1 class="af-title">Editar jogador</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="af-alerta"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <partial name="_CamposJogador" model="Model" />

            <div class="af-linha">
                <div class="af-field">
                    <label class="af-label" for="Altura">Altura em cm <small>(opcional)</small></label>
                    <input asp-for="Altura" class="af-input" type="number" min="0" max="250" />
                    <span asp-validation-for="Altura" class="af-validation"></span>
                </div>
                <div class="af-field">
                    <label class="af-label" for="Peso">Peso em kg <small>(opcional)</small></label>
                    <input asp-for="Peso" class="af-input" type="number" min="0" max="200" />
                    <span asp-validation-for="Peso" class="af-validation"></span>
                </div>
            </div>

            <div class="af-field">
                <label class="af-label" for="Observacoes">Observações <small>(opcional)</small></label>
                <textarea asp-for="Observacoes" class="af-textarea" style="min-height:110px" placeholder="Gols na carreira, chegada ao clube"></textarea>
                <div class="af-hint">Para registros com data e categoria, use as anotações do jogador.</div>
            </div>

            <div class="af-field">
                <label class="af-label" for="fotoUrl">Endereço da foto <small>(opcional)</small></label>
                <input asp-for="FotoUrl" id="fotoUrl" class="af-input" placeholder="https://.../foto.png" />
                <div class="af-hint">Cole o link de uma imagem quando a importação não trouxer a foto.</div>
                <img id="fotoPreview" class="af-preview"
                     src="@Url.FotoSrc(Model.FotoUrl)" alt="Prévia da foto"
                     style="@(string.IsNullOrWhiteSpace(Model.FotoUrl) ? "display:none;" : "")" />
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">Salvar alterações</button>
                <a href="@voltar" class="af-cancel">Cancelar</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@returnUrl" class="af-perigo-link">Excluir jogador</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('fotoUrl');
            var preview = document.getElementById('fotoPreview');
            if (!input || !preview) return;
            input.addEventListener('input', function () {
                var url = this.value.trim();
                if (url) { preview.src = url; preview.style.display = ''; }
                else { preview.removeAttribute('src'); preview.style.display = 'none'; }
            });
            preview.addEventListener('error', function () { preview.style.display = 'none'; });
        })();
    </script>
}
