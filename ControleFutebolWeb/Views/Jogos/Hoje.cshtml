@model List<ControleFutebolWeb.Models.Jogo>
@using ControleFutebolWeb.Helpers
@{
    ViewData["Title"] = "Jogos de Hoje";
    var jogosAnalisadosIds = (HashSet<int>)(ViewBag.JogosAnalisadosIds ?? new HashSet<int>());

    var diaAtual    = (DateTime)(ViewBag.DiaAtual ?? DateTime.Today);
    var diaAnterior = (DateTime)(ViewBag.DiaAnterior ?? DateTime.Today.AddDays(-1));
    var diaSeguinte = (DateTime)(ViewBag.DiaSeguinte ?? DateTime.Today.AddDays(1));
    bool ehHoje = (bool)(ViewBag.EhHoje ?? true);
    var ptBR = new System.Globalization.CultureInfo("pt-BR");

    var fusoHorarioBrasil = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var agoraBrasil = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, fusoHorarioBrasil);

    // Estimativa do minuto ao vivo a partir do horário de início: não há sincronização
    // em tempo real com a API, então assume 1º tempo de 45min + 15min de intervalo.
    // É só uma aproximação (não considera acréscimos reais).
    // IMPORTANTE: jogo.Data fica salvo em UTC — precisa converter pra Brasília antes de
    // comparar com agoraBrasil, senão a diferença de fuso (3h) derruba a conta toda.
    string MinutoAoVivo(DateTime kickoffUtc)
    {
        var kickoff = DateHelper.ParaBrasilia(kickoffUtc) ?? kickoffUtc;
        var decorridos = (int)(agoraBrasil - kickoff).TotalMinutes;
        if (decorridos < 0) return "";
        if (decorridos <= 45) return $"1T {decorridos}'";
        if (decorridos <= 60) return "Intervalo";
        if (decorridos <= 105) return $"2T {decorridos - 60}'";
        return "2T 45+'";
    }

    Func<int?, (string bg, string border, string text)> corComp = (id) => id switch
    {
        1 => ("rgba(34,197,94,0.12)", "rgba(34,197,94,0.3)", "var(--ok)"),
        2 => ("rgba(59,130,246,0.12)", "rgba(59,130,246,0.3)", "var(--info)"),
        3 => ("rgba(212,165,32,0.12)", "rgba(212,165,32,0.3)", "var(--warn)"),
        4 => ("rgba(249,115,22,0.12)", "rgba(249,115,22,0.3)", "#fb923c"),
        5 => ("rgba(168,85,247,0.12)", "rgba(168,85,247,0.3)", "var(--purple)"),
        _ => ("rgba(107,114,128,0.12)", "rgba(107,114,128,0.3)", "var(--text-muted)"),
    };

    var vivos = new List<ControleFutebolWeb.Models.Jogo>();
    var agendados = new List<ControleFutebolWeb.Models.Jogo>();
    var encerrados = new List<ControleFutebolWeb.Models.Jogo>();

    foreach (var jogo in Model.OrderBy(j => j.Data))
    {
        bool realizado = jogo.PlacarCasa.HasValue && jogo.PlacarVisitante.HasValue;
        if (realizado)
        {
            encerrados.Add(jogo);
        }
        else if (jogo.Data.HasValue && DateHelper.ParaBrasilia(jogo.Data) is DateTime kickoffBrasil
                 && kickoffBrasil <= agoraBrasil && agoraBrasil <= kickoffBrasil.AddHours(2.5))
        {
            vivos.Add(jogo);
        }
        else
        {
            agendados.Add(jogo);
        }
    }

    var grupos = new List<(string label, string icone, string cor, List<ControleFutebolWeb.Models.Jogo> jogos)>
    {
        ("Ao Vivo", "🔴", "var(--bad)", vivos),
        ("Agendados", "⏳", "var(--info)", agendados),
        ("Encerrados", "✓", "var(--ok)", encerrados),
    };

    // Competições presentes no dia, para os chips de filtro. Id 0 agrupa os jogos sem
    // competição cadastrada — sem isso eles sumiriam da tela ao filtrar.
    var competicoesDoDia = Model
        .GroupBy(j => (id: j.Competicao?.Id ?? 0, nome: j.Competicao?.Nome ?? "Sem competição"))
        .Select(g => (g.Key.id, g.Key.nome, total: g.Count()))
        .OrderByDescending(c => c.total).ThenBy(c => c.nome)
        .ToList();
}

<style>
    .hj-root, .hj-root *, .hj-root *::before, .hj-root *::after { box-sizing: border-box; }

    .hj-root {
        margin: 0 -12px;
        background: var(--p-0);
        border-radius: 14px;
        overflow: hidden;
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
    }
    .hj-root a { text-decoration: none; color: inherit; }

    @@keyframes hjPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    /* ── Hero ── */
    .hj-hero {
        position: relative; overflow: hidden;
        background: linear-gradient(135deg, #060d1a 0%, #0d1e35 55%, #060d1a 100%);
        padding: 40px 2.5rem 34px;
    }
    .hj-hero-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #d4a520; }
    .hj-hero-fade { position: absolute; bottom: 0; left: 0; right: 0; height: 50px; background: linear-gradient(to top, var(--page-bg), transparent); pointer-events: none; }
    .hj-hero-inner { position: relative; z-index: 1; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
    .hj-hero-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .hj-hero-dot { width: 10px; height: 10px; border-radius: 50%; background: #ef4444; animation: hjPulse 1.5s ease infinite; }
    .hj-hero-kicker span { font-size: .68rem; font-weight: 700; letter-spacing: .28em; color: var(--bad-2); text-transform: uppercase; }
    .hj-hero h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 3rem; font-weight: 800; color: var(--text-strong); margin: 0 0 6px; line-height: 1; }
    .hj-hero p { font-size: .9rem; color: var(--text-dim); margin: 0; }

    .hj-nav { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
    .hj-nav-btn {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(255,255,255,0.06); color: var(--text);
        border: 1px solid rgba(255,255,255,0.14);
        border-radius: 8px; padding: 6px 13px;
        font-size: .78rem; font-weight: 600;
        transition: background .15s, border-color .15s;
    }
    .hj-nav-btn:hover { background: rgba(255,255,255,0.12); border-color: rgba(212,165,32,0.4); color: var(--text); }
    .hj-nav-hoje { background: rgba(212,165,32,0.18); border-color: rgba(212,165,32,0.5); color: var(--gold-ink); }

    .hj-stats { display: flex; gap: 20px; flex-shrink: 0; margin-left: auto; }
    .hj-stat { text-align: center; }
    .hj-stat-num { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2rem; font-weight: 800; line-height: 1; display: flex; align-items: center; gap: 6px; justify-content: center; }
    .hj-stat-dot { width: 8px; height: 8px; border-radius: 50%; background: #ef4444; animation: hjPulse 1.5s ease infinite; display: inline-block; }
    .hj-stat-label { font-size: .62rem; color: var(--text-dimmer); text-transform: uppercase; letter-spacing: .1em; margin-top: 3px; }
    .hj-stat-sep { width: 1px; background: #1e2d45; align-self: stretch; }

    /* ── Conteúdo ── */
    .hj-content { padding: 28px 2.5rem 64px; max-width: 1300px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }

    /* ── Filtro de competição ── */
    .hj-filtro { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .hj-filtro-label { font-size: .62rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dimmer); margin-right: 4px; }
    .hj-chip {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--p-1); color: var(--text-muted);
        border: 1px solid var(--line); border-radius: 999px;
        padding: 5px 12px; font-size: .74rem; font-weight: 600;
        font-family: inherit; cursor: pointer;
        transition: background .15s, border-color .15s, color .15s;
    }
    .hj-chip:hover { border-color: rgba(212,165,32,0.4); color: var(--text); }
    .hj-chip.hj-chip-on { background: rgba(212,165,32,0.14); border-color: rgba(212,165,32,0.5); color: var(--gold-ink); }
    .hj-chip-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .hj-chip-count { font-size: .66rem; color: var(--text-dimmer); font-weight: 700; }
    .hj-chip.hj-chip-on .hj-chip-count { color: var(--gold-ink); }
    .hj-filtros { display: flex; flex-direction: column; gap: 10px; }

    .hj-grupo-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .hj-grupo-label { font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; white-space: nowrap; }
    .hj-grupo-divider { flex: 1; height: 1px; background: var(--p-3); }
    .hj-grupo-count { font-size: .68rem; color: var(--text-dimmer); font-weight: 600; }

    .hj-lista { display: flex; flex-direction: column; gap: 8px; }

    .hj-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 16px 20px; transition: border-color .15s; }
    .hj-card.hj-live { border-color: rgba(239,68,68,0.25); box-shadow: 0 0 20px rgba(239,68,68,0.08); }
    .hj-card.hj-analisado { border-color: rgba(74,222,128,0.35); }

    .hj-card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .hj-comp-badge { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 5px; font-size: .65rem; font-weight: 700; letter-spacing: .04em; white-space: nowrap; }
    .hj-status-badge { font-size: .65rem; font-weight: 700; padding: 2px 8px; border-radius: 5px; }
    .hj-status-live { background: rgba(239,68,68,0.15); color: var(--bad); border: 1px solid rgba(239,68,68,0.3); }
    .hj-status-enc { background: rgba(34,197,94,0.1); color: var(--ok); border: 1px solid rgba(34,197,94,0.25); }
    .hj-status-ag { background: rgba(96,165,250,0.1); color: var(--info); border: 1px solid rgba(96,165,250,0.25); }
    .hj-hora { font-size: .72rem; color: var(--text-dimmer); margin-left: auto; }

    .hj-times { display: flex; align-items: center; gap: 16px; }
    .hj-time-lado { flex: 1; display: flex; align-items: center; gap: 10px; min-width: 0; }
    .hj-time-lado.hj-casa { justify-content: flex-end; }
    .hj-escudo { width: 36px; height: 36px; border-radius: 50%; background: var(--p-0); border: 1px solid var(--line-strong); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; font-size: .8rem; font-weight: 700; color: var(--text-dim); }
    .hj-escudo img { width: 80%; height: 80%; object-fit: contain; }
    .hj-time-nome { font-size: .95rem; font-weight: 500; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .hj-time-nome.hj-casa { text-align: right; }
    .hj-time-nome.hj-vencedor { font-weight: 800; color: var(--text-strong); }
    .hj-placar { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.8rem; font-weight: 900; color: var(--text-strong); flex-shrink: 0; letter-spacing: .06em; min-width: 80px; text-align: center; }

    .hj-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
    .hj-estadio { font-size: .68rem; color: var(--text-dimmer); }
    .hj-transmissao { font-size: .68rem; color: var(--gold-ink); margin-left: 10px; }
    .hj-btn-analisar { font-size: .72rem; padding: 4px 12px; background: rgba(212,165,32,0.1); border: 1px solid rgba(212,165,32,0.28); border-radius: 6px; color: var(--gold-ink); font-weight: 700; }
    .hj-btn-analisar:hover { background: rgba(212,165,32,0.2); color: var(--gold-ink); }
    .hj-status-analisado { font-size: .72rem; font-weight: 700; color: var(--ok); display: flex; align-items: center; gap: 4px; text-decoration: none; }
    .hj-status-analisado:hover { color: var(--ok-2); text-decoration: underline; }

    .hj-sem-filtro { display: none; text-align: center; color: var(--text-dim); padding: 2.2rem 1rem; background: var(--p-1); border: 1px dashed var(--line); border-radius: 12px; }
    .hj-empty { text-align: center; color: var(--text-dim); padding: 3rem 1rem; background: var(--p-1); border: 1px dashed var(--line); border-radius: 12px; }

    /* ── Responsivo ── */
    @@media (max-width: 768px) {
        .hj-hero { padding: 26px 1.1rem 22px; }
        .hj-hero h1 { font-size: 2rem; }
        .hj-content { padding: 20px 1.1rem 40px; }
        .hj-stats { margin-left: 0; gap: 14px; }
        .hj-placar { min-width: 56px; font-size: 1.4rem; }
        .hj-times { gap: 8px; }
    }
</style>

<div class="hj-root">
    <!-- ── Hero ── -->
    <div class="hj-hero theme-dark-zone">
        <div class="hj-hero-stripe"></div>
        <div class="hj-hero-fade"></div>
        <div class="hj-hero-inner">
            <div>
                <div class="hj-hero-kicker">
                    <div class="hj-hero-dot"></div>
                    <span>Jogos · @(ehHoje ? "Hoje" : diaAtual.ToString("dd/MM", ptBR))</span>
                </div>
                <h1>@diaAtual.ToString("dddd, dd 'de' MMMM 'de' yyyy", ptBR)</h1>
                <p><span data-hj-total>@Model.Count</span> jogo(s) programado(s) · <span data-hj-contador="Ao Vivo">@vivos.Count</span> ao vivo</p>

                <div class="hj-nav">
                    <a class="hj-nav-btn" href="@Url.Action("Hoje", new { data = diaAnterior.ToString("yyyy-MM-dd") })">← @diaAnterior.ToString("dd/MM", ptBR)</a>
                    @if (!ehHoje)
                    {
                        <a class="hj-nav-btn hj-nav-hoje" href="@Url.Action("Hoje")">Hoje</a>
                    }
                    <a class="hj-nav-btn" href="@Url.Action("Hoje", new { data = diaSeguinte.ToString("yyyy-MM-dd") })">@diaSeguinte.ToString("dd/MM", ptBR) →</a>
                </div>
            </div>

            <div class="hj-stats">
                <div class="hj-stat">
                    <div class="hj-stat-num" style="color:var(--bad-2)"><span class="hj-stat-dot"></span><span data-hj-contador="Ao Vivo">@vivos.Count</span></div>
                    <div class="hj-stat-label">Ao vivo</div>
                </div>
                <div class="hj-stat-sep"></div>
                <div class="hj-stat">
                    <div class="hj-stat-num" style="color:var(--info)" data-hj-contador="Agendados">@agendados.Count</div>
                    <div class="hj-stat-label">Agendados</div>
                </div>
                <div class="hj-stat-sep"></div>
                <div class="hj-stat">
                    <div class="hj-stat-num" style="color:var(--ok)" data-hj-contador="Encerrados">@encerrados.Count</div>
                    <div class="hj-stat-label">Encerrados</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Conteúdo ── -->
    <div class="hj-content">
        @if (!Model.Any())
        {
            <div class="hj-empty">Nenhum jogo encontrado para @diaAtual.ToString("dd/MM/yyyy", ptBR).</div>
        }
        else
        {
            <div class="hj-filtros" id="hjFiltros">
                @if (competicoesDoDia.Count > 1)
                {
                    <div class="hj-filtro">
                        <span class="hj-filtro-label">Competição</span>
                        <button type="button" class="hj-chip hj-chip-on" data-comp-filtro="">
                            Todas <span class="hj-chip-count">@Model.Count</span>
                        </button>
                        @foreach (var comp in competicoesDoDia)
                        {
                            var cchip = corComp(comp.id == 0 ? (int?)null : comp.id);
                            <button type="button" class="hj-chip" data-comp-filtro="@comp.id">
                                <span class="hj-chip-dot" style="background:@cchip.text;"></span>
                                @comp.nome <span class="hj-chip-count">@comp.total</span>
                            </button>
                        }
                    </div>
                }

                @{ var gruposComJogos = grupos.Where(g => g.jogos.Any()).ToList(); }
                @if (gruposComJogos.Count > 1)
                {
                    <div class="hj-filtro">
                        <span class="hj-filtro-label">Situação</span>
                        <button type="button" class="hj-chip hj-chip-on" data-status-filtro="">
                            Todos <span class="hj-chip-count" data-hj-total>@Model.Count</span>
                        </button>
                        @foreach (var grupo in gruposComJogos)
                        {
                            <button type="button" class="hj-chip" data-status-filtro="@grupo.label">
                                <span class="hj-chip-dot" style="background:@grupo.cor;"></span>
                                @grupo.icone @grupo.label <span class="hj-chip-count" data-hj-contador="@grupo.label">@grupo.jogos.Count</span>
                            </button>
                        }
                    </div>
                }
            </div>

            foreach (var grupo in grupos)
            {
                if (!grupo.jogos.Any()) { continue; }

                <div class="hj-grupo" data-grupo="@grupo.label">
                    <div class="hj-grupo-header">
                        <span class="hj-grupo-label" style="color:@grupo.cor;">@grupo.icone @grupo.label</span>
                        <div class="hj-grupo-divider"></div>
                        <span class="hj-grupo-count">@grupo.jogos.Count jogo(s)</span>
                    </div>

                    <div class="hj-lista">
                        @foreach (var jogo in grupo.jogos)
                        {
                            bool realizado = jogo.PlacarCasa.HasValue && jogo.PlacarVisitante.HasValue;
                            bool live = grupo.label == "Ao Vivo";
                            bool analisado = jogosAnalisadosIds.Contains(jogo.Id);
                            bool casaVenceu = realizado && jogo.PlacarCasa > jogo.PlacarVisitante;
                            bool visVenceu = realizado && jogo.PlacarVisitante > jogo.PlacarCasa;
                            var cc = corComp(jogo.Competicao?.Id);

                            <div class="hj-card @(live ? "hj-live" : "") @(analisado ? "hj-analisado" : "")" data-comp="@(jogo.Competicao?.Id ?? 0)">
                                <div class="hj-card-top">
                                    <span class="hj-comp-badge" style="background:@cc.bg; border:1px solid @cc.border; color:@cc.text;">@(jogo.Competicao?.Nome ?? "Sem competição")</span>
                                    <span class="hj-status-badge @(live ? "hj-status-live" : realizado ? "hj-status-enc" : "hj-status-ag")">
                                        @(live ? $"🔴 {MinutoAoVivo(jogo.Data!.Value)}" : realizado ? "✓ Encerrado" : $"⏳ {(jogo.Data.HasValue ? DateHelper.FormatarData(jogo.Data, "HH:mm") : "--:--")}")
                                    </span>
                                    <span class="hj-hora">@(jogo.Data.HasValue ? DateHelper.FormatarData(jogo.Data, "HH:mm") : "--:--")</span>
                                </div>

                                <div class="hj-times">
                                    <div class="hj-time-lado hj-casa">
                                        <span class="hj-time-nome hj-casa @(casaVenceu ? "hj-vencedor" : "")">@(jogo.TimeCasa?.Nome ?? "?")</span>
                                        <div class="hj-escudo">
                                            @if (!string.IsNullOrEmpty(jogo.TimeCasa?.EscudoUrl))
                                            {
                                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeCasa.EscudoUrl })" alt="" />
                                            }
                                            else
                                            {
                                                @(jogo.TimeCasa?.Nome?.Substring(0, 1) ?? "?")
                                            }
                                        </div>
                                    </div>

                                    <div class="hj-placar">
                                        @(realizado ? $"{jogo.PlacarCasa} – {jogo.PlacarVisitante}" : "– × –")
                                    </div>

                                    <div class="hj-time-lado">
                                        <div class="hj-escudo">
                                            @if (!string.IsNullOrEmpty(jogo.TimeVisitante?.EscudoUrl))
                                            {
                                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeVisitante.EscudoUrl })" alt="" />
                                            }
                                            else
                                            {
                                                @(jogo.TimeVisitante?.Nome?.Substring(0, 1) ?? "?")
                                            }
                                        </div>
                                        <span class="hj-time-nome @(visVenceu ? "hj-vencedor" : "")">@(jogo.TimeVisitante?.Nome ?? "?")</span>
                                    </div>
                                </div>

                                <div class="hj-card-footer">
                                    <span class="hj-estadio">
                                        🏟️ @(string.IsNullOrWhiteSpace(jogo.Estadio) ? "Local não informado" : jogo.Estadio)
                                        @if (!string.IsNullOrWhiteSpace(jogo.TransmissaoTv))
                                        {
                                            <span class="hj-transmissao">📺 @jogo.TransmissaoTv</span>
                                        }
                                    </span>
                                    @if (analisado)
                                    {
                                        <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="hj-status-analisado">✓ Analisado</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="hj-btn-analisar">Analisar →</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="hj-sem-filtro" id="hjSemFiltro">Nenhum jogo para os filtros selecionados.</div>
        }
    </div>
</div>

<script>
    // Filtros de competição e de situação (ao vivo / agendado / encerrado): puramente
    // client-side (os jogos do dia já estão todos na página), então trocar de filtro não
    // recarrega nem perde a navegação de dia. Os dois filtros se combinam.
    (function () {
        var filtros = document.getElementById('hjFiltros');
        if (!filtros) { return; }

        var chipsComp = filtros.querySelectorAll('[data-comp-filtro]');
        var chipsStatus = filtros.querySelectorAll('[data-status-filtro]');
        var cards = document.querySelectorAll('.hj-card[data-comp]');
        var grupos = document.querySelectorAll('.hj-grupo[data-grupo]');
        var semFiltro = document.getElementById('hjSemFiltro');

        var compAtual = '';
        var statusAtual = '';

        function combinaComp(card) {
            return !compAtual || card.dataset.comp === compAtual;
        }

        function aplicar() {
            // Os contadores (hero e chips de situação) seguem só o filtro de competição,
            // pra continuarem servindo de menu mesmo com uma situação selecionada.
            var total = 0;
            var visiveisNoTotal = 0;

            grupos.forEach(function (grupo) {
                var doGrupo = grupo.querySelectorAll('.hj-card[data-comp]');
                var noGrupo = 0;
                var grupoNaSituacao = !statusAtual || grupo.dataset.grupo === statusAtual;

                doGrupo.forEach(function (card) {
                    var okComp = combinaComp(card);
                    if (okComp) { noGrupo++; }
                    card.style.display = (okComp && grupoNaSituacao) ? '' : 'none';
                });

                total += noGrupo;
                if (grupoNaSituacao) { visiveisNoTotal += noGrupo; }
                grupo.style.display = (noGrupo && grupoNaSituacao) ? '' : 'none';

                var contador = grupo.querySelector('.hj-grupo-count');
                if (contador) { contador.textContent = noGrupo + ' jogo(s)'; }

                document.querySelectorAll('[data-hj-contador="' + grupo.dataset.grupo + '"]')
                    .forEach(function (el) { el.textContent = noGrupo; });
            });

            // Grupo inteiro ausente da página (ex.: nenhum jogo ao vivo) fica zerado no hero.
            document.querySelectorAll('[data-hj-contador]').forEach(function (el) {
                var label = el.dataset.hjContador;
                if (!document.querySelector('.hj-grupo[data-grupo="' + label + '"]')) { el.textContent = '0'; }
            });

            document.querySelectorAll('[data-hj-total]').forEach(function (el) { el.textContent = total; });
            if (semFiltro) { semFiltro.style.display = visiveisNoTotal ? 'none' : 'block'; }
        }

        function ligar(chips, aoEscolher) {
            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('hj-chip-on'); });
                    chip.classList.add('hj-chip-on');
                    aoEscolher(chip);
                    aplicar();
                });
            });
        }

        ligar(chipsComp, function (chip) { compAtual = chip.dataset.compFiltro; });
        ligar(chipsStatus, function (chip) { statusAtual = chip.dataset.statusFiltro; });
    })();
</script>
