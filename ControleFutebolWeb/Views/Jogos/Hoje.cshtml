@model List<ControleFutebolWeb.Models.Jogo>
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    ViewData["Title"] = "Jogos de Hoje";
}

@* Os cards vivem em Shared/_JogosDoDia.cshtml, compartilhados com a versão
   pública (/creators/jogos-hoje). Aqui é a versão logada: as setas de dia
   apontam para esta ação e cada card traz o atalho para a análise. *@
@await Html.PartialAsync("_JogosDoDia", Model, new ViewDataDictionary(ViewData)
{
    ["Publico"] = false,
    ["AcaoDia"] = "Hoje",
    ["ControllerDia"] = "Jogos",
})
