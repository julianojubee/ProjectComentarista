@model ControleFutebolWeb.Models.ViewModels.JogosIndexViewModel
@using ControleFutebolWeb.Helpers

@{
    ViewData["Title"] = "Jogos";

    var competicoesMap = Model.CompeticoesMap ?? new Dictionary<int, string>();
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
    string Milhar(int n) => n.ToString("N0", ptBR);

    // Preserva os filtros atuais nos links de paginação
    Func<int, Dictionary<string, string?>> rotaPagina = (p) => new Dictionary<string, string?>
    {
        ["page"] = p.ToString(),
        ["competicaoId"] = Model.CompeticaoIdFiltro?.ToString(),
        ["teamId"] = Model.TeamIdFiltro?.ToString(),
        ["location"] = Model.LocationFiltro,
        ["status"] = Model.StatusFiltro,
        ["startDate"] = Model.StartDate,
        ["endDate"] = Model.EndDate
    };

    bool temFiltro = Model.CompeticaoIdFiltro.HasValue || Model.TeamIdFiltro.HasValue
        || (!string.IsNullOrEmpty(Model.StatusFiltro) && Model.StatusFiltro != "all")
        || !string.IsNullOrEmpty(Model.StartDate) || !string.IsNullOrEmpty(Model.EndDate);

    // Lista agrupada pelo dia no horário de Brasília (a lista já vem do mais novo pro mais antigo)
    var agora = DateTime.UtcNow;
    var hojeBr = DateHelper.ParaBrasilia(agora)!.Value.Date;
    var dias = Model.Jogos
        .GroupBy(j => DateHelper.ParaBrasilia(j.Data)?.Date)
        .ToList();
    string RotuloDia(DateTime? d)
    {
        if (d == null) return "Sem data";
        var dia = d.Value;
        var prefixo = dia == hojeBr ? "Hoje, " : dia == hojeBr.AddDays(-1) ? "Ontem, " : dia == hojeBr.AddDays(1) ? "Amanhã, " : "";
        var texto = dia.ToString(dia.Year == hojeBr.Year ? "dddd, d 'de' MMMM" : "dddd, d 'de' MMMM 'de' yyyy", ptBR);
        texto = prefixo + texto;
        return char.ToUpper(texto[0]) + texto[1..];
    }

    string Iniciais(string? nome) => string.IsNullOrEmpty(nome) ? "?" : nome.Length >= 3 ? nome[..3].ToUpper() : nome.ToUpper();
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    .jgs, .jgs *, .jgs *::before, .jgs *::after { box-sizing: border-box; }
    .jgs {
        margin: 0 -12px; background: var(--p-0); color: var(--text);
        font-family: 'Barlow', Arial, sans-serif; border-radius: 14px;
    }
    .jgs a { text-decoration: none; color: inherit; }
    .jgs :is(a, button, input, select, summary):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Cabeçalho compacto (sempre escuro: cores fixas) ── */
    .jgs-cab {
        padding: 1.5rem 2.5rem; border-radius: 14px 14px 0 0;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520;
        display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    }
    .jgs-cab h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1; }
    .jgs-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.72); }
    .jgs-cab p strong { color: #f3d27a; font-weight: 700; }
    .jgs-cab-acoes { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .jgs .jgs-cab-btn {
        display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 8px;
        border: 1px solid rgba(255,255,255,.25); color: #e8edf5; font-size: .88rem; font-weight: 600; white-space: nowrap;
    }
    .jgs .jgs-cab-btn:hover { border-color: #d4a520; color: #f3d27a; }
    .jgs .jgs-novo { background: #d4a520; border-color: #d4a520; color: #141414; font-weight: 700; }
    .jgs .jgs-novo:hover { background: #e2b532; color: #141414; }

    /* ── Filtros ── */
    .jgs-filtros { background: var(--p-1); border-bottom: 1px solid var(--line); padding: 14px 2.5rem; }
    .jgs-filtros form { display: flex; align-items: flex-end; gap: 10px 12px; flex-wrap: wrap; margin: 0; }
    .jgs-campo { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .jgs-campo label { font-size: .78rem; font-weight: 600; color: var(--text-muted); margin: 0; }
    /* .jgs-sel vale para o <select> e para o botão que o select-buscavel.js põe no
       lugar dele (o componente copia as classes do select original). */
    .jgs .jgs-sel, .jgs-filtros input[type=date] {
        height: 38px; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text); font-size: .86rem; padding: 0 10px; font-family: inherit; max-width: 240px; cursor: pointer;
    }
    .jgs .jgs-sel:focus, .jgs-filtros input:focus { border-color: #d4a520; outline: none; }
    .jgs .jgs-sel:disabled { opacity: .5; cursor: default; }
    .jgs-campo.largo .jgs-sel, .jgs-campo.largo .sb-wrap { width: 230px; max-width: 100%; }
    .jgs-acoes-filtro { display: flex; align-items: center; gap: 10px; margin-left: auto; }
    .jgs-aplicar {
        height: 38px; padding: 0 18px; border-radius: 8px; border: none; cursor: pointer;
        background: var(--text-strong); color: var(--p-0); font-family: inherit; font-size: .88rem; font-weight: 700;
    }
    .jgs-aplicar:hover { opacity: .88; }
    .jgs .jgs-limpar { font-size: .84rem; font-weight: 600; color: var(--text-muted); }
    .jgs .jgs-limpar:hover { color: var(--text-strong); text-decoration: underline; }

    /* ── Lista ── */
    .jgs-lista { padding: 8px 2.5rem 56px; max-width: 1400px; margin: 0 auto; }
    .jgs-alerta { margin: 16px 0 0; padding: .8rem 1rem; border-radius: 10px; font-size: .88rem; }
    .jgs-alerta.ok { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--ok); }
    .jgs-alerta.aviso { background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.3); color: var(--warn); }
    .jgs-alerta.erro { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: var(--bad); }

    .jgs-dia { margin-top: 22px; scroll-margin-top: 12px; }
    .jgs-dia > h2 {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.3rem; font-weight: 700;
        color: var(--text-strong); margin: 0 0 8px; display: flex; align-items: baseline; gap: 8px;
    }
    .jgs-dia > h2 small { font-family: 'Barlow', Arial, sans-serif; font-size: .82rem; font-weight: 500; color: var(--text-dim); }
    .jgs-dia-lista { list-style: none; margin: 0; padding: 0; background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; }

    .jgs-row {
        position: relative; display: grid; align-items: center; gap: 12px;
        grid-template-columns: 54px minmax(0, 1fr) 96px minmax(0, 1fr) minmax(0, 190px) auto;
        padding: 10px 14px; border-top: 1px solid var(--line-soft);
    }
    .jgs-row:first-child { border-top: none; border-radius: 12px 12px 0 0; }
    .jgs-row:last-child { border-radius: 0 0 12px 12px; }
    .jgs-row:hover { background: var(--p-2); }
    .jgs-hora { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; }

    .jgs-time { display: flex; align-items: center; gap: 9px; min-width: 0; font-size: .92rem; color: var(--text-muted); }
    .jgs-time.casa { justify-content: flex-end; text-align: right; }
    .jgs-time span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .jgs-time.venceu { color: var(--text-strong); font-weight: 700; }
    .jgs-escudo {
        width: 26px; height: 26px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
        font-size: .62rem; font-weight: 700; color: var(--text-dim);
    }
    .jgs-escudo img { max-width: 100%; max-height: 100%; object-fit: contain; }

    /* O link do placar cobre a linha inteira (abre a análise); ações ficam por cima */
    .jgs .jgs-placar { text-align: center; line-height: 1.1; }
    .jgs .jgs-placar::after { content: ""; position: absolute; inset: 0; }
    .jgs-placar b { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.35rem; font-weight: 800; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .jgs-placar small { display: block; font-size: .72rem; color: var(--text-dim); }
    .jgs-placar .futuro { font-size: .84rem; font-weight: 600; color: var(--text-dim); }
    .jgs-placar .pendente { font-size: .8rem; font-weight: 600; color: var(--warn); }
    .jgs .jgs-row:hover .jgs-placar b { color: var(--gold-ink); }

    .jgs .jgs-comp { position: relative; z-index: 1; font-size: .82rem; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .jgs .jgs-comp:hover { color: var(--text-strong); text-decoration: underline; }

    .jgs-acoes { position: relative; z-index: 2; display: flex; align-items: center; gap: 4px; justify-content: flex-end; }
    .jgs-analisado { font-size: .76rem; font-weight: 600; color: var(--ok); white-space: nowrap; margin-right: 4px; }
    .jgs .jgs-acao {
        display: inline-flex; align-items: center; padding: 5px 9px; border-radius: 7px; border: 1px solid transparent;
        background: transparent; color: var(--text-muted); font-family: inherit; font-size: .84rem; font-weight: 600; cursor: pointer;
    }
    .jgs .jgs-acao:hover { border-color: var(--line-strong); color: var(--text-strong); background: var(--p-0); }
    .jgs-menu { position: relative; }
    .jgs-menu > summary { list-style: none; }
    .jgs-menu > summary::-webkit-details-marker { display: none; }
    .jgs-menu:not([open]) .jgs-menu-lista { display: none; }
    .jgs-menu-lista {
        position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 170px;
        display: flex; flex-direction: column; padding: 6px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px; box-shadow: 0 10px 24px rgba(0,0,0,.18);
    }
    .jgs .jgs-menu-item { display: block; padding: 8px 10px; border-radius: 7px; font-size: .86rem; font-weight: 600; color: var(--text); }
    .jgs .jgs-menu-item:hover { background: var(--p-4); color: var(--text-strong); }
    .jgs .jgs-menu-item.perigo { color: var(--bad); }

    .jgs-vazio { margin-top: 22px; text-align: center; color: var(--text-dim); padding: 3rem 1rem; background: var(--p-1); border: 1px dashed var(--line); border-radius: 12px; }
    .jgs .jgs-vazio a { color: var(--gold-ink); text-decoration: underline; }

    /* ── Paginação ── */
    .jgs-pager { display: flex; align-items: center; justify-content: space-between; margin-top: 24px; flex-wrap: wrap; gap: 12px; }
    .jgs-pager-info { font-size: .86rem; color: var(--text-dim); }
    .jgs-pager-nav { display: flex; align-items: center; gap: 8px; }
    .jgs .jgs-pager-btn { padding: 8px 14px; background: var(--p-1); border: 1px solid var(--line-strong); border-radius: 8px; color: var(--text-muted); font-size: .86rem; font-weight: 600; }
    .jgs .jgs-pager-btn:hover { border-color: #d4a520; color: var(--gold-ink); }
    .jgs-pager-btn.disabled { opacity: .4; pointer-events: none; }
    .jgs-pager-cur { font-size: .86rem; color: var(--text-dim); padding: 0 6px; }

    @@media (max-width: 900px) {
        .jgs-row {
            grid-template-columns: 46px minmax(0, 1fr) auto;
            grid-template-areas: "hora casa placar" "hora vis placar" "comp comp acoes";
            row-gap: 4px;
        }
        .jgs-row > .jgs-hora { grid-area: hora; align-self: start; padding-top: 3px; }
        .jgs-row > .jgs-time.casa { grid-area: casa; justify-content: flex-end; text-align: left; flex-direction: row-reverse; }
        .jgs-row > .jgs-placar { grid-area: placar; }
        .jgs-row > .jgs-time.vis { grid-area: vis; }
        .jgs-row > .jgs-comp { grid-area: comp; padding-left: 0; }
        .jgs-row > .jgs-acoes { grid-area: acoes; }
    }
    @@media (max-width: 760px) {
        .jgs-cab, .jgs-filtros, .jgs-lista { padding-left: 1rem; padding-right: 1rem; }
        .jgs-cab h1 { font-size: 2rem; }
        .jgs-campo { flex: 1 1 45%; }
        .jgs-campo.largo { flex-basis: 100%; }
        .jgs .jgs-sel, .jgs-filtros input[type=date], .jgs-campo .sb-wrap,
        .jgs-campo.largo .jgs-sel, .jgs-campo.largo .sb-wrap { max-width: none; width: 100%; }
        .jgs-acoes-filtro { margin-left: 0; flex: 1 1 100%; }
        .jgs-aplicar { flex: 1; }
    }
</style>

<div class="jgs">

    <div class="jgs-cab theme-dark-zone">
        <div>
            <h1>Jogos</h1>
            <p>
                <strong>@Milhar(Model.TotalJogos)</strong> @(Model.TotalJogos == 1 ? "jogo" : "jogos")@(temFiltro ? " com os filtros" : ""),
                @Milhar(Model.TotalFinalizados) com placar e @Milhar(Model.TotalAgendados) sem placar
            </p>
        </div>
        <div class="jgs-cab-acoes">
            <a asp-action="Hoje" class="jgs-cab-btn">Jogos de hoje</a>
            <a asp-action="Create" class="jgs-cab-btn jgs-novo">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Novo jogo
            </a>
        </div>
    </div>

    <div class="jgs-filtros">
        <form method="get" asp-action="Index">
            <div class="jgs-campo largo">
                <label for="competicaoId">Competição</label>
                <select id="competicaoId" name="competicaoId" class="jgs-sel" asp-items="Model.CompeticaoList" data-buscavel="Buscar competição">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="jgs-campo largo">
                <label for="teamId">Time</label>
                <select id="teamId" name="teamId" class="jgs-sel" asp-items="Model.TimeList" data-buscavel="Buscar time">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="jgs-campo">
                <label for="location">Mando do time</label>
                <select id="location" name="location" class="jgs-sel" asp-items="Model.LocationList" disabled="@(!Model.TeamIdFiltro.HasValue)"></select>
            </div>
            <div class="jgs-campo">
                <label for="status">Placar</label>
                <select id="status" name="status" class="jgs-sel" asp-items="Model.StatusList"></select>
            </div>
            <div class="jgs-campo">
                <label for="startDate">De</label>
                <input type="date" id="startDate" name="startDate" value="@Model.StartDate" />
            </div>
            <div class="jgs-campo">
                <label for="endDate">Até</label>
                <input type="date" id="endDate" name="endDate" value="@Model.EndDate" />
            </div>
            <div class="jgs-acoes-filtro">
                @if (temFiltro)
                {
                    <a asp-action="Index" class="jgs-limpar">Limpar filtros</a>
                }
                <button type="submit" class="jgs-aplicar">Aplicar filtros</button>
            </div>
        </form>
    </div>

    <div class="jgs-lista">
        @if (TempData["Sucesso"] != null) { <div class="jgs-alerta ok" role="status">@TempData["Sucesso"]</div> }
        @if (TempData["Aviso"] != null) { <div class="jgs-alerta aviso" role="status">@TempData["Aviso"]</div> }
        @if (TempData["Erro"] != null) { <div class="jgs-alerta erro" role="alert">@TempData["Erro"]</div> }

        @if (!Model.Jogos.Any())
        {
            <div class="jgs-vazio">
                @if (temFiltro)
                {
                    <text>Nenhum jogo com esses filtros. <a asp-action="Index">Limpar filtros</a></text>
                }
                else
                {
                    <text>Nenhum jogo cadastrado. Importe os jogos pela página da competição ou <a asp-action="Create">cadastre um</a>.</text>
                }
            </div>
        }

        @{
            // Primeiro dia que já chegou (hoje ou o mais recente antes dele): é onde a
            // tela para quando abre "na data de hoje".
            var diaAtual = dias.FirstOrDefault(d => d.Key.HasValue && d.Key.Value <= hojeBr)?.Key;
        }
        @foreach (var dia in dias)
        {
            <section class="jgs-dia" id="@(Model.AbriuEmHoje && dia.Key == diaAtual ? "hoje" : null)">
                <h2>@RotuloDia(dia.Key) <small>@(dia.Count() == 1 ? "1 jogo" : $"{dia.Count()} jogos")</small></h2>
                <ul class="jgs-dia-lista">
                    @* Dentro do dia, na ordem do horário (a lista em si vem do dia mais novo para o mais antigo) *@
                    @foreach (var jogo in dia.OrderBy(j => j.Data))
                    {
                        var nomeCompeticao = competicoesMap.TryGetValue(jogo.CompeticaoId, out var nome) ? nome : "Sem competição";
                        bool finalizado = jogo.PlacarCasa >= 0 && jogo.PlacarVisitante >= 0;
                        bool casaVenceu = finalizado && (jogo.PlacarCasa > jogo.PlacarVisitante
                            || (jogo.PlacarCasa == jogo.PlacarVisitante && jogo.PenaltisCasa > jogo.PenaltisVisitante));
                        bool visVenceu = finalizado && (jogo.PlacarVisitante > jogo.PlacarCasa
                            || (jogo.PlacarCasa == jogo.PlacarVisitante && jogo.PenaltisVisitante > jogo.PenaltisCasa));
                        bool jaPassou = jogo.Data.HasValue && jogo.Data.Value < agora;

                        <li class="jgs-row">
                            <span class="jgs-hora">@(jogo.Data.HasValue ? DateHelper.FormatarData(jogo.Data, "HH:mm") : "")</span>

                            <span class="jgs-time casa @(casaVenceu ? "venceu" : "")">
                                <span>@jogo.TimeCasa?.Nome</span>
                                <span class="jgs-escudo">
                                    @if (!string.IsNullOrWhiteSpace(jogo.TimeCasa?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeCasa.EscudoUrl })" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <text>@Iniciais(jogo.TimeCasa?.Nome)</text>
                                    }
                                </span>
                            </span>

                            <a asp-action="Analisar" asp-route-id="@jogo.Id" class="jgs-placar"
                               aria-label="Analisar @jogo.TimeCasa?.Nome x @jogo.TimeVisitante?.Nome">
                                @if (finalizado)
                                {
                                    <b>@jogo.PlacarCasa x @jogo.PlacarVisitante</b>
                                    @if (jogo.PenaltisCasa.HasValue && jogo.PenaltisVisitante.HasValue)
                                    {
                                        <small>@jogo.PenaltisCasa x @jogo.PenaltisVisitante nos pênaltis</small>
                                    }
                                }
                                else if (jaPassou)
                                {
                                    <span class="pendente">Sem placar</span>
                                }
                                else
                                {
                                    <span class="futuro">A jogar</span>
                                }
                            </a>

                            <span class="jgs-time vis @(visVenceu ? "venceu" : "")">
                                <span class="jgs-escudo">
                                    @if (!string.IsNullOrWhiteSpace(jogo.TimeVisitante?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeVisitante.EscudoUrl })" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <text>@Iniciais(jogo.TimeVisitante?.Nome)</text>
                                    }
                                </span>
                                <span>@jogo.TimeVisitante?.Nome</span>
                            </span>

                            <a href="@CompeticaoRotaHelper.Url(Url, jogo.CompeticaoId, nomeCompeticao)" class="jgs-comp" title="@nomeCompeticao">@nomeCompeticao</a>

                            <span class="jgs-acoes">
                                @if (jogo.Analisado == 1)
                                {
                                    <span class="jgs-analisado">Analisado</span>
                                }
                                <details class="jgs-menu">
                                    <summary class="jgs-acao" aria-label="Mais ações">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg>
                                    </summary>
                                    <span class="jgs-menu-lista">
                                        <a asp-action="Analisar" asp-route-id="@jogo.Id" class="jgs-menu-item">Analisar</a>
                                        <a asp-action="Edit" asp-route-id="@jogo.Id" class="jgs-menu-item">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@jogo.Id" class="jgs-menu-item perigo">Excluir</a>
                                    </span>
                                </details>
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Model.TotalPaginas > 1)
        {
            var ini = (Model.PaginaAtual - 1) * Model.PageSize + 1;
            var fim = Math.Min(Model.PaginaAtual * Model.PageSize, Model.TotalJogos);
            <div class="jgs-pager">
                <span class="jgs-pager-info">Mostrando @Milhar(ini) a @Milhar(fim) de @Milhar(Model.TotalJogos) jogos, do mais recente para o mais antigo</span>
                <nav class="jgs-pager-nav" aria-label="Páginas">
                    @if (Model.PaginaAtual > 1)
                    {
                        <a class="jgs-pager-btn" asp-action="Index" asp-all-route-data="rotaPagina(Model.PaginaAtual - 1)">Anterior</a>
                    }
                    else
                    {
                        <span class="jgs-pager-btn disabled">Anterior</span>
                    }
                    <span class="jgs-pager-cur">Página @Model.PaginaAtual de @Model.TotalPaginas</span>
                    @if (Model.PaginaAtual < Model.TotalPaginas)
                    {
                        <a class="jgs-pager-btn" asp-action="Index" asp-all-route-data="rotaPagina(Model.PaginaAtual + 1)">Próxima</a>
                    }
                    else
                    {
                        <span class="jgs-pager-btn disabled">Próxima</span>
                    }
                </nav>
            </div>
        }
    </div>
</div>

<script>
(function () {
    // Abriu na página de hoje com jogos futuros acima: rola até o dia de hoje
    var hoje = document.getElementById('hoje');
    if (hoje) hoje.scrollIntoView({ block: 'start' });

    var selComp = document.getElementById('competicaoId');
    var selTime = document.getElementById('teamId');
    var selMando = document.getElementById('location');
    var selectedTeamId = '@(Context.Request.Query["teamId"])';

    // Mando só faz sentido com um time escolhido
    function atualizarMando() { selMando.disabled = !selTime.value; }
    selTime.addEventListener('change', atualizarMando);

    function carregarTimes(compId) {
        if (!compId) return;
        fetch('/Jogos/TimesPorCompeticao?competicaoId=' + compId)
            .then(function (r) { return r.json(); })
            .then(function (times) {
                var anterior = selTime.value;
                selTime.innerHTML = '<option value="">Todos</option>';
                times.forEach(function (t) {
                    var opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = t.nome;
                    if (String(t.id) === String(anterior) || String(t.id) === selectedTeamId) opt.selected = true;
                    selTime.appendChild(opt);
                });
                atualizarMando();
            });
    }

    selComp.addEventListener('change', function () { carregarTimes(this.value); });
    if (selComp.value) carregarTimes(selComp.value);
})();
</script>
