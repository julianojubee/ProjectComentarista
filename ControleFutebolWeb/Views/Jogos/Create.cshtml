@model ControleFutebolWeb.Models.Jogo
@{ ViewData["Title"] = "Novo jogo"; }

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select-buscavel.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Index" class="af-voltar">Jogos</a>
        <h1 class="af-title">Novo jogo</h1>
        <div class="af-sub">
            Os jogos costumam chegar pela importação da competição. Cadastre à mão só o que a
            importação não traz.
        </div>

        <form id="jogoForm" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="af-alerta"></div>

            <div class="af-field">
                <label class="af-label" for="CompeticaoId">Competição</label>
                <select asp-for="CompeticaoId" class="af-select" asp-items="ViewBag.CompeticaoId" data-buscavel="Buscar competição" required>
                    <option value="">Selecione</option>
                </select>
                <span asp-validation-for="CompeticaoId" class="af-validation"></span>
            </div>

            <div class="af-linha">
                <div class="af-field">
                    <label class="af-label" for="Data">Data e hora <small>(de Brasília)</small></label>
                    <input asp-for="Data" type="datetime-local" class="af-input" required />
                    <span asp-validation-for="Data" class="af-validation"></span>
                </div>
                <div class="af-field af-curto">
                    <label class="af-label" for="Rodada">Rodada</label>
                    <input asp-for="Rodada" type="number" min="0" class="af-input" />
                </div>
            </div>

            <div class="af-linha">
                <div class="af-field">
                    <label class="af-label" for="TimeCasaId">Mandante</label>
                    <select asp-for="TimeCasaId" class="af-select" asp-items="ViewBag.TimeCasaId" data-buscavel="Buscar time" required>
                        <option value="">Selecione</option>
                    </select>
                    <span asp-validation-for="TimeCasaId" class="af-validation"></span>
                </div>
                <div class="af-field af-curto">
                    <label class="af-label" for="PlacarCasa">Gols <small>(opcional)</small></label>
                    <input asp-for="PlacarCasa" type="number" min="0" class="af-input" />
                </div>
            </div>

            <div class="af-linha">
                <div class="af-field">
                    <label class="af-label" for="TimeVisitanteId">Visitante</label>
                    <select asp-for="TimeVisitanteId" class="af-select" asp-items="ViewBag.TimeVisitanteId" data-buscavel="Buscar time" required>
                        <option value="">Selecione</option>
                    </select>
                    <span asp-validation-for="TimeVisitanteId" class="af-validation"></span>
                </div>
                <div class="af-field af-curto">
                    <label class="af-label" for="PlacarVisitante">Gols <small>(opcional)</small></label>
                    <input asp-for="PlacarVisitante" type="number" min="0" class="af-input" />
                </div>
            </div>
            <div class="af-hint" style="margin:-.6rem 0 1.25rem">Deixe os gols em branco para um jogo que ainda não aconteceu.</div>

            <div class="af-linha">
                <div class="af-field">
                    <label class="af-label" for="FormacaoCasaId">Formação do mandante <small>(opcional)</small></label>
                    <select asp-for="FormacaoCasaId" class="af-select" asp-items="ViewBag.FormacaoCasaId">
                        <option value="">Sem formação</option>
                    </select>
                </div>
                <div class="af-field">
                    <label class="af-label" for="FormacaoVisitanteId">Formação do visitante <small>(opcional)</small></label>
                    <select asp-for="FormacaoVisitanteId" class="af-select" asp-items="ViewBag.FormacaoVisitanteId">
                        <option value="">Sem formação</option>
                    </select>
                </div>
            </div>

            <div class="af-actions">
                <button id="btnCadastrar" type="submit" class="af-save">Cadastrar jogo</button>
                <a asp-action="Index" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
