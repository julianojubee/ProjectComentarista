<!-- Modal de Avaliação -->
<div id="modal-avaliacao" onclick="if (event.target === this) salvarAvaliacao();" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center">
    <div style="background:var(--p-2); border:1px solid var(--line-strong); color:var(--text); border-radius:12px; width:360px; max-width:95vw; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5)">
        <!-- Cabeçalho fixo -->
        <div style="display:flex; justify-content:space-between; align-items:flex-start; padding:1.25rem 1.25rem 0.75rem; border-bottom:1px solid var(--line); flex-shrink:0">
            <div>
                <h5 id="av-nome" style="margin:0; font-size:15px; font-weight:600; color:var(--text-strong)"></h5>
                <small id="av-pos" style="color:var(--text-dim)"></small>
            </div>
            <button type="button" onclick="fecharAvaliacao()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-dim)">&times;</button>
        </div>

        <!-- Corpo rolável (somente as ações) -->
        <div style="overflow-y:auto; flex:1 1 auto; padding:0.75rem 1.25rem;">
            <div id="av-acoes"></div>

            <!-- Bônus automáticos -->
            <div id="av-bonus-bloco" style="display:none; margin-top:0.75rem; padding:0.6rem 0.75rem; background:rgba(59,130,246,0.08); border-radius:8px; border:1px solid rgba(59,130,246,0.25);">
                <div style="font-size:11px; font-weight:600; color:var(--info); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px">⚡ Bônus automáticos</div>
                <div id="av-bonus-linhas" style="display:flex; flex-direction:column; gap:4px;"></div>
                <div style="margin-top:6px; padding-top:6px; border-top:1px solid rgba(59,130,246,0.25); display:flex; justify-content:space-between; font-size:13px; font-weight:600; color:var(--text)">
                    <span>Subtotal bônus</span>
                    <span id="av-bonus-subtotal" style="color:var(--info)">+0</span>
                </div>
            </div>
        </div>

        <!-- Rodapé fixo: pontuação + observação + salvar -->
        <div style="flex-shrink:0; padding:0.75rem 1.25rem 1.25rem; border-top:1px solid var(--line); background:var(--p-2)">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="color:var(--text-muted); font-size:13px">Pontuação total</span>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span id="av-total" style="font-size:22px; font-weight:600; color:var(--text-strong)">0</span>
                    <span id="av-nota" style="padding:3px 10px; border-radius:20px; font-size:12px; font-weight:500;">Regular</span>
                </div>
            </div>
            <div style="margin-top:0.75rem; display:flex; align-items:center; gap:8px;">
                <label for="av-nota-manual" style="font-size:12px; color:var(--text-muted); flex:1">
                    Nota manual (opcional)
                    <span style="display:block; font-size:10px; color:var(--text-dim)">Se preenchida, vale como nota final (ignora base + ações)</span>
                </label>
                <input type="number" id="av-nota-manual" min="0" max="10" step="0.1" placeholder="—"
                       style="width:70px; font-size:14px; text-align:center; border:1px solid var(--line-strong); border-radius:6px; padding:6px; background:var(--p-0); color:var(--text)">
            </div>
            <div style="margin-top:0.75rem;">
                <label style="font-size:12px; color:var(--text-muted)">Observação:</label>
                <textarea id="av-obs" rows="2" style="width:100%; margin-top:4px; font-size:13px; border:1px solid var(--line-strong); border-radius:6px; padding:6px; resize:vertical; background:var(--p-0); color:var(--text)"></textarea>
            </div>
            <button type="button" onclick="salvarAvaliacao()" style="width:100%; margin-top:10px; padding:8px; background:#d4a520; color:#141414; border:none; border-radius:6px; font-size:14px; font-weight:700; cursor:pointer;">Salvar</button>
        </div>
    </div>
</div>




