                                        +
                                    </button>
                                    <button type="button" class="btn-info-jogador"
                                            onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@esc.Jogador.Id])"
                                            onmouseleave="esconderInfoJogador()">
                                        ℹ
                                    </button>
                                }
                                else
                                {
                                    <div class="player-circle player-circle-empty"></div>
                                }
                            </div>
                            }
                            <input type="hidden" name="escalacaoVisitante[@idxVis].Id" value="@esc.Id" />
                            <input type="hidden" name="escalacaoVisitante[@idxVis].PosicaoId" value="@esc.Id" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__JogadorId" name="escalacaoVisitante[@idxVis].JogadorId" value="@esc.JogadorId" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__PosicaoX" name="escalacaoVisitante[@idxVis].PosicaoX" value="@Coord(esc.PosicaoX)" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__PosicaoY" name="escalacaoVisitante[@idxVis].PosicaoY" value="@Coord(esc.PosicaoY)" />
                            idxVis++;
                        }
                    </div>

                    @if (mostrarBancoReservas)
                    {
                        <!-- Banco de reservas visitante -->
                        <div class="banco-label mt-2">🪑 Banco de reservas</div>
                        <div id="bancoVisitante" class="banco"
                             ondrop="dropNoBanco(event, 'vis')"
                             ondragover="allowDrop(event)">
                            @{
                                var idxResVis = 0;
                            }
                            @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.ReservasVisitante)
                            {
