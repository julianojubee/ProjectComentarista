<!-- ── Modal Compartilhar análise ─────────────────────────────────────────
     Gera/mostra o link público somente-leitura desta análise (/analise/{token}).
     O link é sempre do usuário logado: quem abrir vê as notas e observações
     DELE, sem poder alterar nada nem navegar para outras telas. -->
<div id="modal-compartilhar" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:10000; align-items:center; justify-content:center;">
    <div style="background:#0f1b2d; border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:1.4rem; width:560px; max-width:96vw; box-shadow:0 12px 40px rgba(0,0,0,.5);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem;">
            <h5 style="margin:0; color:#f2f5fa; font-size:15px; font-weight:700">🔗 Compartilhar análise</h5>
            <button onclick="fecharCompartilhar()" style="background:none;border:none;color:rgba(255,255,255,.65);font-size:22px;cursor:pointer;line-height:1">&times;</button>
        </div>
        <div id="compartilhar-corpo" style="color:var(--text-muted); font-size:13px;">
            <div style="text-align:center; padding:1.5rem 0">Carregando...</div>
        </div>
    </div>
</div>

<!-- ── Modal Pós-jogo ─────────────────────────────────────────────────── -->
<div id="modal-posjogo" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:10000; align-items:center; justify-content:center;">
    <div style="background:var(--p-0); border:1px solid rgba(255,255,255,.12); border-radius:16px; width:1140px; max-width:97vw; max-height:93vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5); position:relative">
        <button onclick="fecharPosJogo()" style="position:absolute; top:14px; right:16px; z-index:5; background:rgba(0,0,0,.35); border:1px solid rgba(255,255,255,.15); color:var(--text-strong); font-size:18px; width:30px; height:30px; border-radius:50%; cursor:pointer; line-height:1">&times;</button>
        <div id="posjogo-corpo">
            <div style="text-align:center; color:var(--text-muted); padding:3rem 0">Carregando...</div>
        </div>
    </div>
</div>

@* Carregado no fim do body (o _Layout renderiza esta seção por último), quando
   todo o DOM já existe — os scripts acessam elementos direto, sem esperar
   DOMContentLoaded, como faziam quando estavam inline logo abaixo do HTML deles. *@
@section Scripts {
    <script src="~/js/mencao-jogador.js" asp-append-version="true"></script>
    <script src="~/js/jogadas.js" asp-append-version="true"></script>
    @* painel-jogo.js antes de analisar.js: define window.PainelJogo, usado para
       montar o modal Pós-jogo (e reaproveitado em /analise/{token}). *@
    <script src="~/js/painel-jogo.js" asp-append-version="true"></script>
    <script src="~/js/analisar.js" asp-append-version="true"></script>
}


</div><!-- /.an-root -->