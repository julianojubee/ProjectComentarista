<!-- ══ PLACAR BOARD ══════════════════════════════════════════════════════ -->
<div class="match-board theme-dark-zone">
    <div class="mb-scoreline">
        <!-- Time Casa -->
        <div class="mb-team home">
            <a class="mb-team-link" href="@Url.Action("Details", "Times", new { id = Model.Jogo.TimeCasaId })" title="Ver perfil de @Model.Jogo.TimeCasa?.Nome">
                @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="@Model.Jogo.TimeCasa.Nome" />
                }
                <span class="mb-team-name">@Model.Jogo.TimeCasa?.Nome</span>
            </a>
        </div>

        <!-- Placar: cada visor é um botão que abre a edição do placar -->
        <div class="mb-score">
            <button type="button" class="mb-score-box" id="placarCasaBox"
                    title="Editar placar" aria-label="Gols do @Model.Jogo.TimeCasa?.Nome — editar placar"
                    onclick="editarPlacar()">@(Model.Jogo.PlacarCasa?.ToString() ?? "–")</button>
            <span class="mb-score-sep" aria-hidden="true">–</span>
            <button type="button" class="mb-score-box" id="placarVisBox"
                    title="Editar placar" aria-label="Gols do @Model.Jogo.TimeVisitante?.Nome — editar placar"
                    onclick="editarPlacar()">@(Model.Jogo.PlacarVisitante?.ToString() ?? "–")</button>
        </div>

        <!-- Time Visitante -->
        <div class="mb-team away">
            <a class="mb-team-link" href="@Url.Action("Details", "Times", new { id = Model.Jogo.TimeVisitanteId })" title="Ver perfil de @Model.Jogo.TimeVisitante?.Nome">
                @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="@Model.Jogo.TimeVisitante.Nome" />
                }
                <span class="mb-team-name">@Model.Jogo.TimeVisitante?.Nome</span>
            </a>
        </div>
    </div>

    @if (Model.Jogo.PenaltisCasa.HasValue && Model.Jogo.PenaltisVisitante.HasValue)
    {
        var casaVenceuPen = Model.Jogo.PenaltisCasa > Model.Jogo.PenaltisVisitante;
        var vencedorPen = casaVenceuPen ? Model.Jogo.TimeCasa?.Nome : Model.Jogo.TimeVisitante?.Nome;
        <div class="mb-pen-result">
            <span class="mb-pen-score">@Model.Jogo.PenaltisCasa - @Model.Jogo.PenaltisVisitante nos pênaltis</span>
            <span class="mb-pen-winner">@vencedorPen avançou</span>
        </div>
    }

    <!-- Disputa de pênaltis (preenchida via JS quando houver) -->
    <div class="mb-penaltis" id="mbPenaltis" style="display:none;"></div>

    @* Local da partida: o que a fonte informou ou, na falta dele, o estádio do
       mandante cadastrado no time (EstadioJogoHelper). *@
    @{ var localJogo = EstadioJogoHelper.Local(Model.Jogo); }
    @if (!string.IsNullOrWhiteSpace(localJogo) || !string.IsNullOrWhiteSpace(Model.Jogo.Arbitro))
    {
        <div class="mb-meta">
            @if (!string.IsNullOrWhiteSpace(localJogo))
            {
                <span class="mb-meta-item" title="@(EstadioJogoHelper.DoMandante(Model.Jogo) ? "Estádio do mandante — o local não veio da fonte" : null)">
                    <span class="mb-meta-icon">🏟️</span>
                    <span>@localJogo</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Jogo.Arbitro))
            {
                <span class="mb-meta-item">
                    <span class="mb-meta-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle">
                            <!-- cabeça -->
                            <circle cx="12" cy="5.5" r="3" fill="rgba(255,255,255,0.85)"/>
                            <!-- corpo listrado preto e branco (árbitro) -->
                            <path d="M7 10 Q7 8.5 12 8.5 Q17 8.5 17 10 L17 18 Q17 19 16 19 L8 19 Q7 19 7 18 Z" fill="rgba(255,255,255,0.85)"/>
                            <rect x="7" y="11.5" width="10" height="2" fill="rgba(0,0,0,0.45)"/>
                            <rect x="7" y="15" width="10" height="2" fill="rgba(0,0,0,0.45)"/>
                            <!-- pernas -->
                            <path d="M9 19 L8.5 23 L10.5 23 L12 20.5 L13.5 23 L15.5 23 L15 19 Z" fill="rgba(255,255,255,0.85)"/>
                        </svg>
                    </span>
                    <span>@Model.Jogo.Arbitro</span>
                </span>
            }
        </div>
    }

    <!-- Timeline de gols (sempre visível) -->
    <div class="mb-timeline" id="mbTimelineGols"></div>

    @* Barra de ações em grupos: registrar (ação principal), o que mostrar nesta
       tela (liga/desliga — aria-expanded mantido pelos toggles do analisar.js),
       as análises que abrem em janela e, no fim, compartilhar. *@
    <div class="mb-acoes">
        <div class="mb-acoes-grupo">
            <button type="button" class="mb-acao primaria" id="mbToolbarToggle"
                    onclick="toggleToolbarEventos()" aria-expanded="false" aria-controls="mbToolbar">
                <span>➕ Adicionar evento</span>
                <span class="mb-acao-seta" id="mbToolbarToggleIcon" aria-hidden="true">▾</span>
            </button>
        </div>
        <div class="mb-acoes-grupo">
            <button type="button" class="mb-acao alterna" id="mbOutrosToggle"
                    onclick="toggleOutrosEventos()" aria-expanded="false" aria-controls="mbTimelineOutros">
                <span>📋 Outros eventos</span>
                <span class="mb-acao-seta" id="mbOutrosToggleIcon" aria-hidden="true">▾</span>
            </button>
            <button type="button" class="mb-acao alterna" id="mbEstatisticasToggle"
                    onclick="toggleEstatisticasPanel()" aria-expanded="false" aria-controls="painelEstatisticas">
                <span>📊 Estatísticas</span>
                <span class="mb-acao-seta" id="mbEstatisticasToggleIcon" aria-hidden="true">▾</span>
            </button>
        </div>
        <div class="mb-acoes-grupo">
            <button type="button" class="mb-acao" id="mbH2HToggle" onclick="abrirH2H(@Model.Jogo.Id)"
                    title="Os cinco confrontos mais recentes entre os dois times antes desta partida">⚔️ Últimos confrontos</button>
            <button type="button" class="mb-acao" id="mbPreJogoToggle" onclick="abrirPreJogo(@Model.Jogo.Id)"
                    title="Como os dois times chegam a esta partida: campanha, forma, match-up, desfalques e momento dos jogadores">🔍 Pré-jogo</button>
            <button type="button" class="mb-acao" id="mbPosJogoToggle" onclick="abrirPosJogo(@Model.Jogo.Id)"
