@{
    // Campo sem nenhum jogador nos dois times = a importação não trouxe a escalação
    // (jogo ainda sem dados na API). Em vez de deixar o usuário adivinhando por que o
    // campo está vazio, aponta o caminho: o botão "Última escalação".
    var semNenhumJogadorEmCampo =
        !((List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesCasa).Any(e => e.Jogador != null)
        && !((List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesVisitante).Any(e => e.Jogador != null);
}
@if (semNenhumJogadorEmCampo)
{
    <div class="an-vazio">
        <div class="an-vazio-texto">
            <strong>Nenhum jogador escalado nesta fase</strong>
            <span>
                Arraste os jogadores da lista para o campo, ou carregue a escalação do último
                jogo de cada time (ou a escalação padrão do time) para começar.
            </span>
        </div>
        <button type="button" class="an-vazio-btn"
                onclick="document.getElementById('formUltimaEscalacao').requestSubmit()">
            Carregar última escalação
        </button>
    </div>
}

<!-- ══ PRANCHETA: ferramentas, fases e formações ══════════════════════ -->
@* Uma faixa só, em três grupos: ferramentas que agem no campo, como o campo é
   exibido (nada disso é salvo na escalação) e, à direita, a criação de uma
   nova fase tática a partir do que está em campo. *@
<div class="pr-barra">
    <div class="pr-grupo">
        <button type="button" id="btnModoSeta" class="pr-btn"
                onclick="toggleModoSeta()"
                title="Ligue, clique num jogador e depois no ponto do campo para onde ele se movimentou. Clique duplo numa seta para removê-la.">
            ➹ Setas
        </button>
        <button type="button" id="btnMapaCalor" class="pr-btn" onclick="abrirMapaCalor()">
            🔥 Mapa de calor
        </button>
    </div>

    <div class="pr-grupo">
        @* Temporada dos números do tooltip de info (ℹ) do jogador. Padrão = a do jogo;
           trocar recarrega só os dados do tooltip, sem recarregar a escalação. *@
        <label class="pr-campo" for="tooltipTemporada"
               title="De qual temporada vêm os gols, assistências, jogos como titular e as médias por jogo mostrados no tooltip ℹ dos jogadores.">
            <span>Tooltip</span>
            <select id="tooltipTemporada" class="form-select form-select-sm"
                    onchange="trocarTemporadaTooltip(this.value)">
                @foreach (var t in Model.TemporadasTooltip)
                {
                    <option value="@t" selected="@(t == Model.TemporadaTooltip)">@t@(t == Model.Jogo.Temporada ? " (jogo)" : "")</option>
                }
                <option value="0" selected="@(Model.TemporadaTooltip == 0)">Todas</option>
            </select>
        </label>
        <span id="tooltipTemporadaStatus" class="pr-status"></span>
        @* Como os titulares aparecem no campo: número da camisa (padrão) ou foto do
           jogador com o número em badge. Só visual — a escolha fica no navegador. *@
        <label class="pr-campo" for="campoVisual"
               title="Como mostrar os jogadores em campo: o botão com o número da camisa ou a foto do jogador (com o número em badge).">
            <span>Jogadores</span>
            <select id="campoVisual" class="form-select form-select-sm"
                    onchange="trocarVisualCampo(this.value)">
                <option value="numero">Números</option>
                <option value="foto">Fotos</option>
            </select>
        </label>
        @* Dois jeitos de montar a análise: cada time no seu campinho vertical (lado a
           lado, o original) ou os dois frente a frente num campo horizontal só, como
           em /creators/escalacao. É o MESMO DOM — trocarLayoutAnalise só reposiciona
           campos, listas e bancos; salvar, setas, notas e substituições não mudam. *@
        <label class="pr-campo" for="layoutAnalise"
               title="Como montar os campos: cada time no seu campo (lado a lado) ou os dois times frente a frente no mesmo campo.">
            <span>Layout</span>
            <select id="layoutAnalise" class="form-select form-select-sm"
                    onchange="trocarLayoutAnalise(this.value)">
                <option value="lado">Lado a lado</option>
                <option value="unico">Mesmo campo</option>
            </select>
        </label>
    </div>

    <div class="pr-grupo pr-nova-fase">
        <input type="text" id="faseNome" maxlength="60" placeholder="Nome da fase, ex.: pressão alta"
               aria-label="Nome da nova fase tática"
               class="form-control form-control-sm" />
        <label class="pr-minuto" title="Minuto em que a fase começa">
            <input type="number" id="faseMinuto" min="0" max="130" value="0"
                   aria-label="Minuto em que a fase começa"
                   class="form-control form-control-sm" />
            <span>min</span>
        </label>
        <button type="button" class="pr-btn destaque" onclick="salvarFaseTatica()" title="Salva a escalação atual como uma fase tática no minuto informado">
            Salvar como fase
        </button>
    </div>

    <div id="modoSetaHint" class="pr-dica" style="display:none;">
        Clique no jogador e depois no destino. Duplo clique numa seta a remove; Esc sai do modo setas.
    </div>
</div>

<div class="pr-fases">
    <ul class="nav nav-tabs" id="tabsEscalacao">
        <li class="nav-item">
            <a class="nav-link @(faseAtual == "INICIAL" ? "active" : "")"
               id="tabBtnEscalacaoInicial"
               asp-action="Analisar"
               asp-route-id="@Model.Jogo.Id"
               asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
               asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
               asp-route-faseEscalacao="INICIAL">
                Escalação Inicial
            </a>
        </li>
        @for (int fi = 0; fi < fasesTaticas.Count; fi++)
        {
            var f = fasesTaticas[fi];
            var fim = fi < fasesTaticas.Count - 1 ? (int?)(fasesTaticas[fi + 1].MinutoInicio - 1) : null;
            var faixa = fim.HasValue ? $"{f.MinutoInicio}'–{fim}'" : $"{f.MinutoInicio}'→";
            var rotulo = string.IsNullOrWhiteSpace(f.Nome) ? faixa : $"{f.Nome} ({faixa})";
            <li class="nav-item">
                <a class="nav-link @(faseAtual == f.Chave ? "active" : "")"
                   asp-action="Analisar"
                   asp-route-id="@Model.Jogo.Id"
                   asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
                   asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
                   asp-route-faseEscalacao="@f.Chave"
                   title="Fase tática (@faixa)">
                    @rotulo
                    @if (faseAtual == f.Chave)
                    {
                        <span style="cursor:pointer; margin-left:6px; color:#dc3545;"
                              onclick="event.preventDefault(); excluirFaseTatica('@f.Chave');"
                              title="Excluir esta fase">&times;</span>
                    }
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @(faseAtual == "FINAL" ? "active" : "")"
               id="tabBtnEscalacaoFinal"
               asp-action="Analisar"
               asp-route-id="@Model.Jogo.Id"
               asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
               asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
               asp-route-faseEscalacao="FINAL">
                Escalação Final
            </a>
        </li>
    </ul>
</div>

@* Formações: cada uma em cima do campo do seu time, com a cor da camisa. São
   forms GET próprios (trocar recarrega a tela), por isso ficam fora do
   formSalvarEscalacao — form dentro de form não vale. *@
<div class="pr-formacoes">
    <form method="get" asp-action="Analisar" asp-controller="Jogos" class="pr-formacao casa">
        <input type="hidden" name="id" value="@Model.Jogo.Id" />
        <input type="hidden" name="formacaoVisitanteId" value="@Model.FormacaoVisitanteSelecionada" />
        <input type="hidden" name="faseEscalacao" value="@faseAtual" />
        <span class="pr-formacao-cor" aria-hidden="true"></span>
        <label for="formacaoCasaSel">@Model.Jogo.TimeCasa.Nome</label>
        @* requestSubmit (e não submit): dispara o listener de submit que serializa
           as observações — submit() programático pulava a serialização e o post
           vazio apagava as observações salvas. *@
        <select id="formacaoCasaSel" name="formacaoCasaId" class="form-select form-select-sm"
                title="Formação do @Model.Jogo.TimeCasa.Nome" onchange="this.form.requestSubmit()">
            @foreach (var f in (IEnumerable<SelectListItem>)Model.FormacoesCasa)
            {
                <option value="@f.Value" @(f.Selected ? "selected" : "")>@f.Text</option>
            }
        </select>
    </form>
    <form method="get" asp-action="Analisar" asp-controller="Jogos" class="pr-formacao vis">
        <input type="hidden" name="id" value="@Model.Jogo.Id" />
        <input type="hidden" name="formacaoCasaId" value="@Model.FormacaoCasaSelecionada" />
        <input type="hidden" name="faseEscalacao" value="@faseAtual" />
        <span class="pr-formacao-cor" aria-hidden="true"></span>
        <label for="formacaoVisSel">@Model.Jogo.TimeVisitante.Nome</label>
        <select id="formacaoVisSel" name="formacaoVisitanteId" class="form-select form-select-sm"
                title="Formação do @Model.Jogo.TimeVisitante.Nome" onchange="this.form.requestSubmit()">
            @foreach (var f in (IEnumerable<SelectListItem>)Model.FormacoesVisitante)
            {
                <option value="@f.Value" @(f.Selected ? "selected" : "")>@f.Text</option>
            }
        </select>
    </form>
</div>

<div id="painelEscalacao">

@{
    // Barra de salvar: numa fase intermediária o LimparEscalacoes apaga a fase
    // inteira (e volta para a Inicial); nas outras, esvazia o campo da aba,
    // importada inclusive. Fica fora dos <form>: o corpo de um tag helper é um
    // escopo próprio e o form do Limpar não enxergaria as variáveis.
    var faseIntermediaria = faseAtual != "INICIAL" && faseAtual != "FINAL";
    var rotuloAba = faseAtual == "INICIAL" ? "Escalação inicial"
                  : faseAtual == "FINAL" ? "Escalação final"
                  : "Fase tática";
    var confirmaLimpar = faseIntermediaria
        ? "Excluir esta fase tática?\\n\\nA fase e a escalação dela são apagadas, e a tela volta para a Escalação inicial."
        : $"Limpar a {rotuloAba.ToLowerInvariant()} dos dois times?\\n\\nO campo fica só com as posições vazias da formação, inclusive se a escalação veio importada (dá para recuperar com Reimportar dados). Eventos e observações não são alterados.";
}

<!-- ── FORM PRINCIPAL (id fixo para o JS encontrar com segurança) ── -->
<form id="formSalvarEscalacao" method="post" asp-action="SalvarEscalacao" asp-controller="Jogos">
    <input type="hidden" name="id" value="@Model.Jogo.Id" />
    <input type="hidden" name="formacaoCasaId" value="@Model.FormacaoCasaSelecionada" />
    <input type="hidden" name="formacaoVisitanteId" value="@Model.FormacaoVisitanteSelecionada" />
    <input type="hidden" name="faseEscalacao" value="@faseAtual" />

    @* Layout "Mesmo campo": casca vazia. trocarLayoutAnalise (analisar.js) move para
       cá as listas, os dois campos e os bancos que moram no layout lado a lado
       logo abaixo, e devolve tudo ao voltar. Continua dentro do form, então os
       hidden das escalações seguem sendo enviados no Salvar. *@
    <div id="anUnico" class="an-unico" hidden>
        <div class="an-unico-lista" data-slot="listaCasa"></div>
        <div class="an-unico-centro">
            @* Modo transmissão (como o 📺 de /creators/escalacao): a casca vira uma
               camada do tamanho da janela, elencos e bancos recolhem e os jogadores
               crescem com o campo. Os botões extras só aparecem dentro dele — fora,
               a barra da página já tem setas, visual e o Salvar lá embaixo. *@
            <div class="an-unico-barra">
                <button type="button" id="anBtnTransmissao" class="btn btn-sm btn-outline-info" onclick="toggleTransmissaoAnalise()"
                        title="Campo ocupando a janela inteira, com os jogadores maiores — para apresentar ou capturar no OBS. Esc sai.">📺 Transmissão</button>
                <button type="button" class="btn btn-sm btn-outline-light an-so-transmissao" onclick="AberturaJogo.tocar()"
                        title="Toca de novo a abertura 3D do jogo (entrada dos times e montagem das escalações)">🎬 Abertura</button>
                <button type="button" id="anBtnGravarVideo" class="btn btn-sm btn-outline-danger an-so-transmissao" onclick="gravarVideoAbertura()"
                        title="Grava a abertura (montagem das escalações) em vídeo MP4 1920×1080 para postar no X. O navegador pede para compartilhar esta aba (no Firefox, a janela do navegador); deixe-a na frente até o fim. Dica: ⛶ Tela cheia antes deixa o vídeo mais nítido. Esc cancela.">🎥 Gravar vídeo</button>
                <button type="button" class="btn btn-sm btn-outline-light an-so-transmissao" onclick="toggleElencosTransmissao()"
                        title="Mostra/esconde os elencos e os bancos, para arrastar jogadores e fazer substituições">📋 Elencos</button>
                <button type="button" class="btn btn-sm btn-outline-light an-so-transmissao" onclick="toggleObservacoesTransmissao()"
                        title="Mostra/esconde as observações do jogo embaixo do campo (adicionar, editar, remover, @@ para mencionar jogador)">📝 Observações</button>
                <button type="button" id="anBtnSetaTx" class="btn btn-sm btn-outline-warning an-so-transmissao" onclick="toggleModoSeta()"
                        title="Clique num jogador e depois no destino · duplo clique na seta remove · Esc sai">➹ Setas</button>
                <button type="button" class="btn btn-sm btn-outline-light an-so-transmissao" onclick="alternarVisualTransmissao()"
                        title="Alterna entre o número da camisa e a foto dos jogadores">👤 Fotos/Números</button>
                @if (!string.IsNullOrWhiteSpace(Model.Jogo.LinkDetalhes))
                {
                    @* Mesmo form do "Reimportar dados" da página (confirmação incluída):
                       a página recarrega e volta direto na transmissão, com os elencos
                       como estavam *@
                    <button type="button" class="btn btn-sm btn-outline-light an-so-transmissao" onclick="document.getElementById('formReimportar')?.requestSubmit()"
                            title="Reimporta escalação, gols e cartões deste jogo e volta para a transmissão (não mexe nas suas observações)">🔄 Reimportar</button>
                }
                <button type="button" class="btn btn-sm btn-success an-so-transmissao" onclick="document.getElementById('formSalvarEscalacao').requestSubmit()"
                        title="Salva a escalação desta aba (a página recarrega e volta direto na transmissão)">💾 Salvar</button>
                <button type="button" class="btn btn-sm btn-outline-secondary an-so-transmissao" onclick="toggleTelaCheiaAnalise()"
                        title="Tela cheia do navegador (Esc sai dela)">⛶ Tela cheia</button>
            </div>
            <div class="an-unico-cab">
                <div class="an-unico-time">
                    @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="" />
                    }
                    <span class="an-unico-cor an-unico-cor-casa"></span>
                    @* Autores dos gols embaixo do nome, como na placa de TV (atualizarPlacarUnico) *@
                    <span class="an-unico-nome"><span>@Model.Jogo.TimeCasa?.Nome</span><span class="an-unico-autores" id="anUnicoAutoresCasa"></span></span>
                </div>
                @* Placar da placa: preenchido pelo JS (atualizarPlacarUnico) com o
                   placar do jogo ou, com ele ainda vazio, os gols lançados *@
                <div class="an-unico-centro-placar">
                    <span class="an-unico-vs" id="anUnicoPlacar"><b class="an-unico-gols" id="anUnicoGolsCasa"></b><span>×</span><b class="an-unico-gols" id="anUnicoGolsVis"></b></span>
                    @* Tempo de jogo, mesma conta do card de Jogos de hoje (atualizarRelogioUnico) *@
                    <span class="an-unico-relogio" id="anUnicoRelogio" hidden></span>
                </div>
                <div class="an-unico-time an-unico-time-dir">
                    @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="" />
                    }
                    <span class="an-unico-cor an-unico-cor-vis"></span>
                    <span class="an-unico-nome"><span>@Model.Jogo.TimeVisitante?.Nome</span><span class="an-unico-autores" id="anUnicoAutoresVis"></span></span>
                </div>
            </div>
            <div id="campoUnico" class="campo-unico theme-dark-zone"
                 ondrop="dropNoCampo(event, 'campoCasa')" ondragover="allowDrop(event)">
                <div class="cu-linha-meio"></div>
                <div class="cu-circulo"></div>
                <div class="cu-area cu-area-esq"></div>
                <div class="cu-area cu-area-dir"></div>
                <div class="cu-gol cu-gol-esq"></div>
                <div class="cu-gol cu-gol-dir"></div>
            </div>
            <div class="an-unico-bancos">
                <div data-slot="bancoCasa"></div>
                <div data-slot="bancoVis"></div>
            </div>
            @* Só na transmissão: o #obsBox (observações do jogo, lá embaixo no form)
               vem para cá e o 📝 mostra/esconde. Ao sair, volta para o lugar dele. *@
            <div class="an-unico-obs" data-slot="obs"></div>
        </div>
        <div class="an-unico-lista" data-slot="listaVis"></div>
    </div>

    <div class="row" id="anLadoALado">

        <!-- ===== TIME DA CASA ===== -->
        <div class="col-md-6">
            <div class="row">
                <!-- Lista de jogadores -->
                <div class="col-5 scroll-panel" id="listaPainelCasa">
                    @{
                        var treinadorCasa = Model.TreinadorCasa as ControleFutebolWeb.Models.Treinador;
                    }
                    @if (treinadorCasa != null)
                    {
                        <div class="jog-treinador">
                            @if (!string.IsNullOrWhiteSpace(treinadorCasa.FotoUrl))
                            {
                                <img src="@Url.FotoSrc(treinadorCasa.FotoUrl)"
                                     alt="@treinadorCasa.Nome"
                                     class="jog-treinador-foto" />
                            }
                            else
                            {
                                <span class="jog-treinador-foto vazia" aria-hidden="true">🧑‍💼</span>
                            }
                            <div>
                                <div class="jog-treinador-rot">Treinador</div>
                                <div class="jog-treinador-nome">@treinadorCasa.Nome</div>
                            </div>
                        </div>
                    }
                    <div class="jog-panel">
                    <div class="jog-panel-header">
                        @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="" />
                        }
                        <span class="jog-nome">@Model.Jogo.TimeCasa?.Nome</span>
                        <input type="color" class="jog-cor-camisa" data-lado="casa" value="#dc3545"
                               title="Cor da camisa deste time (clique com o botão direito para voltar à cor original)"
                               oninput="anSetCorCamisa('casa', this.value)"
                               oncontextmenu="event.preventDefault(); anResetCorCamisa('casa', this)" />
                        <button type="button" class="jog-btn-add" onclick="toggleFormNovoJogador('casa')"
                                title="Cadastrar no elenco um jogador que a API ainda não trouxe">+</button>
                    </div>
                    <div class="jog-form-novo" id="formNovoJogadorCasa">
                        <input type="text" class="jf-num" id="novoJogNumCasa" maxlength="3" inputmode="numeric" placeholder="Nº" />
                        <input type="text" class="jf-nome" id="novoJogNomeCasa" placeholder="Nome do jogador"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); criarJogadorNoTime('casa'); }" />
                        <input type="text" class="jf-pos" id="novoJogPosCasa" maxlength="3" placeholder="Pos" title="Posição (opcional): GL, ZG, LD, LE, MC, AT" />
                        <button type="button" onclick="criarJogadorNoTime('casa')">OK</button>
                    </div>
                    <input type="text" id="filtroCasa" class="filtro-jogador" placeholder="🔍 Buscar por nome ou número..." oninput="filtrarLista('listaCasa', this.value)" />
                    <table class="table table-sm table-striped">
                        <thead><tr><th></th><th>Nome</th><th>Pos</th></tr></thead>
                        <tbody id="listaCasa">
                            @* Expulsos primeiro: fora do campo, cinza e sem draggable *@
                            @foreach (var jogador in expulsosCasa)
                            {
                                <tr class="jogador-row expulso" id="jogador-casa-@jogador.Id"
                                    title="Expulso (cartão vermelho)">
                                    <td>
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-casa" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <span class="card-vermelho-badge-mini" title="Expulso (cartão vermelho)"></span>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <a class="jog-nome-link" draggable="false" title="Ver perfil de @jogador.Nome"
                                           asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@jogador.Id">@jogador.Nome</a>
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                            @foreach (var jogador in ((List<ControleFutebolWeb.Models.Jogador>)Model.JogadoresCasa)
                                .Where(j => !idsExpulsosCasa.Contains(j.Id)))
                            {
                                <tr class="jogador-row"
                                    id="jogador-casa-@jogador.Id"
                                    draggable="true"
                                    data-nome="@jogador.Nome"
                                    ondragstart="dragJogador(event, @jogador.Id, this.dataset.nome, '@jogador.NumeroCamisa', '', 'casa')">
                                    <td>
                                        @* position:relative ancora o ℹ no círculo (o <td> não serve de âncora) *@
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-casa" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <a class="jog-nome-link" draggable="false" title="Ver perfil de @jogador.Nome"
                                           asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@jogador.Id">@jogador.Nome</a>
                                        @if (!faseEhInicial && jogadoresSairamCasa.Contains(jogador.Id))
                                        {
                                            <span class="sub-badge-out" title="Jogador saiu">↓</span>
                                        }
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div><!-- /.jog-panel -->
                </div>

                <!-- Campinho casa -->
                <div class="col-7">
                    <div id="campoCasa" class="campo theme-dark-zone"
                         ondrop="dropNoCampo(event, 'campoCasa')"
                         ondragover="allowDrop(event)">
                        <div class="campo-linha-meio"></div>
                        <div class="campo-circulo"></div>
                        <div class="campo-area-sup"></div>
                        <div class="campo-area-inf"></div>
                        <div class="campo-gol-sup"></div>
                        <div class="campo-gol-inf"></div>
                        <svg class="setas-svg" data-campo-svg="campoCasa">
                            <defs>
                                <marker id="setaHeadCasa" markerWidth="12" markerHeight="10" refX="10" refY="5"
                                        orient="auto" markerUnits="userSpaceOnUse">
                                    <path d="M0,0 L12,5 L0,10 z" fill="#facc15" />
                                </marker>
                            </defs>
                        </svg>
                        @{
                            var idxCasa = 0;
                        }
                        @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesCasa)
                        {
                            @* Expulso: a posição inteira some do campo (nem o slot vazio fica —
                               ninguém entra no lugar dele, o time joga com um a menos) e ele
                               passa para o topo da lista lateral. Os hidden continuam com o
                               valor salvo: a escalação no banco não muda por causa do vermelho. *@
                            bool expulsoCasa = !faseEhInicial && esc.Jogador != null
                                               && Model.JogadoresComCartaoVermelho.Contains(esc.Jogador.Id);
                            bool amareloCasa = esc.Jogador != null && Model.JogadoresComCartaoAmarelo.Contains(esc.Jogador.Id);
                            bool capitaoCasa = esc.Jogador != null && Model.JogadoresCapitao.Contains(esc.Jogador.Id);
                            bool craqueCasa = esc.Jogador != null && Model.CraqueJogadorId == esc.Jogador.Id;
                            if (!expulsoCasa)
                            {
                            <div class="posicao-drop"
                                 data-index="casa_@idxCasa"
                                 data-posicao="@AbreviarPosicao(esc.Posicao)"
                                 data-posicao-full="@esc.Posicao"
                                 data-campo="casa"
                                 data-escid="@esc.Id"
                                 data-temjogador="@(esc.Jogador != null ? "1" : "0")"
                                 draggable="true"
                                 ondragstart="dragPosicao(event, 'casa_@idxCasa')"
                                 ondrop="dropEscalacao(event, 'casa_@idxCasa')"
                                 ondragover="allowDrop(event)"
                                 style="left:@Coord(esc.PosicaoX)%; top:@Coord(esc.PosicaoY)%;">
                                @if (esc.Jogador != null)
                                {
                                    @* A foto vai sempre no HTML; quem decide entre foto e número
                                       é a classe .campo-foto no .an-root (seletor "👤 campo"). *@
                                    <div class="player-circle player-circle-casa @(string.IsNullOrEmpty(esc.Jogador.FotoUrl) ? "" : "tem-foto")">
                                        @if (!string.IsNullOrEmpty(esc.Jogador.FotoUrl))
                                        {
                                            <img class="player-foto" src="@esc.Jogador.FotoUrl" alt="" loading="lazy" />
                                        }
                                        <span class="player-num">@(esc.Jogador.NumeroCamisa?.ToString() ?? "")</span>
                                    </div>
                                    @if (amareloCasa)
                                    {
                                        <span class="card-amarelo-badge" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoCasa)
                                    {
                                        <span class="capitao-badge" title="Capitão">C</span>
                                    }
                                    @if (craqueCasa)
                                    {
