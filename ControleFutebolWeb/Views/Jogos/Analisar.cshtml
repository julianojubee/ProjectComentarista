                                    {
                                        <span class="card-amarelo-badge" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoVis)
                                    {
                                        <span class="capitao-badge" title="Capitão">C</span>
                                    }
                                    @if (craqueVis)
                                    {
                                        <span class="craque-badge" title="@tituloCraque">👑</span>
                                    }
                                    @if (!faseEhInicial && jogadoresEntraramVisitante.Contains(esc.Jogador.Id))
