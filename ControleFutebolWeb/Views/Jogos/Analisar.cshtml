                @Model.Jogo.TimeVisitante.Nome
            </h4> *@
            <div class="row">
                <!-- Campinho visitante -->
                <div class="col-7">
                    <div id="campoVisitante" class="campo theme-dark-zone"
                         ondrop="dropNoCampo(event, 'campoVisitante')"
