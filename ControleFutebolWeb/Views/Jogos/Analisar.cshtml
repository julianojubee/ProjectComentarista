<!-- ══ MODAL EDITAR PLACAR ══════════════════════════════════════════════ -->
<div id="modal-placar" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:9998; align-items:center; justify-content:center;">
    <div class="modal-evento-box">
        <h5>Editar Placar</h5>
        <div class="mev-row">
            <div class="mev-field">
                <label>@Model.Jogo.TimeCasa?.Nome</label>
                <input type="number" id="edit-placar-casa" min="0" max="99" />
            </div>
            <div class="mev-field">
                <label>@Model.Jogo.TimeVisitante?.Nome</label>
                <input type="number" id="edit-placar-vis" min="0" max="99" />
            </div>
        </div>
        <div class="mev-actions">
            <button type="button" class="mev-cancel" onclick="document.getElementById('modal-placar').style.display='none'">Cancelar</button>
            <button type="button" class="mev-save" onclick="salvarPlacar()">Salvar</button>
        </div>
    </div>
</div>


@{
    // Campo sem nenhum jogador nos dois times = a importação não trouxe a escalação
    // (jogo ainda sem dados na API). Em vez de deixar o usuário adivinhando por que o
    // campo está vazio, aponta o caminho: o botão "Última escalação".
    var semNenhumJogadorEmCampo =
        !((List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesCasa).Any(e => e.Jogador != null)
        && !((List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesVisitante).Any(e => e.Jogador != null);
}
@if (semNenhumJogadorEmCampo)
{
    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:1rem;
                padding:.85rem 1.2rem; border-radius:12px;
                background:rgba(59,130,246,0.08); border:1px solid rgba(59,130,246,0.35);">
        <span style="font-size:20px;">👥</span>
        <div style="flex:1; min-width:220px;">
            <div style="font-size:13px; font-weight:600; color:#93c5fd;">
                Nenhum jogador escalado nesta fase
            </div>
            <div style="font-size:11px; color:#9ca3af;">
                Arraste os jogadores da lista para o campo, ou carregue a escalação do último
                jogo de cada time (ou a escalação padrão do time) para começar.
            </div>
        </div>
        <button type="button"
                onclick="document.getElementById('formUltimaEscalacao').requestSubmit()"
                style="padding:8px 14px; border-radius:8px; border:1px solid rgba(59,130,246,0.5);
                       background:rgba(59,130,246,0.18); color:#bfdbfe; font-size:13px;
                       font-weight:600; cursor:pointer; white-space:nowrap;">
            👥 Carregar última escalação
        </button>
    </div>
}

<!-- Seleção de Formações -->
<div class="row mb-3">
    <div class="col-md-6">
        <form method="get" asp-action="Analisar" asp-controller="Jogos">
            <input type="hidden" name="id" value="@Model.Jogo.Id" />
            <input type="hidden" name="formacaoVisitanteId" value="@Model.FormacaoVisitanteSelecionada" />
            <input type="hidden" name="faseEscalacao" value="@faseAtual" />
            <label class="fw-bold">Formação @Model.Jogo.TimeCasa.Nome:</label>
            @* requestSubmit (e não submit): dispara o listener de submit que serializa
               as observações — submit() programático pulava a serialização e o post
               vazio apagava as observações salvas. *@
            <select name="formacaoCasaId" class="form-select" onchange="this.form.requestSubmit()">
                @foreach (var f in (IEnumerable<SelectListItem>)Model.FormacoesCasa)
                {
                    <option value="@f.Value" @(f.Selected ? "selected" : "")>@f.Text</option>
                }
            </select>
        </form>
    </div>
    <div class="col-md-6">
        <form method="get" asp-action="Analisar" asp-controller="Jogos">
            <input type="hidden" name="id" value="@Model.Jogo.Id" />
            <input type="hidden" name="formacaoCasaId" value="@Model.FormacaoCasaSelecionada" />
            <input type="hidden" name="faseEscalacao" value="@faseAtual" />
            <label class="fw-bold">Formação @Model.Jogo.TimeVisitante.Nome:</label>
            <select name="formacaoVisitanteId" class="form-select" onchange="this.form.requestSubmit()">
                @foreach (var f in (IEnumerable<SelectListItem>)Model.FormacoesVisitante)
                {
                    <option value="@f.Value" @(f.Selected ? "selected" : "")>@f.Text</option>
                }
            </select>
        </form>
    </div>
</div>

<!-- ── Fase tática da partida ─────────────────────────────────────── -->
<div class="d-flex align-items-center gap-2 mb-2 p-2"
     style="background:#0f172a; border-radius:8px; color:#e2e8f0; flex-wrap:wrap;">
    <button type="button" id="btnModoSeta" class="btn btn-sm btn-outline-warning"
            onclick="toggleModoSeta()"
            title="Ligue, clique num jogador e depois no ponto do campo para onde ele se movimentou. Clique duplo numa seta para removê-la.">
        ➹ Setas
    </button>
    <span id="modoSetaHint" style="font-size:11px; color:#facc15; display:none;">
        clique no jogador e depois no destino · duplo clique na seta remove · Esc sai
    </span>
    <div class="ms-auto d-flex align-items-center gap-1" style="flex-wrap:wrap;">
        <label style="font-size:11px; color:#94a3b8;">nome</label>
        <input type="text" id="faseNome" maxlength="60" placeholder="ex: Fase de ataque"
               class="form-control form-control-sm" style="width:180px;" />
        <label style="font-size:11px; color:#94a3b8;">min</label>
        <input type="number" id="faseMinuto" min="0" max="130" value="0"
               class="form-control form-control-sm" style="width:64px;" />
        <button type="button" class="btn btn-sm btn-primary" onclick="salvarFaseTatica()" title="Salva a escalação atual como uma fase tática no minuto informado">
            💾 Salvar fase
        </button>
    </div>
</div>

<!-- ── Mapa de calor ───────────────────────────────────────────────── -->
<div class="mb-2">
    <button type="button" id="btnMapaCalor" class="btn btn-sm btn-outline-warning" onclick="abrirMapaCalor()">
        🔥 Mapa de Calor
    </button>
</div>

<div class="mb-3">
    <ul class="nav nav-tabs" id="tabsEscalacao">
        <li class="nav-item">
            <a class="nav-link @(faseAtual == "INICIAL" ? "active" : "")"
               id="tabBtnEscalacaoInicial"
               asp-action="Analisar"
               asp-route-id="@Model.Jogo.Id"
               asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
               asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
               asp-route-faseEscalacao="INICIAL">
                Escalação Inicial
            </a>
        </li>
        @for (int fi = 0; fi < fasesTaticas.Count; fi++)
        {
            var f = fasesTaticas[fi];
            var fim = fi < fasesTaticas.Count - 1 ? (int?)(fasesTaticas[fi + 1].MinutoInicio - 1) : null;
            var faixa = fim.HasValue ? $"{f.MinutoInicio}'–{fim}'" : $"{f.MinutoInicio}'→";
            var rotulo = string.IsNullOrWhiteSpace(f.Nome) ? faixa : $"{f.Nome} ({faixa})";
            <li class="nav-item">
                <a class="nav-link @(faseAtual == f.Chave ? "active" : "")"
                   asp-action="Analisar"
                   asp-route-id="@Model.Jogo.Id"
                   asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
                   asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
                   asp-route-faseEscalacao="@f.Chave"
                   title="Fase tática (@faixa)">
                    @rotulo
                    @if (faseAtual == f.Chave)
                    {
                        <span style="cursor:pointer; margin-left:6px; color:#dc3545;"
                              onclick="event.preventDefault(); excluirFaseTatica('@f.Chave');"
                              title="Excluir esta fase">&times;</span>
                    }
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @(faseAtual == "FINAL" ? "active" : "")"
               id="tabBtnEscalacaoFinal"
               asp-action="Analisar"
               asp-route-id="@Model.Jogo.Id"
               asp-route-formacaoCasaId="@Model.FormacaoCasaSelecionada"
               asp-route-formacaoVisitanteId="@Model.FormacaoVisitanteSelecionada"
               asp-route-faseEscalacao="FINAL">
                Escalação Final
            </a>
        </li>
    </ul>
</div>

<div id="painelEscalacao">

<!-- ── FORM PRINCIPAL (id fixo para o JS encontrar com segurança) ── -->
<form id="formSalvarEscalacao" method="post" asp-action="SalvarEscalacao" asp-controller="Jogos">
    <input type="hidden" name="id" value="@Model.Jogo.Id" />
    <input type="hidden" name="formacaoCasaId" value="@Model.FormacaoCasaSelecionada" />
    <input type="hidden" name="formacaoVisitanteId" value="@Model.FormacaoVisitanteSelecionada" />
    <input type="hidden" name="faseEscalacao" value="@faseAtual" />

    <div class="row">

        <!-- ===== TIME DA CASA ===== -->
        <div class="col-md-6">
            <div class="row">
                <!-- Lista de jogadores -->
                <div class="col-5 scroll-panel">
                    @{
                        var treinadorCasa = Model.TreinadorCasa as ControleFutebolWeb.Models.Treinador;
                    }
                    @if (treinadorCasa != null)
                    {
                        <div class="d-flex align-items-center gap-2 px-1 py-1 mb-1"
                             style="background:#161616;border-radius:7px;border:1px solid #262626;">
                            @if (!string.IsNullOrWhiteSpace(treinadorCasa.FotoUrl))
                            {
                                <img src="@Url.FotoSrc(treinadorCasa.FotoUrl)"
                                     alt="@treinadorCasa.Nome"
                                     style="width:24px;height:24px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <span style="font-size:16px;">🧑‍💼</span>
                            }
                            <div>
                                <div style="font-size:9px;color:#6b7280;text-transform:uppercase;line-height:1;">Treinador</div>
                                <div style="font-size:12px;font-weight:600;color:#f1f5f9;">@treinadorCasa.Nome</div>
                            </div>
                        </div>
                    }
                    <div class="jog-panel">
                    <div class="jog-panel-header">
                        @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="" />
                        }
                        <span class="jog-nome">@Model.Jogo.TimeCasa?.Nome</span>
                        <button type="button" class="jog-btn-add" onclick="toggleFormNovoJogador('casa')"
                                title="Cadastrar no elenco um jogador que a API ainda não trouxe">+</button>
                    </div>
                    <div class="jog-form-novo" id="formNovoJogadorCasa">
                        <input type="text" class="jf-num" id="novoJogNumCasa" maxlength="3" inputmode="numeric" placeholder="Nº" />
                        <input type="text" class="jf-nome" id="novoJogNomeCasa" placeholder="Nome do jogador"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); criarJogadorNoTime('casa'); }" />
                        <input type="text" class="jf-pos" id="novoJogPosCasa" maxlength="3" placeholder="Pos" title="Posição (opcional): GL, ZG, LD, LE, MC, AT" />
                        <button type="button" onclick="criarJogadorNoTime('casa')">OK</button>
                    </div>
                    <input type="text" id="filtroCasa" class="filtro-jogador" placeholder="🔍 Buscar por nome ou número..." oninput="filtrarLista('listaCasa', this.value)" />
                    <table class="table table-sm table-striped">
                        <thead><tr><th></th><th>Nome</th><th>Pos</th></tr></thead>
                        <tbody id="listaCasa">
                            @foreach (var jogador in (List<ControleFutebolWeb.Models.Jogador>)Model.JogadoresCasa)
                            {
                                <tr class="jogador-row"
                                    id="jogador-casa-@jogador.Id"
                                    draggable="true"
                                    ondragstart="dragJogador(event, @jogador.Id, '@jogador.Nome', '@jogador.NumeroCamisa', '', 'casa')">
                                    <td>
                                        @* position:relative ancora o ℹ no círculo (o <td> não serve de âncora) *@
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-casa" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        @jogador.Nome
                                        @if (!faseEhInicial && jogadoresSairamCasa.Contains(jogador.Id))
                                        {
                                            <span class="sub-badge-out" title="Jogador saiu">↓</span>
                                        }
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div><!-- /.jog-panel -->
                </div>

                <!-- Campinho casa -->
                <div class="col-7">
                    <div id="campoCasa" class="campo"
                         ondrop="dropNoCampo(event, 'campoCasa')"
                         ondragover="allowDrop(event)">
                        <div class="campo-linha-meio"></div>
                        <div class="campo-circulo"></div>
                        <div class="campo-area-sup"></div>
                        <div class="campo-area-inf"></div>
                        <div class="campo-gol-sup"></div>
                        <div class="campo-gol-inf"></div>
                        <svg class="setas-svg" data-campo-svg="campoCasa">
                            <defs>
                                <marker id="setaHeadCasa" markerWidth="12" markerHeight="10" refX="10" refY="5"
                                        orient="auto" markerUnits="userSpaceOnUse">
                                    <path d="M0,0 L12,5 L0,10 z" fill="#facc15" />
                                </marker>
                            </defs>
                        </svg>
                        @{
                            var idxCasa = 0;
                        }
                        @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesCasa)
                        {
                            bool expulsoCasa = esc.Jogador != null && Model.JogadoresComCartaoVermelho.Contains(esc.Jogador.Id);
                            bool amareloCasa = esc.Jogador != null && Model.JogadoresComCartaoAmarelo.Contains(esc.Jogador.Id);
                            bool capitaoCasa = esc.Jogador != null && Model.JogadoresCapitao.Contains(esc.Jogador.Id);
                            <div class="posicao-drop @(expulsoCasa ? "expulso" : "")"
                                 data-index="casa_@idxCasa"
                                 data-posicao="@AbreviarPosicao(esc.Posicao)"
                                 data-campo="casa"
                                 data-escid="@esc.Id"
                                 data-temjogador="@(esc.Jogador != null ? "1" : "0")"
                                 draggable="@(expulsoCasa ? "false" : "true")"
                                 ondragstart="dragPosicao(event, 'casa_@idxCasa')"
                                 ondrop="dropEscalacao(event, 'casa_@idxCasa')"
                                 ondragover="allowDrop(event)"
                                 style="left:@Coord(esc.PosicaoX)%; top:@Coord(esc.PosicaoY)%;">
                                @if (esc.Jogador != null)
                                {
                                    <div class="player-circle player-circle-casa">@(esc.Jogador.NumeroCamisa?.ToString() ?? "")</div>
                                    @if (expulsoCasa)
                                    {
                                        <span class="card-vermelho-badge" title="Expulso (cartão vermelho)"></span>
                                    }
                                    else if (amareloCasa)
                                    {
                                        <span class="card-amarelo-badge" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoCasa)
                                    {
                                        <span class="capitao-badge" title="Capitão">C</span>
                                    }
                                    @* Fora de .player-name: o overflow:hidden dela cortava a seta em nomes longos *@
                                    @if (!faseEhInicial && jogadoresEntraramCasa.Contains(esc.Jogador.Id))
                                    {
                                        <span class="sub-chip-in" title="@TituloEntrou(esc.Jogador.Id)">↑</span>
                                    }
                                    <div class="player-name">@esc.Jogador.Nome</div>
                                    <button type="button"
                                            id="btn-avaliar-@esc.Jogador.Id"
                                            class="btn-avaliar"
                                            onclick="abrirAvaliacao(@esc.Jogador.Id, '@esc.Jogador.Nome', '@esc.Posicao', event)">
                                        +
                                    </button>
                                    <button type="button" class="btn-info-jogador"
                                            onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@esc.Jogador.Id])"
                                            onmouseleave="esconderInfoJogador()">
                                        ℹ
                                    </button>
                                }
                                else
                                {
                                    <div class="player-circle player-circle-empty"></div>
                                }
                            </div>
                            <input type="hidden" name="escalacaoCasa[@idxCasa].Id" value="@esc.Id" />
                            <input type="hidden" name="escalacaoCasa[@idxCasa].PosicaoId" value="@esc.Id" />
                            <input type="hidden" id="escalacaoCasa_@(idxCasa)__JogadorId" name="escalacaoCasa[@idxCasa].JogadorId" value="@esc.JogadorId" />
                            <input type="hidden" id="escalacaoCasa_@(idxCasa)__PosicaoX" name="escalacaoCasa[@idxCasa].PosicaoX" value="@Coord(esc.PosicaoX)" />
                            <input type="hidden" id="escalacaoCasa_@(idxCasa)__PosicaoY" name="escalacaoCasa[@idxCasa].PosicaoY" value="@Coord(esc.PosicaoY)" />
                            idxCasa++;
                        }
                    </div>

                    @if (mostrarBancoReservas)
                    {
                        <!-- Banco de reservas casa -->
                        <div class="banco-label mt-2">🪑 Banco de reservas</div>
                        <div id="bancoCasa" class="banco"
                             ondrop="dropNoBanco(event, 'casa')"
                             ondragover="allowDrop(event)">
                            @{
                                var idxResCasa = 0;
                            }
                            @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.ReservasCasa)
                            {
                                bool amareloResCasa = esc.Jogador != null && Model.JogadoresComCartaoAmarelo.Contains(esc.Jogador.Id);
                                bool capitaoResCasa = esc.Jogador != null && Model.JogadoresCapitao.Contains(esc.Jogador.Id);
                                <div class="reserva-card" id="reserva-casa-card-@idxResCasa">
                                    <span class="rem-btn" onclick="removerReserva('casa', @idxResCasa)">×</span>
                                    <div class="player-circle player-circle-casa" style="width:28px;height:28px;font-size:11px;">
                                        @(esc.Jogador?.NumeroCamisa?.ToString() ?? "")
                                    </div>
                                    @if (amareloResCasa)
                                    {
                                        <span class="card-amarelo-badge-mini" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoResCasa)
                                    {
                                        <span class="capitao-badge-mini" title="Capitão">C</span>
                                    }
                                    @if (esc.Jogador != null)
                                    {
                                        <button type="button" class="btn-info-jogador"
                                                onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@esc.Jogador.Id])"
                                                onmouseleave="esconderInfoJogador()">
                                            ℹ
                                        </button>
                                    }
                                    <div style="max-width:54px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;">
                                        @esc.Jogador?.Nome
                                    </div>
                                </div>
                                <!-- inputs das reservas JÁ SALVAS ficam dentro do form principal -->
                                <input type="hidden" name="reservasCasa[@idxResCasa].Id" value="@esc.Id" />
                                <input type="hidden" id="reservaCasa_@(idxResCasa)__JogadorId" name="reservasCasa[@idxResCasa].JogadorId" value="@esc.JogadorId" />
                                <input type="hidden" id="reservaCasa_@(idxResCasa)__PosicaoX" name="reservasCasa[@idxResCasa].PosicaoX" value="0" />
                                <input type="hidden" id="reservaCasa_@(idxResCasa)__PosicaoY" name="reservasCasa[@idxResCasa].PosicaoY" value="0" />
                                idxResCasa++;
                            }
                        </div>
                        <input type="hidden" id="totalReservasCasa" value="@idxResCasa" />
                    }
                </div>
            </div>
        </div>

        <!-- ===== TIME VISITANTE ===== -->
        <div class="col-md-6">
            @* <h4>
                <img src="@Model.Jogo.TimeVisitante.EscudoUrl" width="24" />
                @Model.Jogo.TimeVisitante.Nome
            </h4> *@
            <div class="row">
                <!-- Campinho visitante -->
                <div class="col-7">
                    <div id="campoVisitante" class="campo"
                         ondrop="dropNoCampo(event, 'campoVisitante')"
                         ondragover="allowDrop(event)">
                        <div class="campo-linha-meio"></div>
                        <div class="campo-circulo"></div>
                        <div class="campo-area-sup"></div>
                        <div class="campo-area-inf"></div>
                        <div class="campo-gol-sup"></div>
                        <div class="campo-gol-inf"></div>
                        <svg class="setas-svg" data-campo-svg="campoVisitante">
                            <defs>
                                <marker id="setaHeadVis" markerWidth="12" markerHeight="10" refX="10" refY="5"
                                        orient="auto" markerUnits="userSpaceOnUse">
                                    <path d="M0,0 L12,5 L0,10 z" fill="#facc15" />
                                </marker>
                            </defs>
                        </svg>
                        @{
                            var idxVis = 0;
                        }
                        @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.EscalacoesVisitante)
                        {
                            bool expulsoVis = esc.Jogador != null && Model.JogadoresComCartaoVermelho.Contains(esc.Jogador.Id);
                            bool amareloVis = esc.Jogador != null && Model.JogadoresComCartaoAmarelo.Contains(esc.Jogador.Id);
                            bool capitaoVis = esc.Jogador != null && Model.JogadoresCapitao.Contains(esc.Jogador.Id);
                            <div class="posicao-drop @(expulsoVis ? "expulso" : "")"
                                 data-index="vis_@idxVis"
                                 data-posicao="@AbreviarPosicao(esc.Posicao)"
                                 data-campo="vis"
                                 data-escid="@esc.Id"
                                 data-temjogador="@(esc.Jogador != null ? "1" : "0")"
                                 draggable="@(expulsoVis ? "false" : "true")"
                                 ondragstart="dragPosicao(event, 'vis_@idxVis')"
                                 ondrop="dropEscalacao(event, 'vis_@idxVis')"
                                 ondragover="allowDrop(event)"
                                 style="left:@Coord(esc.PosicaoX)%; top:@Coord(esc.PosicaoY)%;">
                                @if (esc.Jogador != null)
                                {
                                    <div class="player-circle player-circle-vis">@(esc.Jogador.NumeroCamisa?.ToString() ?? "")</div>
                                    @if (expulsoVis)
                                    {
                                        <span class="card-vermelho-badge" title="Expulso (cartão vermelho)"></span>
                                    }
                                    else if (amareloVis)
                                    {
                                        <span class="card-amarelo-badge" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoVis)
                                    {
                                        <span class="capitao-badge" title="Capitão">C</span>
                                    }
                                    @if (!faseEhInicial && jogadoresEntraramVisitante.Contains(esc.Jogador.Id))
                                    {
                                        <span class="sub-chip-in" title="@TituloEntrou(esc.Jogador.Id)">↑</span>
                                    }
                                    <div class="player-name">@esc.Jogador.Nome</div>
                                    <button type="button"
                                            id="btn-avaliar-@esc.Jogador.Id"
                                            class="btn-avaliar"
                                            onclick="abrirAvaliacao(@esc.Jogador.Id, '@esc.Jogador.Nome', '@esc.Posicao', event)">
                                        +
                                    </button>
                                    <button type="button" class="btn-info-jogador"
                                            onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@esc.Jogador.Id])"
                                            onmouseleave="esconderInfoJogador()">
                                        ℹ
                                    </button>
                                }
                                else
                                {
                                    <div class="player-circle player-circle-empty"></div>
                                }
                            </div>
                            <input type="hidden" name="escalacaoVisitante[@idxVis].Id" value="@esc.Id" />
                            <input type="hidden" name="escalacaoVisitante[@idxVis].PosicaoId" value="@esc.Id" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__JogadorId" name="escalacaoVisitante[@idxVis].JogadorId" value="@esc.JogadorId" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__PosicaoX" name="escalacaoVisitante[@idxVis].PosicaoX" value="@Coord(esc.PosicaoX)" />
                            <input type="hidden" id="escalacaoVisitante_@(idxVis)__PosicaoY" name="escalacaoVisitante[@idxVis].PosicaoY" value="@Coord(esc.PosicaoY)" />
                            idxVis++;
                        }
                    </div>

                    @if (mostrarBancoReservas)
                    {
                        <!-- Banco de reservas visitante -->
                        <div class="banco-label mt-2">🪑 Banco de reservas</div>
                        <div id="bancoVisitante" class="banco"
                             ondrop="dropNoBanco(event, 'vis')"
                             ondragover="allowDrop(event)">
                            @{
                                var idxResVis = 0;
                            }
                            @foreach (var esc in (List<ControleFutebolWeb.Models.Escalacao>)Model.ReservasVisitante)
                            {
                                bool amareloResVis = esc.Jogador != null && Model.JogadoresComCartaoAmarelo.Contains(esc.Jogador.Id);
                                bool capitaoResVis = esc.Jogador != null && Model.JogadoresCapitao.Contains(esc.Jogador.Id);
                                <div class="reserva-card" id="reserva-vis-card-@idxResVis">
                                    <span class="rem-btn" onclick="removerReserva('vis', @idxResVis)">×</span>
                                    <div class="player-circle player-circle-vis" style="width:28px;height:28px;font-size:11px;">
                                        @(esc.Jogador?.NumeroCamisa?.ToString() ?? "")
                                    </div>
                                    @if (amareloResVis)
                                    {
                                        <span class="card-amarelo-badge-mini" title="Cartão amarelo"></span>
                                    }
                                    @if (capitaoResVis)
                                    {
                                        <span class="capitao-badge-mini" title="Capitão">C</span>
                                    }
                                    @if (esc.Jogador != null)
                                    {
                                        <button type="button" class="btn-info-jogador"
                                                onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@esc.Jogador.Id])"
                                                onmouseleave="esconderInfoJogador()">
                                            ℹ
                                        </button>
                                    }
                                    <div style="max-width:54px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;">
                                        @esc.Jogador?.Nome
                                    </div>
                                </div>
                                <input type="hidden" name="reservasVisitante[@idxResVis].Id" value="@esc.Id" />
                                <input type="hidden" id="reservaVis_@(idxResVis)__JogadorId" name="reservasVisitante[@idxResVis].JogadorId" value="@esc.JogadorId" />
                                <input type="hidden" id="reservaVis_@(idxResVis)__PosicaoX" name="reservasVisitante[@idxResVis].PosicaoX" value="0" />
                                <input type="hidden" id="reservaVis_@(idxResVis)__PosicaoY" name="reservasVisitante[@idxResVis].PosicaoY" value="0" />
                                idxResVis++;
                            }
                        </div>
                        <input type="hidden" id="totalReservasVis" value="@idxResVis" />
                    }
                </div>

                <!-- Lista de jogadores visitante -->
                <div class="col-5 scroll-panel">
                    @{
                        var treinadorVis = Model.TreinadorVisitante as ControleFutebolWeb.Models.Treinador;
                    }
                    @if (treinadorVis != null)
                    {
                        <div class="d-flex align-items-center gap-2 px-1 py-1 mb-1"
                             style="background:#161616;border-radius:7px;border:1px solid #262626;">
                            @if (!string.IsNullOrWhiteSpace(treinadorVis.FotoUrl))
                            {
                                <img src="@Url.FotoSrc(treinadorVis.FotoUrl)"
                                     alt="@treinadorVis.Nome"
                                     style="width:24px;height:24px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <span style="font-size:16px;">🧑‍💼</span>
                            }
                            <div>
                                <div style="font-size:9px;color:#6b7280;text-transform:uppercase;line-height:1;">Treinador</div>
                                <div style="font-size:12px;font-weight:600;color:#f1f5f9;">@treinadorVis.Nome</div>
                            </div>
                        </div>
                    }
                    <div class="jog-panel">
                    <div class="jog-panel-header">
                        @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="" />
                        }
                        <span class="jog-nome">@Model.Jogo.TimeVisitante?.Nome</span>
                        <button type="button" class="jog-btn-add" onclick="toggleFormNovoJogador('vis')"
                                title="Cadastrar no elenco um jogador que a API ainda não trouxe">+</button>
                    </div>
                    <div class="jog-form-novo" id="formNovoJogadorVis">
                        <input type="text" class="jf-num" id="novoJogNumVis" maxlength="3" inputmode="numeric" placeholder="Nº" />
                        <input type="text" class="jf-nome" id="novoJogNomeVis" placeholder="Nome do jogador"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); criarJogadorNoTime('vis'); }" />
                        <input type="text" class="jf-pos" id="novoJogPosVis" maxlength="3" placeholder="Pos" title="Posição (opcional): GL, ZG, LD, LE, MC, AT" />
                        <button type="button" onclick="criarJogadorNoTime('vis')">OK</button>
                    </div>
                    <input type="text" id="filtroVis" class="filtro-jogador" placeholder="🔍 Buscar por nome ou número..." oninput="filtrarLista('listaVisitante', this.value)" />
                    <table class="table table-sm table-striped">
                        <thead><tr><th></th><th>Nome</th><th>Pos</th></tr></thead>
                        <tbody id="listaVisitante">
                            @foreach (var jogador in (List<ControleFutebolWeb.Models.Jogador>)Model.JogadoresVisitante)
                            {
                                <tr class="jogador-row"
                                    id="jogador-vis-@jogador.Id"
                                    draggable="true"
                                    ondragstart="dragJogador(event, @jogador.Id, '@jogador.Nome', '@jogador.NumeroCamisa', '', 'vis')">
                                    <td>
                                        @* position:relative ancora o ℹ no círculo (o <td> não serve de âncora) *@
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-vis" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        @jogador.Nome
                                        @if (!faseEhInicial && jogadoresSairamVisitante.Contains(jogador.Id))
                                        {
                                            <span class="sub-badge-out" title="Jogador saiu">↓</span>
                                        }
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div><!-- /.jog-panel -->
                </div>
            </div>
        </div>

    </div>

    <div class="obs-box">
        <div class="obs-title">Observações do jogo (mandante, visitante, competição, jogador, marcos históricos…)</div>
        <div id="obsTagList">
            @foreach (var o in Model.ObservacoesTag)
            {
                var rotulo = o.Tipo switch
                {
                    "MANDANTE" => "Mandante",
                    "VISITANTE" => "Visitante",
                    "COMPETICAO" => "Competição",
                    "JOGADOR" => "Jogador",
                    "MARCO" => "Marco",
                    _ => o.Tipo
                };
                <div class="obs-tag-row" data-id="@o.Id">
                    <span class="obs-tag-badge obs-tag-badge-@o.Tipo.ToLowerInvariant()">@rotulo</span>
                    @if (o.Tipo == "JOGADOR" && o.Jogador != null)
                    {
                        <span class="obs-tag-jogador-nome">@o.Jogador.NomeExibicao</span>
                    }
                    <span class="obs-tag-texto">@o.Texto</span>
                    <span class="obs-tag-editar" onclick="editarObservacaoTag(@o.Id, this)" title="Editar">&#9998;</span>
                    <span class="obs-tag-remover" onclick="removerObservacaoTag(@o.Id, this)" title="Remover">&times;</span>
                </div>
            }
        </div>
        <div class="obs-actions" style="flex-wrap:wrap;">
            <select id="obsTagTipo" class="form-select form-select-sm" style="width:auto;" onchange="atualizarSeletorJogadorObs()">
                <option value="MANDANTE">Mandante (@Model.Jogo.TimeCasa.Nome)</option>
                <option value="VISITANTE">Visitante (@Model.Jogo.TimeVisitante.Nome)</option>
                <option value="COMPETICAO">Competição</option>
                <option value="JOGADOR">Jogador</option>
                <option value="MARCO">Marco histórico</option>
            </select>
            <select id="obsTagJogador" class="form-select form-select-sm" style="width:auto; display:none;">
                <option value="">Selecione o jogador…</option>
                @foreach (var j in Model.JogadoresEscalados)
                {
                    <option value="@j.Id">@j.NomeExibicao</option>
                }
            </select>
            <textarea id="obsTagTexto" class="form-control form-control-sm obs-tag-input" rows="1"
                      oninput="autoResizeObsTagTexto(this)"
                      placeholder="Ex.: primeiro gol do jogador em mata-mata da competição / jogo mil do clube / título histórico após 41 anos… (use @@ para mencionar um jogador)"></textarea>
            <button type="button" class="obs-btn" onclick="adicionarObservacaoTag()">+ Adicionar observação</button>
        </div>
    </div>

    <div class="text-center mt-3">
        <button type="submit" class="btn btn-success">Salvar Escalação @(faseEhInicial ? "Inicial" : "Final")</button>
    </div>
</form>

<form asp-action="LimparEscalacoes" asp-route-id="@Model.Jogo.Id" asp-route-faseEscalacao="@faseAtual" method="post" class="mt-2">
    @Html.AntiForgeryToken()
    <div class="text-center">
        <button type="submit" class="btn btn-danger">🗑️ Limpar Escalação @(faseEhInicial ? "Inicial" : "Final")</button>
    </div>
</form>

</div>
<!-- fim #painelEscalacao -->

<div id="painelEstatisticas" style="display:none;">
    <div class="cf-card" style="padding:1.25rem;">
        @{
            var totalChutes = PegarStatNumero(statsCasa, "Total Shots") + PegarStatNumero(statsVis, "Total Shots");
            var possCasa = PegarStatNumero(statsCasa, "Ball Possession");
            var possVis = PegarStatNumero(statsVis, "Ball Possession");
            if (possCasa == 0 && possVis == 0) { possCasa = 50; possVis = 50; }
        }

        @if (statsCasa.Count == 0 && statsVis.Count == 0)
        {
            <div style="padding:1.5rem;text-align:center;color:#9ca3af;font-size:13px;">
                Estatísticas ainda não disponíveis para esta partida.
            </div>
        }
        else
        {
            <div style="display:flex;align-items:center;justify-content:center;gap:1.5rem;margin-bottom:1.5rem;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa?.EscudoUrl })"
                         alt="@Model.Jogo.TimeCasa?.Nome" style="width:28px;height:28px;object-fit:contain;" />
                    <span style="font-weight:700;color:#f1f5f9;">@Model.Jogo.TimeCasa?.Nome</span>
                </div>
                <div style="font-size:12px;color:#9ca3af;text-transform:uppercase;font-weight:600;">Posse de bola</div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-weight:700;color:#f1f5f9;">@Model.Jogo.TimeVisitante?.Nome</span>
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante?.EscudoUrl })"
                         alt="@Model.Jogo.TimeVisitante?.Nome" style="width:28px;height:28px;object-fit:contain;" />
                </div>
            </div>

            <div style="display:flex;align-items:center;height:10px;border-radius:6px;overflow:hidden;margin-bottom:0.25rem;background:#222;">
                <div style="height:100%;background:#dc2626;width:@(Coord(possCasa))%;"></div>
                <div style="height:100%;background:#2563eb;width:@(Coord(possVis))%;"></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:#f1f5f9;margin-bottom:1.5rem;">
                <span>@(possCasa)%</span>
                <span>@(possVis)%</span>
            </div>

            @foreach (var (label, chave) in metricasEstatisticas)
            {
                var valCasaStr = PegarStat(statsCasa, chave);
                var valVisStr = PegarStat(statsVis, chave);
                var valCasaNum = PegarStatNumero(statsCasa, chave);
                var valVisNum = PegarStatNumero(statsVis, chave);
                var total = valCasaNum + valVisNum;
                var pctCasa = total > 0 ? (valCasaNum / total * 100) : 50;
                var pctVis = 100 - pctCasa;

                <div style="margin-bottom:1rem;">
                    <div style="display:flex;justify-content:space-between;font-size:13px;color:#e5e7eb;margin-bottom:4px;">
                        <span style="font-weight:700;">@valCasaStr</span>
                        <span style="color:#9ca3af;">@label</span>
                        <span style="font-weight:700;">@valVisStr</span>
                    </div>
                    <div style="display:flex;align-items:center;height:8px;border-radius:5px;overflow:hidden;background:#222;">
                        <div style="height:100%;background:#dc2626;width:@(Coord(pctCasa))%;"></div>
                        <div style="height:100%;background:#2563eb;width:@(Coord(pctVis))%;"></div>
                    </div>
                </div>
            }
        }
    </div>
</div>


<input type="hidden" id="jogoId" value="@Model.Jogo.Id" />
<!-- Modal de Avaliação -->
<div id="modal-avaliacao" onclick="if (event.target === this) salvarAvaliacao();" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#1a1a1a; border:1px solid #2a2a2a; color:#e5e7eb; border-radius:12px; width:360px; max-width:95vw; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
        <!-- Cabeçalho fixo -->
        <div style="display:flex; justify-content:space-between; align-items:flex-start; padding:1.25rem 1.25rem 0.75rem; border-bottom:1px solid #262626; flex-shrink:0;">
            <div>
                <h5 id="av-nome" style="margin:0; font-size:15px; font-weight:600; color:#f1f5f9;"></h5>
                <small id="av-pos" style="color:#6b7280;"></small>
            </div>
            <button type="button" onclick="fecharAvaliacao()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#6b7280;">&times;</button>
        </div>

        <!-- Corpo rolável (somente as ações) -->
        <div style="overflow-y:auto; flex:1 1 auto; padding:0.75rem 1.25rem;">
            <div id="av-acoes"></div>

            <!-- Bônus automáticos -->
            <div id="av-bonus-bloco" style="display:none; margin-top:0.75rem; padding:0.6rem 0.75rem; background:rgba(59,130,246,0.08); border-radius:8px; border:1px solid rgba(59,130,246,0.25);">
                <div style="font-size:11px; font-weight:600; color:#60a5fa; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">⚡ Bônus automáticos</div>
                <div id="av-bonus-linhas" style="display:flex; flex-direction:column; gap:4px;"></div>
                <div style="margin-top:6px; padding-top:6px; border-top:1px solid rgba(59,130,246,0.25); display:flex; justify-content:space-between; font-size:13px; font-weight:600; color:#e5e7eb;">
                    <span>Subtotal bônus</span>
                    <span id="av-bonus-subtotal" style="color:#60a5fa;">+0</span>
                </div>
            </div>
        </div>

        <!-- Rodapé fixo: pontuação + observação + salvar -->
        <div style="flex-shrink:0; padding:0.75rem 1.25rem 1.25rem; border-top:1px solid #262626; background:#1a1a1a;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="color:#9ca3af; font-size:13px;">Pontuação total</span>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span id="av-total" style="font-size:22px; font-weight:600; color:#f1f5f9;">0</span>
                    <span id="av-nota" style="padding:3px 10px; border-radius:20px; font-size:12px; font-weight:500;">Regular</span>
                </div>
            </div>
            <div style="margin-top:0.75rem; display:flex; align-items:center; gap:8px;">
                <label for="av-nota-manual" style="font-size:12px; color:#9ca3af; flex:1;">
                    Nota manual (opcional)
                    <span style="display:block; font-size:10px; color:#6b7280;">Se preenchida, vale como nota final (ignora base + ações)</span>
                </label>
                <input type="number" id="av-nota-manual" min="0" max="10" step="0.1" placeholder="—"
                       style="width:70px; font-size:14px; text-align:center; border:1px solid #2a2a2a; border-radius:6px; padding:6px; background:#0f0f0f; color:#e5e7eb;">
            </div>
            <div style="margin-top:0.75rem;">
                <label style="font-size:12px; color:#9ca3af;">Observação:</label>
                <textarea id="av-obs" rows="2" style="width:100%; margin-top:4px; font-size:13px; border:1px solid #2a2a2a; border-radius:6px; padding:6px; resize:vertical; background:#0f0f0f; color:#e5e7eb;"></textarea>
            </div>
            <button type="button" onclick="salvarAvaliacao()" style="width:100%; margin-top:10px; padding:8px; background:#d4a520; color:#141414; border:none; border-radius:6px; font-size:14px; font-weight:700; cursor:pointer;">Salvar</button>
        </div>
    </div>
</div>




<!-- ── Modal Últimos Confrontos (H2H) ─────────────────────────────────── -->
<div id="modal-h2h" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:10000; align-items:center; justify-content:center;">
    <div style="background:#1e293b; border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:1.4rem; width:480px; max-width:96vw; max-height:88vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h5 style="margin:0; color:#e2e8f0; font-size:15px; font-weight:700;">⚔️ Últimos confrontos</h5>
            <button onclick="fecharH2H()" style="background:none;border:none;color:#94a3b8;font-size:22px;cursor:pointer;line-height:1;">&times;</button>
        </div>
        <div id="h2h-corpo">
            <div style="text-align:center; color:#94a3b8; padding:2rem 0;">Carregando...</div>
        </div>
    </div>
</div>



<!-- ── Modal Pré-jogo ─────────────────────────────────────────────────── -->
<div id="modal-prejogo" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:10000; align-items:center; justify-content:center;">
    <div id="prejogo-box" style="background:#0f1b2d; border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:1.4rem; width:780px; max-width:96vw; max-height:90vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5); transition:width .2s;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem;">
            <h5 style="margin:0; color:#e2e8f0; font-size:15px; font-weight:700;">🔍 Pré-jogo</h5>
            <button onclick="fecharPreJogo()" style="background:none;border:none;color:#94a3b8;font-size:22px;cursor:pointer;line-height:1;">&times;</button>
        </div>
        <div class="pj-tabs">
            <button type="button" id="pj-tab-resumo" class="pj-tab active" onclick="mostrarAbaPreJogo('resumo')">📋 Resumo</button>
            <button type="button" id="pj-tab-matchup" class="pj-tab" onclick="mostrarAbaPreJogo('matchup')">⚔️ Match-up</button>
        </div>
        <div id="prejogo-corpo">
            <div style="text-align:center; color:#94a3b8; padding:2rem 0;">Carregando...</div>
        </div>
        <div id="prejogo-matchup" style="display:none;">
            <div style="text-align:center; color:#94a3b8; padding:2rem 0;">Carregando...</div>
        </div>
    </div>
</div>

<!-- ── Modal: Mapa de Calor ────────────────────────────────────────── -->
<div id="modal-mapacalor" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:10000; align-items:center; justify-content:center;">
    <div style="background:#0b0f16; border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:1.2rem 1.4rem; width:900px; max-width:97vw; max-height:93vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5); position:relative;">
        <button onclick="fecharMapaCalor()" style="position:absolute; top:14px; right:16px; z-index:5; background:rgba(0,0,0,.35); border:1px solid rgba(255,255,255,.15); color:#e2e8f0; font-size:18px; width:30px; height:30px; border-radius:50%; cursor:pointer; line-height:1;">&times;</button>
        <h5 style="margin:0 0 1rem; color:#e2e8f0; font-size:15px; font-weight:700;">🔥 Mapa de Calor</h5>
        <div class="mc-grid">
            <div class="mc-col">
                <div class="mc-col-head">@Model.Jogo.TimeCasa.Nome</div>
                <select id="mcSelectCasa" class="form-select form-select-sm" onchange="mcMostrar('casa')">
                    <option value="">— selecione —</option>
                    <option value="time">🔥 Todo o time</option>
                </select>
                <div id="mcCampoCasa" class="campo mc-campo">
                    <div class="campo-linha-meio"></div>
                    <div class="campo-circulo"></div>
                    <div class="campo-area-sup"></div>
                    <div class="campo-area-inf"></div>
                    <div class="campo-gol-sup"></div>
                    <div class="campo-gol-inf"></div>
                </div>
            </div>
            <div class="mc-col">
                <div class="mc-col-head">@Model.Jogo.TimeVisitante.Nome</div>
                <select id="mcSelectVisitante" class="form-select form-select-sm" onchange="mcMostrar('visitante')">
                    <option value="">— selecione —</option>
                    <option value="time">🔥 Todo o time</option>
                </select>
                <div id="mcCampoVisitante" class="campo mc-campo">
                    <div class="campo-linha-meio"></div>
                    <div class="campo-circulo"></div>
                    <div class="campo-area-sup"></div>
                    <div class="campo-area-inf"></div>
                    <div class="campo-gol-sup"></div>
                    <div class="campo-gol-inf"></div>
                </div>
            </div>
        </div>
        <div style="display:flex; align-items:center; justify-content:center; margin-top:.8rem; gap:8px;">
            <span style="font-size:.6rem; color:#374151; font-weight:600;">Baixa</span>
            <div style="width:160px; height:5px; border-radius:3px; background:linear-gradient(90deg, #4ade80, #facc15, #f97316, #ef4444);"></div>
            <span style="font-size:.6rem; color:#374151; font-weight:600;">Alta</span>
        </div>
        <div style="font-size:11px; color:#64748b; margin-top:.6rem;">
            Só aparecem jogadores que entraram em campo. Baseado em todas as escalações salvas neste jogo (inicial, final e fases táticas).
        </div>
    </div>
</div>




<!-- ── Modal Pós-jogo ─────────────────────────────────────────────────── -->
<div id="modal-posjogo" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:10000; align-items:center; justify-content:center;">
    <div style="background:#0b0f16; border:1px solid rgba(255,255,255,.12); border-radius:16px; width:1140px; max-width:97vw; max-height:93vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5); position:relative;">
        <button onclick="fecharPosJogo()" style="position:absolute; top:14px; right:16px; z-index:5; background:rgba(0,0,0,.35); border:1px solid rgba(255,255,255,.15); color:#e2e8f0; font-size:18px; width:30px; height:30px; border-radius:50%; cursor:pointer; line-height:1;">&times;</button>
        <div id="posjogo-corpo">
            <div style="text-align:center; color:#94a3b8; padding:3rem 0;">Carregando...</div>
        </div>
    </div>
</div>

@* Carregado no fim do body (o _Layout renderiza esta seção por último), quando
   todo o DOM já existe — os scripts acessam elementos direto, sem esperar
   DOMContentLoaded, como faziam quando estavam inline logo abaixo do HTML deles. *@
@section Scripts {
    <script src="~/js/analisar.js" asp-append-version="true"></script>
}


</div><!-- /.an-root -->