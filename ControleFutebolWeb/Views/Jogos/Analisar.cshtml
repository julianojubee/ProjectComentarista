@* Cor da camisa escolhida pelo usuário no cabeçalho das escalações (igual ao
   seletor do match-up de /creators). Fica só no navegador, por jogo: o Jogo é
   compartilhado e as cores da API continuam valendo para os outros. *@
<script>
    (function () {
        const chave = function (lado) { return 'an-cor-camisa-@(Model.Jogo.Id)-' + lado; };

        // Número em preto ou branco, o que contrastar mais com a camisa
        function corNumero(hex) {
            const n = parseInt(hex.slice(1), 16);
            const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
            return (0.299 * r + 0.587 * g + 0.114 * b) > 160 ? '#111111' : '#ffffff';
        }

        function aplicar(lado, cor) {
            const s = document.documentElement.style;
            s.setProperty('--cor-camisa-' + lado, cor);
            s.setProperty('--cor-numero-' + lado, corNumero(cor));
        }

        window.anSetCorCamisa = function (lado, cor) {
            aplicar(lado, cor);
            try { localStorage.setItem(chave(lado), cor); } catch (e) { }
        };

        window.anResetCorCamisa = function (lado, input) {
            const s = document.documentElement.style;
            s.removeProperty('--cor-camisa-' + lado);
            s.removeProperty('--cor-numero-' + lado);
            try { localStorage.removeItem(chave(lado)); } catch (e) { }
            if (input) input.value = getComputedStyle(document.documentElement).getPropertyValue('--cor-camisa-' + lado).trim().slice(0, 7);
        };

        ['casa', 'vis'].forEach(function (lado) {
            let cor = null;
            try { cor = localStorage.getItem(chave(lado)); } catch (e) { }
            if (cor && /^#[0-9a-f]{6}$/i.test(cor)) aplicar(lado, cor);
        });

        // Os inputs vêm depois no HTML: sincroniza o valor quando o DOM estiver pronto
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.jog-cor-camisa').forEach(function (inp) {
                const cor = getComputedStyle(document.documentElement).getPropertyValue('--cor-camisa-' + inp.dataset.lado).trim();
                if (/^#[0-9a-f]{6}$/i.test(cor)) inp.value = cor;
            });
        });
    })();
</script>

