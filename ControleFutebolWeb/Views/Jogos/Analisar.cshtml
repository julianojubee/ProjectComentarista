        </div>
        <div class="mb-acoes-grupo fim">
            <button type="button" class="mb-acao" id="mbCompartilharToggle" onclick="abrirCompartilhar(@Model.Jogo.Id)"
                    title="Gera um link público, somente leitura, para mostrar esta análise a quem não tem conta no sistema">🔗 Compartilhar</button>
        </div>
