                        </div>
                        </div>
                        <input type="hidden" id="totalReservasVis" value="@idxResVis" />
                    }
                </div>

                <!-- Lista de jogadores visitante -->
                <div class="col-5 scroll-panel" id="listaPainelVis">
                    @{
                        var treinadorVis = Model.TreinadorVisitante as ControleFutebolWeb.Models.Treinador;
                    }
                    @if (treinadorVis != null)
                    {
                        <div class="jog-treinador">
                            @if (!string.IsNullOrWhiteSpace(treinadorVis.FotoUrl))
                            {
                                <img src="@Url.FotoSrc(treinadorVis.FotoUrl)"
                                     alt="@treinadorVis.Nome"
                                     class="jog-treinador-foto" />
                            }
                            else
                            {
                                <span class="jog-treinador-foto vazia" aria-hidden="true">🧑‍💼</span>
                            }
                            <div>
                                <div class="jog-treinador-rot">Treinador</div>
                                <div class="jog-treinador-nome">@treinadorVis.Nome</div>
                            </div>
                        </div>
                    }
                    <div class="jog-panel">
                    <div class="jog-panel-header">
                        @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="" />
                        }
                        <span class="jog-nome">@Model.Jogo.TimeVisitante?.Nome</span>
                        <input type="color" class="jog-cor-camisa" data-lado="vis" value="#0d6efd"
                               title="Cor da camisa deste time (clique com o botão direito para voltar à cor original)"
                               oninput="anSetCorCamisa('vis', this.value)"
                               oncontextmenu="event.preventDefault(); anResetCorCamisa('vis', this)" />
                        <button type="button" class="jog-btn-add" onclick="toggleFormNovoJogador('vis')"
                                title="Cadastrar no elenco um jogador que a API ainda não trouxe">+</button>
                    </div>
                    <div class="jog-form-novo" id="formNovoJogadorVis">
                        <input type="text" class="jf-num" id="novoJogNumVis" maxlength="3" inputmode="numeric" placeholder="Nº" />
                        <input type="text" class="jf-nome" id="novoJogNomeVis" placeholder="Nome do jogador"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); criarJogadorNoTime('vis'); }" />
                        <input type="text" class="jf-pos" id="novoJogPosVis" maxlength="3" placeholder="Pos" title="Posição (opcional): GL, ZG, LD, LE, MC, AT" />
                        <button type="button" onclick="criarJogadorNoTime('vis')">OK</button>
                    </div>
                    <input type="text" id="filtroVis" class="filtro-jogador" placeholder="🔍 Buscar por nome ou número..." oninput="filtrarLista('listaVisitante', this.value)" />
                    <table class="table table-sm table-striped">
                        <thead><tr><th></th><th>Nome</th><th>Pos</th></tr></thead>
                        <tbody id="listaVisitante">
                            @* Expulsos primeiro: fora do campo, cinza e sem draggable *@
                            @foreach (var jogador in expulsosVisitante)
                            {
                                <tr class="jogador-row expulso" id="jogador-vis-@jogador.Id"
                                    title="Expulso (cartão vermelho)">
                                    <td>
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-vis" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <span class="card-vermelho-badge-mini" title="Expulso (cartão vermelho)"></span>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <a class="jog-nome-link" draggable="false" title="Ver perfil de @jogador.Nome"
                                           asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@jogador.Id">@jogador.Nome</a>
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                            @foreach (var jogador in ((List<ControleFutebolWeb.Models.Jogador>)Model.JogadoresVisitante)
                                .Where(j => !idsExpulsosVisitante.Contains(j.Id)))
                            {
                                <tr class="jogador-row"
                                    id="jogador-vis-@jogador.Id"
                                    draggable="true"
                                    data-nome="@jogador.Nome"
                                    ondragstart="dragJogador(event, @jogador.Id, this.dataset.nome, '@jogador.NumeroCamisa', '', 'vis')">
                                    <td>
                                        @* position:relative ancora o ℹ no círculo (o <td> não serve de âncora) *@
                                        <div style="position:relative;display:inline-block;">
                                            <div class="player-circle player-circle-vis" style="width:28px;height:28px;font-size:11px;">
                                                @(jogador.NumeroCamisa?.ToString() ?? "")
                                            </div>
                                            <button type="button" class="btn-info-jogador"
                                                    onmouseenter="mostrarInfoJogador(this, DADOS_JOGADORES[@jogador.Id])"
                                                    onmouseleave="esconderInfoJogador()">
                                                ℹ
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <a class="jog-nome-link" draggable="false" title="Ver perfil de @jogador.Nome"
                                           asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@jogador.Id">@jogador.Nome</a>
                                        @if (!faseEhInicial && jogadoresSairamVisitante.Contains(jogador.Id))
                                        {
                                            <span class="sub-badge-out" title="Jogador saiu">↓</span>
                                        }
                                    </td>
                                    <td>@AbreviarPosicao(jogador.Posicao)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div><!-- /.jog-panel -->
                </div>
            </div>
        </div>

    </div>

    <div class="obs-box" id="obsBox">
        <div class="obs-title">Observações do jogo (mandante, visitante, competição, jogador, marcos históricos…)</div>
        <div id="obsTagList">
            @foreach (var o in Model.ObservacoesTag)
            {
                var rotulo = o.Tipo switch
                {
                    "MANDANTE" => "Mandante",
                    "VISITANTE" => "Visitante",
                    "COMPETICAO" => "Competição",
                    "JOGADOR" => "Jogador",
                    "MARCO" => "Marco",
                    _ => o.Tipo
                };
                <div class="obs-tag-row" data-id="@o.Id">
                    <span class="obs-tag-badge obs-tag-badge-@o.Tipo.ToLowerInvariant()">@rotulo</span>
                    @if (o.Tipo == "JOGADOR" && o.Jogador != null)
                    {
                        <span class="obs-tag-jogador-nome">@o.Jogador.NomeExibicao</span>
                    }
                    <span class="obs-tag-texto">@o.Texto</span>
                    <span class="obs-tag-editar" onclick="editarObservacaoTag(@o.Id, this)" title="Editar">&#9998;</span>
                    <span class="obs-tag-remover" onclick="removerObservacaoTag(@o.Id, this)" title="Remover">&times;</span>
                </div>
            }
        </div>
        <div class="obs-actions" style="flex-wrap:wrap;">
            <select id="obsTagTipo" class="form-select form-select-sm" style="width:auto;" onchange="atualizarSeletorJogadorObs()">
                <option value="MANDANTE">Mandante (@Model.Jogo.TimeCasa.Nome)</option>
                <option value="VISITANTE">Visitante (@Model.Jogo.TimeVisitante.Nome)</option>
                <option value="COMPETICAO">Competição</option>
                <option value="JOGADOR">Jogador</option>
                <option value="MARCO">Marco histórico</option>
            </select>
            <select id="obsTagJogador" class="form-select form-select-sm" style="width:auto; display:none;">
                <option value="">Selecione o jogador…</option>
                @foreach (var j in Model.JogadoresEscalados)
                {
                    <option value="@j.Id">@j.NomeExibicao</option>
                }
            </select>
            <textarea id="obsTagTexto" class="form-control form-control-sm obs-tag-input" rows="1"
                      oninput="autoResizeObsTagTexto(this)"
                      placeholder="Ex.: primeiro gol do jogador em mata-mata da competição / jogo mil do clube / título histórico após 41 anos… (use @@ para mencionar um jogador)"></textarea>
            <button type="button" class="obs-btn" onclick="adicionarObservacaoTag()">+ Adicionar observação</button>
        </div>
    </div>

    @* Fica grudada no pé da janela enquanto a prancheta está na tela: dá pra
       salvar sem rolar até o fim depois de mexer no campo. O Limpar pertence ao
       form de baixo (atributo form=), só mora aqui para ficar junto do Salvar. *@
    <div class="pr-salvar">
        <span class="pr-salvar-aba">@rotuloAba</span>
        <button type="submit" form="formLimparEscalacao" class="pr-salvar-limpar">
            @(faseIntermediaria ? "Excluir fase" : "Limpar escalação")
        </button>
        <button type="submit" class="pr-salvar-ok">Salvar escalação</button>
    </div>
</form>

<form id="formLimparEscalacao" asp-action="LimparEscalacoes" asp-route-id="@Model.Jogo.Id" asp-route-faseEscalacao="@faseAtual" method="post"
      onsubmit="return confirm('@Html.Raw(confirmaLimpar)')">
    @Html.AntiForgeryToken()
</form>

</div>
<!-- fim #painelEscalacao -->

<div id="painelEstatisticas" style="display:none;">
    @* Comparativo da partida. As cores são as das camisas (--cor-camisa-*), as
       mesmas das faixas do placar e do seletor de cor das escalações. *@
    <div class="est-painel">
        @{
            var possCasa = PegarStatNumero(statsCasa, "Ball Possession");
            var possVis = PegarStatNumero(statsVis, "Ball Possession");
            var possInformada = possCasa > 0 || possVis > 0;
            if (!possInformada) { possCasa = 50; possVis = 50; }
        }

        @if (statsCasa.Count == 0 && statsVis.Count == 0)
        {
            <div class="est-vazio">
                <strong>Esta partida ainda não tem estatísticas</strong>
                <span>Elas aparecem aqui quando a importação trouxer os números do jogo.</span>
            </div>
        }
        else
        {
            <div class="est-times">
                <div class="est-time casa">
                    <span class="est-time-cor" aria-hidden="true"></span>
                    @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="" />
                    }
                    <span>@Model.Jogo.TimeCasa?.Nome</span>
                </div>
                <div class="est-time vis">
                    <span>@Model.Jogo.TimeVisitante?.Nome</span>
                    @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="" />
                    }
                    <span class="est-time-cor" aria-hidden="true"></span>
                </div>
            </div>

            @* Posse: a única métrica que soma 100, por isso a barra dividida *@
            <div class="est-posse">
                <span class="est-posse-num">@(possInformada ? $"{possCasa}%" : "–")</span>
                <div class="est-posse-meio">
                    <div class="est-posse-barra" role="img"
                         aria-label="Posse de bola: @Model.Jogo.TimeCasa?.Nome @(possCasa)%, @Model.Jogo.TimeVisitante?.Nome @(possVis)%">
                        <span class="casa" style="width:@(Coord(possCasa))%"></span>
                        <span class="vis" style="width:@(Coord(possVis))%"></span>
                    </div>
                    <span class="est-posse-rot">Posse de bola@(possInformada ? "" : " (não informada)")</span>
                </div>
                <span class="est-posse-num">@(possInformada ? $"{possVis}%" : "–")</span>
            </div>

            <div class="est-grupos">
                @foreach (var (tituloGrupo, chavesGrupo) in gruposEstatisticas)
                {
                    var metricasGrupo = metricasEstatisticas.Where(m => chavesGrupo.Contains(m.chave)).ToList();
                    if (metricasGrupo.Count == 0) { continue; }
                    <section class="est-grupo">
                        <h3 class="est-grupo-titulo">@tituloGrupo</h3>
                        @foreach (var (label, chave) in metricasGrupo)
                        {
                            var valCasaStr = PegarStat(statsCasa, chave);
                            var valVisStr = PegarStat(statsVis, chave);
                            var valCasaNum = PegarStatNumero(statsCasa, chave);
                            var valVisNum = PegarStatNumero(statsVis, chave);
                            // Borboleta: cada lado cresce do centro, proporcional ao maior
                            // dos dois. Quem tem o número maior fica destacado.
                            var maior = Math.Max(valCasaNum, valVisNum);
                            var largCasa = maior > 0 ? valCasaNum / maior * 100 : 0;
                            var largVis = maior > 0 ? valVisNum / maior * 100 : 0;
                            var lider = valCasaNum > valVisNum ? "casa" : valVisNum > valCasaNum ? "vis" : "";

                            <div class="est-linha @(lider != "" ? "lider-" + lider : "")">
                                <span class="est-val casa">@valCasaStr</span>
                                <span class="est-rot">@label</span>
                                <span class="est-val vis">@valVisStr</span>
                                <div class="est-barras" aria-hidden="true">
                                    <span class="casa"><i style="width:@(Coord(largCasa))%"></i></span>
                                    <span class="vis"><i style="width:@(Coord(largVis))%"></i></span>
                                </div>
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </div>
</div>


<input type="hidden" id="jogoId" value="@Model.Jogo.Id" />
<!-- Modal de Avaliação -->
<div id="modal-avaliacao" onclick="if (event.target === this) salvarAvaliacao();" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center">
    <div style="background:var(--p-2); border:1px solid var(--line-strong); color:var(--text); border-radius:12px; width:360px; max-width:95vw; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5)">
        <!-- Cabeçalho fixo -->
        <div style="display:flex; justify-content:space-between; align-items:flex-start; padding:1.25rem 1.25rem 0.75rem; border-bottom:1px solid var(--line); flex-shrink:0">
            <div>
                <h5 id="av-nome" style="margin:0; font-size:15px; font-weight:600; color:var(--text-strong)"></h5>
                <small id="av-pos" style="color:var(--text-dim)"></small>
            </div>
            <button type="button" onclick="fecharAvaliacao()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-dim)">&times;</button>
        </div>

        <!-- Corpo rolável (somente as ações) -->
        <div style="overflow-y:auto; flex:1 1 auto; padding:0.75rem 1.25rem;">
            <div id="av-acoes"></div>

            <!-- Bônus automáticos -->
            <div id="av-bonus-bloco" style="display:none; margin-top:0.75rem; padding:0.6rem 0.75rem; background:rgba(59,130,246,0.08); border-radius:8px; border:1px solid rgba(59,130,246,0.25);">
                <div style="font-size:11px; font-weight:600; color:var(--info); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px">⚡ Bônus automáticos</div>
                <div id="av-bonus-linhas" style="display:flex; flex-direction:column; gap:4px;"></div>
                <div style="margin-top:6px; padding-top:6px; border-top:1px solid rgba(59,130,246,0.25); display:flex; justify-content:space-between; font-size:13px; font-weight:600; color:var(--text)">
                    <span>Subtotal bônus</span>
                    <span id="av-bonus-subtotal" style="color:var(--info)">+0</span>
                </div>
            </div>
        </div>

        <!-- Rodapé fixo: pontuação + observação + salvar -->
        <div style="flex-shrink:0; padding:0.75rem 1.25rem 1.25rem; border-top:1px solid var(--line); background:var(--p-2)">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="color:var(--text-muted); font-size:13px">Pontuação total</span>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span id="av-total" style="font-size:22px; font-weight:600; color:var(--text-strong)">0</span>
                    <span id="av-nota" style="padding:3px 10px; border-radius:20px; font-size:12px; font-weight:500;">Regular</span>
                </div>
            </div>
            <div style="margin-top:0.75rem; display:flex; align-items:center; gap:8px;">
                <label for="av-nota-manual" style="font-size:12px; color:var(--text-muted); flex:1">
                    Nota manual (opcional)
                    <span style="display:block; font-size:10px; color:var(--text-dim)">Se preenchida, vale como nota final (ignora base + ações)</span>
                </label>
                <input type="number" id="av-nota-manual" min="0" max="10" step="0.1" placeholder="—"
                       style="width:70px; font-size:14px; text-align:center; border:1px solid var(--line-strong); border-radius:6px; padding:6px; background:var(--p-0); color:var(--text)">
            </div>
            <div style="margin-top:0.75rem;">
                <label style="font-size:12px; color:var(--text-muted)">Observação:</label>
                <textarea id="av-obs" rows="2" style="width:100%; margin-top:4px; font-size:13px; border:1px solid var(--line-strong); border-radius:6px; padding:6px; resize:vertical; background:var(--p-0); color:var(--text)"></textarea>
            </div>
            <button type="button" onclick="salvarAvaliacao()" style="width:100%; margin-top:10px; padding:8px; background:#d4a520; color:#141414; border:none; border-radius:6px; font-size:14px; font-weight:700; cursor:pointer;">Salvar</button>
        </div>
    </div>
</div>




