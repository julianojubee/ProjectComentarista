@model ControleFutebolWeb.Models.ViewModels.AnalisarViewModel
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@using ControleFutebolWeb.Helpers
@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // Título da aba do navegador: app na frente + confronto, para diferenciar
    // várias análises abertas ao mesmo tempo (ex.: "Análise de Craque - Nova Zelândia x Bélgica").
    ViewData["TitleOverride"] = $"Análise de Craque - {Model.Jogo.TimeCasa?.Nome} x {Model.Jogo.TimeVisitante?.Nome}";

    // Coroa do craque da partida (maior nota do jogo — ver CraqueDaPartida).
    var tituloCraque = $"Craque da partida — nota {Model.CraqueNota.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}";

    var faseAtual = (Model.FaseEscalacaoAtual as string) ?? "INICIAL";
    var faseEhInicial = faseAtual == "INICIAL";
    var fasesTaticas = (Model.FasesTaticas as List<ControleFutebolWeb.Models.FaseTatica>) ?? new List<ControleFutebolWeb.Models.FaseTatica>();
    var mostrarBancoReservas = (Model.MostrarBancoReservas as bool?) ?? false;
    var jogadoresEntraramCasa = (Model.JogadoresEntraramCasa as List<int>) ?? new List<int>();
    var jogadoresEntraramVisitante = (Model.JogadoresEntraramVisitante as List<int>) ?? new List<int>();
    var jogadoresSairamCasa = (Model.JogadoresSairamCasa as List<int>) ?? new List<int>();
    var jogadoresSairamVisitante = (Model.JogadoresSairamVisitante as List<int>) ?? new List<int>();
    var entrouNoLugarDe = (Model.EntrouNoLugarDe as Dictionary<int, string>) ?? new Dictionary<int, string>();
    // Texto do tooltip da seta verde: com o registro da substituição mostra
    // "Entrou no lugar de {nome} ({min}')"; sem registro, o texto genérico.
    string TituloEntrou(int jogadorId) =>
        entrouNoLugarDe.TryGetValue(jogadorId, out var saiu)
            ? $"Entrou no lugar de {saiu}"
            : "Jogador entrou";
    // Expulso sai do campo e vai para o TOPO da lista lateral, em cinza e sem
    // poder ser arrastado de volta: antes o botão dele ficava no campo apenas
    // desabilitado e atrapalhava quem precisava arrastar outro jogador para a vaga.
    // Na escalação INICIAL ele aparece normal — quando ela foi montada o cartão
    // vermelho ainda não tinha acontecido.
    // Reserva expulso continua no banco (o banco não usa o campo), por isso sai daqui.
    List<Jogador> ExpulsosDoTime(List<Escalacao> titulares, List<Escalacao> reservas, List<Jogador> elenco)
    {
        if (faseEhInicial) return new List<Jogador>();
        var idsReservas = reservas.Where(e => e.JogadorId != null).Select(e => e.JogadorId!.Value).ToHashSet();
        return titulares.Where(e => e.Jogador != null).Select(e => e.Jogador!)
            .Concat(elenco)
            .Where(j => Model.JogadoresComCartaoVermelho.Contains(j.Id) && !idsReservas.Contains(j.Id))
            .GroupBy(j => j.Id)
            .Select(g => g.First())
            .OrderBy(j => j.Nome)
            .ToList();
    }
    var expulsosCasa = ExpulsosDoTime(Model.EscalacoesCasa, Model.ReservasCasa, Model.JogadoresCasa);
    var expulsosVisitante = ExpulsosDoTime(Model.EscalacoesVisitante, Model.ReservasVisitante, Model.JogadoresVisitante);
    var idsExpulsosCasa = expulsosCasa.Select(j => j.Id).ToHashSet();
    var idsExpulsosVisitante = expulsosVisitante.Select(j => j.Id).ToHashSet();

    var golsPorJogador = (Model.GolsPorJogador as Dictionary<int, int>) ?? new Dictionary<int, int>();
    var assistsPorJogador = (Model.AssistsPorJogador as Dictionary<int, int>) ?? new Dictionary<int, int>();

    // Em jogo de seleção o tooltip do jogador mostra também o clube dele
    // (Jogador.Time é o clube; a seleção fica em Jogador.SelecaoId).
    var jogoDeSelecao = Model.Jogo.TimeCasa?.EhSelecao == true || Model.Jogo.TimeVisitante?.EhSelecao == true;
    string ClubeTooltip(ControleFutebolWeb.Models.Jogador j) =>
        jogoDeSelecao && j.Time != null && !j.Time.EhSelecao
            ? j.Time.Nome
            : "";
    // Escudo do clube (só quando o clube aparece no tooltip — ver ClubeTooltip).
    string ClubeEscudoTooltip(ControleFutebolWeb.Models.Jogador j) =>
        jogoDeSelecao && j.Time != null && !j.Time.EhSelecao && !string.IsNullOrEmpty(j.Time.EscudoUrl)
            ? Url.Action("Imagem", "MediaProxy", new { url = j.Time.EscudoUrl })!
            : "";
    // Imagem da bandeira (flagcdn) em vez do emoji: no Windows os navegadores não
    // renderizam emoji de bandeira (mostram só as letras do código do país).
    string BandeiraTooltip(ControleFutebolWeb.Models.Jogador j) =>
        j.Nacionalidade != null ? (FlagHelper.GetFlagImageUrl(j.Nacionalidade.Nome) ?? "") : "";

    // Dados do tooltip ℹ por jogador (id → objeto consumido por mostrarInfoJogador).
    // Ficam num mapa único, e não repetidos em cada botão, porque o botão também é
    // criado em JS: jogador arrastado para o campo/banco e cadastro rápido pelo "+"
    // já nascem com o ℹ, sem depender de recarregar a página. Reúne o elenco das
    // listas laterais e quem está escalado (na fase FINAL os titulares não estão
    // na lista lateral, que mostra só reservas e quem saiu).
    var jogadoresTooltip = new List<ControleFutebolWeb.Models.Jogador>();
    jogadoresTooltip.AddRange(Model.JogadoresCasa);
    jogadoresTooltip.AddRange(Model.JogadoresVisitante);
    foreach (var escalados in new[] { Model.EscalacoesCasa, Model.EscalacoesVisitante,
                                      Model.ReservasCasa, Model.ReservasVisitante })
    {
        jogadoresTooltip.AddRange(escalados.Where(e => e.Jogador != null).Select(e => e.Jogador!));
    }

    var dadosJogadores = jogadoresTooltip
        .GroupBy(j => j.Id)
        .ToDictionary(g => g.Key, g =>
        {
            var j = g.First();
            return new
            {
                id = j.Id,
                nome = j.NomeExibicao,
                foto = j.FotoUrl ?? "",
                posicao = j.Posicao ?? "",
                numero = j.NumeroCamisa,
                idade = j.Idade > 0 ? (int?)j.Idade : null,
                altura = j.Altura,
                peso = j.Peso,
                nac = j.Nacionalidade?.Nome ?? "",
                nacFlag = BandeiraTooltip(j),
                time = ClubeTooltip(j),
                timeEscudo = ClubeEscudoTooltip(j),
                gols = golsPorJogador.TryGetValue(j.Id, out var g1) ? g1 : 0,
                assists = assistsPorJogador.TryGetValue(j.Id, out var a1) ? a1 : 0,
                obs = j.Observacoes ?? "",
            };
        });

    // Abrevia a posição (pode ser composta: "Lateral Direito/Zagueiro" → "LD/ZAG")
    // e reconhece os nomes granulares vindos de PosicaoFormacao.
    string AbreviarPosicao(string? pos) => PosicaoJogadorHelper.Sigla(pos);

    // Coordenada em % para CSS/inputs: sempre com ponto decimal. Com a cultura
    // pt-BR do servidor, @esc.PosicaoX renderizava "10,5" — CSS inválido
    // (boneco fora do campo) e valor ambíguo no round-trip do form.
    string Coord(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Estatísticas da partida (posse, finalizações, etc.) — ver Jogo.EstatisticasJson
    Dictionary<string, string> statsCasa = new();
    Dictionary<string, string> statsVis = new();
    if (!string.IsNullOrWhiteSpace(Model.Jogo.EstatisticasJson))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.Jogo.EstatisticasJson);
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var timeId = item.GetProperty("TimeId").GetInt32();
                var stats = new Dictionary<string, string>();
                if (item.TryGetProperty("Stats", out var statsEl))
                {
                    foreach (var prop in statsEl.EnumerateObject())
                        stats[prop.Name] = prop.Value.ValueKind == JsonValueKind.Null
                            ? "0" : (prop.Value.GetString() ?? "0");
                }

                if (timeId == Model.Jogo.TimeCasa?.IdApi) statsCasa = stats;
                else if (timeId == Model.Jogo.TimeVisitante?.IdApi) statsVis = stats;
            }
        }
        catch { /* JSON inválido/antigo — ignora */ }
    }

    string PegarStat(Dictionary<string, string> stats, string chave) =>
        stats.TryGetValue(chave, out var v) ? v : "0";

    double PegarStatNumero(Dictionary<string, string> stats, string chave)
    {
        var raw = PegarStat(stats, chave).Replace("%", "").Trim();
        return double.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0;
    }

    var metricasEstatisticas = new List<(string label, string chave)>
    {
        ("xG (Gols Esperados)", "expected_goals"),
        ("Finalizações totais", "Total Shots"),
        ("Finalizações no gol", "Shots on Goal"),
        ("Finalizações para fora", "Shots off Goal"),
        ("Finalizações bloqueadas", "Blocked Shots"),
        ("Escanteios", "Corner Kicks"),
        ("Impedimentos", "Offsides"),
        ("Faltas", "Fouls"),
        ("Cartões amarelos", "Yellow Cards"),
        ("Cartões vermelhos", "Red Cards"),
        ("Defesas do goleiro", "Goalkeeper Saves"),
        ("Passes certos", "Passes accurate"),
        ("Precisão de passe", "Passes %"),
    };
}

@* O CSS desta tela (~66 KB) fica em wwwroot/css/analisar.css, carregado no head
   pela seção Styles: versionado por hash, o navegador baixa uma vez e reusa em
   todas as partidas — antes vinha inline e era retransmitido a cada abertura. *@
@section Styles {
    <link rel="stylesheet" href="~/css/mencao-jogador.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/jogadas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/analisar.css" asp-append-version="true" />
}

@* Tudo que o JS desta tela precisa do servidor, num objeto só. É a única parte
   que muda de partida para partida — o comportamento (~121 KB) mora em
   wwwroot/js/analisar.js, que o navegador baixa uma vez e reusa.
   O arquivo lê daqui e redeclara os nomes que o restante do código já usava. *@
<script>
    window.ANALISAR = {
        jogoId: @Model.Jogo.Id,
        temporada: @Model.Jogo.Temporada,
        timeCasaId: @Model.Jogo.TimeCasaId,
        timeVisitanteId: @Model.Jogo.TimeVisitanteId,
        timeCasaNome: '@Model.Jogo.TimeCasa?.Nome',
        timeVisitanteNome: '@Model.Jogo.TimeVisitante?.Nome',
        placarCasaInicial: @(Model.Jogo.PlacarCasa?.ToString() ?? "null"),
        placarVisitanteInicial: @(Model.Jogo.PlacarVisitante?.ToString() ?? "null"),
        faseEscalacaoAtual: '@faseAtual',
        camisas: {
            casa: '@Url.Content(CamisaHelper.ObterCamisa(Model.Jogo, Model.Jogo.TimeCasa))',
            vis: '@Url.Content(CamisaHelper.ObterCamisa(Model.Jogo, Model.Jogo.TimeVisitante))'
        },
        jogadoresEscalados: @Html.Raw(JsonSerializer.Serialize(
            Model.JogadoresEscalados.Select(j => new { id = j.Id, nome = j.NomeExibicao }))),
        jogadoresCasa: @Html.Raw(JsonSerializer.Serialize(
            Model.JogadoresCasa.Select(j => new { id = j.Id, nome = j.Nome }))),
        jogadoresVisitante: @Html.Raw(JsonSerializer.Serialize(
            Model.JogadoresVisitante.Select(j => new { id = j.Id, nome = j.Nome }))),
        @* { escalacaoId: [{id, x, y}, ...] } — coordenadas das setas em % do campo. *@
        setas: @Html.Raw(JsonSerializer.Serialize(
            Model.EscalacoesCasa
                .Concat(Model.EscalacoesVisitante)
                .Where(e => e.Setas.Any())
                .ToDictionary(
                    e => e.Id.ToString(),
                    e => e.Setas.Select(s => new { id = s.Id, x = s.X, y = s.Y }).ToList()))),
        @* Tooltip de info do jogador: dados, médias por jogo e jogos como titular. *@
        dadosJogadores: @Html.Raw(JsonSerializer.Serialize(
            dadosJogadores,
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })),
        medias: @Html.Raw(JsonSerializer.Serialize(
            Model.MediasPorJogador,
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })),
        @* Temporada aplicada aos números do tooltip (0 = todas) — seletor "ℹ tooltip". *@
        temporadaTooltip: @Model.TemporadaTooltip,
        titularCompeticao: @Html.Raw(JsonSerializer.Serialize(Model.TitularPorJogador)),
        golsTemporada: @Html.Raw(JsonSerializer.Serialize(Model.GolsTemporadaPorJogador)),
        assistsTemporada: @Html.Raw(JsonSerializer.Serialize(Model.AssistsTemporadaPorJogador)),
        titularTemporada: @Html.Raw(JsonSerializer.Serialize(Model.TitularTemporadaPorJogador)),
        @* Clube da temporada anterior (só para quem chegou depois) — linha "Vinha do". *@
        timeAnterior: @Html.Raw(JsonSerializer.Serialize(
            Model.TimeAnteriorPorJogador,
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))
    };
</script>

<div id="jogador-tooltip"></div>

<div class="an-root">
@* Só as cores de camisa continuam inline: dependem do jogo. *@
<style>
    :root {
        --cor-camisa-casa: #@(string.IsNullOrWhiteSpace(Model.Jogo.CorCamisaCasa) ? "dc3545" : Model.Jogo.CorCamisaCasa);
        --cor-numero-casa: #@(string.IsNullOrWhiteSpace(Model.Jogo.CorNumeroCasa) ? "ffffff" : Model.Jogo.CorNumeroCasa);
        --cor-camisa-vis:  #@(string.IsNullOrWhiteSpace(Model.Jogo.CorCamisaVisitante) ? "0d6efd" : Model.Jogo.CorCamisaVisitante);
        --cor-numero-vis:  #@(string.IsNullOrWhiteSpace(Model.Jogo.CorNumeroVisitante) ? "ffffff" : Model.Jogo.CorNumeroVisitante);
    }
</style>

@if (Model.Jogo.CompeticaoId == 1)
{
    <div class="cf-comp-hero theme-dark-zone">
        <div class="cf-comp-hero-content">
            <span class="cf-comp-badge">Competição nacional</span>
            <div class="cf-comp-title-wrap">
                <img src="~/images/background/campeonatobrasileiro.png" alt="Escudo Campeonato Brasileiro" class="cf-comp-logo" />
                <h2 class="cf-comp-title">Campeonato Brasileiro</h2>
            </div>
            <p class="cf-comp-sub">Análise tática da partida com foco em escalação inicial e final.</p>
        </div>
    </div>
}


<!-- ══ PLACAR BOARD ══════════════════════════════════════════════════════ -->
<div class="match-board theme-dark-zone">
    <div class="mb-scoreline">
        <!-- Time Casa -->
        <div class="mb-team home">
            <a class="mb-team-link" href="@Url.Action("Details", "Times", new { id = Model.Jogo.TimeCasaId })" title="Ver perfil de @Model.Jogo.TimeCasa?.Nome">
                @if (!string.IsNullOrEmpty(Model.Jogo.TimeCasa?.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeCasa.EscudoUrl })" alt="@Model.Jogo.TimeCasa.Nome" />
                }
                <span class="mb-team-name">@Model.Jogo.TimeCasa?.Nome</span>
            </a>
        </div>

        <!-- Placar -->
        <div class="mb-score">
            <div class="mb-score-box" id="placarCasaBox"
                 title="Clique para editar"
                 onclick="editarPlacar()">
                @(Model.Jogo.PlacarCasa?.ToString() ?? "–")
            </div>
            <span class="mb-score-sep">×</span>
            <div class="mb-score-box" id="placarVisBox"
                 title="Clique para editar"
                 onclick="editarPlacar()">
                @(Model.Jogo.PlacarVisitante?.ToString() ?? "–")
            </div>
        </div>

        <!-- Time Visitante -->
        <div class="mb-team away">
            <a class="mb-team-link" href="@Url.Action("Details", "Times", new { id = Model.Jogo.TimeVisitanteId })" title="Ver perfil de @Model.Jogo.TimeVisitante?.Nome">
                @if (!string.IsNullOrEmpty(Model.Jogo.TimeVisitante?.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Jogo.TimeVisitante.EscudoUrl })" alt="@Model.Jogo.TimeVisitante.Nome" />
                }
                <span class="mb-team-name">@Model.Jogo.TimeVisitante?.Nome</span>
            </a>
        </div>
    </div>

    @if (Model.Jogo.PenaltisCasa.HasValue && Model.Jogo.PenaltisVisitante.HasValue)
    {
        var casaVenceuPen = Model.Jogo.PenaltisCasa > Model.Jogo.PenaltisVisitante;
        var vencedorPen = casaVenceuPen ? Model.Jogo.TimeCasa?.Nome : Model.Jogo.TimeVisitante?.Nome;
        <div class="mb-pen-result">
            <span class="mb-pen-score">@Model.Jogo.PenaltisCasa - @Model.Jogo.PenaltisVisitante nos pênaltis</span>
            <span class="mb-pen-winner">@vencedorPen avançou</span>
        </div>
    }

    <!-- Disputa de pênaltis (preenchida via JS quando houver) -->
    <div class="mb-penaltis" id="mbPenaltis" style="display:none;"></div>

    @if (!string.IsNullOrWhiteSpace(Model.Jogo.Estadio) || !string.IsNullOrWhiteSpace(Model.Jogo.Arbitro))
    {
        <div class="mb-meta">
            @if (!string.IsNullOrWhiteSpace(Model.Jogo.Estadio))
            {
                <span class="mb-meta-item">
                    <span class="mb-meta-icon">🏟️</span>
                    <span>@Model.Jogo.Estadio</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Jogo.Arbitro))
            {
                <span class="mb-meta-item">
                    <span class="mb-meta-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle">
                            <!-- cabeça -->
                            <circle cx="12" cy="5.5" r="3" fill="rgba(255,255,255,0.85)"/>
                            <!-- corpo listrado preto e branco (árbitro) -->
                            <path d="M7 10 Q7 8.5 12 8.5 Q17 8.5 17 10 L17 18 Q17 19 16 19 L8 19 Q7 19 7 18 Z" fill="rgba(255,255,255,0.85)"/>
                            <rect x="7" y="11.5" width="10" height="2" fill="rgba(0,0,0,0.45)"/>
                            <rect x="7" y="15" width="10" height="2" fill="rgba(0,0,0,0.45)"/>
                            <!-- pernas -->
                            <path d="M9 19 L8.5 23 L10.5 23 L12 20.5 L13.5 23 L15.5 23 L15 19 Z" fill="rgba(255,255,255,0.85)"/>
                        </svg>
                    </span>
                    <span>@Model.Jogo.Arbitro</span>
                </span>
            }
        </div>
    }

    <!-- Timeline de gols (sempre visível) -->
    <div class="mb-timeline" id="mbTimelineGols"></div>

    <!-- Barra de ações: três botões lado a lado -->
    <div style="display:flex; gap:8px; justify-content:center; margin-top:.9rem; flex-wrap:wrap;">
        <div class="mb-toolbar-toggle" id="mbToolbarToggle" onclick="toggleToolbarEventos()" style="margin:0;">
            <span>➕ Adicionar evento</span>
            <span id="mbToolbarToggleIcon" style="transition:transform .15s;">▾</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbOutrosToggle" onclick="toggleOutrosEventos()" style="margin:0;">
            <span>📋 Outros eventos</span>
            <span id="mbOutrosToggleIcon" style="transition:transform .15s;">▾</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbEstatisticasToggle" onclick="toggleEstatisticasPanel()" style="margin:0;">
            <span>📊 Estatísticas</span>
            <span id="mbEstatisticasToggleIcon" style="transition:transform .15s;">▾</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbH2HToggle" onclick="abrirH2H(@Model.Jogo.Id)" style="margin:0; cursor:pointer;">
            <span>⚔️ Últimos confrontos</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbPreJogoToggle" onclick="abrirPreJogo(@Model.Jogo.Id)" style="margin:0; cursor:pointer;">
            <span>🔍 Pré-jogo</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbPosJogoToggle" onclick="abrirPosJogo(@Model.Jogo.Id)" style="margin:0; cursor:pointer;">
            <span>📝 Pós-jogo</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbCompartilharToggle" onclick="abrirCompartilhar(@Model.Jogo.Id)" style="margin:0; cursor:pointer;"
             title="Gera um link público, somente leitura, para mostrar esta análise a quem não tem conta no sistema">
            <span>🔗 Compartilhar</span>
        </div>
        <div class="mb-toolbar-toggle" id="mbJogadasToggle" onclick="Jogadas.abrirModal(@Model.Jogo.Id)" style="margin:0; cursor:pointer;"
             title="Prancheta tática: desenhe passo a passo as jogadas de cada time e reproduza a animação">
            <span>🎬 Jogadas</span>
        </div>
    </div>

    <div class="mb-toolbar" id="mbToolbar" style="display:none;">
        <button type="button" class="mb-btn gol"
                onclick="abrirModalEvento('gol', 'casa')">
            ⚽ Gol Mandante
        </button>
        <button type="button" class="mb-btn gol"
                onclick="abrirModalEvento('gol', 'vis')">
            ⚽ Gol Visitante
        </button>
        <button type="button" class="mb-btn cartao-amarelo"
                onclick="abrirModalEvento('amarelo', 'casa')">
            🟨 Cartão Casa
        </button>
        <button type="button" class="mb-btn cartao-amarelo"
                onclick="abrirModalEvento('amarelo', 'vis')">
            🟨 Cartão Visit.
        </button>
        <button type="button" class="mb-btn cartao-vermelho"
                onclick="abrirModalEvento('vermelho', 'casa')">
            🟥 Vermelho Casa
        </button>
        <button type="button" class="mb-btn cartao-vermelho"
                onclick="abrirModalEvento('vermelho', 'vis')">
            🟥 Vermelho Visit.
        </button>
    </div>

    <div class="mb-timeline" id="mbTimelineOutros" style="display:none;"></div>

</div>

<!-- ── Status de Análise ───────────────────────────────────────────── -->
<div style="display:flex; align-items:center; gap:12px; margin-bottom:1rem; flex-wrap:wrap;
            padding:.85rem 1.2rem; background:var(--p-1); border:1px solid var(--line);
            border-radius:12px;">
    <div style="display:flex; align-items:center; gap:10px; flex:1;">
        <div id="statusIcon" style="width:36px; height:36px; border-radius:50%;
             display:flex; align-items:center; justify-content:center; font-size:18px;
             background:@(Model.Analisado ? "rgba(34,197,94,0.12)" : "rgba(255,255,255,0.06)");
             border:2px solid @(Model.Analisado ? "#22c55e" : "var(--line)");">
            @(Model.Analisado ? "✅" : "⏳")
        </div>
        <div>
            <div id="statusLabel" style="font-size:13px; font-weight:600;
                 color:@(Model.Analisado ? "var(--ok)" : "var(--text-muted)");">
                @(Model.Analisado ? "Jogo analisado" : "Aguardando análise")
            </div>
            <div style="font-size:11px; color:var(--text-dim)">
                Marque como analisado após revisar escalação final e eventos
            </div>
        </div>
    </div>

    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;
                  padding:8px 14px; border-radius:8px; border:1px solid var(--line);
                  background:var(--p-2); user-select:none"
           title="Marcar/desmarcar jogo como analisado">
        <input type="checkbox"
               id="chkAnalisado"
               style="width:16px; height:16px; cursor:pointer; accent-color:#22c55e;"
               @(Model.Analisado ? "checked" : "")
               onchange="toggleAnalisado(this)" />
        <span style="font-size:13px; font-weight:500; color:var(--text-muted)">Marcar como analisado</span>
    </label>

    @if (!string.IsNullOrWhiteSpace(Model.Jogo.LinkDetalhes))
    {
        <form asp-action="ReimportarEscalacao" asp-controller="Jogos" asp-route-id="@Model.Jogo.Id"
              method="post" style="margin:0;"
              onsubmit="return confirm('Reimportar dados do jogo?\n\nIsso vai reimportar do zero a escalação (titulares/reservas), gols, cartões e assistências deste jogo, e recarregar a SUA escalação a partir da importação.\n\nSuas observações e notas já digitadas NÃO são alteradas.')">
            @Html.AntiForgeryToken()
            <button type="submit"
                    style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                           border-radius:8px; border:1px solid rgba(245,158,11,0.4); background:rgba(245,158,11,0.08);
                           color:var(--warn); font-size:13px; font-weight:500; cursor:pointer;
                           white-space:nowrap;"
                    title="Apaga e reimporta escalação, gols e cartões deste jogo (não mexe nas suas observações)">
                🔄 Reimportar dados
            </button>
        </form>
    }

    @* Devolve o jogo à lista de Serviços › Jogos sem estatísticas, que só mostra jogo
       com algum bloco faltando — sem isso, uma importação ruim que preencheu os dois
       blocos tira o jogo de lá e não há mais como reimportar da ESPN. *@
    <form asp-action="LimparEstatisticas" asp-controller="Jogos" asp-route-id="@Model.Jogo.Id"
          method="post" style="margin:0;"
          onsubmit="return confirm('Limpar as estatísticas importadas deste jogo?\n\nApaga as estatísticas de time e as de cada jogador, e o jogo volta a aparecer em Serviços › Jogos sem estatísticas, para você reimportar da ESPN.\n\nSuas notas, observações, escalação, gols e cartões NÃO são alterados.')">
        @Html.AntiForgeryToken()
        <button type="submit"
                style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                       border-radius:8px; border:1px solid rgba(239,68,68,0.35); background:rgba(239,68,68,0.07);
                       color:var(--bad); font-size:13px; font-weight:500; cursor:pointer;
                       white-space:nowrap;"
                title="Apaga só as estatísticas importadas, para poder reimportar da ESPN (não mexe em notas, observações nem escalação)">
            🧹 Limpar estatísticas
        </button>
    </form>

    @* Primeiro plano B quando a api-football não trouxe a partida: a ESPN costuma ter
       o XI e as estatísticas de jogos que ela devolve vazios. Só aparece com a
       competição mapeada em ligas-espn.json (ver AnalisarViewModel.EspnDisponivel) —
       vem antes da "Última escalação" porque é dado de verdade, não chute. *@
    @if (Model.EspnDisponivel)
    {
        var espnRotulo = Model.EspnSoComplementos ? "📊 Completar pela ESPN" : "🔎 Buscar ESPN";

        var espnTitulo = Model.EspnSoComplementos
            ? "A escalação já está importada — busca na ESPN as estatísticas e os lances que faltarem"
            : "A API não trouxe este jogo — busca escalação, estatísticas e lances na ESPN";

        @* Texto do confirm(): sem aspas simples, porque ele entra numa string JS
           delimitada por aspas simples dentro de um atributo delimitado por aspas
           duplas — escapar nos dois níveis só convida a erro. O \n vira a
           sequência de escape do JS, não uma quebra de linha de verdade: quebra real
           dentro da string invalida o handler inteiro. *@
        var espnConfirma = Model.EspnSoComplementos
            ? "Buscar na ESPN as estatísticas e os lances (gols, cartões, substituições) que faltarem neste jogo?\n\nA escalação NÃO é alterada, e nada que já esteja gravado é sobrescrito."
            : "Buscar este jogo na ESPN?\n\nTraz a escalação dos times que ainda não têm importação (substituindo o chute que está em campo, e a aba Final é remontada) e, se faltarem, as estatísticas e os lances da partida. O time que já veio da API não é tocado.\n\nSuas notas e observações não são alteradas.";

        <form asp-action="BuscarEscalacaoEspn" asp-controller="Jogos" asp-route-id="@Model.Jogo.Id"
              method="post" style="margin:0;"
              onsubmit="return confirm('@Html.Raw(espnConfirma)')">
            @Html.AntiForgeryToken()
            <button type="submit"
                    style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                           border-radius:8px; border:1px solid rgba(34,197,94,0.4); background:rgba(34,197,94,0.08);
                           color:var(--ok); font-size:13px; font-weight:500; cursor:pointer;
                           white-space:nowrap;"
                    title="@espnTitulo">
                @espnRotulo
            </button>
        </form>
    }

    @* Plano B do "Reimportar" quando a API ainda não tem a escalação do jogo:
       monta os dois times pela última escalação de cada um (ou pela escalação
       padrão do time / formação vazia) — tudo editável em campo. *@
    <form id="formUltimaEscalacao" asp-action="AplicarUltimaEscalacao" asp-controller="Jogos" asp-route-id="@Model.Jogo.Id"
          asp-route-faseEscalacao="@faseAtual" method="post" style="margin:0;"
          onsubmit="return confirm('Carregar a última escalação dos dois times?\n\nUsa a escalação do último jogo de cada time (ou a escalação padrão do time, se ele não tiver jogo anterior).\n\nIsso SUBSTITUI a escalação que você tem nesta aba — os eventos e observações do jogo não são alterados.')">
        @Html.AntiForgeryToken()
        <button type="submit"
                style="display:flex; align-items:center; gap:6px; padding:8px 14px;
                       border-radius:8px; border:1px solid rgba(59,130,246,0.4); background:rgba(59,130,246,0.08);
                       color:var(--info); font-size:13px; font-weight:500; cursor:pointer;
                       white-space:nowrap;"
                title="Sem escalação importada? Traz a última escalação de cada time (ou a padrão do time) para você ajustar">
            👥 Última escalação
        </button>
    </form>


    @* --- Selo de origem da escalação -------------------------------------
       A escalação montada pela "última escalação" de cada time fica idêntica na
       tela à que veio importada. Este selo diz de onde veio a que está em campo,
       para o analista não descobrir no meio do jogo que estava errada.

       Compacto de propósito: o texto longo ocupava metade da barra de ações em
       toda partida, inclusive nas que estavam certas. O ícone dá o veredito de
       relance (logo da fonte = confiável, ✕ vermelho = confira) e o title traz a
       explicação inteira para quem parar o mouse em cima. *@
    @{
        var fonteCasa = Model.FonteEscalacaoCasa;
        var fonteVis = Model.FonteEscalacaoVisitante;
        var nomeCasa = Model.Jogo.TimeCasa?.Nome ?? "mandante";
        var nomeVis = Model.Jogo.TimeVisitante?.Nome ?? "visitante";

        // Um lado sem importação derruba o selo para alerta mesmo que o outro tenha
        // vindo da API: metade do campo continua sendo chute.
        var faltaAlgum = fonteCasa == null || fonteVis == null;
        var seloClasse = !faltaAlgum ? "ok" : (fonteCasa != null || fonteVis != null ? "parcial" : "alerta");

        string RotuloFonte(string? f) => f switch
        {
            FonteEscalacao.ApiFootball => "api-football",
            FonteEscalacao.Espn => "ESPN",
            FonteEscalacao.Transfermarkt => "Transfermarkt",
            _ => "nenhuma fonte",
        };

        // Logos das fontes. O arquivo pode não estar em wwwroot/Images/fontes/ (o
        // Transfermarkt não tem logo, e os outros dois dependem de alguém ter posto
        // lá), então a existência é conferida aqui e o selo cai no rótulo em texto —
        // resolver no servidor evita depender de onerror no <img>.
        string? LogoFonte(string? f)
        {
            var arquivo = f switch
            {
                FonteEscalacao.ApiFootball => "apisports.png",
                FonteEscalacao.Espn => "espn.png",
                _ => null,
            };
            if (arquivo == null) return null;

            var caminho = System.IO.Path.Combine(Env.WebRootPath, "Images", "fontes", arquivo);
            return System.IO.File.Exists(caminho) ? $"/Images/fontes/{arquivo}" : null;
        }

        var fontesUsadas = new[] { fonteCasa, fonteVis }
            .Where(f => f != null).Distinct().ToList();

        var seloTitulo = !faltaAlgum
            ? (fontesUsadas.Count == 1
                ? $"Escalação importada da {RotuloFonte(fonteCasa)}"
                : $"Escalação importada: {nomeCasa} da {RotuloFonte(fonteCasa)}, {nomeVis} da {RotuloFonte(fonteVis)}")
            : (fonteCasa != null || fonteVis != null)
                ? $"Escalação importada só do {(fonteCasa != null ? nomeCasa : nomeVis)} (da {RotuloFonte(fonteCasa ?? fonteVis)})"
                : "Escalação NÃO importada de nenhuma fonte";

        var seloSub = !faltaAlgum
            ? (Model.EscalacaoEditada
                ? "titulares alterados por você depois da importação"
                : "titulares e reservas vieram do próprio jogo")
            : (fonteCasa != null || fonteVis != null)
                ? $"a do {(fonteCasa != null ? nomeVis : nomeCasa)} veio da última escalação — confira"
                : "a da tela veio da última escalação de cada time — confira antes de analisar";
    }
    <div class="an-selo-esc @seloClasse" title="@seloTitulo — @seloSub">
        @if (faltaAlgum)
        {
            <span class="an-selo-esc-x" aria-hidden="true">✕</span>
        }
        @foreach (var f in fontesUsadas)
        {
            var logo = LogoFonte(f);
            if (logo != null)
            {
                <img class="an-selo-esc-logo" src="@logo" alt="@RotuloFonte(f)" />
            }
            else
            {
                <span class="an-selo-esc-fallback">@RotuloFonte(f)</span>
            }
        }
        <span class="visually-hidden">@seloTitulo — @seloSub</span>
    </div>
</div>

