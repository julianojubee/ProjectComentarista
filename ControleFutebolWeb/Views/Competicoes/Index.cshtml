@model IEnumerable<Competicao>
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models
@{
    ViewData["Title"] = "Competições";

    // Mesma regra de roteamento do menu do layout (CompeticaoRotaHelper).
    Func<Competicao, string> rotaCompeticao = comp => CompeticaoRotaHelper.Url(Url, comp.Id);

    // Competicao.Tipo é o FORMATO da competição (ver Create/Edit: PONTOS_CORRIDOS,
    // GRUPOS, MATA_MATA, JOGO_UNICO) — não uma classificação geográfica.
    static string ChaveTipo(string? tipoRaw) => (tipoRaw ?? "").Trim().ToUpperInvariant();
    static string LabelTipo(string chave) => chave switch
    {
        "MATA_MATA"       => "Mata-mata",
        "JOGO_UNICO"      => "Jogo único",
        "GRUPOS"          => "Grupos",
        "PONTOS_CORRIDOS" => "Pontos corridos",
        _                 => ""
    };

    var jogosPorCompeticao = ViewBag.JogosPorCompeticao as Dictionary<int, int> ?? new();
    var timesPorCompeticao = ViewBag.TimesPorCompeticao as Dictionary<int, int> ?? new();
    var topTierIds = (HashSet<int>)(ViewBag.TopTierIds ?? new HashSet<int>());
    var homeIds = (HashSet<int>)(ViewBag.HomeIds ?? new HashSet<int>());

    // Competições de teste (nome começando com "TESTE") ficam num bloco à parte, no fim
    static bool EhTeste(Competicao c) => (c.Nome ?? "").TrimStart().StartsWith("TESTE", StringComparison.OrdinalIgnoreCase);

    var todas = Model.OrderBy(c => c.Nome).ToList();
    var reais = todas.Where(c => !EhTeste(c)).ToList();
    var testes = todas.Where(EhTeste).ToList();

    var principais = reais.Where(c => topTierIds.Contains(c.Id)).ToList();
    var naHome = reais.Where(c => !topTierIds.Contains(c.Id) && homeIds.Contains(c.Id)).ToList();
    var porBloco = reais
        .Where(c => !topTierIds.Contains(c.Id) && !homeIds.Contains(c.Id))
        .GroupBy(c => RegiaoCompeticaoHelper.Bloco(c.Regiao))
        .OrderBy(g => RegiaoCompeticaoHelper.OrdemBloco(g.Key)).ThenBy(g => g.Key)
        .ToList();

    // Abas por formato: só os formatos que existem no cadastro
    var formatos = todas
        .GroupBy(c => ChaveTipo(c.Tipo))
        .Where(g => LabelTipo(g.Key) != "")
        .Select(g => (Chave: g.Key, Rotulo: LabelTipo(g.Key), Qtd: g.Count()))
        .OrderByDescending(f => f.Qtd)
        .ToList();

    int qtdHome = todas.Count(c => homeIds.Contains(c.Id));
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
    string Milhar(int n) => n.ToString("N0", ptBR);
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    .co, .co *, .co *::before, .co *::after { box-sizing: border-box; }

    .co {
        margin: 0 -12px;
        background: var(--p-0);
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        border-radius: 14px;
        overflow: hidden;
    }
    .co a { text-decoration: none; color: inherit; }
    .co :is(a, button, input, summary):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Cabeçalho compacto ── */
    .co-cab {
        padding: 1.5rem 2.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520;
        display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    }
    .co-cab h1 {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1;
    }
    .co-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.72); }
    .co-cab p strong { color: #f3d27a; font-weight: 700; }
    .co-cab-acoes { display: flex; align-items: center; gap: 8px; }
    .co .co-nova {
        display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 8px;
        background: #d4a520; color: #141414; font-size: .88rem; font-weight: 700; white-space: nowrap;
    }
    .co .co-nova:hover { background: #e2b532; color: #141414; }
    .co-cab .co-menu > summary {
        display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 8px; cursor: pointer;
        border: 1px solid rgba(255,255,255,.25); color: #e8edf5; font-size: .88rem; font-weight: 600;
    }
    .co-cab .co-menu > summary:hover { border-color: #d4a520; color: #f3d27a; }

    /* ── Menus (Mais / ⋯) ── */
    .co-menu { position: relative; }
    .co-menu > summary { list-style: none; }
    .co-menu > summary::-webkit-details-marker { display: none; }
    .co-menu:not([open]) .co-menu-lista { display: none; }
    .co-menu-lista {
        position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 220px;
        display: flex; flex-direction: column; padding: 6px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px; box-shadow: 0 10px 24px rgba(0,0,0,.18);
    }
    .co-menu-lista form { margin: 0; }
    .co .co-menu-item {
        display: block; width: 100%; text-align: left; padding: 8px 10px; border-radius: 7px; border: none;
        background: transparent; color: var(--text); font-family: inherit; font-size: .86rem; font-weight: 600; cursor: pointer;
    }
    .co .co-menu-item:hover { background: var(--p-4); color: var(--text-strong); }
    .co-menu-item small { display: block; font-weight: 400; color: var(--text-dim); font-size: .76rem; margin-top: 1px; }

    /* ── Busca e abas ── */
    .co-filtros {
        background: var(--p-1); border-bottom: 1px solid var(--line); padding: 14px 2.5rem;
        display: flex; align-items: center; gap: 10px 16px; flex-wrap: wrap;
    }
    .co-busca {
        flex: 1 1 220px; max-width: 320px; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px;
        color: var(--text); font-family: inherit; font-size: .86rem; padding: 8px 12px; outline: none;
    }
    .co-busca:focus { border-color: #d4a520; }
    .co-abas { display: flex; gap: 4px; flex-wrap: wrap; }
    .co-aba {
        padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent;
        color: var(--text-muted); font-family: inherit; font-size: .84rem; font-weight: 600; cursor: pointer;
    }
    .co-aba span { color: var(--text-dim); font-weight: 500; margin-left: 2px; }
    .co-aba:hover { color: var(--text-strong); }
    .co-aba[aria-pressed="true"] { background: var(--text-strong); border-color: var(--text-strong); color: var(--p-0); }
    .co-aba[aria-pressed="true"] span { color: inherit; opacity: .7; }

    /* ── Conteúdo ── */
    .co-main { padding: 24px 2.5rem 56px; max-width: 1500px; margin: 0 auto; }

    .co-alert {
        border-radius: 10px; padding: .8rem 1.1rem; margin-bottom: 1rem; font-size: .88rem;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    .co-alert-sucesso { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--ok); }
    .co-alert-erro { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: var(--bad); }
    .co-alert-close { background: none; border: none; color: inherit; font-size: 1rem; cursor: pointer; opacity: .7; }
    .co-alert-close:hover { opacity: 1; }

    .co-secao { margin-bottom: 32px; }
    .co-secao > h2, .co-testes > summary {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.35rem; font-weight: 700; color: var(--text-strong);
        margin: 0 0 12px; display: flex; align-items: baseline; gap: 8px;
    }
    .co-secao > h2 small, .co-testes > summary small { font-family: 'Barlow', Arial, sans-serif; font-size: .82rem; font-weight: 500; color: var(--text-dim); }
    .co-testes > summary { cursor: pointer; list-style: none; }
    .co-testes > summary::-webkit-details-marker { display: none; }
    .co-testes > summary::before { content: "▸"; font-size: .9rem; color: var(--text-dim); align-self: center; }
    .co-testes[open] > summary::before { content: "▾"; }

    .co-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }

    /* ── Card ── */
    .co-card {
        position: relative; display: flex; flex-direction: column; gap: 12px;
        background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 14px;
        scroll-margin-top: 90px;
    }
    .co-card:hover { border-color: var(--line-strong); background: var(--p-2); }
    .co-card:target { border-color: #d4a520; }
    .co-card-topo { display: flex; align-items: center; gap: 12px; }
    .co-logo {
        width: 44px; height: 44px; flex-shrink: 0; border-radius: 10px; background: #fff; padding: 4px;
        display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px rgba(0,0,0,.08);
    }
    .co-logo img { width: 100%; height: 100%; object-fit: contain; }
    .co-card-info { min-width: 0; }
    /* O link do nome cobre o card inteiro; as ações ficam por cima dele */
    .co .co-card-nome {
        font-size: .98rem; font-weight: 700; color: var(--text-strong); line-height: 1.2;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .co .co-card-nome::after { content: ""; position: absolute; inset: 0; border-radius: 12px; }
    .co .co-card:hover .co-card-nome { color: var(--gold-ink); }
    .co-card-sub { font-size: .8rem; color: var(--text-dim); margin-top: 2px; }
    .co-card-base {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        border-top: 1px solid var(--line-soft); padding-top: 10px;
    }
    .co-card-num { margin-top: 4px; font-size: .82rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
    .co-card-num strong { color: var(--text-strong); font-weight: 700; }
    .co-card-num.vazio { color: var(--text-dimmer); }
    .co-card-acoes { position: relative; z-index: 2; display: flex; align-items: center; gap: 2px; }
    /* Todas as barras de ação estão na camada 2, e o card seguinte vem depois no
       HTML: sem isto, o menu "⋯" aberto ficava por baixo do card de baixo. */
    .co-card-acoes:has(.co-menu[open]) { z-index: 40; }
    .co-card-acoes form { margin: 0; }
    .co .co-acao {
        display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; border-radius: 7px;
        border: 1px solid transparent; background: transparent; color: var(--text-muted);
        font-family: inherit; font-size: .8rem; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .co .co-acao:hover { border-color: var(--line-strong); color: var(--text-strong); background: var(--p-0); }
    .co .co-acao svg { flex-shrink: 0; }
    /* Liga/desliga: dourado quando ligado, apagado quando não */
    .co .co-toggle { color: var(--text-dimmer); }
    .co .co-toggle[aria-pressed="true"] { color: var(--gold-ink); background: rgba(212,165,32,.12); }
    .co .co-toggle[aria-pressed="true"] svg { fill: currentColor; }

    .co-vazio { padding: 40px 0; text-align: center; color: var(--text-dim); }

    /* ── Modais (Bootstrap) reskin dark ── */
    .co-modais .modal-content { background: var(--p-1); border: 1px solid var(--line); color: var(--text); }
    .co-modais .modal-header, .co-modais .modal-footer { border-color: var(--line); }
    .co-modais .modal-title { color: var(--text-strong); }
    .co-modais .form-control { background: var(--p-2); border-color: var(--line-strong); color: var(--text); }
    .co-modais .form-control:focus { background: var(--p-2); border-color: #d4a520; color: var(--text); box-shadow: none; }
    .co-modais .form-text { color: var(--text-dim); }
    .co-modais .btn-close { filter: invert(1); }

    @@media (max-width: 640px) {
        .co-cab, .co-filtros, .co-main { padding-left: 1rem; padding-right: 1rem; }
        .co-cab h1 { font-size: 2rem; }
        .co-busca { max-width: none; flex-basis: 100%; }
        .co-cab .co-menu-lista { right: auto; left: 0; }
        .co-grid { grid-template-columns: 1fr; }
    }
</style>

@{
    // Card de uma competição (mesmo desenho em todas as seções)
    async Task Card(Competicao comp)
    {
        var chaveTipo = ChaveTipo(comp.Tipo);
        var regiao = RegiaoCompeticaoHelper.Normalizar(comp.Regiao);
        var tipoTxt = LabelTipo(chaveTipo);
        var sub = string.Join(", ", new[] { regiao, tipoTxt.ToLowerInvariant() }.Where(s => s != ""));
        if (sub.Length > 0) sub = char.ToUpper(sub[0]) + sub[1..];
        var jogos = jogosPorCompeticao.TryGetValue(comp.Id, out var j) ? j : 0;
        var times = timesPorCompeticao.TryGetValue(comp.Id, out var t) ? t : 0;
        var principal = topTierIds.Contains(comp.Id);
        var home = homeIds.Contains(comp.Id);

        <article class="co-card" id="comp-@comp.Id" data-nome="@comp.Nome" data-tipo="@chaveTipo">
            <div class="co-card-topo">
                <div class="co-logo">
                    <img src="@CompeticaoHelper.GetLogoCompeticao(comp.Id, comp.LogoUrl)" alt="" loading="lazy" />
                </div>
                <div class="co-card-info">
                    <a href="@rotaCompeticao(comp)" class="co-card-nome" title="@comp.Nome">@comp.Nome</a>
                    @if (sub.Length > 0)
                    {
                        <div class="co-card-sub">@sub</div>
                    }
                    @if (jogos == 0)
                    {
                        <div class="co-card-num vazio">Sem jogos importados</div>
                    }
                    else
                    {
                        <div class="co-card-num"><strong>@times</strong> times, <strong>@Milhar(jogos)</strong> jogos</div>
                    }
                </div>
            </div>
            <div class="co-card-base">
                <div class="co-card-acoes">
                    <form asp-action="ToggleTopTier" asp-route-id="@comp.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="co-acao co-toggle" aria-pressed="@(principal ? "true" : "false")"
                                title="@(principal ? "Tirar dos principais" : "Marcar como principal (aparece no menu e no topo desta lista)")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                            <span>Principal</span>
                        </button>
                    </form>
                    <form asp-action="ToggleHome" asp-route-id="@comp.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="co-acao co-toggle" aria-pressed="@(home ? "true" : "false")"
                                title="@(home ? "Tirar da tabela da home" : "Mostrar na tabela da home")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
                            <span>Home</span>
                        </button>
                    </form>
                </div>
                <div class="co-card-acoes">
                    <a asp-action="Edit" asp-route-id="@comp.Id" class="co-acao">Editar</a>
                    <details class="co-menu">
                        <summary class="co-acao" aria-label="Mais ações para @comp.Nome" title="Mais ações">⋯</summary>
                        <div class="co-menu-lista">
                            <button type="button" class="co-menu-item" data-bs-toggle="modal" data-bs-target="#linkModal-@comp.Id">
                                Link de importação
                                <small>@(string.IsNullOrWhiteSpace(comp.LinkTransfermarket) ? "Nenhum link informado" : "Trocar o link atual")</small>
                            </button>
                            <button type="button" class="co-menu-item" data-bs-toggle="modal" data-bs-target="#logoModal-@comp.Id">Trocar escudo</button>
                            @if (!string.IsNullOrWhiteSpace(comp.LinkTransfermarket))
                            {
                                <form asp-action="BuscarJogos" asp-route-id="@comp.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="co-menu-item"
                                            onclick="this.disabled=true; this.firstChild.textContent='Buscando jogos...'; this.form.submit();">Buscar jogos<small>Importa os jogos pelo link</small></button>
                                </form>
                            }
                        </div>
                    </details>
                </div>
            </div>
        </article>
    }

    async Task Secao(string titulo, string? nota, IEnumerable<Competicao> comps)
    {
        var lista = comps.ToList();
        <section class="co-secao" data-secao>
            <h2>@titulo <small>@(nota ?? lista.Count.ToString())</small></h2>
            <div class="co-grid">
                @foreach (var c in lista) { await Card(c); }
            </div>
        </section>
    }
}

<div class="co">
    <div class="co-cab theme-dark-zone">
        <div>
            <h1>Competições</h1>
            <p>
                <strong>@todas.Count</strong> cadastradas,
                @if (qtdHome == 0)
                {
                    <text>nenhuma na tabela da home ainda</text>
                }
                else
                {
                    <strong>@qtdHome</strong> <text>na tabela da home</text>
                }
            </p>
        </div>
        <div class="co-cab-acoes">
            <details class="co-menu">
                <summary>Mais</summary>
                <div class="co-menu-lista">
                    <a asp-action="CompeticoesApi" class="co-menu-item">
                        Catálogo da api-football
                        <small>Ligas da temporada com o código para cadastro</small>
                    </a>
                    <form asp-action="SincronizarEscudos" method="post"
                          onsubmit="return confirm('Substituir o escudo de todas as competições com link da API pelo escudo publicado pela api-football?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="co-menu-item">
                            Sincronizar escudos
                            <small>Usa o escudo da api-football em todas com link da API</small>
                        </button>
                    </form>
                </div>
            </details>
            <a asp-action="Create" class="co-nova">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Nova competição
            </a>
        </div>
    </div>

    <div class="co-filtros">
        <label for="coBusca" class="visually-hidden">Buscar competição</label>
        <input type="search" id="coBusca" class="co-busca" placeholder="Buscar competição" autocomplete="off" />
        @if (formatos.Count > 1)
        {
            <div class="co-abas" role="group" aria-label="Formato">
                <button type="button" class="co-aba" data-tipo="" aria-pressed="true">Todas <span>@todas.Count</span></button>
                @foreach (var f in formatos)
                {
                    <button type="button" class="co-aba" data-tipo="@f.Chave" aria-pressed="false">@f.Rotulo <span>@f.Qtd</span></button>
                }
            </div>
        }
    </div>

    <div class="co-main">
        @if (TempData["Sucesso"] != null)
        {
            <div class="co-alert co-alert-sucesso" role="status">
                <span>@TempData["Sucesso"]</span>
                <button type="button" class="co-alert-close" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="co-alert co-alert-erro" role="alert">
                <span>@TempData["Erro"]</span>
                <button type="button" class="co-alert-close" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button>
            </div>
        }

        @if (!todas.Any())
        {
            <div class="co-vazio">
                Nenhuma competição cadastrada. Crie a primeira em <a asp-action="Create">Nova competição</a>
                ou veja o <a asp-action="CompeticoesApi">catálogo da api-football</a>.
            </div>
        }

        @if (principais.Any())
        {
            await Secao("Principais", null, principais);
        }
        @if (naHome.Any())
        {
            await Secao("Na tabela da home", null, naHome);
        }
        @foreach (var bloco in porBloco)
        {
            await Secao(bloco.Key, null, bloco);
        }
        @if (testes.Any())
        {
            <details class="co-testes co-secao" data-secao>
                <summary>Testes <small>@testes.Count</small></summary>
                <div class="co-grid">
                    @foreach (var c in testes) { await Card(c); }
                </div>
            </details>
        }

        <p class="co-vazio" id="coSemResultado" hidden>Nenhuma competição encontrada. Tente outro nome ou volte para "Todas".</p>
    </div>
</div>

<div class="co-modais">
    @foreach (var comp in todas)
    {
        @await Html.PartialAsync("_CompeticaoModais", comp)
    }
</div>

@section Scripts {
    <script>
        (function () {
            var busca = document.getElementById('coBusca');
            var abas = document.querySelectorAll('.co-aba');
            var semResultado = document.getElementById('coSemResultado');
            var tipoAtual = '';

            function normalizar(s) {
                return (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
            }

            function filtrar() {
                var termo = normalizar(busca.value);
                var filtrando = termo !== '' || tipoAtual !== '';
                var total = 0;
                document.querySelectorAll('[data-secao]').forEach(function (secao) {
                    var visiveis = 0;
                    secao.querySelectorAll('.co-card').forEach(function (card) {
                        var ok = (termo === '' || normalizar(card.dataset.nome).indexOf(termo) !== -1)
                            && (tipoAtual === '' || card.dataset.tipo === tipoAtual);
                        card.hidden = !ok;
                        if (ok) visiveis++;
                    });
                    secao.hidden = visiveis === 0;
                    // Busca ou filtro ativo abre o bloco de testes se ele tiver resultado
                    if (secao.tagName === 'DETAILS' && filtrando && visiveis > 0) secao.open = true;
                    total += visiveis;
                });
                semResultado.hidden = total > 0;
            }

            busca.addEventListener('input', filtrar);
            abas.forEach(function (aba) {
                aba.addEventListener('click', function () {
                    tipoAtual = aba.dataset.tipo;
                    abas.forEach(function (a) { a.setAttribute('aria-pressed', a === aba ? 'true' : 'false'); });
                    filtrar();
                });
            });

            // Fecha os menus (Mais / ⋯) ao clicar fora ou com Esc
            document.addEventListener('click', function (e) {
                document.querySelectorAll('.co-menu[open]').forEach(function (m) { if (!m.contains(e.target)) m.open = false; });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') document.querySelectorAll('.co-menu[open]').forEach(function (m) { m.open = false; });
            });
            // Abrir um modal a partir do menu fecha o menu
            document.querySelectorAll('.co-menu [data-bs-toggle="modal"]').forEach(function (b) {
                b.addEventListener('click', function () { var m = b.closest('.co-menu'); if (m) m.open = false; });
            });
        })();
    </script>
}
