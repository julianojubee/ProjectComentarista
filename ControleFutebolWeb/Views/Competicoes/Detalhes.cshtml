@model ControleFutebolWeb.Models.ViewModels.CompeticaoDetalhesViewModel
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Controllers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = Model.Competicao.Nome;
    var semJogos = !Model.Competicao.Jogos.Any();
    var temApiLink = Model.Competicao.LinkTransfermarket?.StartsWith("apifoot:") == true;

    var tipoNorm = (Model.Tipo ?? "").Trim().ToUpperInvariant();
    var (heroGrad, accent, tipoLabel) = tipoNorm switch
    {
        "GRUPOS"    => ("linear-gradient(135deg,#060d1a 0%,#0d1e35 55%,#060d1a 100%)", "#3b82f6", "Grupos"),
        "MATA_MATA" => ("linear-gradient(135deg,#1a1200 0%,#2a1e00 55%,#1a1200 100%)", "#d4a520", "Mata-Mata"),
        "JOGO_UNICO" => ("linear-gradient(135deg,#1a0012 0%,#2a0020 55%,#1a0012 100%)", "#c026d3", "Jogo Único"),
        _           => ("linear-gradient(135deg,#0a1200 0%,#152000 55%,#0a1200 100%)", "#22c55e", "Pontos Corridos"),
    };

    var temporadasDet = ViewBag.TemporadasDisponiveis as List<int> ?? new List<int>();
    var temporadaDetSel = ViewBag.Temporada as int?;
    var totalTimes = (int)(ViewBag.TotalTimes ?? 0);
    var totalGolsComp = (int)(ViewBag.TotalGols ?? 0);
    var artilheiros = ViewBag.Artilheiros as List<ArtilheiroViewModel> ?? new();

    // Fases declaradas na competição (grupos + mata-mata, liga + playoffs...):
    // quando existem, cada fase vira uma aba própria e os painéis por Tipo não são usados.
    var temFases = Model.Fases.Any();

    // Com fases declaradas, o controller ainda soma as fases não-eliminatórias numa tabela
    // acumulada (ex.: Apertura + Clausura = tabela anual do Argentino) — ela vira a 1ª aba.
    var temTabelaGeral = temFases && Model.Classificacao.Any();

    // Aba inicial: tabela geral, senão a primeira fase declarada, senão o painel do tipo
    string tabInicial = temTabelaGeral
        ? "classif"
        : temFases
        ? $"fase-{Model.Fases[0].Fase.Id}"
        : tipoNorm switch
        {
            "GRUPOS"     => "grupos",
            "MATA_MATA"  => "bracket",
            "JOGO_UNICO" => "bracket",
            _            => "classif",
        };

    string IconeFase(string tipoFase) => tipoFase switch
    {
        "GRUPOS"     => "🔢",
        "MATA_MATA"  => "⚔️",
        "JOGO_UNICO" => "🏆",
        _            => "📊",
    };

    // Competição decidida em partida única: só existe o painel do confronto.
    var ehJogoUnico = tipoNorm == "JOGO_UNICO";
}

<style>
    .cd-root, .cd-root *, .cd-root *::before, .cd-root *::after { box-sizing: border-box; }
    .cd-root { margin: 0 -12px; background: var(--p-0); border-radius: 14px; overflow: hidden; color: var(--text); font-family: 'Barlow', Arial, sans-serif; }
    .cd-root a { text-decoration: none; color: inherit; }

    /* ── Hero ── */
    .cd-hero { position: relative; overflow: hidden; background: @heroGrad; padding: 38px 2.5rem 32px; }
    .cd-hero-pattern { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.05; pointer-events: none; }
    .cd-hero-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: @accent; }
    .cd-hero-fade { position: absolute; bottom: 0; left: 0; right: 0; height: 60px; background: linear-gradient(to top, var(--page-bg), transparent); pointer-events: none; }
    .cd-hero-inner { position: relative; z-index: 1; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .cd-hero-icon { width: 64px; height: 64px; border-radius: 50%; background: rgba(255,255,255,.08); border: 2px solid @(accent)48; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
    .cd-hero-icon img { width: 78%; height: 78%; object-fit: contain; }
    .cd-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .cd-kicker-line { height: 2px; width: 24px; background: @accent; }
    .cd-kicker span { font-size: .65rem; font-weight: 700; letter-spacing: .24em; color: @accent; text-transform: uppercase; }
    .cd-hero h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 3rem; font-weight: 800; color: var(--text-strong); margin: 0 0 6px; line-height: 1; }
    .cd-hero-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .cd-hero-temporada { display: flex; align-items: center; gap: 6px; }
    .cd-hero-temporada select { appearance: none; padding: 5px 10px; border-radius: 7px; border: 1px solid var(--line-strong); background: var(--p-2); color: var(--text-muted); font-size: .8rem; font-weight: 600; cursor: pointer; }
    .cd-pill { font-size: .75rem; padding: 4px 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; color: var(--text-muted); font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; }
    .cd-pill:hover { border-color: @accent; color: @accent; }
    .cd-pill-accent { background: @(accent)1a; border-color: @(accent)48; color: @accent; }
    .cd-pill-accent:hover { background: @(accent)33; }

    .cd-stats { display: flex; gap: 20px; flex-shrink: 0; padding: 14px 20px; background: rgba(0,0,0,0.3); border: 1px solid @(accent)4d; border-radius: 10px; margin-left: auto; }
    .cd-stat { text-align: center; }
    .cd-stat .val { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.6rem; font-weight: 800; color: @accent; line-height: 1; }
    .cd-stat .lbl { font-size: .58rem; color: var(--text-dimmer); text-transform: uppercase; letter-spacing: .08em; margin-top: 2px; }
    .cd-stat-sep { width: 1px; background: @(accent)4d; align-self: stretch; }

    /* ── Tabs ── */
    .cd-tabs { background: var(--p-0); border-bottom: 1px solid var(--line-soft); padding: 0 2.5rem; position: sticky; top: 0; z-index: 50; display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .cd-tab-btn { padding: 14px 18px; background: transparent; border: none; cursor: pointer; font-size: .82rem; font-weight: 600; color: var(--text-dim); border-bottom: 2px solid transparent; white-space: nowrap; transition: color .15s, border-color .15s; font-family: inherit; flex-shrink: 0; }
    .cd-tab-btn.active { font-weight: 700; color: @accent; border-bottom-color: @accent; }

    /* ── Conteúdo ── */
    .cd-content { padding: 24px 2.5rem 64px; max-width: 1500px; margin: 0 auto; }
    .cd-layout { display: grid; grid-template-columns: 1fr 290px; gap: 24px; align-items: start; }
    @@media (max-width: 1000px) { .cd-layout { grid-template-columns: 1fr; } }

    /* ── Tabela classificação ── */
    .cd-tablewrap { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .cd-cols { display: grid; grid-template-columns: 4px 36px 28px 1fr 36px 36px 36px 36px 36px 44px 60px 80px; gap: 4px; padding: 10px 14px; padding-left: 0; background: var(--p-0); border-bottom: 1px solid var(--line-soft); align-items: center; }
    .cd-cols span { font-size: .58rem; color: #374151; font-weight: 700; text-transform: uppercase; text-align: center; }
    .cd-cols span.left { text-align: left; }
    .cd-row { display: grid; grid-template-columns: 4px 36px 28px 1fr 36px 36px 36px 36px 36px 44px 60px 80px; gap: 4px; padding: 9px 14px; padding-left: 0; border-bottom: 1px solid var(--line-soft); align-items: center; transition: background .12s; }
    .cd-row:last-child { border-bottom: none; }
    .cd-row:hover { background: var(--p-2); }
    .cd-zonebar { width: 4px; height: 100%; align-self: stretch; flex-shrink: 0; }
    .cd-pos { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1rem; font-weight: 700; text-align: center; }
    .cd-escudo { width: 26px; height: 26px; border-radius: 50%; background: var(--p-0); border: 1px solid var(--line-strong); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
    .cd-escudo img { width: 90%; height: 90%; object-fit: contain; }
    .cd-nome { font-size: .86rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
    .cd-nome:hover { text-decoration: underline; }
    .cd-cell { font-size: .8rem; color: var(--text-muted); text-align: center; }
    .cd-cell.v { color: var(--ok-2); font-weight: 600; }
    .cd-cell.e { color: var(--warn); }
    .cd-cell.d { color: var(--bad-2); }
    .cd-sg { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .88rem; font-weight: 700; text-align: center; }
    .cd-aprov { display: flex; flex-direction: column; gap: 2px; align-items: center; }
    .cd-aprov span { font-size: .72rem; color: var(--text-muted); font-weight: 600; }
    .cd-aprov-bar { width: 40px; height: 3px; background: var(--p-3); border-radius: 2px; overflow: hidden; }
    .cd-aprov-bar div { height: 100%; border-radius: 2px; }
    .cd-pts { display: flex; align-items: center; justify-content: center; }
    .cd-pts span { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.05rem; font-weight: 900; padding: 2px 8px; border-radius: 6px; }
    .cd-legend { padding: 10px 18px; background: var(--p-0); border-top: 1px solid var(--line-soft); display: flex; gap: 14px; flex-wrap: wrap; }
    .cd-legend-item { display: flex; align-items: center; gap: 5px; }
    .cd-legend-dot { width: 10px; height: 3px; border-radius: 2px; }
    .cd-legend-item span { font-size: .62rem; color: var(--text-dimmer); font-weight: 600; }

    /* ── Sidebar ── */
    .cd-sidebar { display: flex; flex-direction: column; gap: 16px; }
    .cd-side-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .cd-side-header { padding: 12px 16px; background: var(--p-0); border-bottom: 1px solid var(--line-soft); }
    .cd-side-title { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .88rem; font-weight: 700; color: var(--text-strong); text-transform: uppercase; }
    .cd-mini-jogo { display: flex; align-items: center; gap: 8px; padding: 9px 14px; border-bottom: 1px solid var(--line-soft); }
    .cd-mini-jogo:last-child { border-bottom: none; }
    .cd-mini-jogo:hover { background: var(--p-3); }
    .cd-mini-lado { flex: 1; display: flex; align-items: center; gap: 5px; min-width: 0; }
    .cd-mini-lado.casa { justify-content: flex-end; }
    .cd-mini-lado span { font-size: .8rem; font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cd-mini-lado img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
    .cd-mini-hora { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .7rem; color: var(--text-dimmer); flex-shrink: 0; font-weight: 700; }
    .cd-artilheiro { display: flex; align-items: center; gap: 10px; padding: 9px 14px; border-bottom: 1px solid var(--line-soft); }
    .cd-artilheiro:last-child { border-bottom: none; }
    .cd-artilheiro:hover { background: var(--p-3); }
    .cd-art-rank { font-size: .72rem; font-weight: 700; width: 14px; text-align: center; flex-shrink: 0; }
    .cd-art-avatar { width: 28px; height: 28px; border-radius: 50%; background: #1e293b; border: 1px solid #2a3a52; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
    .cd-art-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .cd-art-nome { font-size: .82rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cd-art-clube { display: flex; align-items: center; gap: 4px; margin-top: 1px; }
    .cd-art-clube img { width: 12px; height: 12px; object-fit: contain; }
    .cd-art-clube span { font-size: .64rem; color: var(--text-dimmer); }
    /* Times da barra lateral levam à página do clube */
    a.cd-mini-lado, a.cd-art-clube, a.cd-art-nome { text-decoration: none; }
    a.cd-mini-lado:hover span, a.cd-art-clube:hover span { color: var(--gold-ink); text-decoration: underline; }
    a.cd-art-nome { display: block; }
    a.cd-art-nome:hover { color: var(--gold-ink); text-decoration: underline; }
    .cd-art-gols { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.05rem; font-weight: 800; color: var(--ok); flex-shrink: 0; }
    .cd-vazio { text-align: center; color: var(--text-dim); padding: 1.6rem 1rem; font-size: .8rem; }

    /* ── Grupos ── */
    .cd-grupos-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    @@media (max-width: 900px) { .cd-grupos-grid { grid-template-columns: 1fr; } }
    .cd-grupo-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .cd-grupo-header { padding: 12px 16px; background: var(--p-0); border-bottom: 1px solid var(--line-soft); display: flex; align-items: center; gap: 10px; }
    .cd-grupo-letra { min-width: 28px; height: 28px; padding: 0 6px; border-radius: 8px; background: @(accent)26; border: 1px solid @(accent)4d; display: flex; align-items: center; justify-content: center; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .9rem; font-weight: 800; color: @accent; white-space: nowrap; flex-shrink: 0; }
    .cd-grupo-nome { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .9rem; font-weight: 700; color: var(--text-strong); text-transform: uppercase; letter-spacing: .04em; }
    .cd-grupo-cols { display: grid; grid-template-columns: 24px 28px 1fr 28px 28px 28px 28px 36px; gap: 4px; padding: 8px 14px; background: var(--p-0); border-bottom: 1px solid var(--line-soft); align-items: center; }
    .cd-grupo-cols span { font-size: .56rem; color: #374151; font-weight: 700; text-align: center; }
    .cd-grupo-row { display: grid; grid-template-columns: 24px 28px 1fr 28px 28px 28px 28px 36px; gap: 4px; padding: 9px 14px; border-bottom: 1px solid var(--line-soft); align-items: center; transition: background .12s; }
    .cd-grupo-row:last-child { border-bottom: none; }
    .cd-grupo-row:hover { background: var(--p-3); }
    .cd-grupo-escudo { width: 24px; height: 24px; border-radius: 50%; background: var(--p-0); border: 1px solid var(--line-strong); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .cd-grupo-escudo img { width: 90%; height: 90%; object-fit: contain; }

    /* ── Mata-mata ── */
    .cd-mm-scroll { overflow-x: auto; padding-bottom: 16px; }
    .cd-mm-inner { display: flex; gap: 0; align-items: flex-start; min-width: max-content; }
    .cd-mm-fase-col { display: flex; gap: 0; align-items: flex-start; }
    .cd-mm-fase-wrap { width: 240px; flex-shrink: 0; }
    .cd-mm-fase-nome { text-align: center; padding: 10px 0 16px; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .82rem; font-weight: 800; color: @accent; text-transform: uppercase; letter-spacing: .1em; }
    .cd-mm-confrontos { display: flex; flex-direction: column; gap: 12px; padding: 0 12px; }
    .cd-mm-confronto { background: var(--p-1); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; transition: border-color .15s; }
    .cd-mm-confronto:hover { border-color: var(--line); }
    .cd-mm-time-row { padding: 9px 12px; display: flex; align-items: center; gap: 8px; }
    .cd-mm-time-row.top { border-bottom: 1px solid var(--line-soft); }
    .cd-mm-time-lado { flex: 1; display: flex; align-items: center; gap: 6px; min-width: 0; }
    .cd-mm-time-lado img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
    .cd-mm-time-lado span { font-size: .82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cd-mm-placar { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.1rem; font-weight: 800; flex-shrink: 0; }
    /* Times do chaveamento levam à página do clube */
    a.cd-mm-time-lado { text-decoration: none; }
    a.cd-mm-time-lado[href]:hover span { color: var(--gold-ink) !important; text-decoration: underline; }
    .cd-mm-classificado { padding: 5px 12px; background: rgba(34,197,94,0.08); border-top: 1px solid rgba(34,197,94,0.15); display: flex; align-items: center; gap: 5px; }
    .cd-mm-classificado span { font-size: .64rem; color: var(--ok); font-weight: 700; }
    .cd-mm-connector { width: 24px; flex-shrink: 0; align-self: stretch; position: relative; }
    .cd-mm-connector-arrow { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); color: #333; font-size: 14px; }
    .cd-mm-datas { padding: 5px 12px; background: rgba(0,0,0,.2); font-size: .62rem; color: var(--text-dimmer); display: flex; gap: 8px; }

    /* ── Jogos (lista full-width) ── */
    .cd-jogos-wrap { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .cd-jogos-cols { display: grid; grid-template-columns: 90px 110px 1fr 100px 1fr 140px; gap: 12px; padding: 10px 16px; background: var(--p-0); border-bottom: 1px solid var(--line-soft); }
    .cd-jogos-cols span { font-size: .6rem; color: #374151; font-weight: 700; text-transform: uppercase; }
    .cd-jogo-row { display: grid; grid-template-columns: 90px 110px 1fr 100px 1fr 140px; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line-soft); align-items: center; transition: background .12s; }
    .cd-jogo-row:last-child { border-bottom: none; }
    .cd-jogo-row:hover { background: var(--p-2); }
    .cd-jogo-row .data { font-size: .8rem; font-weight: 600; color: var(--text); }
    .cd-jogo-row .hora { font-size: .68rem; color: var(--text-dimmer); margin-top: 1px; }
    .cd-jogo-row .rodada { font-size: .78rem; color: var(--text-dim); font-weight: 600; }
    .cd-jogo-time { display: flex; align-items: center; gap: 7px; min-width: 0; }
    .cd-jogo-time img { width: 22px; height: 22px; object-fit: contain; flex-shrink: 0; }
    .cd-jogo-time span { font-size: .86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* Times das linhas de jogo levam à página do clube */
    a.cd-jogo-time { text-decoration: none; }
    a.cd-jogo-time:hover span { color: var(--gold-ink) !important; text-decoration: underline; }
    .cd-jogo-placar { text-align: center; }
    .cd-jogo-placar span { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text-strong); background: var(--p-0); padding: 2px 10px; border-radius: 6px; letter-spacing: .06em; }
    .cd-jogo-pen { font-size: .62rem; color: var(--text-dim); display: block; margin-top: 2px; text-align: center; }
    .cd-jogo-acao { display: flex; gap: 6px; justify-content: flex-end; }
    .cd-btn-analisar { font-size: .68rem; padding: 4px 10px; background: transparent; border: 1px solid #3b82f6; border-radius: 6px; color: var(--info); font-weight: 700; }
    .cd-btn-analisar:hover { background: rgba(59,130,246,0.1); }

    .cd-sem-dados { text-align: center; padding: 3rem 1rem; color: var(--text-dim); }
    .cd-sem-dados .icon { font-size: 2.5rem; margin-bottom: .8rem; }
    .cd-sem-dados p { font-size: .9rem; margin: 0; }

    .cd-alert { border-radius: 10px; padding: .8rem 1.1rem; margin: 0 2.5rem 1rem; font-size: .88rem; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--ok); }

    /* ── Responsivo ── */
    @@media (max-width: 768px) {
        .cd-hero { padding: 26px 1.1rem 22px; }
        .cd-hero h1 { font-size: 1.9rem; }
        .cd-hero-inner { gap: 14px; }
        .cd-stats { margin-left: 0; padding: 10px 14px; gap: 14px; }
        .cd-tabs { padding: 0 1.1rem; }
        .cd-content { padding: 18px 1.1rem 40px; }
        .cd-alert { margin: 0 1.1rem 1rem; }

        /* Tabelas em grid (colunas fixas): a área rolável fica dentro do card
           arredondado em vez de estourar/clipar contra o overflow:hidden do -root. */
        .cd-tablewrap, .cd-jogos-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .cd-cols, .cd-row { min-width: 620px; }
        .cd-jogos-cols, .cd-jogo-row { min-width: 620px; }

        .cd-grupos-grid { gap: 14px; }
        .cd-grupo-card { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .cd-grupo-cols, .cd-grupo-row { min-width: 320px; }

        .cd-mm-fase-wrap { width: 210px; }
    }
</style>

<div class="cd-root">

    @if (TempData["Sucesso"] != null)
    {
        <div style="padding-top:1rem;">
            <div class="cd-alert">✅ @TempData["Sucesso"]</div>
        </div>
    }

    <!-- ── Hero ── -->
    <div class="cd-hero theme-dark-zone">
        <img src="~/Images/banner/escudos-pattern.svg" class="cd-hero-pattern" alt="" />
        <div class="cd-hero-stripe"></div>
        <div class="cd-hero-fade"></div>
        <div class="cd-hero-inner">
            <div class="cd-hero-icon">
                <img src="@CompeticaoHelper.GetLogoCompeticao(Model.Competicao.Id, Model.Competicao.LogoUrl)" alt="@Model.Competicao.Nome" />
            </div>

            <div style="flex:1; min-width:220px;">
                <div class="cd-kicker">
                    <div class="cd-kicker-line"></div>
                    <span>@Model.Competicao.Regiao · @tipoLabel</span>
                </div>
                <h1>@Model.Competicao.Nome</h1>
                <div class="cd-hero-actions">
                    @if (temporadasDet.Count > 1)
                    {
                        <form method="get" asp-action="Detalhes" asp-route-id="@Model.Competicao.Id" class="cd-hero-temporada">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                            <select name="temporada" onchange="this.form.submit()">
                                @foreach (var temp in temporadasDet)
                                {
                                    <option value="@temp" selected="@(temporadaDetSel == temp)">Temporada @temp</option>
                                }
                            </select>
                        </form>
                    }
                    @if (temApiLink)
                    {
                        <form asp-action="BuscarJogos" asp-route-id="@Model.Competicao.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="cd-pill" style="border:none;">🔄 @(semJogos ? "Importar Jogos" : "Sincronizar jogos")</button>
                        </form>
                    }
                    <a href="@Url.Action("Edit", "Competicoes", new { id = Model.Competicao.Id })" class="cd-pill cd-pill-accent">✏️ Editar competição</a>
                </div>
            </div>

            <div class="cd-stats">
                <div class="cd-stat"><div class="val">@totalTimes</div><div class="lbl">Times</div></div>
                <div class="cd-stat-sep"></div>
                <div class="cd-stat"><div class="val">@Model.Competicao.Jogos.Count</div><div class="lbl">Jogos</div></div>
                <div class="cd-stat-sep"></div>
                <div class="cd-stat"><div class="val">@totalGolsComp</div><div class="lbl">Gols</div></div>
            </div>
        </div>
    </div>

    @if (semJogos)
    {
        <div class="cd-content">
            <div class="cd-sem-dados cd-jogos-wrap" style="padding:3rem;">
                <div class="icon">📭</div>
                <p>Nenhum jogo importado ainda.<br />
                @if (temApiLink) { <text>Clique em <strong>Importar Jogos</strong> para buscar os dados da API.</text> }
                else { <text>Configure o link da API para importar os jogos.</text> }
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- ── Tabs ── -->
        <div class="cd-tabs">
            @if (temFases)
            {
                if (temTabelaGeral)
                {
                    <button type="button" class="cd-tab-btn @(tabInicial == "classif" ? "active" : "")" data-tab="classif">🏆 Tabela Geral</button>
                }
                foreach (var f in Model.Fases)
                {
                    <button type="button" class="cd-tab-btn @(tabInicial == $"fase-{f.Fase.Id}" ? "active" : "")" data-tab="fase-@f.Fase.Id">@IconeFase(f.Fase.Tipo) @f.Fase.Nome</button>
                }
            }
            else if (tipoNorm == "GRUPOS")
            {
                <button type="button" class="cd-tab-btn @(tabInicial == "grupos" ? "active" : "")" data-tab="grupos">🔢 Grupos</button>
                @if (Model.FasesMataMata.Any())
                {
                    <button type="button" class="cd-tab-btn" data-tab="bracket">⚔️ Mata-Mata</button>
                }
            }
            else if (ehJogoUnico)
            {
                <button type="button" class="cd-tab-btn @(tabInicial == "bracket" ? "active" : "")" data-tab="bracket">🏆 Decisão</button>
            }
            else if (tipoNorm == "MATA_MATA")
            {
                <button type="button" class="cd-tab-btn @(tabInicial == "bracket" ? "active" : "")" data-tab="bracket">⚔️ Chaveamento</button>
            }
            else
            {
                <button type="button" class="cd-tab-btn @(tabInicial == "classif" ? "active" : "")" data-tab="classif">📊 Classificação</button>
                @if (Model.FasesMataMata.Any())
                {
                    <button type="button" class="cd-tab-btn" data-tab="bracket">⚔️ Playoffs</button>
                }
            }
            <button type="button" class="cd-tab-btn" data-tab="estatisticas">📈 Estatísticas</button>
            <button type="button" class="cd-tab-btn" data-tab="jogos">📋 Jogos Realizados</button>
            <button type="button" class="cd-tab-btn" data-tab="proximos">📅 Próximos</button>
        </div>

        <div class="cd-content">

            <!-- ══════ PAINÉIS POR FASE DECLARADA ══════ -->
            @if (temFases)
            {
                foreach (var f in Model.Fases)
                {
                    <div class="cd-panel" id="cd-panel-fase-@f.Fase.Id" style="@(tabInicial == $"fase-{f.Fase.Id}" ? "" : "display:none;")">
                        @if (f.Fase.Tipo == "GRUPOS")
                        {
                            @await Html.PartialAsync("_PainelGrupos", f.Grupos)
                        }
                        else if (f.Fase.Tipo == "MATA_MATA" || f.Fase.Tipo == "JOGO_UNICO")
                        {
                            @await Html.PartialAsync("_PainelChaveamento", f.FasesMataMata)
                        }
                        else
                        {
                            <div class="cd-layout">
                                @await Html.PartialAsync("_PainelClassificacao", f.Classificacao)
                                @await Html.PartialAsync("_DetalhesSidebar", Model.ProximosJogos)
                            </div>
                        }
                    </div>
                }
            }

            <!-- ══════ CLASSIFICAÇÃO (pontos corridos, ou tabela geral acumulada das fases) ══════ -->
            @if (temTabelaGeral || (!temFases && tipoNorm != "GRUPOS" && tipoNorm != "MATA_MATA" && !ehJogoUnico))
            {
                <div class="cd-panel" id="cd-panel-classif" style="@(tabInicial == "classif" ? "" : "display:none;")">
                    <div class="cd-layout">
                        @await Html.PartialAsync("_PainelClassificacao", Model.Classificacao)
                        @await Html.PartialAsync("_DetalhesSidebar", Model.ProximosJogos)
                    </div>
                </div>
            }

            <!-- ══════ GRUPOS ══════ -->
            @if (!temFases && tipoNorm == "GRUPOS")
            {
                <div class="cd-panel" id="cd-panel-grupos" style="@(tabInicial == "grupos" ? "" : "display:none;")">
                    @await Html.PartialAsync("_PainelGrupos", Model.Grupos)
                </div>
            }

            <!-- ══════ MATA-MATA (chaveamento próprio, ou fase eliminatória detectada nos jogos) ══════ -->
            @if (!temFases && (tipoNorm == "MATA_MATA" || ehJogoUnico || Model.FasesMataMata.Any()))
            {
                <div class="cd-panel" id="cd-panel-bracket" style="@(tabInicial == "bracket" ? "" : "display:none;")">
                    @await Html.PartialAsync("_PainelChaveamento", Model.FasesMataMata)
                </div>
            }


            <!-- ══════ ESTATÍSTICAS (compartilhado, todos os tipos/formatos) ══════ -->
            <div class="cd-panel" id="cd-panel-estatisticas" style="display:none">
                <div style="padding:16px 2.5rem 0; text-align:right">
                    <a asp-action="EquipeDaRodada" asp-route-id="@Model.Competicao.Id" asp-route-temporada="@temporadaDetSel"
                       style="background:var(--p-1);border:1px solid var(--line);color:var(--text-2);border-radius:8px;font-family:'Barlow',Arial,sans-serif;font-size:12px;font-weight:700;padding:.4rem .85rem;text-decoration:none;margin-right:6px">
                        ⭐ Equipe da rodada
                    </a>
                    <a asp-action="Estatisticas" asp-route-id="@Model.Competicao.Id" asp-route-temporada="@temporadaDetSel"
                       style="background:var(--p-1);border:1px solid var(--line);color:var(--text-2);border-radius:8px;font-family:'Barlow',Arial,sans-serif;font-size:12px;font-weight:700;padding:.4rem .85rem;text-decoration:none">
                        ⛶ Abrir em tela cheia
                    </a>
                </div>
                @await Html.PartialAsync("_PainelEstatisticas", ViewBag.EstatisticasTimes as List<ControleFutebolWeb.Models.ViewModels.EstatisticaTimeViewModel>)
            </div>

            <!-- ══════ JOGOS REALIZADOS (compartilhado) ══════ -->
            <div class="cd-panel" id="cd-panel-jogos" style="display:none;">
                @if (!Model.JogosRealizados.Any())
                {
                    <div class="cd-sem-dados cd-jogos-wrap"><div class="icon">📋</div><p>Nenhum jogo realizado ainda.</p></div>
                }
                else
                {
                    <div class="cd-jogos-wrap">
                        <div class="cd-jogos-cols">
                            <span>Data</span><span>Rodada</span><span>Casa</span><span style="text-align:center;">Placar</span><span>Visitante</span><span style="text-align:right;">Ação</span>
                        </div>
                        @foreach (var jr in Model.JogosRealizados)
                        {
                            bool casaW = jr.PlacarCasa > jr.PlacarVisitante, visW = jr.PlacarVisitante > jr.PlacarCasa;
                            <div class="cd-jogo-row">
                                <div>
                                    <div class="data">@DateHelper.FormatarData(jr.Data, "dd/MM/yyyy")</div>
                                    <div class="hora">@DateHelper.FormatarData(jr.Data, "HH:mm")</div>
                                </div>
                                <span class="rodada">@(!string.IsNullOrEmpty(jr.Grupo) ? jr.Grupo : jr.Rodada > 0 ? $"Rod. {jr.Rodada}" : "-")</span>
                                <a class="cd-jogo-time" asp-controller="Times" asp-action="Details" asp-route-id="@jr.TimeCasaId" title="Ver @jr.TimeCasa?.Nome">
                                    @if (!string.IsNullOrEmpty(jr.TimeCasa?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jr.TimeCasa.EscudoUrl })" alt="" />
                                    }
                                    <span style="font-weight:@(casaW ? 700 : 500); color:@(casaW ? "var(--text-strong)" : "var(--text-dim)");">@jr.TimeCasa?.Nome</span>
                                </a>
                                <div class="cd-jogo-placar">
                                    <span>@jr.PlacarCasa–@jr.PlacarVisitante</span>
                                    @if (jr.PenaltisCasa.HasValue && jr.PenaltisVisitante.HasValue)
                                    {
                                        <span class="cd-jogo-pen">pên. @jr.PenaltisCasa-@jr.PenaltisVisitante</span>
                                    }
                                </div>
                                <a class="cd-jogo-time" asp-controller="Times" asp-action="Details" asp-route-id="@jr.TimeVisitanteId" title="Ver @jr.TimeVisitante?.Nome">
                                    @if (!string.IsNullOrEmpty(jr.TimeVisitante?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jr.TimeVisitante.EscudoUrl })" alt="" />
                                    }
                                    <span style="font-weight:@(visW ? 700 : 500); color:@(visW ? "var(--text-strong)" : "var(--text-dim)");">@jr.TimeVisitante?.Nome</span>
                                </a>
                                <div class="cd-jogo-acao">
                                    <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jr.Id" class="cd-btn-analisar">Analisar</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ══════ PRÓXIMOS (compartilhado) ══════ -->
            <div class="cd-panel" id="cd-panel-proximos" style="display:none;">
                @if (!Model.ProximosJogos.Any())
                {
                    <div class="cd-sem-dados cd-jogos-wrap"><div class="icon">📅</div><p>Nenhum jogo agendado.</p></div>
                }
                else
                {
                    <div class="cd-jogos-wrap">
                        <div class="cd-jogos-cols">
                            <span>Data</span><span>Rodada</span><span>Casa</span><span style="text-align:center;">Hora</span><span>Visitante</span><span style="text-align:right;"></span>
                        </div>
                        @foreach (var jp in Model.ProximosJogos)
                        {
                            <div class="cd-jogo-row">
                                <div>
                                    <div class="data">@DateHelper.FormatarData(jp.Data, "dd/MM/yyyy")</div>
                                </div>
                                <span class="rodada">@(!string.IsNullOrEmpty(jp.Grupo) ? jp.Grupo : jp.Rodada > 0 ? $"Rod. {jp.Rodada}" : "-")</span>
                                <a class="cd-jogo-time" asp-controller="Times" asp-action="Details" asp-route-id="@jp.TimeCasaId" title="Ver @jp.TimeCasa?.Nome">
                                    @if (!string.IsNullOrEmpty(jp.TimeCasa?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jp.TimeCasa.EscudoUrl })" alt="" />
                                    }
                                    <span style="color:var(--text-strong)">@jp.TimeCasa?.Nome</span>
                                </a>
                                <div class="cd-jogo-placar">
                                    <span style="background:transparent; color:var(--gold-ink)">@DateHelper.FormatarData(jp.Data, "HH:mm")</span>
                                </div>
                                <a class="cd-jogo-time" asp-controller="Times" asp-action="Details" asp-route-id="@jp.TimeVisitanteId" title="Ver @jp.TimeVisitante?.Nome">
                                    @if (!string.IsNullOrEmpty(jp.TimeVisitante?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jp.TimeVisitante.EscudoUrl })" alt="" />
                                    }
                                    <span style="color:var(--text-strong)">@jp.TimeVisitante?.Nome</span>
                                </a>
                                <div></div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }
</div>

<script>
    (function () {
        var buttons = document.querySelectorAll('.cd-tab-btn');
        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                buttons.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                document.querySelectorAll('.cd-panel').forEach(function (p) { p.style.display = 'none'; });
                var painel = document.getElementById('cd-panel-' + btn.dataset.tab);
                if (painel) painel.style.display = '';
            });
        });
    })();
</script>
