@model ControleFutebolWeb.Models.ViewModels.HomeViewModel
@using ControleFutebolWeb.Helpers

@{
    ViewData["Title"] = "Início";
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    /* ── Reset local ─────────────────────────────── */
    .cf-home * {
        box-sizing: border-box;
    }

    .cf-home {
        margin: 0 -12px; /* compensa o .container do layout pra ocupar a largura toda */
        background: var(--p-0);
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        border-radius: 14px;
        overflow: hidden;
    }

    .cf-home a { text-decoration: none; color: inherit; }
    .cf-home h1, .cf-home h2, .cf-home h3 { font-family: 'Barlow Condensed', Arial, sans-serif; }

    /* ── Hero ────────────────────────────────────── */
    .cf-hero {
        position: relative;
        overflow: hidden;
        min-height: 300px;
        background: #0a0a0a;
        display: flex;
        align-items: center;
    }

    .cf-hero-pattern {
        position: absolute;
        inset: 0;
        object-fit: cover;
        opacity: 0.05;
        pointer-events: none;
    }

    .cf-hero-fade-left {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #0a0a0a 40%, rgba(10,10,10,0.85) 60%, rgba(10,10,10,0.4) 80%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }

    .cf-hero-stripe {
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: #d4a520;
        z-index: 3;
    }

    /* ── Prancheta tática animada ────────────────── */
    .cf-hero-board {
        position: absolute;
        right: 3rem;
        top: 50%;
        transform: translateY(-50%) rotate(3deg);
        width: 210px;
        z-index: 1;
    }

    .cf-hero-board svg {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 18px 40px rgba(0,0,0,0.55));
        animation: cfFloat 7s ease-in-out infinite;
    }

    .cf-tatica-ball   { animation: cfBallMove 7.5s linear infinite; }
    .cf-tatica-runner { animation: cfRunnerMove 7.5s ease-in-out infinite; }
    .cf-tatica-linha1 { stroke-dasharray: 149; animation: cfLinha1 7.5s linear infinite; }
    .cf-tatica-linha2 { stroke-dasharray: 130; animation: cfLinha2 7.5s linear infinite; }
    .cf-tatica-linha3 { stroke-dasharray: 125; animation: cfLinha3 7.5s linear infinite; }
    .cf-tatica-corrida { stroke-dasharray: 5 6; animation: cfCorrida 0.9s linear infinite; }
    .cf-tatica-burst {
        transform-box: fill-box;
        transform-origin: center;
        animation: cfBurst 7.5s ease-out infinite;
    }

    @@keyframes cfFloat {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-8px); }
    }

    @@keyframes cfBallMove {
        0%, 8%   { transform: translate(110px, 380px); opacity: 1; }
        18%, 30% { transform: translate(250px, 330px); opacity: 1; }
        40%, 52% { transform: translate(285px, 205px); opacity: 1; }
        62%, 80% { transform: translate(178px, 142px); opacity: 1; }
        86%      { transform: translate(178px, 142px); opacity: 0; }
        96%      { transform: translate(110px, 380px); opacity: 0; }
        100%     { transform: translate(110px, 380px); opacity: 1; }
    }

    @@keyframes cfRunnerMove {
        0%, 30%  { transform: translate(140px, 300px); opacity: 1; }
        60%, 80% { transform: translate(165px, 150px); opacity: 1; }
        86%      { transform: translate(165px, 150px); opacity: 0; }
        96%      { transform: translate(140px, 300px); opacity: 0; }
        100%     { transform: translate(140px, 300px); opacity: 1; }
    }

    @@keyframes cfLinha1 {
        0%, 2%    { stroke-dashoffset: 149; opacity: 1; }
        8%, 78%   { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 149; opacity: 0; }
    }

    @@keyframes cfLinha2 {
        0%, 20%   { stroke-dashoffset: 130; opacity: 1; }
        28%, 78%  { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 130; opacity: 0; }
    }

    @@keyframes cfLinha3 {
        0%, 42%   { stroke-dashoffset: 125; opacity: 1; }
        50%, 78%  { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 125; opacity: 0; }
    }

    @@keyframes cfCorrida {
        to { stroke-dashoffset: -11; }
    }

    @@keyframes cfBurst {
        0%, 61%   { opacity: 0; transform: scale(0.3); }
        66%       { opacity: 0.85; transform: scale(1); }
        76%, 100% { opacity: 0; transform: scale(1.9); }
    }

    .cf-hero-content {
        position: relative;
        z-index: 3;
        padding: 2.5rem 3rem;
        max-width: 620px;
    }

    .cf-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.05;
        color: var(--text-strong);
        margin: 0 0 14px;
        letter-spacing: -0.01em;
    }

    .cf-hero p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0 0 26px;
        max-width: 520px;
        line-height: 1.6;
    }

    /* ── Search ──────────────────────────────────── */
    .cf-search-wrap { position: relative; max-width: 460px; }

    .cf-search-box {
        display: flex;
        align-items: stretch;
        background: var(--p-2);
        border: 1px solid var(--line);
        border-radius: 9px;
        overflow: hidden;
        transition: border-color 0.15s;
    }

    .cf-search-box:focus-within { border-color: #d4a520; }

    .cf-search-icon {
        display: flex;
        align-items: center;
        padding: 0 14px;
        color: #666;
        flex-shrink: 0;
    }

    .cf-search-input {
        flex: 1;
        padding: 13px 4px;
        background: transparent;
        border: none;
        color: var(--text-strong);
        font-size: 0.88rem;
        outline: none;
        font-family: inherit;
    }

    .cf-search-input::placeholder { color: #666; }

    .cf-search-btn {
        padding: 0 22px;
        background: #d4a520;
        color: #141414;
        font-weight: 700;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        letter-spacing: 0.04em;
        flex-shrink: 0;
        transition: background 0.15s;
    }

    .cf-search-btn:hover { background: #c49918; }

    /* position:fixed (não absolute) porque o .cf-hero tem overflow:hidden —
       um dropdown absoluto ficava cortado no fim da faixa do hero, escondendo
       todos os resultados menos o primeiro. A posição é calculada via JS
       (posicionarDropdown) a partir do retângulo da caixa de busca. */
    .cf-search-dropdown {
        position: fixed;
        background: var(--p-2);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.4);
        z-index: 999;
        overflow-y: auto;
        max-height: min(60vh, 420px);
        display: none;
    }

    .cf-search-dropdown.open { display: block; }

    .cf-search-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        text-decoration: none;
        color: var(--text);
        font-size: 13px;
        border-bottom: 1px solid var(--line);
        transition: background .1s;
    }

    .cf-search-item:last-child { border-bottom: none; }
    .cf-search-item:hover { background: var(--p-3); text-decoration: none; color: inherit; }

    .cf-search-avatar {
        position: relative;
        width: 26px; height: 26px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
        background: var(--p-4);
        border: 1px solid var(--line);
    }
    .cf-search-avatar img {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
    }
    .cf-avatar-time img    { object-fit: contain; padding: 3px; }
    .cf-avatar-jogador img { object-fit: cover; }
    .cf-avatar-fallback {
        font-size: 11px; color: var(--text-dim); display: flex; align-items: center; justify-content: center;
    }

    .cf-search-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 20px;
        letter-spacing: .04em;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .cf-badge-time       { background: rgba(56,138,221,0.18);  color: #7db8ee; }
    .cf-badge-jogador    { background: rgba(34,197,94,0.16);   color: #6ee0a0; }
    .cf-badge-competicao { background: rgba(212,165,32,0.18);  color: #eecb6c; }

    .cf-search-nome  { flex: 1; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cf-search-extra { font-size: 11px; color: var(--text-dim); }
    .cf-search-empty { padding: 14px; text-align: center; color: var(--text-dim); font-size: 13px; }

    /* ── Títulos de seção: texto comum em Condensed, sem caixa alta ─────── */
    .cf-sec-cab {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 12px;
    }

    .cf-home .cf-sec-titulo {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-strong);
    }

    .cf-sec-conta {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--gold-ink);
    }

    .cf-home .cf-sec-link {
        margin-left: auto;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--gold-ink);
        white-space: nowrap;
    }

    .cf-home .cf-sec-link:hover { text-decoration: underline; }

    /* ── Atalhos: uma ação (novo jogo) e os destinos como links simples ─── */
    .cf-atalhos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 4px;
        padding: 12px 2.5rem;
        background: var(--p-1);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .cf-home .cf-atalho-novo {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-right: 10px;
        padding: 8px 16px;
        border-radius: 8px;
        background: #d4a520;
        color: #141414;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .cf-home .cf-atalho-novo:hover { background: #e2b42c; }

    .cf-home .cf-atalho {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-2);
    }

    .cf-home .cf-atalho:hover { background: var(--p-3); color: var(--text-strong); }
    .cf-atalho-num { font-size: 0.78rem; font-weight: 500; color: var(--text-dim); font-variant-numeric: tabular-nums; }

    .cf-home .cf-atalho:focus-visible,
    .cf-home .cf-atalho-novo:focus-visible,
    .cf-home .cf-linha-jogo:focus-visible,
    .cf-home .cf-game-card:focus-visible,
    .cf-home .cf-sec-link:focus-visible,
    .cf-search-btn:focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── O dia: jogos de hoje + falta analisar ───────────────────────────── */
    .cf-dia {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: 28px;
        padding: 2rem 2.5rem 0;
        align-items: start;
    }

    .cf-lista {
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }

    /* Linha de jogo: status | competição | mandante | placar | visitante */
    .cf-home .cf-linha-jogo {
        display: grid;
        grid-template-columns: 62px 18px minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border-bottom: 1px solid var(--line-soft);
        color: var(--text);
    }

    .cf-home .cf-linha-jogo:last-child { border-bottom: none; }
    .cf-home .cf-linha-jogo:hover { background: var(--p-3); }

    .cf-linha-status {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .cf-linha-status.vivo { color: var(--bad-2); }
    .cf-linha-status.vivo::before {
        content: "";
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 5px;
        border-radius: 50%;
        background: var(--bad-2);
        vertical-align: 1px;
    }

    .cf-linha-status.fim { color: var(--text-dimmer); font-weight: 600; font-size: 0.85rem; }

    .cf-comp-logo { width: 18px; height: 18px; object-fit: contain; display: block; }
    .cf-comp-logo-vazio { width: 18px; height: 18px; border-radius: 50%; background: var(--p-4); }

    .cf-linha-time {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
        font-size: 0.88rem;
        font-weight: 600;
    }

    .cf-linha-time.casa { justify-content: flex-end; text-align: right; }
    .cf-linha-time span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cf-linha-time img { width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; }

    .cf-linha-placar {
        min-width: 52px;
        text-align: center;
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-strong);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .cf-linha-placar.agendado { font-weight: 600; color: var(--text-dimmer); }

    /* Falta analisar: sem coluna de status (todos encerrados); a data vai à direita */
    .cf-home .cf-pendente {
        grid-template-columns: 18px minmax(0, 1fr) auto minmax(0, 1fr) 44px;
    }

    .cf-pendente-dia { font-size: 0.75rem; color: var(--text-dim); text-align: right; }

    .cf-lista-vazia {
        padding: 1.4rem 1rem;
        text-align: center;
        font-size: 0.88rem;
        color: var(--text-muted);
    }

    .cf-lista-vazia a { color: var(--gold-ink) !important; font-weight: 600; }

    /* ── Resultados + classificação ──────────────────────────────────────── */
    .cf-main-grid {
        padding: 2rem 2.5rem 2.5rem;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 28px;
        align-items: start;
    }

    .cf-main-grid.sem-classif { grid-template-columns: 1fr; }

    .cf-games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
    }

    .cf-game-card {
        display: block;
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 12px 14px;
        transition: border-color 0.18s;
    }

    .cf-game-card:hover { border-color: var(--line-strong); }

    .cf-game-top {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
    }

    .cf-game-top .cf-comp-logo { width: 16px; height: 16px; }

    .cf-game-comp {
        flex: 1;
        min-width: 0;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cf-game-date { font-size: 0.75rem; color: var(--text-dimmer); font-weight: 600; flex-shrink: 0; }

    .cf-game-teams { display: flex; align-items: center; gap: 7px; }

    .cf-team-badge {
        width: 22px; height: 22px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--p-0);
        border: 1px solid var(--line);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .cf-team-badge img { width: 100%; height: 100%; object-fit: contain; }
    .cf-team-badge-abbr { font-size: 8px; font-weight: 700; color: var(--text-dim); }

    .cf-team-name {
        flex: 1;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .cf-team-name.venceu { font-weight: 700; color: var(--text-strong); }
    .cf-team-name.vis { text-align: right; }

    .cf-score {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-strong);
        background: var(--p-0);
        padding: 2px 11px;
        border-radius: 7px;
        flex-shrink: 0;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .cf-game-pen { text-align: center; font-size: 0.7rem; color: var(--text-dim); margin-top: 4px; }

    .cf-game-footer {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid var(--line);
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-dim);
    }

    .cf-game-card:hover .cf-game-footer { color: var(--gold-ink); }
    .cf-game-footer.feito { color: var(--ok); }

    .cf-empty {
        grid-column: 1 / -1;
        font-size: 0.85rem;
        color: var(--text-dim);
        text-align: center;
        padding: 1.5rem 1rem;
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
    }

    .cf-empty a { color: var(--gold-ink) !important; font-weight: 600; }

    /* ── Classificação ───────────────────────────── */
    .cf-classif-panel {
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }

    .cf-classif-head {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        background: var(--p-0);
        border-bottom: 1px solid var(--line);
    }

    .cf-classif-head span {
        font-size: 0.72rem;
        color: var(--text-dimmer);
        font-weight: 700;
    }

    .cf-classif-row {
        display: flex;
        align-items: center;
        padding: 9px 16px;
        border-bottom: 1px solid var(--line-soft);
    }

    .cf-classif-row:last-child { border-bottom: none; }
    .cf-classif-row:hover { background: var(--p-3); }

    .cf-classif-bar { width: 3px; height: 26px; border-radius: 2px; flex-shrink: 0; margin-right: 10px; }

    .cf-classif-pos { width: 20px; font-size: 0.78rem; font-weight: 700; flex-shrink: 0; }
    .cf-classif-pos.top  { color: var(--gold-ink); }
    .cf-classif-pos.mid  { color: var(--text-dim); }
    .cf-classif-pos.drop { color: var(--bad-2); }

    .cf-classif-time {
        flex: 1;
        font-size: 0.82rem;
        color: var(--text);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 8px;
        min-width: 0;
    }

    .cf-classif-cols { display: flex; gap: 0; flex-shrink: 0; }
    .cf-classif-cols span { width: 26px; font-size: 0.75rem; color: var(--text-dim); text-align: center; }
    .cf-classif-cols .pts { width: 32px; font-size: 0.82rem; color: var(--gold-ink); font-weight: 800; }

    /* ── Responsivo ──────────────────────────────── */
    @@media (max-width: 1023px) {
        .cf-hero-board { display: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cf-hero-board svg, .cf-hero-board svg * { animation: none !important; }
    }

    @@media (max-width: 900px) {
        .cf-dia, .cf-main-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .cf-hero { min-height: 0; }
        .cf-hero-content { padding: 1.8rem 1.2rem; max-width: 100%; }
        .cf-hero h1 { font-size: 2rem; }
        .cf-atalhos, .cf-dia, .cf-main-grid { padding-left: 1rem; padding-right: 1rem; }
        .cf-home .cf-linha-jogo { grid-template-columns: 52px 16px minmax(0, 1fr) auto minmax(0, 1fr); gap: 6px; padding: 9px 10px; }
        .cf-home .cf-pendente { grid-template-columns: 16px minmax(0, 1fr) auto minmax(0, 1fr) 36px; }
        .cf-linha-time img { display: none; }
        .cf-linha-time { font-size: 0.82rem; }
    }
</style>

<div class="cf-home">

    <!-- Hero -->
    <div class="cf-hero theme-dark-zone">
        <img class="cf-hero-pattern" src="~/Images/banner/escudos-pattern.svg" alt="" />
        <div class="cf-hero-fade-left"></div>
        <div class="cf-hero-stripe"></div>
        <div class="cf-hero-board" aria-hidden="true">
            <svg viewBox="0 0 360 470" xmlns="http://www.w3.org/2000/svg">
                <!-- prancheta -->
                <rect x="6" y="20" width="348" height="444" rx="16" fill="#191919" stroke="#333" stroke-width="1.5" />
                <rect x="140" y="6" width="80" height="28" rx="9" fill="#d4a520" />
                <rect x="158" y="13" width="44" height="9" rx="4.5" fill="#0f0f0f" />
                <text x="34" y="53" font-family="'Barlow Condensed', Arial, sans-serif" font-size="14" font-weight="700" letter-spacing="3" fill="#6b7280">PLANO DE JOGO</text>
                <text x="326" y="53" text-anchor="end" font-family="'Barlow Condensed', Arial, sans-serif" font-size="14" font-weight="700" letter-spacing="2" fill="#d4a520">4-3-3</text>

                <!-- campo -->
                <g stroke="rgba(255,255,255,0.16)" stroke-width="1.5" fill="none">
                    <rect x="28" y="64" width="304" height="376" rx="4" fill="rgba(255,255,255,0.02)" />
                    <line x1="28" y1="252" x2="332" y2="252" />
                    <circle cx="180" cy="252" r="36" />
                    <rect x="104" y="64" width="152" height="58" />
                    <rect x="140" y="64" width="80" height="24" />
                    <rect x="104" y="382" width="152" height="58" />
                    <rect x="140" y="416" width="80" height="24" />
                </g>
                <circle cx="180" cy="252" r="2.5" fill="rgba(255,255,255,0.25)" />
                <rect x="150" y="59" width="60" height="5" rx="1.5" fill="rgba(212,165,32,0.5)" />

                <!-- adversários (X) -->
                <g stroke="#4b5563" stroke-width="2.5" stroke-linecap="round">
                    <path d="M124 154 l12 12 M136 154 l-12 12" />
                    <path d="M224 174 l12 12 M236 174 l-12 12" />
                    <path d="M172 209 l12 12 M184 209 l-12 12" />
                    <path d="M89 134 l12 12 M101 134 l-12 12" />
                    <path d="M259 144 l12 12 M271 144 l-12 12" />
                </g>

                <!-- corrida do camisa 9 (seta tracejada) -->
                <path class="cf-tatica-corrida" d="M140 300 C150 245 172 195 165 150" stroke="rgba(212,165,32,0.55)" stroke-width="2" fill="none" />
                <path d="M158 159 L165 148 L172 159" stroke="rgba(212,165,32,0.55)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />

                <!-- linhas de passe (desenham em sequência) -->
                <line class="cf-tatica-linha1" x1="110" y1="380" x2="250" y2="330" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />
                <line class="cf-tatica-linha2" x1="250" y1="330" x2="285" y2="205" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />
                <line class="cf-tatica-linha3" x1="285" y1="205" x2="178" y2="142" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />

                <!-- jogadores (ouro) -->
                <g font-family="'Barlow', Arial, sans-serif" font-size="8.5" font-weight="800" text-anchor="middle">
                    <circle cx="180" cy="428" r="8" fill="#d4a520" />
                    <text x="180" y="431" fill="#141414">1</text>
                    <circle cx="70" cy="355" r="8" fill="#d4a520" />
                    <text x="70" y="358" fill="#141414">4</text>
                    <circle cx="110" cy="380" r="8" fill="#d4a520" />
                    <text x="110" y="383" fill="#141414">6</text>
                    <circle cx="250" cy="330" r="8" fill="#d4a520" />
                    <text x="250" y="333" fill="#141414">8</text>
                    <circle cx="285" cy="205" r="8" fill="#d4a520" />
                    <text x="285" y="208" fill="#141414">7</text>
                </g>

                <!-- camisa 9 correndo pra área -->
                <g class="cf-tatica-runner" transform="translate(140 300)">
                    <circle r="8" fill="#d4a520" stroke="#f0c040" stroke-width="1" />
                    <text y="3" text-anchor="middle" font-family="'Barlow', Arial, sans-serif" font-size="8.5" font-weight="800" fill="#141414">9</text>
                </g>

                <!-- explosão do gol -->
                <circle class="cf-tatica-burst" cx="178" cy="142" r="12" fill="none" stroke="#d4a520" stroke-width="2" style="opacity:0" />

                <!-- bola -->
                <g class="cf-tatica-ball" transform="translate(110 380)">
                    <circle r="5" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
                    <path d="M-1.8 -1.5 L1.8 -1.5 L2.8 1 L0 2.6 L-2.8 1 Z" fill="#334155" opacity="0.8" />
                </g>
            </svg>
        </div>

        @{
            var ptBR = new System.Globalization.CultureInfo("pt-BR");
            var dataTitulo = Model.Hoje.ToString("dddd, d 'de' MMMM", ptBR);
            dataTitulo = char.ToUpper(dataTitulo[0]) + dataTitulo[1..];

            // Mesma regra de Jogos/Hoje: sem placar final e dentro de 2h30 do início.
            bool AoVivo(ControleFutebolWeb.Models.Jogo j)
            {
                if (j.PlacarCasa.HasValue && j.PlacarVisitante.HasValue) return false;
                if (DateHelper.ParaBrasilia(j.Data) is not DateTime inicio) return false;
                return inicio <= Model.AgoraBrasil && Model.AgoraBrasil <= inicio.AddHours(2.5);
            }

            var jogosHoje = Model.JogosHoje;
            var qtdAoVivo = jogosHoje.Count(AoVivo);
            // Ao vivo primeiro; o resto na ordem do horário.
            var jogosHojeLista = jogosHoje.OrderBy(j => AoVivo(j) ? 0 : 1).ThenBy(j => j.Data).Take(8).ToList();

            string? Img(string? url) => string.IsNullOrEmpty(url) ? null : Url.Action("Imagem", "MediaProxy", new { url });
            string Milhar(int n) => n.ToString("N0", ptBR);

            string resumoDia = jogosHoje.Count switch
            {
                0 => "Nenhum jogo hoje.",
                1 => "1 jogo hoje",
                _ => $"{jogosHoje.Count} jogos hoje",
            };
            if (jogosHoje.Count > 0)
                resumoDia += qtdAoVivo switch { 0 => ".", 1 => ", 1 ao vivo agora.", _ => $", {qtdAoVivo} ao vivo agora." };
            string resumoPendentes = Model.TotalPendentesAnalise switch
            {
                0 => "Nada de ontem ou de hoje esperando análise.",
                1 => "1 partida de ontem ou de hoje espera sua análise.",
                _ => $"{Model.TotalPendentesAnalise} partidas de ontem e de hoje esperam sua análise.",
            };

            var ontemParam = Model.Hoje.AddDays(-1).ToString("yyyy-MM-dd");
            bool mostrarClassif = Model.Classificacao.Any() || Model.CompeticoesHomeSelecionadas > 0;
        }

        <div class="cf-hero-content">
            <h1>@dataTitulo</h1>
            <p>@resumoDia @resumoPendentes</p>
            <div class="cf-search-wrap">
                <div class="cf-search-box">
                    <span class="cf-search-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    </span>
                    <input id="cfSearchInput" type="text" class="cf-search-input"
                           aria-label="Buscar time, jogador ou competição"
                           placeholder="Buscar time, jogador ou competição..." autocomplete="off" />
                    <button type="button" id="cfSearchBtn" class="cf-search-btn">Buscar</button>
                </div>
                <div id="cfSearchDropdown" class="cf-search-dropdown"></div>
            </div>
        </div>
    </div>

    <!-- Atalhos: a única ação do grupo (novo jogo) e os destinos com seus totais -->
    <nav class="cf-atalhos" aria-label="Atalhos">
        <a href="@Url.Action("Create", "Jogos")" class="cf-atalho-novo">+ Novo jogo</a>
        <a href="@Url.Action("Hoje", "Jogos")" class="cf-atalho">Jogos de hoje</a>
        <a href="@Url.Action("Index", "Jogos")" class="cf-atalho">Jogos <span class="cf-atalho-num">@Milhar(Model.TotalJogos)</span></a>
        <a href="@Url.Action("Index", "Competicoes")" class="cf-atalho">Competições <span class="cf-atalho-num">@Milhar(Model.TotalCompeticoes)</span></a>
        <a href="@Url.Action("Index", "Times")" class="cf-atalho">Times <span class="cf-atalho-num">@Milhar(Model.TotalTimes)</span></a>
        <a href="@Url.Action("Index", "Jogadores")" class="cf-atalho">Jogadores <span class="cf-atalho-num">@Milhar(Model.TotalJogadores)</span></a>
        <a href="@Url.Action("Scout", "Relatorios")" class="cf-atalho">Scout</a>
        <a href="@Url.Action("Index", "Relatorios")" class="cf-atalho">Relatórios</a>
    </nav>

    <!-- O dia: jogos de hoje e o que falta analisar -->
    <div class="cf-dia">
        <section>
            <div class="cf-sec-cab">
                <h2 class="cf-sec-titulo">Hoje</h2>
                @if (jogosHoje.Count > 0)
                {
                    <span class="cf-sec-conta">@jogosHoje.Count</span>
                }
                <a href="@Url.Action("Hoje", "Jogos")" class="cf-sec-link">Ver todos os jogos de hoje</a>
            </div>
            <div class="cf-lista">
                @if (jogosHoje.Count == 0)
                {
                    <div class="cf-lista-vazia">
                        Nenhum jogo cadastrado para hoje.
                        <a href="@Url.Action("Hoje", "Jogos", new { data = Model.Hoje.AddDays(1).ToString("yyyy-MM-dd") })">Ver os jogos de amanhã</a>
                    </div>
                }
                @foreach (var jogo in jogosHojeLista)
                {
                    var vivo = AoVivo(jogo);
                    var encerrado = jogo.PlacarCasa.HasValue && jogo.PlacarVisitante.HasValue;
                    var placar = encerrado ? $"{jogo.PlacarCasa} – {jogo.PlacarVisitante}"
                               : vivo && jogo.PlacarParcialCasa.HasValue ? $"{jogo.PlacarParcialCasa} – {jogo.PlacarParcialVisitante}"
                               : "×";
                    var logoComp = Img(jogo.Competicao?.LogoUrl);
                    <a class="cf-linha-jogo" href="@Url.Action("Analisar", "Jogos", new { id = jogo.Id })"
                       title="@(jogo.Competicao?.Nome ?? "Sem competição") — analisar partida">
                        @if (vivo)
                        {
                            <span class="cf-linha-status vivo">Ao vivo</span>
                        }
                        else if (encerrado)
                        {
                            <span class="cf-linha-status fim">Encerrado</span>
                        }
                        else
                        {
                            <span class="cf-linha-status">@DateHelper.FormatarData(jogo.Data, "HH:mm")</span>
                        }
                        @if (logoComp != null)
                        {
                            <img class="cf-comp-logo" src="@logoComp" alt="@jogo.Competicao?.Nome" />
                        }
                        else
                        {
                            <span class="cf-comp-logo-vazio" aria-hidden="true"></span>
                        }
                        <span class="cf-linha-time casa">
                            <span>@jogo.TimeCasa?.Nome</span>
                            @if (Img(jogo.TimeCasa?.EscudoUrl) is string escCasa) { <img src="@escCasa" alt="" /> }
                        </span>
                        <span class="cf-linha-placar @(encerrado || vivo ? "" : "agendado")">@placar</span>
                        <span class="cf-linha-time">
                            @if (Img(jogo.TimeVisitante?.EscudoUrl) is string escVis) { <img src="@escVis" alt="" /> }
                            <span>@jogo.TimeVisitante?.Nome</span>
                        </span>
                    </a>
                }
            </div>
        </section>

        <section>
            <div class="cf-sec-cab">
                <h2 class="cf-sec-titulo">Falta analisar</h2>
                @if (Model.TotalPendentesAnalise > 0)
                {
                    <span class="cf-sec-conta">@Model.TotalPendentesAnalise</span>
                }
                <a href="@Url.Action("Hoje", "Jogos", new { data = ontemParam })" class="cf-sec-link">Jogos de ontem</a>
            </div>
            <div class="cf-lista">
                @if (!Model.PendentesAnalise.Any())
                {
                    <div class="cf-lista-vazia">Nenhuma partida encerrada ontem ou hoje esperando análise.</div>
                }
                @foreach (var jogo in Model.PendentesAnalise)
                {
                    var logoComp = Img(jogo.Competicao?.LogoUrl);
                    var ehHoje = DateHelper.ParaBrasilia(jogo.Data)?.Date == Model.Hoje;
                    <a class="cf-linha-jogo cf-pendente" href="@Url.Action("Analisar", "Jogos", new { id = jogo.Id })"
                       title="@(jogo.Competicao?.Nome ?? "Sem competição") — analisar partida">
                        @if (logoComp != null)
                        {
                            <img class="cf-comp-logo" src="@logoComp" alt="@jogo.Competicao?.Nome" />
                        }
                        else
                        {
                            <span class="cf-comp-logo-vazio" aria-hidden="true"></span>
                        }
                        <span class="cf-linha-time casa"><span>@jogo.TimeCasa?.Nome</span></span>
                        <span class="cf-linha-placar">@jogo.PlacarCasa – @jogo.PlacarVisitante</span>
                        <span class="cf-linha-time"><span>@jogo.TimeVisitante?.Nome</span></span>
                        <span class="cf-pendente-dia">@(ehHoje ? "hoje" : "ontem")</span>
                    </a>
                }
            </div>
        </section>
    </div>

    <!-- Últimos resultados + classificação (esta só quando há competição marcada) -->
    <div class="cf-main-grid @(mostrarClassif ? "" : "sem-classif")">
        <section>
            <div class="cf-sec-cab">
                <h2 class="cf-sec-titulo">Últimos resultados</h2>
                <a href="@Url.Action("Index", "Jogos")" class="cf-sec-link">Ver todos os jogos</a>
            </div>
            <div class="cf-games-grid">
                @if (!Model.JogosRecentes.Any())
                {
                    <div class="cf-empty">Nenhum jogo encerrado ainda.</div>
                }
                @foreach (var jogo in Model.JogosRecentes)
                {
                    bool casaVenceu = (jogo.PlacarCasa ?? 0) > (jogo.PlacarVisitante ?? 0);
                    bool visVenceu = (jogo.PlacarVisitante ?? 0) > (jogo.PlacarCasa ?? 0);
                    bool analisado = Model.JogosAnalisadosIds.Contains(jogo.Id);
                    var logoComp = Img(jogo.Competicao?.LogoUrl);
                    <a href="@Url.Action("Analisar", "Jogos", new { id = jogo.Id })" class="cf-game-card">
                        <div class="cf-game-top">
                            @if (logoComp != null)
                            {
                                <img class="cf-comp-logo" src="@logoComp" alt="" />
                            }
                            <span class="cf-game-comp">@(jogo.Competicao?.Nome ?? "Sem competição")</span>
                            <span class="cf-game-date">@DateHelper.FormatarData(jogo.Data, "dd/MM")</span>
                        </div>
                        <div class="cf-game-teams">
                            <div class="cf-team-badge">
                                @if (Img(jogo.TimeCasa?.EscudoUrl) is string escCasa)
                                {
                                    <img src="@escCasa" alt="" />
                                }
                                else
                                {
                                    <span class="cf-team-badge-abbr">@(jogo.TimeCasa?.Nome?.Length >= 3 ? jogo.TimeCasa.Nome.Substring(0, 3).ToUpper() : jogo.TimeCasa?.Nome)</span>
                                }
                            </div>
                            <span class="cf-team-name @(casaVenceu ? "venceu" : "")">@jogo.TimeCasa?.Nome</span>
                            <span class="cf-score">@jogo.PlacarCasa – @jogo.PlacarVisitante</span>
                            <span class="cf-team-name vis @(visVenceu ? "venceu" : "")">@jogo.TimeVisitante?.Nome</span>
                            <div class="cf-team-badge">
                                @if (Img(jogo.TimeVisitante?.EscudoUrl) is string escVis)
                                {
                                    <img src="@escVis" alt="" />
                                }
                                else
                                {
                                    <span class="cf-team-badge-abbr">@(jogo.TimeVisitante?.Nome?.Length >= 3 ? jogo.TimeVisitante.Nome.Substring(0, 3).ToUpper() : jogo.TimeVisitante?.Nome)</span>
                                }
                            </div>
                        </div>
                        @if (jogo.PenaltisCasa.HasValue && jogo.PenaltisVisitante.HasValue)
                        {
                            <div class="cf-game-pen">@jogo.PenaltisCasa – @jogo.PenaltisVisitante nos pênaltis</div>
                        }
                        <div class="cf-game-footer @(analisado ? "feito" : "")">@(analisado ? "✓ Analisado" : "Analisar partida")</div>
                    </a>
                }
            </div>
        </section>

        @if (mostrarClassif)
        {
            <section>
                <div class="cf-sec-cab">
                    <h2 class="cf-sec-titulo">Classificação</h2>
                    <a href="@Url.Action("Index", "Competicoes")" class="cf-sec-link">Competições</a>
                </div>
                @if (!Model.Classificacao.Any())
                {
                    <div class="cf-empty">As competições marcadas para a home ainda não têm jogos encerrados.</div>
                }
                else
                {
                    <div class="cf-classif-panel">
                        <div class="cf-classif-head">
                            <div style="width:3px; margin-right:10px; flex-shrink:0;"></div>
                            <span style="width:20px; flex-shrink:0;">#</span>
                            <div style="width:22px; flex-shrink:0;"></div>
                            <span style="flex:1;">Time</span>
                            <div class="cf-classif-cols">
                                <span title="Jogos">J</span><span title="Vitórias">V</span><span title="Empates">E</span><span title="Derrotas">D</span><span class="pts">Pts</span>
                            </div>
                        </div>
                        @foreach (var c in Model.Classificacao)
                        {
                            string faixa = c.Posicao <= 4 ? "top" : (c.Posicao >= Model.Classificacao.Count - 2 ? "drop" : "mid");
                            string corBarra = faixa == "top" ? "#d4a520" : (faixa == "drop" ? "#ef4444" : "#374151");
                            <div class="cf-classif-row">
                                <div class="cf-classif-bar" style="background:@corBarra;"></div>
                                <span class="cf-classif-pos @faixa">@c.Posicao</span>
                                <div class="cf-team-badge" style="margin-right:6px;">
                                    @if (Img(c.Time?.EscudoUrl) is string escTime)
                                    {
                                        <img src="@escTime" alt="" />
                                    }
                                    else
                                    {
                                        <span class="cf-team-badge-abbr">@(c.Time?.Nome?.Length >= 3 ? c.Time.Nome.Substring(0, 3).ToUpper() : c.Time?.Nome)</span>
                                    }
                                </div>
                                <span class="cf-classif-time">@c.Time?.Nome</span>
                                <div class="cf-classif-cols">
                                    <span>@c.Jogos</span><span>@c.Vitorias</span><span>@c.Empates</span><span>@c.Derrotas</span>
                                    <span class="pts">@c.Pontos</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    // ── Busca global (time / jogador / competição) ────────────────────
    const input = document.getElementById('cfSearchInput');
    const dropdown = document.getElementById('cfSearchDropdown');
    if (!input || !dropdown) return;

    const urls = {
        Time:       id => '/Times/Details/' + id,
        Jogador:    id => '/Jogadores/Estatisticas/' + id,
        // Competição com tela própria (Brasileirão, Libertadores, Champions...) vai
        // para ela, como no menu; as demais, para a genérica
        Competição: id => (@Html.Raw(ControleFutebolWeb.Helpers.CompeticaoRotaHelper.MapaTelasPropriasJson(Url)))[id] || '/Competicoes/Detalhes/' + id,
    };

    const badgeClass = {
        Time:       'cf-badge-time',
        Jogador:    'cf-badge-jogador',
        Competição: 'cf-badge-competicao',
    };

    const avatarClass = {
        Time:       'cf-avatar-time',
        Jogador:    'cf-avatar-jogador',
        Competição: 'cf-avatar-competicao',
    };

    // Ícone/inicial exibido enquanto a imagem carrega, ou quando não há
    // imagem/a URL falha — diferencia o tipo mesmo sem escudo/foto.
    const fallbackIcon = {
        Time: (nome) => esc((nome || '').trim().charAt(0).toUpperCase() || '?'),
        Jogador: () => '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7z"/></svg>',
        Competição: () => '🏆',
    };

    let timer;

    input.addEventListener('input', function () {
        clearTimeout(timer);
        const q = this.value.trim();
        if (q.length < 2) { close(); return; }
        timer = setTimeout(() => fetchResults(q), 220);
    });

    document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) close();
    });

    // Enter e o botão "Buscar" abrem o primeiro resultado. Se a lista ainda
    // não chegou (digitou e apertou na hora), busca agora e abre o primeiro.
    async function irParaPrimeiro() {
        const q = input.value.trim();
        if (q.length < 2) { input.focus(); return; }
        clearTimeout(timer);
        let primeiro = dropdown.querySelector('.cf-search-item');
        if (!primeiro || ultimaBusca !== q) {
            await fetchResults(q);
            primeiro = dropdown.querySelector('.cf-search-item');
        }
        if (primeiro) window.location.href = primeiro.href;
    }

    input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
        if (e.key === 'Enter') { e.preventDefault(); irParaPrimeiro(); }
    });
    document.getElementById('cfSearchBtn')?.addEventListener('click', irParaPrimeiro);

    function close() {
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
    }

    // O dropdown é position:fixed (não absolute) porque o hero tem
    // overflow:hidden e cortava a lista sobrando só o primeiro resultado.
    // A posição é recalculada aqui em vez de fixa no CSS.
    function posicionarDropdown() {
        const r = input.closest('.cf-search-box').getBoundingClientRect();
        dropdown.style.left  = r.left + 'px';
        dropdown.style.top   = (r.bottom + 6) + 'px';
        dropdown.style.width = r.width + 'px';
    }

    window.addEventListener('resize', () => { if (dropdown.classList.contains('open')) posicionarDropdown(); });
    window.addEventListener('scroll', () => { if (dropdown.classList.contains('open')) posicionarDropdown(); }, true);

    let ultimaBusca = '';
    async function fetchResults(q) {
        ultimaBusca = q;
        try {
            const res = await fetch('/Home/Buscar?q=' + encodeURIComponent(q));
            const data = await res.json();
            render(data, q);
        } catch { close(); }
    }

    function esc(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function avatarHtml(item) {
        const cls = avatarClass[item.tipo] || '';
        const gerarFallback = fallbackIcon[item.tipo] || (() => '•');
        const fallback = `<span class="cf-avatar-fallback">${gerarFallback(item.nome)}</span>`;
        // A imagem fica sobreposta ao fallback; se a URL falhar (onerror), o
        // <img> some e o fallback (inicial/ícone) aparece por baixo.
        const img = item.imagem ? `<img src="${esc(item.imagem)}" alt="" onerror="this.remove()" />` : '';
        return `<span class="cf-search-avatar ${cls}">${fallback}${img}</span>`;
    }

    function render(items, q) {
        posicionarDropdown();

        if (!items.length) {
            dropdown.innerHTML = '<div class="cf-search-empty">Nenhum resultado encontrado.</div>';
            dropdown.classList.add('open');
            return;
        }

        const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');

        dropdown.innerHTML = items.map(item => {
            const url   = esc((urls[item.tipo] || (() => '#'))(item.id));
            const nome  = esc(item.nome || '').replace(re, '<mark style="background:#d4a520;color:#141414;border-radius:2px;padding:0 1px">$1</mark>');
            const badge = `<span class="cf-search-badge ${esc(badgeClass[item.tipo] || '')}">${esc(item.tipo)}</span>`;
            const extra = item.extra ? `<span class="cf-search-extra">${esc(item.extra)}</span>` : '';
            return `<a href="${url}" class="cf-search-item">${avatarHtml(item)}${badge}<span class="cf-search-nome">${nome}</span>${extra}</a>`;
        }).join('');

        dropdown.classList.add('open');
    }
})();
</script>
}
