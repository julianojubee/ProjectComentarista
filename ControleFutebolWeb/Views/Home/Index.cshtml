@model ControleFutebolWeb.Models.ViewModels.HomeViewModel
@using ControleFutebolWeb.Helpers

@{
    ViewData["Title"] = "Início";
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    /* ── Reset local ─────────────────────────────── */
    .cf-home * {
        box-sizing: border-box;
    }

    .cf-home {
        margin: 0 -12px; /* compensa o .container do layout pra ocupar a largura toda */
        background: var(--p-0);
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        border-radius: 14px;
        overflow: hidden;
    }

    .cf-home a { text-decoration: none; color: inherit; }
    .cf-home h1, .cf-home h2, .cf-home h3 { font-family: 'Barlow Condensed', Arial, sans-serif; }

    /* ── Hero ────────────────────────────────────── */
    .cf-hero {
        position: relative;
        overflow: hidden;
        min-height: 380px;
        background: #0a0a0a;
        display: flex;
        align-items: center;
    }

    .cf-hero-pattern {
        position: absolute;
        inset: 0;
        object-fit: cover;
        opacity: 0.05;
        pointer-events: none;
    }

    .cf-hero-fade-left {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #0a0a0a 40%, rgba(10,10,10,0.85) 60%, rgba(10,10,10,0.4) 80%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }

    .cf-hero-stripe {
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: #d4a520;
        z-index: 3;
    }

    /* ── Prancheta tática animada ────────────────── */
    .cf-hero-board {
        position: absolute;
        right: 3rem;
        top: 50%;
        transform: translateY(-50%) rotate(3deg);
        width: 272px;
        z-index: 1;
    }

    .cf-hero-board svg {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 18px 40px rgba(0,0,0,0.55));
        animation: cfFloat 7s ease-in-out infinite;
    }

    .cf-tatica-ball   { animation: cfBallMove 7.5s linear infinite; }
    .cf-tatica-runner { animation: cfRunnerMove 7.5s ease-in-out infinite; }
    .cf-tatica-linha1 { stroke-dasharray: 149; animation: cfLinha1 7.5s linear infinite; }
    .cf-tatica-linha2 { stroke-dasharray: 130; animation: cfLinha2 7.5s linear infinite; }
    .cf-tatica-linha3 { stroke-dasharray: 125; animation: cfLinha3 7.5s linear infinite; }
    .cf-tatica-corrida { stroke-dasharray: 5 6; animation: cfCorrida 0.9s linear infinite; }
    .cf-tatica-burst {
        transform-box: fill-box;
        transform-origin: center;
        animation: cfBurst 7.5s ease-out infinite;
    }

    @@keyframes cfFloat {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-8px); }
    }

    @@keyframes cfBallMove {
        0%, 8%   { transform: translate(110px, 380px); opacity: 1; }
        18%, 30% { transform: translate(250px, 330px); opacity: 1; }
        40%, 52% { transform: translate(285px, 205px); opacity: 1; }
        62%, 80% { transform: translate(178px, 142px); opacity: 1; }
        86%      { transform: translate(178px, 142px); opacity: 0; }
        96%      { transform: translate(110px, 380px); opacity: 0; }
        100%     { transform: translate(110px, 380px); opacity: 1; }
    }

    @@keyframes cfRunnerMove {
        0%, 30%  { transform: translate(140px, 300px); opacity: 1; }
        60%, 80% { transform: translate(165px, 150px); opacity: 1; }
        86%      { transform: translate(165px, 150px); opacity: 0; }
        96%      { transform: translate(140px, 300px); opacity: 0; }
        100%     { transform: translate(140px, 300px); opacity: 1; }
    }

    @@keyframes cfLinha1 {
        0%, 2%    { stroke-dashoffset: 149; opacity: 1; }
        8%, 78%   { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 149; opacity: 0; }
    }

    @@keyframes cfLinha2 {
        0%, 20%   { stroke-dashoffset: 130; opacity: 1; }
        28%, 78%  { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 130; opacity: 0; }
    }

    @@keyframes cfLinha3 {
        0%, 42%   { stroke-dashoffset: 125; opacity: 1; }
        50%, 78%  { stroke-dashoffset: 0; opacity: 1; }
        86%, 97%  { stroke-dashoffset: 0; opacity: 0; }
        98%, 100% { stroke-dashoffset: 125; opacity: 0; }
    }

    @@keyframes cfCorrida {
        to { stroke-dashoffset: -11; }
    }

    @@keyframes cfBurst {
        0%, 61%   { opacity: 0; transform: scale(0.3); }
        66%       { opacity: 0.85; transform: scale(1); }
        76%, 100% { opacity: 0; transform: scale(1.9); }
    }

    .cf-hero-content {
        position: relative;
        z-index: 3;
        padding: 2.5rem 3rem;
        max-width: 620px;
    }

    .cf-hero-kicker {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    .cf-hero-kicker-line { height: 2px; width: 28px; background: #d4a520; }

    .cf-hero-kicker span {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        color: var(--gold-ink);
        text-transform: uppercase;
    }

    .cf-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.05;
        color: var(--text-strong);
        margin: 0 0 14px;
        letter-spacing: -0.01em;
    }

    .cf-hero h1 .gold { color: var(--gold-ink); }

    .cf-hero p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0 0 26px;
        max-width: 420px;
        line-height: 1.6;
    }

    /* ── Search ──────────────────────────────────── */
    .cf-search-wrap { position: relative; max-width: 460px; }

    .cf-search-box {
        display: flex;
        align-items: stretch;
        background: var(--p-2);
        border: 1px solid var(--line);
        border-radius: 9px;
        overflow: hidden;
        transition: border-color 0.15s;
    }

    .cf-search-box:focus-within { border-color: #d4a520; }

    .cf-search-icon {
        display: flex;
        align-items: center;
        padding: 0 14px;
        color: #666;
        flex-shrink: 0;
    }

    .cf-search-input {
        flex: 1;
        padding: 13px 4px;
        background: transparent;
        border: none;
        color: var(--text-strong);
        font-size: 0.88rem;
        outline: none;
        font-family: inherit;
    }

    .cf-search-input::placeholder { color: #666; }

    .cf-search-btn {
        padding: 0 22px;
        background: #d4a520;
        color: #141414;
        font-weight: 700;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        letter-spacing: 0.04em;
        flex-shrink: 0;
        transition: background 0.15s;
    }

    .cf-search-btn:hover { background: #c49918; }

    /* position:fixed (não absolute) porque o .cf-hero tem overflow:hidden —
       um dropdown absoluto ficava cortado no fim da faixa do hero, escondendo
       todos os resultados menos o primeiro. A posição é calculada via JS
       (posicionarDropdown) a partir do retângulo da caixa de busca. */
    .cf-search-dropdown {
        position: fixed;
        background: var(--p-2);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.4);
        z-index: 999;
        overflow-y: auto;
        max-height: min(60vh, 420px);
        display: none;
    }

    .cf-search-dropdown.open { display: block; }

    .cf-search-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        text-decoration: none;
        color: var(--text);
        font-size: 13px;
        border-bottom: 1px solid var(--line);
        transition: background .1s;
    }

    .cf-search-item:last-child { border-bottom: none; }
    .cf-search-item:hover { background: var(--p-3); text-decoration: none; color: inherit; }

    .cf-search-avatar {
        position: relative;
        width: 26px; height: 26px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
        background: var(--p-4);
        border: 1px solid var(--line);
    }
    .cf-search-avatar img {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
    }
    .cf-avatar-time img    { object-fit: contain; padding: 3px; }
    .cf-avatar-jogador img { object-fit: cover; }
    .cf-avatar-fallback {
        font-size: 11px; color: var(--text-dim); display: flex; align-items: center; justify-content: center;
    }

    .cf-search-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 20px;
        letter-spacing: .04em;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .cf-badge-time       { background: rgba(56,138,221,0.18);  color: #7db8ee; }
    .cf-badge-jogador    { background: rgba(34,197,94,0.16);   color: #6ee0a0; }
    .cf-badge-competicao { background: rgba(212,165,32,0.18);  color: #eecb6c; }

    .cf-search-nome  { flex: 1; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cf-search-extra { font-size: 11px; color: var(--text-dim); }
    .cf-search-empty { padding: 14px; text-align: center; color: var(--text-dim); font-size: 13px; }

    /* ── Stats bar ───────────────────────────────── */
    .cf-stats {
        background: var(--p-1);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .cf-stat-card {
        padding: 20px 28px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-right: 1px solid var(--line);
        transition: background 0.15s;
    }

    .cf-stat-card:last-child { border-right: none; }
    .cf-stat-card:hover { background: var(--p-2); }

    .cf-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(212,165,32,0.12);
        border: 1px solid rgba(212,165,32,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cf-stat-num {
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--gold-ink);
        line-height: 1;
    }

    .cf-stat-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--text-dim);
        text-transform: uppercase;
        margin-top: 3px;
    }

    /* ── Section label ───────────────────────────── */
    .cf-section-label {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .cf-section-label span {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--text-dim);
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cf-section-label .line { flex: 1; height: 1px; background: var(--p-3); }

    .cf-section-link {
        font-size: 0.72rem;
        color: var(--gold-ink);
        font-weight: 700;
        letter-spacing: 0.04em;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .cf-section-link:hover { color: var(--gold-ink); }

    /* ── Acesso rápido ───────────────────────────── */
    .cf-quick-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 12px;
        padding: 0 2.5rem;
        margin-bottom: 2rem;
    }

    .cf-quick-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 9px;
        padding: 18px 10px 16px;
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        transition: all 0.18s;
    }

    .cf-quick-card:hover {
        background: var(--p-3);
        border-color: #d4a520;
        transform: translateY(-2px);
    }

    .cf-quick-card .icon { font-size: 1.6rem; line-height: 1; }
    .cf-quick-card .label { font-size: 0.82rem; font-weight: 700; color: var(--text-strong); text-align: center; }
    .cf-quick-card .desc  { font-size: 0.68rem; color: var(--text-dim); font-weight: 500; text-align: center; }

    /* ── Main grid ───────────────────────────────── */
    .cf-main-grid {
        padding: 0 2.5rem 2.5rem;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 26px;
        align-items: start;
    }

    /* ── Jogos recentes ──────────────────────────── */
    .cf-games-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .cf-game-card {
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px 16px;
        transition: border-color 0.18s;
    }

    .cf-game-card:hover { border-color: var(--line-strong); }

    .cf-game-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .cf-game-comp {
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--gold-ink);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cf-game-date { font-size: 0.65rem; color: var(--text-dimmer); font-weight: 600; flex-shrink: 0; }

    .cf-game-teams { display: flex; align-items: center; gap: 7px; }

    .cf-team-badge {
        width: 22px; height: 22px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--p-0);
        border: 1px solid var(--line);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .cf-team-badge img { width: 100%; height: 100%; object-fit: contain; }
    .cf-team-badge-abbr { font-size: 8px; font-weight: 700; color: var(--text-dim); }

    .cf-team-name {
        flex: 1;
        font-size: 0.82rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .cf-score {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-strong);
        background: var(--p-0);
        padding: 2px 11px;
        border-radius: 7px;
        flex-shrink: 0;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .cf-game-footer {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--line);
    }

    .cf-analisar-link {
        font-size: 0.7rem;
        color: var(--text-dim);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .cf-analisar-link:hover { color: var(--gold-ink); }

    .cf-empty {
        grid-column: 1 / -1;
        font-size: 12px;
        color: var(--text-dim);
        text-align: center;
        padding: 1.5rem 0;
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
    }

    /* ── Classificação ───────────────────────────── */
    .cf-classif-panel {
        background: var(--p-1);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }

    .cf-classif-head {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        background: var(--p-0);
        border-bottom: 1px solid var(--line);
    }

    .cf-classif-head span {
        font-size: 0.6rem;
        color: var(--text-dimmer);
        font-weight: 700;
        text-transform: uppercase;
    }

    .cf-classif-row {
        display: flex;
        align-items: center;
        padding: 9px 16px;
        border-bottom: 1px solid var(--line-soft);
        transition: background 0.15s;
    }

    .cf-classif-row:last-child { border-bottom: none; }
    .cf-classif-row:hover { background: var(--p-3); }

    .cf-classif-bar { width: 3px; height: 26px; border-radius: 2px; flex-shrink: 0; margin-right: 10px; }

    .cf-classif-pos { width: 20px; font-size: 0.78rem; font-weight: 700; flex-shrink: 0; }
    .cf-classif-pos.top  { color: var(--gold-ink); }
    .cf-classif-pos.mid  { color: var(--text-dim); }
    .cf-classif-pos.drop { color: var(--bad-2); }

    .cf-classif-time {
        flex: 1;
        font-size: 0.82rem;
        color: var(--text);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 8px;
        min-width: 0;
    }

    .cf-classif-cols { display: flex; gap: 0; flex-shrink: 0; }
    .cf-classif-cols span { width: 26px; font-size: 0.75rem; color: var(--text-dim); text-align: center; }
    .cf-classif-cols .pts { width: 32px; font-size: 0.82rem; color: var(--gold-ink); font-weight: 800; }

    /* ── Responsivo ──────────────────────────────── */
    @@media (max-width: 1023px) {
        .cf-hero-board { display: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cf-hero-board svg, .cf-hero-board svg * { animation: none !important; }
    }

    @@media (max-width: 900px) {
        .cf-main-grid { grid-template-columns: 1fr; }
        .cf-games-grid { grid-template-columns: 1fr; }
        .cf-stats { grid-template-columns: repeat(2, 1fr); }
        .cf-stat-card:nth-child(2) { border-right: none; }
    }

    @@media (max-width: 640px) {
        .cf-hero-content { padding: 2rem 1.4rem; max-width: 100%; }
        .cf-hero h1 { font-size: 2rem; }
        .cf-quick-grid, .cf-main-grid { padding-left: 1.2rem; padding-right: 1.2rem; }
        .cf-stats { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="cf-home">

    <!-- Hero -->
    <div class="cf-hero theme-dark-zone">
        <img class="cf-hero-pattern" src="~/Images/banner/escudos-pattern.svg" alt="" />
        <div class="cf-hero-fade-left"></div>
        <div class="cf-hero-stripe"></div>
        <div class="cf-hero-board" aria-hidden="true">
            <svg viewBox="0 0 360 470" xmlns="http://www.w3.org/2000/svg">
                <!-- prancheta -->
                <rect x="6" y="20" width="348" height="444" rx="16" fill="#191919" stroke="#333" stroke-width="1.5" />
                <rect x="140" y="6" width="80" height="28" rx="9" fill="#d4a520" />
                <rect x="158" y="13" width="44" height="9" rx="4.5" fill="#0f0f0f" />
                <text x="34" y="53" font-family="'Barlow Condensed', Arial, sans-serif" font-size="14" font-weight="700" letter-spacing="3" fill="#6b7280">PLANO DE JOGO</text>
                <text x="326" y="53" text-anchor="end" font-family="'Barlow Condensed', Arial, sans-serif" font-size="14" font-weight="700" letter-spacing="2" fill="#d4a520">4-3-3</text>

                <!-- campo -->
                <g stroke="rgba(255,255,255,0.16)" stroke-width="1.5" fill="none">
                    <rect x="28" y="64" width="304" height="376" rx="4" fill="rgba(255,255,255,0.02)" />
                    <line x1="28" y1="252" x2="332" y2="252" />
                    <circle cx="180" cy="252" r="36" />
                    <rect x="104" y="64" width="152" height="58" />
                    <rect x="140" y="64" width="80" height="24" />
                    <rect x="104" y="382" width="152" height="58" />
                    <rect x="140" y="416" width="80" height="24" />
                </g>
                <circle cx="180" cy="252" r="2.5" fill="rgba(255,255,255,0.25)" />
                <rect x="150" y="59" width="60" height="5" rx="1.5" fill="rgba(212,165,32,0.5)" />

                <!-- adversários (X) -->
                <g stroke="#4b5563" stroke-width="2.5" stroke-linecap="round">
                    <path d="M124 154 l12 12 M136 154 l-12 12" />
                    <path d="M224 174 l12 12 M236 174 l-12 12" />
                    <path d="M172 209 l12 12 M184 209 l-12 12" />
                    <path d="M89 134 l12 12 M101 134 l-12 12" />
                    <path d="M259 144 l12 12 M271 144 l-12 12" />
                </g>

                <!-- corrida do camisa 9 (seta tracejada) -->
                <path class="cf-tatica-corrida" d="M140 300 C150 245 172 195 165 150" stroke="rgba(212,165,32,0.55)" stroke-width="2" fill="none" />
                <path d="M158 159 L165 148 L172 159" stroke="rgba(212,165,32,0.55)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />

                <!-- linhas de passe (desenham em sequência) -->
                <line class="cf-tatica-linha1" x1="110" y1="380" x2="250" y2="330" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />
                <line class="cf-tatica-linha2" x1="250" y1="330" x2="285" y2="205" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />
                <line class="cf-tatica-linha3" x1="285" y1="205" x2="178" y2="142" stroke="rgba(229,231,235,0.75)" stroke-width="2" stroke-linecap="round" />

                <!-- jogadores (ouro) -->
                <g font-family="'Barlow', Arial, sans-serif" font-size="8.5" font-weight="800" text-anchor="middle">
                    <circle cx="180" cy="428" r="8" fill="#d4a520" />
                    <text x="180" y="431" fill="#141414">1</text>
                    <circle cx="70" cy="355" r="8" fill="#d4a520" />
                    <text x="70" y="358" fill="#141414">4</text>
                    <circle cx="110" cy="380" r="8" fill="#d4a520" />
                    <text x="110" y="383" fill="#141414">6</text>
                    <circle cx="250" cy="330" r="8" fill="#d4a520" />
                    <text x="250" y="333" fill="#141414">8</text>
                    <circle cx="285" cy="205" r="8" fill="#d4a520" />
                    <text x="285" y="208" fill="#141414">7</text>
                </g>

                <!-- camisa 9 correndo pra área -->
                <g class="cf-tatica-runner" transform="translate(140 300)">
                    <circle r="8" fill="#d4a520" stroke="#f0c040" stroke-width="1" />
                    <text y="3" text-anchor="middle" font-family="'Barlow', Arial, sans-serif" font-size="8.5" font-weight="800" fill="#141414">9</text>
                </g>

                <!-- explosão do gol -->
                <circle class="cf-tatica-burst" cx="178" cy="142" r="12" fill="none" stroke="#d4a520" stroke-width="2" style="opacity:0" />

                <!-- bola -->
                <g class="cf-tatica-ball" transform="translate(110 380)">
                    <circle r="5" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
                    <path d="M-1.8 -1.5 L1.8 -1.5 L2.8 1 L0 2.6 L-2.8 1 Z" fill="#334155" opacity="0.8" />
                </g>
            </svg>
        </div>

        <div class="cf-hero-content">
            <div class="cf-hero-kicker">
                <div class="cf-hero-kicker-line"></div>
                <span>Dashboard principal</span>
            </div>

            <h1>Análise de futebol,<br /><span class="gold">sem planilha.</span></h1>
            <p>Gerencie times, jogadores e competições. Avalie partidas com critérios configuráveis. Tudo em um lugar.</p>

            <div class="cf-search-wrap">
                <div class="cf-search-box">
                    <span class="cf-search-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    </span>
                    <input id="cfSearchInput" type="text" class="cf-search-input"
                           placeholder="Buscar time, jogador ou competição..." autocomplete="off" />
                    <button type="button" class="cf-search-btn">Buscar</button>
                </div>
                <div id="cfSearchDropdown" class="cf-search-dropdown"></div>
            </div>
        </div>
    </div>

    <!-- Stats bar -->
    <div class="cf-stats">
        <div class="cf-stat-card">
            <div class="cf-stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d4a520" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
            </div>
            <div>
                <div class="cf-stat-num" data-count="@Model.TotalTimes">0</div>
                <div class="cf-stat-label">Times</div>
            </div>
        </div>
        <div class="cf-stat-card">
            <div class="cf-stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d4a520" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div>
                <div class="cf-stat-num" data-count="@Model.TotalJogadores">0</div>
                <div class="cf-stat-label">Jogadores</div>
            </div>
        </div>
        <div class="cf-stat-card">
            <div class="cf-stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d4a520" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 8v4l3 3" /></svg>
            </div>
            <div>
                <div class="cf-stat-num" data-count="@Model.TotalJogos">0</div>
                <div class="cf-stat-label">Jogos</div>
            </div>
        </div>
        <div class="cf-stat-card">
            <div class="cf-stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d4a520" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" /></svg>
            </div>
            <div>
                <div class="cf-stat-num" data-count="@Model.TotalCompeticoes">0</div>
                <div class="cf-stat-label">Competições</div>
            </div>
        </div>
    </div>

    <!-- Acesso rápido -->
    <div style="padding: 2.2rem 2.5rem 0;">
        <div class="cf-section-label">
            <span>Acesso rápido</span>
            <div class="line"></div>
        </div>
    </div>
    <div class="cf-quick-grid">
        <a href="@Url.Action("Index", "Jogadores")" class="cf-quick-card">
            <span class="icon">⚽</span>
            <div class="label">Jogadores</div>
            <div class="desc">@Model.TotalJogadores cadastrados</div>
        </a>
        <a href="@Url.Action("Index", "Times")" class="cf-quick-card">
            <span class="icon">🏟</span>
            <div class="label">Times</div>
            <div class="desc">@Model.TotalTimes clubes</div>
        </a>
        <a href="@Url.Action("Index", "Competicoes")" class="cf-quick-card">
            <span class="icon">🏆</span>
            <div class="label">Competições</div>
            <div class="desc">@Model.TotalCompeticoes competições</div>
        </a>
        <a href="@Url.Action("Index", "Jogos")" class="cf-quick-card">
            <span class="icon">📋</span>
            <div class="label">Jogos</div>
            <div class="desc">@Model.TotalJogos partidas</div>
        </a>
        <a href="@Url.Action("Create", "Jogos")" class="cf-quick-card">
            <span class="icon">➕</span>
            <div class="label">Novo jogo</div>
            <div class="desc">Cadastrar partida</div>
        </a>
        <a href="@Url.Action("Scout", "Relatorios")" class="cf-quick-card">
            <span class="icon">🔍</span>
            <div class="label">Scout</div>
            <div class="desc">Busca avançada</div>
        </a>
        <a href="@Url.Action("Index", "Relatorios")" class="cf-quick-card">
            <span class="icon">📊</span>
            <div class="label">Relatórios</div>
            <div class="desc">Estatísticas gerais</div>
        </a>
    </div>

    <!-- Jogos recentes + Classificação -->
    <div class="cf-main-grid">

        <!-- Jogos recentes -->
        <div>
            <div class="cf-section-label">
                <span>Últimos resultados</span>
                <div class="line"></div>
                <a href="@Url.Action("Index", "Jogos")" class="cf-section-link">ver todos &rarr;</a>
            </div>

            <div class="cf-games-grid">
                @if (!Model.JogosRecentes.Any())
                {
                    <div class="cf-empty">Nenhum jogo finalizado ainda.</div>
                }
                else
                {
                    @foreach (var jogo in Model.JogosRecentes)
                    {
                        bool casaVenceu = (jogo.PlacarCasa ?? 0) > (jogo.PlacarVisitante ?? 0);
                        bool visVenceu = (jogo.PlacarVisitante ?? 0) > (jogo.PlacarCasa ?? 0);

                        <a href="@Url.Action("Analisar", "Jogos", new { id = jogo.Id })" class="cf-game-card" style="display:block;">
                            <div class="cf-game-top">
                                <span class="cf-game-comp">@(jogo.Competicao?.Nome ?? "—")</span>
                                <span class="cf-game-date">@DateHelper.FormatarData(jogo.Data, "dd/MM")</span>
                            </div>
                            <div class="cf-game-teams">
                                <div class="cf-team-badge">
                                    @if (!string.IsNullOrEmpty(jogo.TimeCasa?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeCasa.EscudoUrl })" alt="@jogo.TimeCasa.Nome" />
                                    }
                                    else
                                    {
                                        <span class="cf-team-badge-abbr">
                                            @(jogo.TimeCasa?.Nome?.Length >= 3 ? jogo.TimeCasa.Nome.Substring(0, 3).ToUpper() : jogo.TimeCasa?.Nome)
                                        </span>
                                    }
                                </div>
                                <span class="cf-team-name" style="font-weight:@(casaVenceu ? "700" : "500"); color:@(casaVenceu ? "var(--text-strong)" : "var(--text-muted)");">@jogo.TimeCasa?.Nome</span>
                                <span class="cf-score">
                                    @jogo.PlacarCasa &ndash; @jogo.PlacarVisitante
                                </span>
                                <span class="cf-team-name" style="text-align:right; font-weight:@(visVenceu ? "700" : "500"); color:@(visVenceu ? "var(--text-strong)" : "var(--text-muted)");">@jogo.TimeVisitante?.Nome</span>
                                <div class="cf-team-badge">
                                    @if (!string.IsNullOrEmpty(jogo.TimeVisitante?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeVisitante.EscudoUrl })" alt="@jogo.TimeVisitante.Nome" />
                                    }
                                    else
                                    {
                                        <span class="cf-team-badge-abbr">
                                            @(jogo.TimeVisitante?.Nome?.Length >= 3 ? jogo.TimeVisitante.Nome.Substring(0, 3).ToUpper() : jogo.TimeVisitante?.Nome)
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (jogo.PenaltisCasa.HasValue && jogo.PenaltisVisitante.HasValue)
                            {
                                <div style="text-align:center; font-size:0.65rem; color:var(--text-dim); margin-top:4px">(@jogo.PenaltisCasa-@jogo.PenaltisVisitante pên.)</div>
                            }
                            <div class="cf-game-footer">
                                <span class="cf-analisar-link">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 12h20M16 6l6 6-6 6" /></svg>
                                    Analisar partida
                                </span>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Classificação -->
        <div>
            <div class="cf-section-label">
                <span>Classificação</span>
                <div class="line"></div>
                <a href="@Url.Action("Index", "Competicoes")" class="cf-section-link">ver completa &rarr;</a>
            </div>

            @if (!Model.Classificacao.Any())
            {
                <div class="cf-empty">Nenhum dado disponível ainda.</div>
            }
            else
            {
                <div class="cf-classif-panel">
                    <div class="cf-classif-head">
                        <div style="width:3px; margin-right:10px; flex-shrink:0;"></div>
                        <span style="width:20px; flex-shrink:0;">#</span>
                        <div style="width:22px; flex-shrink:0;"></div>
                        <span style="flex:1;">Time</span>
                        <div class="cf-classif-cols">
                            <span>J</span><span>V</span><span>E</span><span>D</span><span class="pts">Pts</span>
                        </div>
                    </div>

                    @foreach (var c in Model.Classificacao)
                    {
                        string faixa = c.Posicao <= 4 ? "top" : (c.Posicao >= Model.Classificacao.Count - 2 ? "drop" : "mid");
                        string corBarra = faixa == "top" ? "#d4a520" : (faixa == "drop" ? "#ef4444" : "#374151");

                        <div class="cf-classif-row">
                            <div class="cf-classif-bar" style="background:@corBarra;"></div>
                            <span class="cf-classif-pos @faixa">@c.Posicao</span>
                            <div class="cf-team-badge" style="margin-right:6px;">
                                @if (!string.IsNullOrEmpty(c.Time?.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = c.Time.EscudoUrl })" alt="@c.Time.Nome" />
                                }
                                else
                                {
                                    <span class="cf-team-badge-abbr">
                                        @(c.Time?.Nome?.Length >= 3 ? c.Time.Nome.Substring(0, 3).ToUpper() : c.Time?.Nome)
                                    </span>
                                }
                            </div>
                            <span class="cf-classif-time">@c.Time?.Nome</span>
                            <div class="cf-classif-cols">
                                <span>@c.Jogos</span><span>@c.Vitorias</span><span>@c.Empates</span><span>@c.Derrotas</span>
                                <span class="pts">@c.Pontos</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    // ── Contadores animados da barra de estatísticas ──────────────────
    document.querySelectorAll('.cf-stat-num[data-count]').forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var duration = 1200;
        var start = performance.now();
        function animate(now) {
            var p = Math.min((now - start) / duration, 1);
            var ease = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * ease).toLocaleString('pt-BR');
            if (p < 1) requestAnimationFrame(animate);
        }
        requestAnimationFrame(animate);
    });

    // ── Busca global (time / jogador / competição) ────────────────────
    const input = document.getElementById('cfSearchInput');
    const dropdown = document.getElementById('cfSearchDropdown');
    if (!input || !dropdown) return;

    const urls = {
        Time:       id => '/Times/Details/' + id,
        Jogador:    id => '/Jogadores/Estatisticas/' + id,
        Competição: id => '/Competicoes/Detalhes/' + id,
    };

    const badgeClass = {
        Time:       'cf-badge-time',
        Jogador:    'cf-badge-jogador',
        Competição: 'cf-badge-competicao',
    };

    const avatarClass = {
        Time:       'cf-avatar-time',
        Jogador:    'cf-avatar-jogador',
        Competição: 'cf-avatar-competicao',
    };

    // Ícone/inicial exibido enquanto a imagem carrega, ou quando não há
    // imagem/a URL falha — diferencia o tipo mesmo sem escudo/foto.
    const fallbackIcon = {
        Time: (nome) => esc((nome || '').trim().charAt(0).toUpperCase() || '?'),
        Jogador: () => '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7z"/></svg>',
        Competição: () => '🏆',
    };

    let timer;

    input.addEventListener('input', function () {
        clearTimeout(timer);
        const q = this.value.trim();
        if (q.length < 2) { close(); return; }
        timer = setTimeout(() => fetchResults(q), 220);
    });

    document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) close();
    });

    input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
    });

    function close() {
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
    }

    // O dropdown é position:fixed (não absolute) porque o hero tem
    // overflow:hidden e cortava a lista sobrando só o primeiro resultado.
    // A posição é recalculada aqui em vez de fixa no CSS.
    function posicionarDropdown() {
        const r = input.closest('.cf-search-box').getBoundingClientRect();
        dropdown.style.left  = r.left + 'px';
        dropdown.style.top   = (r.bottom + 6) + 'px';
        dropdown.style.width = r.width + 'px';
    }

    window.addEventListener('resize', () => { if (dropdown.classList.contains('open')) posicionarDropdown(); });
    window.addEventListener('scroll', () => { if (dropdown.classList.contains('open')) posicionarDropdown(); }, true);

    async function fetchResults(q) {
        try {
            const res = await fetch('/Home/Buscar?q=' + encodeURIComponent(q));
            const data = await res.json();
            render(data, q);
        } catch { close(); }
    }

    function esc(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function avatarHtml(item) {
        const cls = avatarClass[item.tipo] || '';
        const gerarFallback = fallbackIcon[item.tipo] || (() => '•');
        const fallback = `<span class="cf-avatar-fallback">${gerarFallback(item.nome)}</span>`;
        // A imagem fica sobreposta ao fallback; se a URL falhar (onerror), o
        // <img> some e o fallback (inicial/ícone) aparece por baixo.
        const img = item.imagem ? `<img src="${esc(item.imagem)}" alt="" onerror="this.remove()" />` : '';
        return `<span class="cf-search-avatar ${cls}">${fallback}${img}</span>`;
    }

    function render(items, q) {
        posicionarDropdown();

        if (!items.length) {
            dropdown.innerHTML = '<div class="cf-search-empty">Nenhum resultado encontrado.</div>';
            dropdown.classList.add('open');
            return;
        }

        const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');

        dropdown.innerHTML = items.map(item => {
            const url   = esc((urls[item.tipo] || (() => '#'))(item.id));
            const nome  = esc(item.nome || '').replace(re, '<mark style="background:#d4a520;color:#141414;border-radius:2px;padding:0 1px">$1</mark>');
            const badge = `<span class="cf-search-badge ${esc(badgeClass[item.tipo] || '')}">${esc(item.tipo)}</span>`;
            const extra = item.extra ? `<span class="cf-search-extra">${esc(item.extra)}</span>` : '';
            return `<a href="${url}" class="cf-search-item">${avatarHtml(item)}${badge}<span class="cf-search-nome">${nome}</span>${extra}</a>`;
        }).join('');

        dropdown.classList.add('open');
    }
})();
</script>
}
