@model ControleFutebolWeb.Models.Nba.NbaDetalheJogo
@using ControleFutebolWeb.Models.Nba
@{
    var j = Model.Jogo;
    ViewData["Title"] = $"NBA — {j.Visitante.Time.Sigla} @ {j.Casa.Time.Sigla}";
    ViewData["NbaAba"] = "jogos";
    var vivo = j.Situacao == NbaSituacao.AoVivo;
    var temPlacar = j.Situacao != NbaSituacao.Agendado && j.Casa.Placar != null;
    var diaRodada = NbaViewHelper.Brasilia(j.InicioUtc).Date;
    var periodos = Math.Max(j.Casa.Parciais.Count, j.Visitante.Parciais.Count);
    string NomePeriodo(int p) => p <= 4 ? $"{p}º" : p == 5 ? "PR" : $"PR{p - 4}";
    string NomePeriodoLongo(int p) => p <= 4 ? $"{p}º quarto" : p == 5 ? "Prorrogação" : $"{p - 4}ª prorrogação";
    var siglaPorTime = new Dictionary<string, NbaTimeResumo> { [j.Casa.Time.Id] = j.Casa.Time, [j.Visitante.Time.Id] = j.Visitante.Time };
}

@section Styles {
    <link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nba.css" asp-append-version="true" />
}

<div class="nba-root">
    <header class="nba-cab">
        <div class="nba-cab-topo">
            <div class="nba-cab-marca">🏀 NBA · @NbaViewHelper.Capitalizar(NbaViewHelper.DataHora(j.InicioUtc))</div>
            <a class="nba-nav-btn" asp-action="Index" asp-route-data="@diaRodada.ToString("yyyy-MM-dd")">◀ Jogos do dia</a>
        </div>

        <div class="nba-placar">
            @foreach (var lado in new[] { j.Visitante, j.Casa })
            {
                var outro = lado.Casa ? j.Visitante : j.Casa;
                var perde = j.Situacao == NbaSituacao.Encerrado && lado.Placar < outro.Placar;
                if (lado.Casa)
                {
                    <div class="nba-placar-meio">
                        @if (vivo) { <span class="vivo"><span class="nba-ponto-vivo"></span> @j.Status</span> }
                        else if (j.Situacao == NbaSituacao.Agendado) { <span>@NbaViewHelper.Horario(j.InicioUtc, diaRodada)</span> }
                        else { <span>@j.Status</span> }
                        @if (j.Ginasio != null) { <small style="font-weight:500;opacity:.7">@j.Ginasio</small> }
                    </div>
                }
                <a class="nba-placar-time @(lado.Casa ? "casa" : "") @(perde ? "perde" : "")" asp-action="Time" asp-route-id="@lado.Time.Id">
                    @if (lado.Time.Logo != null) { <img class="nba-logo g" src="@lado.Time.Logo" alt="" /> }
                    <div>
                        <div class="nome">@lado.Time.Nome</div>
                        <small>@(lado.Campanha ?? "") · @(lado.Casa ? "mandante" : "visitante")</small>
                    </div>
                    <span class="pts">@(temPlacar ? lado.Placar.ToString() : "")</span>
                </a>
            }
        </div>

        <partial name="_NbaAbas" />
    </header>

    <div class="nba-conteudo">
        @if (temPlacar && periodos > 0)
        {
            <section class="nba-secao">
                <h2>Placar por quarto</h2>
                <div class="nba-tabela-wrap">
                    <table class="nba-tabela">
                        <thead>
                            <tr>
                                <th class="e">Time</th>
                                @for (var p = 1; p <= periodos; p++) { <th>@NomePeriodo(p)</th> }
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lado in new[] { j.Visitante, j.Casa })
                            {
                                <tr>
                                    <td class="e"><span class="nba-time-cel">@if (lado.Time.Logo != null) { <img class="nba-logo p" src="@lado.Time.Logo" alt="" /> } @lado.Time.Nome</span></td>
                                    @for (var p = 0; p < periodos; p++) { <td>@(p < lado.Parciais.Count ? lado.Parciais[p].ToString() : "")</td> }
                                    <td class="destaque">@lado.Placar</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <div class="nba-info">
            @if (ViewData["CanaisBrasil"] is IReadOnlyList<string> canaisBr)
            {
                <span class="nba-tv">📺 No Brasil: @foreach (var tv in canaisBr) { <span class="nba-tag br">@tv</span> }</span>
            }
            else if (j.Situacao is NbaSituacao.Agendado or NbaSituacao.AoVivo)
            {
                <span>📺 No Brasil: <span class="nba-tv-pendente">a confirmar</span></span>
            }
            @if (j.Transmissao.Any()) { <span>EUA: <b>@string.Join(", ", j.Transmissao)</b></span> }
            @if (Model.Confronto != null) { <span>Na temporada: <b>@Model.Confronto</b></span> }
            @if (Model.Publico is int pub && pub > 0) { <span>Público: <b>@pub.ToString("N0", NbaViewHelper.PtBr)</b></span> }
            @if (Model.Arbitros.Any()) { <span>Arbitragem: <b>@string.Join(", ", Model.Arbitros)</b></span> }
        </div>

        @if (j.Visitante.Lideres.Any() || j.Casa.Lideres.Any())
        {
            <section class="nba-secao">
                <h2>Destaques</h2>
                <div class="nba-duas">
                    @foreach (var lado in new[] { j.Visitante, j.Casa })
                    {
                        <div class="nba-lider-card">
                            <h3><span>@lado.Time.Nome</span></h3>
                            <ol class="nba-lider-lista">
                                @foreach (var l in lado.Lideres)
                                {
                                    <li style="grid-template-columns: 40px 36px minmax(0,1fr) auto">
                                        <span class="i">@NbaViewHelper.SiglaLider(l.Categoria)</span>
                                        @if (l.Foto != null) { <img class="nba-foto" src="@l.Foto" alt="" loading="lazy" /> } else { <span></span> }
                                        <a class="n nba-time-link" asp-action="Jogador" asp-route-id="@l.AtletaId">@l.Nome</a>
                                        <span class="v">@l.Valor</span>
                                    </li>
                                }
                            </ol>
                        </div>
                    }
                </div>
            </section>
        }

        @foreach (var box in Model.Box.Where(b => b.Atletas.Any()))
        {
            var titulares = box.Atletas.Where(a => a.Titular).ToList();
            var reservas = box.Atletas.Where(a => !a.Titular).ToList();
            <section class="nba-secao">
                <h2>
                    @if (box.Time.Logo != null) { <img class="nba-logo" src="@box.Time.Logo" alt="" /> }
                    @box.Time.Nome <small>estatísticas individuais</small>
                </h2>
                <div class="nba-tabela-wrap">
                    <table class="nba-tabela">
                        <thead>
                            <tr>
                                <th class="e">Jogador</th>
                                @foreach (var c in box.Colunas) { <th>@c</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (grupo, atletas) in new[] { ("Titulares", titulares), ("Reservas", reservas) })
                            {
                                if (!atletas.Any()) { continue; }
                                <tr><td class="e" colspan="@(box.Colunas.Count + 1)" style="background:var(--p-1);font-weight:700;color:var(--text-dim);font-size:.76rem;text-transform:uppercase">@grupo</td></tr>
                                foreach (var a in atletas)
                                {
                                    var semStats = a.NaoJogou || a.Valores.Count == 0;
                                    <tr class="@(semStats ? "nba-dnp" : "")">
                                        <td class="e"><a class="nba-time-link" style="font-weight:700;color:var(--text-strong)" asp-action="Jogador" asp-route-id="@a.AtletaId">@a.Nome</a> <small style="color:var(--text-dim)">@a.Posicao</small></td>
                                        @if (semStats)
                                        {
                                            <td colspan="@box.Colunas.Count">@(a.Motivo ?? "Não jogou")</td>
                                        }
                                        else
                                        {
                                            for (var i = 0; i < box.Colunas.Count; i++)
                                            {
                                                <td class="@(box.Colunas[i] == "PTS" ? "destaque" : "")">@(i < a.Valores.Count ? a.Valores[i] : "")</td>
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (box.Totais.Any(t => t != ""))
                        {
                            <tfoot>
                                <tr>
                                    <td class="e">Total</td>
                                    @for (var i = 0; i < box.Colunas.Count; i++) { <td>@(i < box.Totais.Count ? box.Totais[i] : "")</td> }
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </section>
        }

        <div class="nba-duas">
            @if (Model.EstatisticasTimes.Any())
            {
                <section class="nba-secao">
                    <h2>Comparativo dos times</h2>
                    <div class="nba-tabela-wrap">
                        <table class="nba-comparativo">
                            <thead>
                                <tr>
                                    <td>@j.Visitante.Time.Sigla</td>
                                    <td></td>
                                    <td>@j.Casa.Time.Sigla</td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.EstatisticasTimes)
                                {
                                    <tr><td>@e.Visitante</td><td>@e.Nome</td><td>@e.Casa</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            @if (Model.Lesoes.Any())
            {
                <section class="nba-secao">
                    <h2>Departamento médico</h2>
                    <div class="nba-tabela-wrap">
                        <table class="nba-tabela">
                            <thead><tr><th class="e">Time</th><th class="e">Jogador</th><th class="e">Situação</th><th class="e">Lesão</th></tr></thead>
                            <tbody>
                                @foreach (var l in Model.Lesoes)
                                {
                                    var t = siglaPorTime.GetValueOrDefault(l.TimeId);
                                    <tr>
                                        <td class="e">@if (t?.Logo != null) { <img class="nba-logo p" src="@t.Logo" alt="@t.Sigla" /> } else { @t?.Sigla }</td>
                                        <td class="e">@l.Nome</td>
                                        <td class="e nba-lesao">@l.Status</td>
                                        <td class="e">@(l.Detalhe ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        @if (Model.Lances.Any())
        {
            <section class="nba-secao" id="lances">
                <h2>Jogada a jogada <small>@Model.Lances.Count lances</small></h2>
                <div class="nba-filtro-lances" role="group" aria-label="Filtrar lances">
                    <button type="button" class="nba-chip" aria-pressed="false" data-filtro="pontos">Só cestas</button>
                    @for (var p = 1; p <= Model.Lances.Max(l => l.Periodo); p++)
                    {
                        <button type="button" class="nba-chip" aria-pressed="false" data-periodo="@p">@NomePeriodo(p)</button>
                    }
                </div>
                <ol class="nba-lances">
                    @{ var periodoAtual = 0; }
                    @* Mais recente primeiro, como o "play-by-play" da ESPN em jogo ao vivo. *@
                    @foreach (var l in Model.Lances.AsEnumerable().Reverse())
                    {
                        if (l.Periodo != periodoAtual)
                        {
                            periodoAtual = l.Periodo;
                            <li class="periodo" data-periodo="@l.Periodo">@NomePeriodoLongo(l.Periodo)</li>
                        }
                        var t = l.TimeId != null ? siglaPorTime.GetValueOrDefault(l.TimeId) : null;
                        <li class="@(l.Pontuou ? "ponto" : "")" data-periodo="@l.Periodo" data-ponto="@(l.Pontuou ? "1" : "0")">
                            <span class="rel">@l.Relogio</span>
                            <span class="txt">
                                @if (t?.Logo != null) { <img class="nba-logo p" src="@t.Logo" alt="@t.Sigla" loading="lazy" style="vertical-align:middle;margin-right:4px" /> }
                                @l.Texto
                            </span>
                            <span class="plc">@l.PlacarVisitante – @l.PlacarCasa</span>
                        </li>
                    }
                </ol>
            </section>
        }
    </div>
</div>

<script>
    (function () {
        var lista = document.querySelector('.nba-lances');
        if (!lista) return;
        var botoes = document.querySelectorAll('.nba-filtro-lances [data-periodo], .nba-filtro-lances [data-filtro]');
        var periodo = null, soPontos = false;
        function aplicar() {
            lista.querySelectorAll('li').forEach(function (li) {
                var okPeriodo = periodo === null || li.dataset.periodo === periodo;
                var okPonto = !soPontos || li.classList.contains('periodo') || li.dataset.ponto === '1';
                li.hidden = !(okPeriodo && okPonto);
            });
        }
        botoes.forEach(function (b) {
            b.addEventListener('click', function () {
                if (b.dataset.filtro) {
                    soPontos = !soPontos;
                    b.setAttribute('aria-pressed', soPontos);
                } else {
                    periodo = periodo === b.dataset.periodo ? null : b.dataset.periodo;
                    document.querySelectorAll('.nba-filtro-lances [data-periodo]').forEach(function (x) {
                        x.setAttribute('aria-pressed', x.dataset.periodo === periodo);
                    });
                }
                aplicar();
            });
        });
    })();
</script>

@if (vivo)
{
    <script>setTimeout(function () { if (!document.hidden) location.reload(); }, 60000);</script>
}
