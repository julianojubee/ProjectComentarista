@model ControleFutebolWeb.Models.AnotacaoJogador
@{
    var jogador = (ControleFutebolWeb.Models.Jogador)ViewBag.Jogador;
    var isEdicao = Model.Id > 0;
    var action = isEdicao ? "Editar" : "Nova";
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Index" asp-route-jogadorId="@Model.JogadorId" class="af-voltar">Anotações sobre @jogador.Nome</a>
        <h1 class="af-title">@(isEdicao ? "Editar anotação" : "Nova anotação")</h1>

        <form asp-action="@action" asp-route-id="@(isEdicao ? Model.Id : null)" method="post">
            <div asp-validation-summary="ModelOnly" class="af-alerta"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="JogadorId" />

            <div class="af-field">
                <label class="af-label" for="Titulo">Título</label>
                <input asp-for="Titulo" class="af-input" placeholder="Lesão na coxa, renovação até 2028" required autofocus />
                <span asp-validation-for="Titulo" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="Categoria">Categoria <small>(opcional)</small></label>
                <select asp-for="Categoria" class="af-select">
                    <option value="">Sem categoria</option>
                    <option value="Lesão">Lesão</option>
                    <option value="Contrato">Contrato</option>
                    <option value="Desempenho">Desempenho</option>
                    <option value="Curiosidade">Curiosidade</option>
                    <option value="Informação">Informação</option>
                </select>
            </div>

            <div class="af-field">
                <label class="af-label" for="Conteudo">Conteúdo</label>
                <textarea asp-for="Conteudo" class="af-textarea" placeholder="Escreva livremente sobre o jogador" required></textarea>
                <div class="af-hint">As quebras de linha são mantidas.</div>
                <span asp-validation-for="Conteudo" class="af-validation"></span>
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">@(isEdicao ? "Salvar alterações" : "Salvar anotação")</button>
                <a asp-action="Index" asp-route-jogadorId="@Model.JogadorId" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
