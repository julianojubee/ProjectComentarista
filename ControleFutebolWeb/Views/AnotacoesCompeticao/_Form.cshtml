@model ControleFutebolWeb.Models.AnotacaoCompeticao
@{
    var competicao = (ControleFutebolWeb.Models.Competicao)ViewBag.Competicao;
    var isEdicao = Model.Id > 0;
    var action = isEdicao ? "Editar" : "Nova";
    var returnUrl = (string?)ViewBag.ReturnUrl;
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <div class="af-title">
            @(isEdicao ? "✏️ Editar anotação" : "📝 Nova anotação") — @competicao.Nome
        </div>

        <form asp-action="@action" asp-route-id="@(isEdicao ? Model.Id : null)" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompeticaoId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="af-field">
                <label class="af-label">Título *</label>
                <input asp-for="Titulo" class="af-input" placeholder="Ex: Formato de 2027, critérios de desempate…" autofocus />
                <span asp-validation-for="Titulo" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="af-field">
                <label class="af-label">Categoria</label>
                <select asp-for="Categoria" class="af-select">
                    <option value="">— Sem categoria —</option>
                    @foreach (var cat in ControleFutebolWeb.Helpers.CategoriaAnotacaoCompeticao.Todas)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="af-field">
                <label class="af-label">Conteúdo *</label>
                <textarea asp-for="Conteudo" class="af-textarea" placeholder="Escreva livremente sobre a competição…"></textarea>
                <div class="af-hint">Suporta texto livre com quebras de linha.</div>
                <span asp-validation-for="Conteudo" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">💾 Salvar</button>
                <a asp-action="Index" asp-route-competicaoId="@Model.CompeticaoId" asp-route-returnUrl="@returnUrl" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
