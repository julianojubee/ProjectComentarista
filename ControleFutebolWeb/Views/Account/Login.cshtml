@model ControleFutebolWeb.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    var numeros = ViewBag.Numeros is ValueTuple<int, int, int, int> n ? n : (0, 0, 0, 0);
    string Numero(int v) => v.ToString("N0", ptBr);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Entrar - Análise de Craque</title>
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
  <link rel="alternate icon" href="~/favicon.ico">
  <link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ouro: #d4a520;
      --ouro-claro: #e6b93a;
      --fundo: #0a0a0a;
      --painel: #121212;
      --linha: rgba(255,255,255,.09);
      --texto: #f4f4f5;
      --texto-2: #b4b4bb;
      --texto-3: #8b8b93;
    }
    html, body { height: 100%; background: var(--fundo); color: var(--texto); font-family: 'Barlow', Arial, sans-serif; }
    a { color: inherit; }
    :focus-visible { outline: 2px solid var(--ouro); outline-offset: 2px; }

    @@keyframes surgir { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    .login { min-height: 100vh; display: flex; }

    /* ── Painel do campo (esquerda) ─────────────────────────────────────── */
    .campo-painel {
      flex: 1; min-width: 0; position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: space-between;
      padding: 40px 48px;
    }
    .campo-painel field-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    /* Escurece a base do campo: o texto de baixo não briga com as linhas */
    .campo-painel::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 46%; pointer-events: none;
      background: linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,.82) 55%, rgba(10,10,10,.96) 100%);
    }
    .marca { position: relative; z-index: 2; display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .marca img { width: 40px; height: 40px; border-radius: 9px; }
    .marca-nome { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--texto); line-height: 1; }

    .campo-texto { position: relative; z-index: 2; max-width: 560px; animation: surgir .6s .1s ease both; }
    .campo-titulo {
      font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.6rem; font-weight: 800;
      line-height: 1.02; color: var(--texto);
    }
    .campo-sub { margin-top: 10px; font-size: 1rem; line-height: 1.5; color: var(--texto-2); max-width: 46ch; }
    .numeros { display: flex; gap: 32px; margin-top: 26px; flex-wrap: wrap; }
    .numero b {
      display: block; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.9rem; font-weight: 800;
      color: var(--ouro); line-height: 1;
    }
    .numero span { display: block; margin-top: 4px; font-size: .82rem; color: var(--texto-3); }

    /* ── Painel do formulário (direita) ─────────────────────────────────── */
    .form-painel {
      width: 440px; flex-shrink: 0; position: relative; z-index: 2;
      display: flex; flex-direction: column;
      background: var(--painel); border-left: 1px solid var(--linha);
      padding: 48px 48px 28px;
      animation: surgir .5s ease both;
    }
    .form-painel::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--ouro), transparent);
    }
    /* O formulário fica no meio da altura; o rodapé, embaixo */
    .form-miolo { margin: auto 0; width: 100%; }

    .form-titulo { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.1rem; font-weight: 800; line-height: 1.05; }
    .form-sub { margin-top: 6px; font-size: .95rem; color: var(--texto-3); }

    .erro {
      margin-top: 24px; padding: 11px 13px; border-radius: 8px;
      background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.38); color: #fca5a5;
      font-size: .9rem; line-height: 1.45;
    }
    .erro div + div { margin-top: 4px; }

    form { display: flex; flex-direction: column; gap: 18px; margin-top: 28px; }
    .campo label, .campo-rotulo { display: block; margin-bottom: 7px; font-size: .88rem; font-weight: 600; color: var(--texto-2); }
    .entrada {
      width: 100%; height: 46px; padding: 0 14px; border-radius: 8px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.14); color: var(--texto);
      /* 16px: abaixo disso o iPhone dá zoom na página ao focar o campo */
      font-family: inherit; font-size: 16px;
      transition: border-color .15s, background .15s;
    }
    .entrada::placeholder { color: #75757d; }
    .entrada:hover { border-color: rgba(255,255,255,.24); }
    .entrada:focus { outline: none; border-color: var(--ouro); background: rgba(255,255,255,.07); }
    .entrada.invalida { border-color: rgba(239,68,68,.6); }

    .senha-caixa { position: relative; }
    .senha-caixa .entrada { padding-right: 84px; }
    .ver-senha {
      position: absolute; top: 6px; right: 6px; height: 34px; padding: 0 10px; border-radius: 6px;
      background: none; border: none; color: var(--texto-2); font-family: inherit; font-size: .86rem; font-weight: 600; cursor: pointer;
    }
    .ver-senha:hover { color: var(--texto); background: rgba(255,255,255,.06); }
    .aviso-caps { display: none; margin-top: 6px; font-size: .82rem; color: var(--ouro-claro); }
    .aviso-caps.ativo { display: block; }

    .linha-opcoes { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .manter { display: flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--texto-2); cursor: pointer; user-select: none; }
    .manter input { width: 16px; height: 16px; accent-color: var(--ouro); }
    .link-ouro { font-size: .9rem; font-weight: 600; color: var(--ouro-claro); text-decoration: none; }
    .link-ouro:hover { text-decoration: underline; }

    .botao {
      height: 48px; margin-top: 4px; border: none; border-radius: 8px; cursor: pointer;
      background: var(--ouro); color: #111;
      font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.2rem; font-weight: 800;
      transition: background .15s, transform .08s;
    }
    .botao:hover { background: var(--ouro-claro); }
    .botao:active { transform: scale(.985); }
    .botao:disabled { opacity: .7; cursor: default; transform: none; }

    /* Atalho para a área aberta: quem chega aqui atrás das ferramentas de
       creators não precisa de conta */
    .creators {
      display: block; margin-top: 30px; padding: 14px 16px; border-radius: 10px; text-decoration: none;
      border: 1px solid var(--linha); background: rgba(255,255,255,.025);
      transition: border-color .15s;
    }
    .creators:hover { border-color: rgba(212,165,32,.5); }
    .creators b { display: block; font-size: .95rem; color: var(--texto); }
    .creators span { display: block; margin-top: 3px; font-size: .86rem; line-height: 1.45; color: var(--texto-3); }

    .rodape { margin-top: 28px; text-align: center; font-size: .78rem; color: #6f6f77; }

    @@media (max-width: 900px) {
      .login { flex-direction: column; }
      .campo-painel { min-height: 300px; flex: 0 0 auto; padding: 24px; }
      .campo-titulo { font-size: 1.9rem; }
      .campo-sub { display: none; }
      .numeros { gap: 22px; margin-top: 16px; }
      .numero b { font-size: 1.5rem; }
      .form-painel { width: 100%; flex: 1 0 auto; border-left: none; border-top: 1px solid var(--linha); padding: 32px 24px 24px; }
    }
    /* Celular: a faixa do campo fica só como ilustração, com a marca; o texto
       por cima dos jogadores virava ruído e empurrava o formulário para baixo */
    @@media (max-width: 520px) {
      .campo-painel { min-height: 190px; }
      .campo-texto { display: none; }
    }
    @@media (prefers-reduced-motion: reduce) {
      .campo-texto, .form-painel { animation: none; }
    }
  </style>
</head>
<body>

<div class="login">

  <section class="campo-painel" aria-label="Análise de Craque">
    <field-canvas aria-hidden="true"></field-canvas>

    <a class="marca" href="/creators" aria-label="Análise de Craque">
      <img src="~/favicon.svg" alt="">
      <span class="marca-nome">Análise de Craque</span>
    </a>

    <div class="campo-texto">
      <p class="campo-titulo">Avalie jogadores, monte escalações e acompanhe cada jogo.</p>
      <p class="campo-sub">Notas por partida, scout, pré-jogo e pós-jogo das competições que você acompanha.</p>
      @if (numeros.Item1 > 0)
      {
          <div class="numeros">
            <div class="numero"><b>@Numero(numeros.Item1)</b><span>jogadores</span></div>
            <div class="numero"><b>@Numero(numeros.Item4)</b><span>jogos</span></div>
            <div class="numero"><b>@Numero(numeros.Item3)</b><span>times</span></div>
            <div class="numero"><b>@Numero(numeros.Item2)</b><span>competições</span></div>
          </div>
      }
    </div>
  </section>

  <main class="form-painel">
    <div class="form-miolo">
      <h1 class="form-titulo">Bem-vindo de volta</h1>
      <p class="form-sub">Entre na sua conta para continuar a análise.</p>

      @if (!ViewData.ModelState.IsValid)
      {
          <div class="erro" role="alert">
              @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
              {
                  <div>@error.ErrorMessage</div>
              }
          </div>
      }

      <form method="post" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" id="formLogin" novalidate>
        @Html.AntiForgeryToken()
        <div class="campo">
          <label asp-for="UserName">Usuário ou e-mail</label>
          <input asp-for="UserName" class="entrada" type="text" autocomplete="username" autocapitalize="none" spellcheck="false"
                 autofocus="@(string.IsNullOrEmpty(Model?.UserName))" required>
        </div>
        <div class="campo">
          <label asp-for="Password">Senha</label>
          <div class="senha-caixa">
            <input asp-for="Password" class="entrada" type="password" autocomplete="current-password"
                   autofocus="@(!string.IsNullOrEmpty(Model?.UserName))" required aria-describedby="avisoCaps">
            <button type="button" class="ver-senha" id="verSenha" aria-controls="Password" aria-pressed="false">Mostrar</button>
          </div>
          <p class="aviso-caps" id="avisoCaps" aria-live="polite">Caps Lock está ligado.</p>
        </div>

        <div class="linha-opcoes">
          <label class="manter">
            <input asp-for="RememberMe" type="checkbox">
            Manter conectado
          </label>
          <a asp-action="ForgotPassword" class="link-ouro">Esqueci minha senha</a>
        </div>

        <button type="submit" class="botao" id="btnEntrar">Entrar</button>
      </form>

      <a class="creators" href="/creators">
        <b>Ferramentas para creators</b>
        <span>Escalações, tabelas e simulador para o seu conteúdo. Abertas, sem precisar de conta.</span>
      </a>
    </div>

    <p class="rodape">© @DateTime.Now.Year Análise de Craque</p>
  </main>
</div>

<script src="~/js/field-canvas.js" asp-append-version="true"></script>
<script>
  (function () {
    var form = document.getElementById('formLogin');
    var usuario = document.getElementById('UserName');
    var senha = document.getElementById('Password');
    var ver = document.getElementById('verSenha');
    var caps = document.getElementById('avisoCaps');
    var btn = document.getElementById('btnEntrar');

    ver.addEventListener('click', function () {
      var mostrar = senha.type === 'password';
      senha.type = mostrar ? 'text' : 'password';
      ver.textContent = mostrar ? 'Ocultar' : 'Mostrar';
      ver.setAttribute('aria-pressed', String(mostrar));
      senha.focus();
    });

    function checarCaps(ev) {
      if (ev.getModifierState) caps.classList.toggle('ativo', ev.getModifierState('CapsLock'));
    }
    senha.addEventListener('keydown', checarCaps);
    senha.addEventListener('keyup', checarCaps);
    senha.addEventListener('blur', function () { caps.classList.remove('ativo'); });

    // Campo vazio: avisa no próprio campo em vez de mandar o formulário
    // (novalidate tira o balão do navegador, que destoava da tela).
    // Preenchido: trava o botão para o duplo clique não mandar duas vezes.
    form.addEventListener('submit', function (ev) {
      var vazio = [usuario, senha].filter(function (c) { return !c.value.trim(); });
      [usuario, senha].forEach(function (c) { c.classList.toggle('invalida', vazio.indexOf(c) >= 0); });
      if (vazio.length) { ev.preventDefault(); vazio[0].focus(); return; }
      btn.disabled = true;
      btn.textContent = 'Entrando...';
    });
    [usuario, senha].forEach(function (c) {
      c.addEventListener('input', function () { c.classList.remove('invalida'); });
    });
    // Voltar pelo navegador restaura a página do cache com o botão travado
    window.addEventListener('pageshow', function () { btn.disabled = false; btn.textContent = 'Entrar'; });
  })();
</script>
</body>
</html>
