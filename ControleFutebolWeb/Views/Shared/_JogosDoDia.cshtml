@model List<ControleFutebolWeb.Models.Jogo>
@using ControleFutebolWeb.Helpers
@{
    // Cards dos jogos de um dia — cabeçalho com a data, filtros por situação/competição,
    // placar (inclusive o parcial do jogo em andamento), gols e transmissão.
    //
    // Compartilhada por /Jogos/Hoje (logada) e /creators/jogos-hoje (pública). O
    // que muda entre as duas: a rota da navegação de dia (ViewData["AcaoDia"] e
    // ViewData["ControllerDia"]) e o atalho para a análise, que só existe na
    // logada (ViewData["Publico"]).
    var publico = (bool)(ViewData["Publico"] ?? false);
    var acaoDia = (string)(ViewData["AcaoDia"] ?? "Hoje");
    var controllerDia = (string)(ViewData["ControllerDia"] ?? "Jogos");
    string UrlDia(DateTime? dia) => dia == null
        ? Url.Action(acaoDia, controllerDia)!
        : Url.Action(acaoDia, controllerDia, new { data = dia.Value.ToString("yyyy-MM-dd") })!;

    var jogosAnalisadosIds = (HashSet<int>)(ViewBag.JogosAnalisadosIds ?? new HashSet<int>());

    // Gols do dia por jogo, montados pelo GolResumoHelper — mesma regra de lado e de
    // assistência da timeline da tela Analisar.
    var golsPorJogo = (Dictionary<int, List<GolResumo>>)(ViewBag.GolsPorJogo
        ?? new Dictionary<int, List<GolResumo>>());

    var diaAtual    = (DateTime)(ViewBag.DiaAtual ?? DateTime.Today);
    var diaAnterior = (DateTime)(ViewBag.DiaAnterior ?? DateTime.Today.AddDays(-1));
    var diaSeguinte = (DateTime)(ViewBag.DiaSeguinte ?? DateTime.Today.AddDays(1));
    bool ehHoje = (bool)(ViewBag.EhHoje ?? true);
    var ptBR = new System.Globalization.CultureInfo("pt-BR");

    var fusoHorarioBrasil = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var agoraBrasil = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, fusoHorarioBrasil);
    var hojeBrasil = agoraBrasil.Date;

    // "Hoje", "Ontem", "Amanhã" ou a data curta — rótulo das setas de dia
    string Relativo(DateTime dia) =>
        dia == hojeBrasil ? "Hoje"
        : dia == hojeBrasil.AddDays(-1) ? "Ontem"
        : dia == hojeBrasil.AddDays(1) ? "Amanhã"
        : dia.ToString("d 'de' MMM", ptBR);
    string Capitalizar(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];
    string Plural(int n, string um, string varios) => $"{n} {(n == 1 ? um : varios)}";

    // Estimativa do minuto ao vivo a partir do horário de início: não há sincronização
    // em tempo real com a API, então assume 1º tempo de 45min + 15min de intervalo.
    // É só uma aproximação (não considera acréscimos reais).
    // IMPORTANTE: jogo.Data fica salvo em UTC — precisa converter pra Brasília antes de
    // comparar com agoraBrasil, senão a diferença de fuso (3h) derruba a conta toda.
    string MinutoAoVivo(DateTime kickoffUtc)
    {
        var kickoff = DateHelper.ParaBrasilia(kickoffUtc) ?? kickoffUtc;
        var decorridos = (int)(agoraBrasil - kickoff).TotalMinutes;
        if (decorridos < 0) return "";
        if (decorridos <= 45) return $"1T {decorridos}'";
        if (decorridos <= 60) return "Intervalo";
        if (decorridos <= 105) return $"2T {decorridos - 60}'";
        return "2T 45+'";
    }

    // Relógio de verdade, do que a api-football informou na última leitura do serviço de
    // jogos ao vivo (Jogo.StatusParcial/MinutoParcial). Devolve null quando não há leitura
    // — jogo de fonte que não publica relógio, ou serviço que ainda não passou — e aí o
    // card cai na estimativa acima.
    //
    // No 1º/2º tempo mostra só o minuto da partida ("63'"), que é como todo placar mostra;
    // o "1T/2T" da estimativa existe porque lá o número é contado do zero em cada tempo.
    string? RelogioDaApi(ControleFutebolWeb.Models.Jogo j)
    {
        if (string.IsNullOrEmpty(j.StatusParcial) || j.PlacarParcialEm == null) return null;

        switch (j.StatusParcial.ToUpperInvariant())
        {
            // Bola parada: não há minuto correndo para mostrar, e o card não conta adiante.
            case "HT": return "Intervalo";
            case "BT": return "Interv. pror.";
            case "P": return "Pênaltis";
            case "SUSP": return "Suspenso";
            case "INT": return "Interrompido";
        }

        if (j.MinutoParcial == null) return null;

        var minuto = j.AcrescimoParcial > 0
            ? $"{j.MinutoParcial}+{j.AcrescimoParcial}'"
            : $"{j.MinutoParcial}'";

        return j.StatusParcial.Equals("ET", StringComparison.OrdinalIgnoreCase)
            ? $"Pror. {minuto}"
            : minuto;
    }

    // Instante da leitura em epoch, para o relógio do card saber quanto tempo passou.
    // O banco devolve a coluna como UTC; Unspecified só apareceria em dado antigo.
    long LidoEmEpoch(DateTime lido) => new DateTimeOffset(
        lido.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(lido, DateTimeKind.Utc) : lido
    ).ToUnixTimeSeconds();

    string Escudo(string? url) => Url.Action("Imagem", "MediaProxy", new { url })!;

    var vivos = new List<ControleFutebolWeb.Models.Jogo>();
    var agendados = new List<ControleFutebolWeb.Models.Jogo>();
    var encerrados = new List<ControleFutebolWeb.Models.Jogo>();

    foreach (var jogo in Model.OrderBy(j => j.Data))
    {
        bool realizado = jogo.PlacarCasa.HasValue && jogo.PlacarVisitante.HasValue;
        if (realizado)
        {
            encerrados.Add(jogo);
        }
        else if (jogo.Data.HasValue && DateHelper.ParaBrasilia(jogo.Data) is DateTime kickoffBrasil
                 && kickoffBrasil <= agoraBrasil && agoraBrasil <= kickoffBrasil.AddHours(2.5))
        {
            vivos.Add(jogo);
        }
        else
        {
            agendados.Add(jogo);
        }
    }

    // Chave (usada pelo filtro e pelos contadores), título e jogos de cada situação
    var grupos = new List<(string chave, string titulo, List<ControleFutebolWeb.Models.Jogo> jogos)>
    {
        ("vivo", "Ao vivo", vivos),
        ("agendado", "Agendados", agendados),
        ("encerrado", "Encerrados", encerrados),
    };
    var gruposComJogos = grupos.Where(g => g.jogos.Any()).ToList();

    // Competições presentes no dia, para os chips de filtro. Id 0 agrupa os jogos sem
    // competição cadastrada — sem isso eles sumiriam da tela ao filtrar.
    var competicoesDoDia = Model
        .GroupBy(j => (id: j.Competicao?.Id ?? 0, nome: j.Competicao?.Nome ?? "Sem competição"))
        .Select(g => (g.Key.id, g.Key.nome, total: g.Count(),
                      logo: g.Select(j => j.Competicao?.LogoUrl).FirstOrDefault(u => !string.IsNullOrEmpty(u))))
        .OrderByDescending(c => c.total).ThenBy(c => c.nome)
        .ToList();

    var tituloDia = Capitalizar(diaAtual.ToString(diaAtual.Year == hojeBrasil.Year ? "dddd, d 'de' MMMM" : "dddd, d 'de' MMMM 'de' yyyy", ptBR));
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    .hj-root, .hj-root *, .hj-root *::before, .hj-root *::after { box-sizing: border-box; }

    .hj-root {
        margin: 0 -12px;
        background: var(--p-0);
        border-radius: 14px;
        overflow: hidden;
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
    }
    .hj-root a { text-decoration: none; color: inherit; }
    .hj-root :is(a, button, input):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    @@keyframes hjPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    @@media (prefers-reduced-motion: reduce) { .hj-root .hj-ponto-vivo { animation: none !important; } }
    .hj-ponto-vivo { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; animation: hjPulse 1.5s ease infinite; flex-shrink: 0; }

    /* ── Cabeçalho (cores fixas: o fundo é escuro nos dois temas) ── */
    .hj-cab {
        display: flex; align-items: flex-end; justify-content: space-between; gap: 14px 24px; flex-wrap: wrap;
        padding: 1.5rem 2.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520;
    }
    .hj-cab-rel { font-size: .9rem; font-weight: 700; color: #f3d27a; margin-bottom: 2px; }
    .hj-cab h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1.05; }
    .hj-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.75); display: flex; align-items: center; gap: 8px; }
    .hj-cab p strong { color: #f2f5fa; }
    .hj-cab p .vivo { color: #fca5a5; font-weight: 700; }

    .hj-nav { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .hj-root .hj-nav-btn {
        display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: 8px;
        border: 1px solid rgba(255,255,255,.25); background: transparent; color: #e8edf5;
        font-family: inherit; font-size: .86rem; font-weight: 600; white-space: nowrap; cursor: pointer;
    }
    .hj-root .hj-nav-btn:hover { border-color: #d4a520; color: #f3d27a; }
    .hj-root .hj-nav-btn.hoje { background: #d4a520; border-color: #d4a520; color: #141414; }
    .hj-nav form { margin: 0; }
    .hj-data {
        height: 36px; padding: 0 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.06); color: #e8edf5; font-family: inherit; font-size: .86rem; color-scheme: dark;
    }
    .hj-data:hover, .hj-data:focus { border-color: #d4a520; outline: none; }

    /* ── Filtros: situação (abas) + competição (fileira) ── */
    .hj-barra {
        display: flex; flex-direction: column; gap: 10px;
        padding: 14px 2.5rem; background: var(--p-1); border-bottom: 1px solid var(--line);
    }
    .hj-abas, .hj-comps { display: flex; gap: 6px; }

    .hj-abas, .hj-comps { overflow-x: auto; scrollbar-width: thin; padding-bottom: 2px; }
    .hj-chip {
        display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0;
        padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent;
        color: var(--text-muted); font-family: inherit; font-size: .86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .hj-chip:hover { color: var(--text-strong); border-color: #d4a520; }
    .hj-chip[aria-pressed="true"] { background: var(--text-strong); border-color: var(--text-strong); color: var(--p-0); }
    .hj-chip-count { font-weight: 500; opacity: .7; }
    .hj-comp-logo { width: 16px; height: 16px; object-fit: contain; flex-shrink: 0; }

    /* ── Conteúdo ── */
    .hj-content { padding: 24px 2.5rem 56px; max-width: 1300px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
    .hj-grupo > h2 {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.4rem; font-weight: 700; color: var(--text-strong);
        margin: 0 0 12px; display: flex; align-items: center; gap: 8px;
    }
    .hj-grupo > h2 small { font-family: 'Barlow', Arial, sans-serif; font-size: .84rem; font-weight: 500; color: var(--text-dim); }
    .hj-lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

    /* ── Card ── */
    .hj-card {
        display: flex; flex-direction: column; gap: 10px;
        background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
    }
    .hj-card.hj-live { border-color: rgba(239,68,68,.45); }
    .hj-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 0; }
    .hj-root .hj-comp {
        display: inline-flex; align-items: center; gap: 6px; min-width: 0;
        font-size: .82rem; font-weight: 600; color: var(--text-muted);
    }
    .hj-root .hj-comp span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hj-root a.hj-comp:hover { color: var(--gold-ink); text-decoration: underline; }
    .hj-estado { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; font-size: .86rem; font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; }
    .hj-estado.ag { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.15rem; color: var(--text-strong); }
    .hj-estado.vivo { color: var(--bad); }
    .hj-estado.enc { color: var(--text-dim); font-weight: 600; }

    /* Os dois times em linhas: escudo, nome e gols — nada corta no celular */
    .hj-times { display: flex; flex-direction: column; gap: 6px; }
    .hj-linha { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .hj-escudo {
        width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
        font-size: .75rem; font-weight: 700; color: var(--text-dim);
    }
    .hj-escudo img { width: 100%; height: 100%; object-fit: contain; }
    .hj-nome { flex: 1; min-width: 0; font-size: 1rem; font-weight: 600; color: var(--text-strong); overflow-wrap: anywhere; }
    .hj-n { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--text-strong); min-width: 24px; text-align: right; line-height: 1; font-variant-numeric: tabular-nums; }
    .hj-linha.perde .hj-nome, .hj-linha.perde .hj-n { color: var(--text-dim); font-weight: 500; }
    .hj-linha.vence .hj-nome { font-weight: 800; }
    /* Placar parcial do jogo em andamento (Jogo.PlacarParcialCasa, alimentado a cada
       15 min pelo AtualizarJogosAoVivoService): vermelho para não ser confundido com
       o resultado final, que é o único que conta como jogo realizado. */
    .hj-card.hj-live .hj-n { color: var(--bad); }
    .hj-parcial { font-size: .76rem; font-weight: 600; color: var(--bad); align-self: flex-end; margin-top: -2px; }

    /* Gols em ordem de minuto, com o escudo de quem marcou */
    .hj-gols { list-style: none; margin: 0; padding: 8px 0 0; border-top: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 4px; }
    .hj-gol { display: flex; align-items: baseline; gap: 6px; font-size: .84rem; color: var(--text-muted); }
    .hj-gol-min { font-weight: 700; color: var(--text-dim); min-width: 30px; font-variant-numeric: tabular-nums; }
    .hj-gol img { width: 14px; height: 14px; object-fit: contain; align-self: center; }
    .hj-gol-nome { color: var(--text-strong); font-weight: 600; }
    .hj-gol-extra { color: var(--text-dim); }

    .hj-card-footer {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line-soft);
    }
    .hj-local { min-width: 0; display: flex; flex-direction: column; gap: 1px; font-size: .8rem; color: var(--text-dim); }
    .hj-local span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hj-tv { color: var(--text-muted); }
    .hj-root .hj-analisar {
        flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 8px;
        border: 1px solid rgba(212,165,32,.5); color: var(--gold-ink); font-size: .84rem; font-weight: 700;
    }
    .hj-root .hj-analisar:hover { background: rgba(212,165,32,.12); color: var(--gold-ink); }
    .hj-root .hj-analisar.feito { border-color: transparent; color: var(--ok); font-weight: 600; }
    .hj-root .hj-analisar.feito:hover { background: transparent; text-decoration: underline; }

    .hj-sem-filtro, .hj-empty { text-align: center; color: var(--text-dim); padding: 2.5rem 1rem; background: var(--p-1); border: 1px dashed var(--line); border-radius: 12px; }
    .hj-sem-filtro { display: none; }

    /* ── Responsivo ── */
    @@media (max-width: 900px) {
        .hj-lista { grid-template-columns: 1fr; }
    }
    @@media (max-width: 640px) {
        .hj-cab { padding: 1.1rem 1rem; }
        .hj-cab h1 { font-size: 1.9rem; }
        .hj-barra { padding: 12px 1rem; }
        .hj-content { padding: 18px 1rem 40px; }
        .hj-card { padding: 12px 14px; }
    }
</style>

<div class="hj-root">
    <!-- ── Cabeçalho ── -->
    <div class="hj-cab theme-dark-zone">
        <div>
            @if (Relativo(diaAtual) is "Hoje" or "Ontem" or "Amanhã")
            {
                <div class="hj-cab-rel">@Relativo(diaAtual)</div>
            }
            <h1>@tituloDia</h1>
            <p>
                <span><strong data-hj-total>@Model.Count</strong> @(Model.Count == 1 ? "jogo" : "jogos")</span>
                @if (vivos.Any())
                {
                    <span class="vivo"><span class="hj-ponto-vivo" aria-hidden="true"></span> <span data-hj-contador="vivo">@vivos.Count</span> ao vivo</span>
                }
            </p>
        </div>
        <nav class="hj-nav" aria-label="Escolher o dia">
            <a class="hj-nav-btn" href="@UrlDia(diaAnterior)" aria-label="Dia anterior: @diaAnterior.ToString("d 'de' MMMM", ptBR)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                @Relativo(diaAnterior)
            </a>
            @if (!ehHoje && diaAnterior != hojeBrasil && diaSeguinte != hojeBrasil)
            {
                <a class="hj-nav-btn hoje" href="@UrlDia(null)">Hoje</a>
            }
            <form method="get" action="@UrlDia(null)">
                <label class="visually-hidden" for="hjData">Ir para a data</label>
                <input type="date" id="hjData" name="data" class="hj-data" value="@diaAtual.ToString("yyyy-MM-dd")"
                       onchange="if (this.value) this.form.submit();" />
            </form>
            <a class="hj-nav-btn" href="@UrlDia(diaSeguinte)" aria-label="Dia seguinte: @diaSeguinte.ToString("d 'de' MMMM", ptBR)">
                @Relativo(diaSeguinte)
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </a>
        </nav>
    </div>

    @if (Model.Any() && (gruposComJogos.Count > 1 || competicoesDoDia.Count > 1))
    {
        <div class="hj-barra" id="hjFiltros">
            @if (gruposComJogos.Count > 1)
            {
                <div class="hj-abas" role="group" aria-label="Situação">
                    <button type="button" class="hj-chip" data-status-filtro="" aria-pressed="true">
                        Todos <span class="hj-chip-count" data-hj-total>@Model.Count</span>
                    </button>
                    @foreach (var grupo in gruposComJogos)
                    {
                        <button type="button" class="hj-chip" data-status-filtro="@grupo.chave" aria-pressed="false">
                            @if (grupo.chave == "vivo")
                            {
                                <span class="hj-ponto-vivo" aria-hidden="true"></span>
                            }
                            @grupo.titulo <span class="hj-chip-count" data-hj-contador="@grupo.chave">@grupo.jogos.Count</span>
                        </button>
                    }
                </div>
            }
            @if (competicoesDoDia.Count > 1)
            {
                <div class="hj-comps" role="group" aria-label="Competição">
                    <button type="button" class="hj-chip" data-comp-filtro="" aria-pressed="true">
                        Todas as competições
                    </button>
                    @foreach (var comp in competicoesDoDia)
                    {
                        <button type="button" class="hj-chip" data-comp-filtro="@comp.id" aria-pressed="false">
                            @if (!string.IsNullOrEmpty(comp.logo))
                            {
                                <img class="hj-comp-logo" src="@Escudo(comp.logo)" alt="" />
                            }
                            @comp.nome <span class="hj-chip-count">@comp.total</span>
                        </button>
                    }
                </div>
            }
        </div>
    }

    <!-- ── Conteúdo ── -->
    <div class="hj-content">
        @if (!Model.Any())
        {
            <div class="hj-empty">
                Nenhum jogo cadastrado para @diaAtual.ToString(diaAtual.Year == hojeBrasil.Year ? "d 'de' MMMM" : "d 'de' MMMM 'de' yyyy", ptBR).
                Use as setas ou escolha outra data acima.
            </div>
        }
        else
        {
            foreach (var grupo in gruposComJogos)
            {
                <section class="hj-grupo" data-grupo="@grupo.chave">
                    <h2>
                        @if (grupo.chave == "vivo")
                        {
                            <span class="hj-ponto-vivo" aria-hidden="true"></span>
                        }
                        @grupo.titulo <small class="hj-grupo-count">@Plural(grupo.jogos.Count, "jogo", "jogos")</small>
                    </h2>

                    <div class="hj-lista">
                        @foreach (var jogo in grupo.jogos)
                        {
                            bool realizado = jogo.PlacarCasa.HasValue && jogo.PlacarVisitante.HasValue;
                            bool live = grupo.chave == "vivo";
                            bool analisado = jogosAnalisadosIds.Contains(jogo.Id);
                            // Placar parcial: o gol a gol que o serviço de jogos ao vivo grava
                            // enquanto a partida rola. Fica em campos próprios porque PlacarCasa
                            // preenchido é o que marca o jogo como realizado no sistema inteiro.
                            bool parcial = !realizado
                                && jogo.PlacarParcialCasa.HasValue && jogo.PlacarParcialVisitante.HasValue;
                            int? golsCasa = realizado ? jogo.PlacarCasa : parcial ? jogo.PlacarParcialCasa : null;
                            int? golsVis = realizado ? jogo.PlacarVisitante : parcial ? jogo.PlacarParcialVisitante : null;
                            string ResultadoLado(bool casa) =>
                                !realizado || jogo.PlacarCasa == jogo.PlacarVisitante ? ""
                                : (jogo.PlacarCasa > jogo.PlacarVisitante) == casa ? "vence" : "perde";

                            var golsDoJogo = golsPorJogo.TryGetValue(jogo.Id, out var gs) ? gs : new List<GolResumo>();
                            var localJogo = EstadioJogoHelper.Local(jogo);

                            <article class="hj-card @(live ? "hj-live" : "")" data-comp="@(jogo.Competicao?.Id ?? 0)">
                                <div class="hj-card-top">
                                    @if (jogo.Competicao != null)
                                    {
                                        @* Abre a tabela da competição na temporada do jogo, em outra aba.
                                           A pública não enxerga Competicoes/Detalhes (exige login). *@
                                        var urlTabela = publico
                                            ? Url.Action("Tabelas", "Creators", new { competicao = jogo.Competicao.Id, temporada = jogo.Temporada })
                                            : Url.Action("Detalhes", "Competicoes", new { id = jogo.Competicao.Id, temporada = jogo.Temporada });
                                        <a class="hj-comp" href="@urlTabela" target="_blank" rel="noopener" title="Ver a tabela (abre em outra aba)">
                                            @if (!string.IsNullOrEmpty(jogo.Competicao.LogoUrl))
                                            {
                                                <img class="hj-comp-logo" src="@Escudo(jogo.Competicao.LogoUrl)" alt="" />
                                            }
                                            <span>@jogo.Competicao.Nome</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="hj-comp"><span>Sem competição</span></span>
                                    }

                                    @if (live)
                                    {
                                        var relogio = RelogioDaApi(jogo);
                                        <span class="hj-estado vivo">
                                            <span class="hj-ponto-vivo" aria-hidden="true"></span>
                                            @if (relogio != null)
                                            {
                                                <span data-hj-relogio
                                                      data-status="@jogo.StatusParcial"
                                                      data-minuto="@jogo.MinutoParcial"
                                                      data-acrescimo="@jogo.AcrescimoParcial"
                                                      data-lido-em="@LidoEmEpoch(jogo.PlacarParcialEm!.Value)">@relogio</span>
                                            }
                                            else
                                            {
                                                <span>@(MinutoAoVivo(jogo.Data!.Value) is var m && m != "" ? m : "Ao vivo")</span>
                                            }
                                        </span>
                                    }
                                    else if (realizado)
                                    {
                                        <span class="hj-estado enc">Encerrado</span>
                                    }
                                    else
                                    {
                                        <span class="hj-estado ag">@(jogo.Data.HasValue ? DateHelper.FormatarData(jogo.Data, "HH:mm") : "A definir")</span>
                                    }
                                </div>

                                <div class="hj-times">
                                    @foreach (var casa in new[] { true, false })
                                    {
                                        var time = casa ? jogo.TimeCasa : jogo.TimeVisitante;
                                        var gols = casa ? golsCasa : golsVis;
                                        <div class="hj-linha @ResultadoLado(casa)">
                                            <span class="hj-escudo">
                                                @if (!string.IsNullOrEmpty(time?.EscudoUrl))
                                                {
                                                    <img src="@Escudo(time.EscudoUrl)" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    @(time?.Nome?.Substring(0, 1) ?? "?")
                                                }
                                            </span>
                                            <span class="hj-nome">@(time?.Nome ?? "A definir")</span>
                                            @if (gols != null)
                                            {
                                                <span class="hj-n">@gols</span>
                                            }
                                        </div>
                                    }
                                    @if (parcial)
                                    {
                                        <span class="hj-parcial">Placar parcial</span>
                                    }
                                </div>

                                @if (golsDoJogo.Count > 0)
                                {
                                    <ul class="hj-gols" aria-label="Gols">
                                        @foreach (var gol in golsDoJogo)
                                        {
                                            // Lado do gol (contra já vem no lado de quem se beneficiou)
                                            var timeGol = gol.EhCasa ? jogo.TimeCasa : jogo.TimeVisitante;
                                            <li class="hj-gol">
                                                <span class="hj-gol-min">@(gol.Minuto)'</span>
                                                @if (!string.IsNullOrEmpty(timeGol?.EscudoUrl))
                                                {
                                                    <img src="@Escudo(timeGol.EscudoUrl)" alt="@timeGol.Nome" title="@timeGol.Nome" loading="lazy" />
                                                }
                                                <span>
                                                    <span class="hj-gol-nome">@gol.NomeJogador</span>
                                                    @if (gol.Contra)
                                                    {
                                                        <span class="hj-gol-extra">(contra)</span>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(gol.NomeAssistencia))
                                                    {
                                                        <span class="hj-gol-extra">(assist. @gol.NomeAssistencia)</span>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }

                                <div class="hj-card-footer">
                                    <div class="hj-local">
                                        @* Sem o local da fonte, cai no estádio do mandante (EstadioJogoHelper) *@
                                        <span title="@(EstadioJogoHelper.DoMandante(jogo) ? "Estádio do mandante: o local não veio da fonte" : localJogo)">@(localJogo ?? "Local não informado")</span>
                                        @if (!string.IsNullOrWhiteSpace(jogo.TransmissaoTv))
                                        {
                                            <span class="hj-tv" title="Transmissão: @jogo.TransmissaoTv">@jogo.TransmissaoTv</span>
                                        }
                                    </div>
                                    @* Atalho para a análise: só na tela logada — o visitante
                                       não tem para onde ir. *@
                                    @if (!publico)
                                    {
                                        if (analisado)
                                        {
                                            <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="hj-analisar feito">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                                                Analisado
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="hj-analisar">Analisar</a>
                                        }
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <div class="hj-sem-filtro" id="hjSemFiltro">Nenhum jogo com esses filtros. Escolha "Todos" ou outra competição.</div>
        }
    </div>
</div>

<script>
    // Filtros de situação (ao vivo / agendado / encerrado) e de competição: puramente
    // client-side (os jogos do dia já estão todos na página), então trocar de filtro não
    // recarrega nem perde a navegação de dia. Os dois filtros se combinam.
    (function () {
        var filtros = document.getElementById('hjFiltros');
        if (!filtros) { return; }

        var chipsComp = filtros.querySelectorAll('[data-comp-filtro]');
        var chipsStatus = filtros.querySelectorAll('[data-status-filtro]');
        var grupos = document.querySelectorAll('.hj-grupo[data-grupo]');
        var semFiltro = document.getElementById('hjSemFiltro');

        var compAtual = '';
        var statusAtual = '';

        function aplicar() {
            // Os contadores (cabeçalho e abas de situação) seguem só o filtro de competição,
            // pra continuarem servindo de menu mesmo com uma situação selecionada.
            var total = 0;
            var visiveis = 0;

            grupos.forEach(function (grupo) {
                var noGrupo = 0;
                var naSituacao = !statusAtual || grupo.dataset.grupo === statusAtual;

                grupo.querySelectorAll('.hj-card[data-comp]').forEach(function (card) {
                    var okComp = !compAtual || card.dataset.comp === compAtual;
                    if (okComp) { noGrupo++; }
                    card.style.display = (okComp && naSituacao) ? '' : 'none';
                });

                total += noGrupo;
                if (naSituacao) { visiveis += noGrupo; }
                grupo.style.display = (noGrupo && naSituacao) ? '' : 'none';

                var contador = grupo.querySelector('.hj-grupo-count');
                if (contador) { contador.textContent = noGrupo + (noGrupo === 1 ? ' jogo' : ' jogos'); }
                document.querySelectorAll('[data-hj-contador="' + grupo.dataset.grupo + '"]')
                    .forEach(function (el) { el.textContent = noGrupo; });
            });

            document.querySelectorAll('[data-hj-total]').forEach(function (el) { el.textContent = total; });
            if (semFiltro) { semFiltro.style.display = visiveis ? 'none' : 'block'; }
        }

        function ligar(chips, aoEscolher) {
            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
                    aoEscolher(chip);
                    aplicar();
                });
            });
        }

        ligar(chipsComp, function (chip) { compAtual = chip.dataset.compFiltro; });
        ligar(chipsStatus, function (chip) { statusAtual = chip.dataset.statusFiltro; });
    })();

    // Relógio dos cards ao vivo. O servidor manda o minuto que a api-football informou na
    // última leitura (de 15 em 15 min), e aqui ele anda para a frente a partir dela, senão
    // o card ficaria mostrando "63'" por um quarto de hora.
    //
    // Só anda com a bola rolando: intervalo, prorrogação parada, pênaltis e jogo suspenso
    // ficam de fora da tabela LIMITE, então o texto que o servidor mandou ("Intervalo",
    // "Pênaltis") permanece. Também não anda quando a leitura pegou acréscimo ("45+2'"),
    // porque contar em cima de acréscimo é chute — e trava no fim de cada tempo, para não
    // inventar um "52'" de primeiro tempo.
    (function () {
        var LIMITE = { '1H': 45, '2H': 90, 'ET': 120, 'LIVE': 90 };

        function atualizar() {
            var relogios = document.querySelectorAll('[data-hj-relogio]');
            relogios.forEach(function (el) {
                var limite = LIMITE[(el.dataset.status || '').toUpperCase()];
                var base = parseInt(el.dataset.minuto, 10);
                var acrescimo = parseInt(el.dataset.acrescimo, 10);
                if (limite === undefined || isNaN(base) || acrescimo > 0) { return; }

                var lidoEm = parseInt(el.dataset.lidoEm, 10);
                if (isNaN(lidoEm)) { return; }

                var minuto = base + Math.floor((Date.now() / 1000 - lidoEm) / 60);
                if (minuto < base) { minuto = base; }   // relógio do cliente atrasado

                var texto = minuto >= limite ? limite + "+'" : minuto + "'";
                if (el.dataset.status.toUpperCase() === 'ET') { texto = 'Pror. ' + texto; }
                if (el.textContent !== texto) { el.textContent = texto; }
            });
            return relogios.length;
        }

        if (atualizar() > 0) { setInterval(atualizar, 30000); }
    })();
</script>
