@model ControleFutebolWeb.Models.ViewModels.TreinadorHeroViewModel
@using ControleFutebolWeb.Helpers
@{
    var t = Model.Treinador;

    // Ícones inline por chave — evita repetir os <svg> em cada tela que monta o hero.
    Func<string?, Microsoft.AspNetCore.Html.IHtmlContent> icone = chave => chave switch
    {
        "voltar" => Html.Raw("<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><polyline points='15 18 9 12 15 6'/></svg>"),
        "editar" => Html.Raw("<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7'/><path d='M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z'/></svg>"),
        "anotacoes" => Html.Raw("<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z'/><polyline points='14 2 14 8 20 8'/></svg>"),
        "mais" => Html.Raw("<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>"),
        "importar" => Html.Raw("<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' y1='15' x2='12' y2='3'/></svg>"),
        _ => Html.Raw("")
    };
}

<div class="an-hero theme-dark-zone">
    <img class="an-hero-pattern" src="~/Images/banner/escudos-pattern.svg" alt="" />
    <div class="an-hero-stripe"></div>
    <div class="an-hero-row">
        <div class="an-foto">
            @* FotoSrc (e não o MediaProxy direto) porque a foto pode ser uma URL colada
               à mão em /Treinadores/Edit — o proxy tem allowlist e bloquearia o host. *@
            <img src="@(Url.FotoSrc(t.FotoUrl) ?? Url.Content("~/images/placeholder-treinador.png"))" alt="@t.Nome" />
        </div>
        <div class="an-hero-info">
            <div class="an-hero-kicker">
                <div class="an-hero-kicker-line"></div>
                <span>@Model.Kicker</span>
            </div>
            <h1>@t.Nome</h1>
            <p>
                @if (t.Time != null)
                {
                    <a class="an-clube-link" asp-controller="Times" asp-action="Details" asp-route-id="@t.TimeId" title="Ver @t.Time.Nome">
                        @if (!string.IsNullOrEmpty(t.Time.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = t.Time.EscudoUrl })" alt="" />
                        }
                        <span>@t.Time.Nome</span>
                    </a>
                }
                @if (t.Nacionalidade != null)
                {
                    <span>·</span>
                    <span>@FlagHelper.GetFlagEmoji(t.Nacionalidade.Nome) @t.Nacionalidade.Nome</span>
                }
                @if (t.Idade > 0)
                {
                    <span>·</span>
                    <span>@t.Idade anos</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.MetaExtra))
                {
                    <span>·</span>
                    <span>@Model.MetaExtra</span>
                }
            </p>
        </div>
        @if (Model.Acoes.Any())
        {
            <div class="an-hero-actions">
                @foreach (var acao in Model.Acoes)
                {
                    <a href="@acao.Url" class="an-btn @(acao.Destaque ? "gold" : "")">
                        @icone(acao.Icone)
                        @acao.Texto
                    </a>
                }
            </div>
        }
    </div>
</div>
