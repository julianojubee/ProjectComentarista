@using ControleFutebolWeb.Data
@using ControleFutebolWeb.Models.ViewModels
@model (int CompeticaoId, int? Temporada)
@inject FutebolContext _ctx
@*
    Artilharia e assistências da competição, lado a lado. Autossuficiente (busca os
    próprios dados, como o _Layout faz com o menu) porque as telas fixas — Copa do
    Brasil, Libertadores, Sul-Americana, Champions, Copa do Mundo — não têm sidebar
    onde encaixar o ranking e nenhuma delas passava esses dados pelo controller.
*@
@{
    var artilheiros  = await RankingCompeticaoHelper.ArtilheirosAsync(_ctx, Model.CompeticaoId, Model.Temporada);
    var assistentes  = await RankingCompeticaoHelper.AssistentesAsync(_ctx, Model.CompeticaoId, Model.Temporada);
    var rankColors   = new[] { "var(--warn)", "var(--text-muted)", "#b45309", "var(--text-dimmer)", "var(--text-dimmer)" };
}

<div class="rk-wrap">
    @foreach (var painel in new[]
    {
        (Titulo: "Artilheiros", Icone: "⚽", Sufixo: "⚽", Vazio: "Nenhum gol registrado ainda.",         Linhas: artilheiros),
        (Titulo: "Assistências", Icone: "🅰️", Sufixo: "🅰️", Vazio: "Nenhuma assistência registrada ainda.", Linhas: assistentes)
    })
    {
        <div class="rk-card">
            <div class="rk-header"><span>@painel.Icone</span><span class="rk-title">@painel.Titulo</span></div>
            @if (!painel.Linhas.Any())
            {
                <div class="rk-vazio">@painel.Vazio</div>
            }
            else
            {
                for (int i = 0; i < painel.Linhas.Count; i++)
                {
                    var l = painel.Linhas[i];
                    <div class="rk-linha">
                        <span class="rk-rank" style="color:@rankColors[Math.Min(i, rankColors.Length - 1)];">@(i + 1)</span>
                        <a class="rk-avatar" asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@l.Jogador.Id"
                           title="Ver estatísticas de @l.Jogador.Nome">
                            @if (!string.IsNullOrEmpty(l.Jogador.FotoUrl))
                            {
                                <img src="@Url.FotoSrc(l.Jogador.FotoUrl)" alt="" />
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            }
                        </a>
                        <div style="flex:1; min-width:0;">
                            <a class="rk-nome" asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@l.Jogador.Id"
                               title="Ver estatísticas de @l.Jogador.Nome">@l.Jogador.Nome</a>
                            <a class="rk-clube" asp-controller="Times" asp-action="Details" asp-route-id="@l.Jogador.TimeId"
                               title="Ver @l.Jogador.Time?.Nome">
                                @if (!string.IsNullOrEmpty(l.Jogador.Time?.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = l.Jogador.Time.EscudoUrl })" alt="" />
                                }
                                <span>@(l.Jogador.Time?.Nome ?? "—")</span>
                            </a>
                        </div>
                        <span class="rk-valor">@l.Valor @painel.Sufixo</span>
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .rk-wrap {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
        padding: 20px 2.5rem 0; font-family: 'Barlow', Arial, sans-serif;
    }
    .rk-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .rk-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    .rk-title { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .95rem; font-weight: 800; color: var(--text-strong); text-transform: uppercase; letter-spacing: .06em; }
    .rk-vazio { padding: 18px 16px; font-size: .78rem; color: var(--text-dimmer); }
    .rk-linha { display: flex; align-items: center; gap: 10px; padding: 9px 16px; border-bottom: 1px solid var(--line-soft); }
    .rk-linha:last-child { border-bottom: none; }
    .rk-rank { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1rem; font-weight: 800; width: 14px; flex-shrink: 0; text-align: center; }
    .rk-avatar {
        width: 30px; height: 30px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
        background: var(--p-3); display: flex; align-items: center; justify-content: center;
    }
    .rk-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .rk-nome { display: block; font-size: .8rem; font-weight: 700; color: var(--text-strong); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rk-nome:hover { color: var(--gold-ink); }
    .rk-clube { display: flex; align-items: center; gap: 4px; font-size: .68rem; color: var(--text-dim); text-decoration: none; }
    .rk-clube:hover { color: var(--text-muted); }
    .rk-clube img { width: 12px; height: 12px; object-fit: contain; }
    .rk-valor { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .9rem; font-weight: 800; color: var(--text-strong); flex-shrink: 0; }

    @@media (max-width: 900px) { .rk-wrap { grid-template-columns: 1fr; padding: 16px 1.1rem 0; } }
</style>
