@model ControleFutebolWeb.Models.ViewModels.TreinadoresIndexViewModel
@using ControleFutebolWeb.Helpers

@section Scripts {
    <script>
        (function () {
            function initMulti(wrapId, boxId, panelId, placeholder, onChange) {
                var wrap  = document.getElementById(wrapId);
                var box   = document.getElementById(boxId);
                var panel = document.getElementById(panelId);
                if (!wrap) return null;

                function render() {
                    var checks = panel.querySelectorAll('input[type=checkbox]');
                    var marcados = Array.prototype.filter.call(checks, function (c) { return c.checked; });
                    box.innerHTML = '';
                    if (marcados.length === 0) {
                        var ph = document.createElement('span');
                        ph.className = 'ms-placeholder';
                        ph.textContent = placeholder;
                        box.appendChild(ph);
                        return;
                    }
                    marcados.forEach(function (c) {
                        var chip = document.createElement('span');
                        chip.className = 'ms-chip';
                        var txt = document.createElement('span');
                        txt.textContent = c.dataset.nome;
                        var x = document.createElement('span');
                        x.className = 'ms-chip-x';
                        x.textContent = '×';
                        x.addEventListener('click', function (e) {
                            e.stopPropagation();
                            c.checked = false;
                            render();
                            if (onChange) onChange();
                        });
                        chip.appendChild(txt);
                        chip.appendChild(x);
                        box.appendChild(chip);
                    });
                }

                function bindChecks() {
                    panel.querySelectorAll('input[type=checkbox]').forEach(function (c) {
                        c.addEventListener('change', function () { render(); if (onChange) onChange(); });
                    });
                }

                box.addEventListener('click', function () { panel.classList.toggle('open'); });
                box.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); panel.classList.toggle('open'); }
                });
                document.addEventListener('click', function (e) {
                    if (!wrap.contains(e.target)) panel.classList.remove('open');
                });

                bindChecks();
                render();
                return { render: render, bindChecks: bindChecks, panel: panel };
            }

            function ligarBusca(inputId, optionsContainerId) {
                var input = document.getElementById(inputId);
                if (!input) return;
                function filtrar() {
                    var termo = input.value.trim().toLowerCase();
                    document.querySelectorAll('#' + optionsContainerId + ' .ms-opt').forEach(function (lbl) {
                        var nome = (lbl.querySelector('span')?.textContent || '').toLowerCase();
                        lbl.style.display = (termo === '' || nome.indexOf(termo) !== -1) ? '' : 'none';
                    });
                }
                input.addEventListener('input', filtrar);
                input.addEventListener('click', function (e) { e.stopPropagation(); });
            }

            ligarBusca('compSearch', 'compOptions');
            var timeCtl = initMulti('timeMulti', 'timeBox', 'timePanel', 'Todos os times');
            ligarBusca('timeSearch', 'timeOptions');
            initMulti('nacMulti', 'nacBox', 'nacPanel', 'Todas as nacionalidades');
            ligarBusca('nacSearch', 'nacOptions');

            function recarregarTimes() {
                var compChecks = document.querySelectorAll('#compPanel input[type=checkbox]:checked');
                var ids = Array.prototype.map.call(compChecks, function (c) { return c.value; });
                if (!timeCtl) return;

                var selecionados = Array.prototype.map.call(
                    timeCtl.panel.querySelectorAll('input[type=checkbox]:checked'),
                    function (c) { return c.value; });

                var qs = ids.length ? ids.map(function (id) { return 'competicaoIds=' + id; }).join('&') : '';
                fetch('/Jogos/TimesPorCompeticoes?' + qs)
                    .then(function (r) { return r.json(); })
                    .then(function (times) {
                        var opts = document.getElementById('timeOptions');
                        opts.innerHTML = '';
                        times.forEach(function (t) {
                            var lbl = document.createElement('label');
                            lbl.className = 'ms-opt';
                            var inp = document.createElement('input');
                            inp.type = 'checkbox';
                            inp.name = 'timeIds';
                            inp.value = t.id;
                            inp.dataset.nome = t.nome;
                            if (selecionados.indexOf(String(t.id)) !== -1) inp.checked = true;
                            var sp = document.createElement('span');
                            sp.textContent = t.nome;
                            lbl.appendChild(inp);
                            lbl.appendChild(sp);
                            opts.appendChild(lbl);
                        });
                        timeCtl.bindChecks();
                        timeCtl.render();
                    });
            }

            initMulti('compMulti', 'compBox', 'compPanel', 'Todas as competições', recarregarTimes);
        })();
    </script>
}

@{
    ViewData["Title"] = "Treinadores";

    var competicoesLista = Model.Competicoes;
    var timesLista = Model.Times;
    var nacLista = Model.NacionalidadesLista;
    var compSel = Model.CompeticaoIdsFiltro;
    var timeSel = Model.TimeIdsFiltro;
    var nacSel = Model.NacionalidadesFiltro;
    bool temFiltro = !string.IsNullOrWhiteSpace(Model.NomeFiltro) || compSel.Any() || timeSel.Any() || nacSel.Any();

    int paginaAtual = Model.PaginaAtual;
    int totalPaginas = Model.TotalPaginas;
    int totalTreinadores = Model.TotalTreinadores;
    int pageSize = Model.PageSize;
    int primeiroDaPagina = totalTreinadores == 0 ? 0 : (paginaAtual - 1) * pageSize + 1;
    int ultimoDaPagina = Math.Min(paginaAtual * pageSize, totalTreinadores);

    var filtrosQs = new System.Text.StringBuilder();
    if (!string.IsNullOrWhiteSpace(Model.NomeFiltro)) filtrosQs.Append("&nome=").Append(Uri.EscapeDataString(Model.NomeFiltro));
    foreach (var id in compSel) filtrosQs.Append("&competicaoIds=").Append(id);
    foreach (var id in timeSel) filtrosQs.Append("&timeIds=").Append(id);
    foreach (var nn in nacSel) filtrosQs.Append("&nacionalidades=").Append(Uri.EscapeDataString(nn));
    Func<int, string> linkPagina = (p) => $"{Url.Action("Index")}?page={p}{filtrosQs}";

    var ptBR = new System.Globalization.CultureInfo("pt-BR");
    string Milhar(int n) => n.ToString("N0", ptBR);
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    .tr-root, .tr-root *, .tr-root *::before, .tr-root *::after { box-sizing: border-box; }

    .tr-root {
        margin: 0 -12px;
        background: var(--p-0);
        border-radius: 14px;
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
    }
    .tr-root a { text-decoration: none; color: inherit; }
    .tr-root :is(a, button, input, summary, [tabindex]):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Cabeçalho compacto (sempre escuro: cores fixas) ── */
    .tr-cab {
        padding: 1.5rem 2.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520; border-radius: 14px 14px 0 0;
        display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    }
    .tr-cab h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1; }
    .tr-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.72); }
    .tr-cab p strong { color: #f3d27a; font-weight: 700; }
    .tr-root .tr-novo {
        display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 8px;
        background: #d4a520; color: #141414; font-size: .88rem; font-weight: 700; white-space: nowrap;
    }
    .tr-root .tr-novo:hover { background: #e2b532; color: #141414; }

    /* ── Filtros ── */
    .tr-filterbar { background: var(--p-1); border-bottom: 1px solid var(--line); padding: 14px 2.5rem; }
    .tr-filterbar form { display: flex; align-items: flex-end; gap: 10px 12px; flex-wrap: wrap; margin: 0; }
    .tr-field { display: flex; flex-direction: column; gap: 4px; }
    .tr-field > .tr-rot { font-size: .78rem; font-weight: 600; color: var(--text-muted); }

    .tr-search-box {
        display: flex; align-items: center; min-width: 200px; height: 38px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden;
    }
    .tr-search-box:focus-within { border-color: #d4a520; }
    .tr-search-icon { padding: 0 10px; color: var(--text-dim); display: flex; align-items: center; flex-shrink: 0; }
    .tr-search-box input { flex: 1; min-width: 0; padding: 0 8px 0 0; height: 100%; background: transparent; border: none; color: var(--text-strong); font-family: inherit; font-size: .88rem; outline: none; }

    .ms-wrap { position: relative; min-width: 200px; max-width: 260px; }
    .ms-box {
        display: flex; flex-wrap: wrap; gap: 5px; align-items: center;
        min-height: 38px; max-height: 38px; overflow: hidden; padding: 4px 30px 4px 10px; cursor: pointer;
        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--p-2); font-size: .86rem;
    }
    .ms-wrap:focus-within .ms-box, .ms-box:hover { border-color: #d4a520; }
    .ms-box::after {
        content: ""; position: absolute; right: 12px; top: 19px; width: 7px; height: 7px; margin-top: -5px;
        border-right: 1.5px solid var(--text-muted); border-bottom: 1.5px solid var(--text-muted); transform: rotate(45deg);
        pointer-events: none;
    }
    .ms-placeholder { color: var(--text-muted); }
    .ms-chip {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.35);
        border-radius: 6px; padding: 1px 6px; font-size: .8rem; font-weight: 600;
    }
    .ms-chip-x { cursor: pointer; font-weight: 700; line-height: 1; opacity: .7; }
    .ms-chip-x:hover { opacity: 1; }
    .ms-panel {
        position: absolute; top: calc(100% + 4px); left: 0; min-width: 100%; width: max-content; max-width: min(340px, calc(100vw - 32px));
        z-index: 50; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0,0,0,.22); max-height: 300px; overflow-y: auto; display: none; padding: 4px;
    }
    .ms-panel.open { display: block; }
    .ms-opt { display: flex; align-items: center; gap: 8px; padding: 7px 10px; margin: 0; border-radius: 6px; cursor: pointer; font-size: .86rem; color: var(--text); }
    .ms-opt:hover { background: var(--p-4); }
    .ms-opt input { cursor: pointer; accent-color: #d4a520; }
    .ms-search {
        width: 100%; padding: 7px 10px; margin-bottom: 4px;
        border: 1px solid var(--line-strong); border-radius: 6px; font-size: .86rem; outline: none;
        position: sticky; top: 0; background: var(--p-1); color: var(--text);
    }
    .ms-search:focus { border-color: #d4a520; }

    .tr-acoes-filtro { display: flex; align-items: center; gap: 10px; }
    .tr-btn-filtrar {
        height: 38px; padding: 0 18px; border-radius: 8px; border: none; cursor: pointer;
        background: var(--text-strong); color: var(--p-0); font-family: inherit; font-size: .88rem; font-weight: 700;
    }
    .tr-btn-filtrar:hover { opacity: .88; }
    .tr-root .tr-btn-limpar { font-size: .84rem; font-weight: 600; color: var(--text-muted); }
    .tr-root .tr-btn-limpar:hover { color: var(--text-strong); text-decoration: underline; }

    /* ── Conteúdo ── */
    .tr-content { padding: 20px 2.5rem 56px; max-width: 1500px; margin: 0 auto; }
    .tr-resumo { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; color: var(--text-dim); font-size: .86rem; }
    .tr-resumo strong { color: var(--text-strong); }

    .tr-alerta { border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: .88rem; display: flex; justify-content: space-between; gap: 12px; }
    .tr-alerta button { background: none; border: none; color: inherit; cursor: pointer; opacity: .7; }
    .tr-alerta.ok { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--ok); }
    .tr-alerta.erro { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: var(--bad); }
    .tr-alerta.info { background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.3); color: var(--warn); }

    .tr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 12px; }

    .tr-card {
        position: relative; background: var(--p-1); border: 1px solid var(--line); border-radius: 12px;
        padding: 14px; display: flex; flex-direction: column; gap: 12px;
    }
    .tr-card:hover { border-color: var(--line-strong); background: var(--p-2); }
    .tr-topo { display: flex; gap: 12px; align-items: center; }
    .tr-avatar {
        width: 52px; height: 52px; border-radius: 50%; background: var(--p-3); border: 1px solid var(--line-strong);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;
        font-family: 'Barlow Condensed', Arial, sans-serif; font-weight: 700; color: var(--text-dim);
    }
    .tr-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .tr-info { flex: 1; min-width: 0; }
    /* O link do nome cobre o card inteiro; as ações ficam por cima dele */
    .tr-root .tr-nome { display: block; font-size: 1rem; font-weight: 700; color: var(--text-strong); line-height: 1.2; overflow-wrap: anywhere; }
    .tr-root .tr-nome::after { content: ""; position: absolute; inset: 0; border-radius: 12px; }
    .tr-root .tr-card:hover .tr-nome { color: var(--gold-ink); }
    .tr-meta { font-size: .82rem; color: var(--text-dim); margin-top: 2px; }
    .tr-clube { display: flex; align-items: center; gap: 7px; margin-top: 6px; font-size: .86rem; }
    .tr-clube img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
    .tr-clube-nome { font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tr-clube-desde { color: var(--text-dim); white-space: nowrap; }

    .tr-base {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        border-top: 1px solid var(--line-soft); padding-top: 10px;
    }
    .tr-campanha { display: flex; align-items: baseline; gap: 8px; min-width: 0; font-variant-numeric: tabular-nums; }
    .tr-aprov { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--text-strong); line-height: 1; }
    .tr-campanha-txt { font-size: .8rem; color: var(--text-dim); line-height: 1.3; }
    .tr-campanha-vazia { font-size: .82rem; color: var(--text-dimmer); }

    .tr-card-acoes { position: relative; z-index: 2; display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .tr-root .tr-acao {
        display: inline-flex; align-items: center; padding: 5px 9px; border-radius: 7px;
        border: 1px solid transparent; background: transparent; color: var(--text-muted);
        font-family: inherit; font-size: .82rem; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .tr-root .tr-acao:hover { border-color: var(--line-strong); color: var(--text-strong); background: var(--p-0); }

    .tr-menu { position: relative; }
    .tr-menu > summary { list-style: none; }
    .tr-menu > summary::-webkit-details-marker { display: none; }
    .tr-menu:not([open]) .tr-menu-lista { display: none; }
    .tr-menu-lista {
        position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 230px;
        display: flex; flex-direction: column; padding: 6px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px; box-shadow: 0 10px 24px rgba(0,0,0,.18);
    }
    .tr-menu-lista form { margin: 0; }
    .tr-root .tr-menu-item {
        display: block; width: 100%; text-align: left; padding: 8px 10px; border-radius: 7px; border: none;
        background: transparent; color: var(--text); font-family: inherit; font-size: .86rem; font-weight: 600; cursor: pointer;
    }
    .tr-root .tr-menu-item:hover { background: var(--p-4); color: var(--text-strong); }
    .tr-menu-item small { display: block; font-weight: 400; color: var(--text-dim); font-size: .76rem; margin-top: 1px; }
    .tr-root .tr-menu-item.perigo { color: var(--bad); }

    .tr-vazio { text-align: center; color: var(--text-dim); padding: 3rem 1rem; background: var(--p-1); border: 1px dashed var(--line); border-radius: 12px; }
    .tr-root .tr-vazio a { color: var(--gold-ink); text-decoration: underline; }

    /* ── Paginação ── */
    .tr-pagination { margin-top: 20px; }
    .tr-pagination .pagination { margin: 0; gap: 4px; }
    .tr-pagination .page-link { background: var(--p-1); border: 1px solid var(--line); border-radius: 8px !important; color: var(--text-muted); min-width: 38px; text-align: center; }
    .tr-pagination .page-link:hover { background: var(--p-3); color: var(--text-strong); }
    .tr-pagination .page-item.active .page-link { background: var(--text-strong); border-color: var(--text-strong); color: var(--p-0); font-weight: 700; }
    .tr-pagination .page-item.disabled .page-link { background: var(--p-1); border-color: var(--line); color: var(--text-dimmer); }

    @@media (max-width: 760px) {
        .tr-cab, .tr-filterbar, .tr-content { padding-left: 1rem; padding-right: 1rem; }
        .tr-cab h1 { font-size: 2rem; }
        .tr-field, .ms-wrap { flex: 1 1 100%; max-width: none; min-width: 0; }
        .tr-acoes-filtro { flex: 1 1 100%; }
        .tr-btn-filtrar { flex: 1; }
        .tr-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="tr-root">
    <div class="tr-cab theme-dark-zone">
        <div>
            <h1>Treinadores</h1>
            <p>
                @if (temFiltro)
                {
                    <strong>@Milhar(totalTreinadores)</strong> @(totalTreinadores == 1 ? "encontrado" : "encontrados") <text>com os filtros</text>
                }
                else
                {
                    <strong>@Milhar(totalTreinadores)</strong> <text>cadastrados, com a campanha no clube atual</text>
                }
            </p>
        </div>
        <a asp-action="Create" class="tr-novo">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Novo treinador
        </a>
    </div>

    <div class="tr-filterbar">
        <form asp-action="Index" method="get">
            <div class="tr-field">
                <label class="tr-rot" for="trBusca">Nome</label>
                <div class="tr-search-box">
                    <span class="tr-search-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></span>
                    <input type="search" id="trBusca" name="nome" value="@Model.NomeFiltro" placeholder="Buscar treinador" />
                </div>
            </div>

            <div class="tr-field">
                <span class="tr-rot" id="rotComp">Competições</span>
                <div class="ms-wrap" id="compMulti">
                    <div class="ms-box" id="compBox" tabindex="0" role="button" aria-labelledby="rotComp" aria-haspopup="true"></div>
                    <div class="ms-panel" id="compPanel">
                        <input type="text" class="ms-search" id="compSearch" placeholder="Buscar competição" autocomplete="off" aria-label="Buscar competição" />
                        <div id="compOptions">
                            @foreach (var c in competicoesLista)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="competicaoIds" value="@c.Id" data-nome="@c.Nome"
                                           @(compSel.Contains(c.Id) ? "checked" : "") />
                                    <span>@c.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tr-field">
                <span class="tr-rot" id="rotTimes">Times</span>
                <div class="ms-wrap" id="timeMulti">
                    <div class="ms-box" id="timeBox" tabindex="0" role="button" aria-labelledby="rotTimes" aria-haspopup="true"></div>
                    <div class="ms-panel" id="timePanel">
                        <input type="text" class="ms-search" id="timeSearch" placeholder="Buscar time" autocomplete="off" aria-label="Buscar time" />
                        <div id="timeOptions">
                            @foreach (var t in timesLista)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="timeIds" value="@t.Id" data-nome="@t.Nome"
                                           @(timeSel.Contains(t.Id) ? "checked" : "") />
                                    <span>@t.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tr-field">
                <span class="tr-rot" id="rotNac">Nacionalidades</span>
                <div class="ms-wrap" id="nacMulti">
                    <div class="ms-box" id="nacBox" tabindex="0" role="button" aria-labelledby="rotNac" aria-haspopup="true"></div>
                    <div class="ms-panel" id="nacPanel">
                        <input type="text" class="ms-search" id="nacSearch" placeholder="Buscar nacionalidade" autocomplete="off" aria-label="Buscar nacionalidade" />
                        <div id="nacOptions">
                            @foreach (var n in nacLista)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="nacionalidades" value="@n.Nome" data-nome="@n.Nome"
                                           @(nacSel.Contains(n.Nome) ? "checked" : "") />
                                    <span>@n.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="tr-acoes-filtro">
                <button type="submit" class="tr-btn-filtrar">Aplicar filtros</button>
                @if (temFiltro)
                {
                    <a asp-action="Index" class="tr-btn-limpar">Limpar filtros</a>
                }
            </div>
        </form>
    </div>

    <div class="tr-content">
        @if (TempData["Sucesso"] != null)
        {
            <div class="tr-alerta ok" role="status"><span>@TempData["Sucesso"]</span><button type="button" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button></div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="tr-alerta erro" role="alert"><span>@TempData["Erro"]</span><button type="button" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button></div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="tr-alerta info" role="status"><span>@TempData["Info"]</span><button type="button" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button></div>
        }

        @if (totalPaginas > 1)
        {
            <div class="tr-resumo">
                <span>Mostrando <strong>@primeiroDaPagina a @ultimoDaPagina</strong> de <strong>@Milhar(totalTreinadores)</strong>, em ordem alfabética</span>
                <span>Página @paginaAtual de @totalPaginas</span>
            </div>
        }

        @if (!Model.Itens.Any())
        {
            <div class="tr-vazio">
                @if (temFiltro)
                {
                    <text>Nenhum treinador com esses filtros. <a asp-action="Index">Limpar filtros</a></text>
                }
                else
                {
                    <text>Nenhum treinador cadastrado. <a asp-action="Create">Cadastre o primeiro</a></text>
                }
            </div>
        }
        else
        {
            <div class="tr-grid">
                @foreach (var treinador in Model.Itens)
                {
                    var stat = Model.Stats.TryGetValue(treinador.Id, out var s) ? s : new ControleFutebolWeb.Models.ViewModels.TreinadorCardStats();
                    var meta = new List<string>();
                    if (treinador.Nacionalidade != null) meta.Add(treinador.Nacionalidade.Nome);
                    if (treinador.Idade > 0) meta.Add($"{treinador.Idade} anos");

                    <article class="tr-card">
                        <div class="tr-topo">
                            <div class="tr-avatar">
                                @if (!string.IsNullOrEmpty(treinador.FotoUrl))
                                {
                                    <img src="@Url.FotoSrc(treinador.FotoUrl)" alt="" loading="lazy" decoding="async"
                                         onerror="this.replaceWith(document.createTextNode(this.dataset.ini))" data-ini="@(treinador.Nome.Length >= 2 ? treinador.Nome[..2].ToUpper() : "?")" />
                                }
                                else
                                {
                                    <text>@(treinador.Nome.Length >= 2 ? treinador.Nome[..2].ToUpper() : "?")</text>
                                }
                            </div>
                            <div class="tr-info">
                                <a asp-action="Details" asp-route-id="@treinador.Id" class="tr-nome">@treinador.Nome</a>
                                @if (meta.Any())
                                {
                                    <div class="tr-meta">@string.Join(", ", meta)</div>
                                }
                                <div class="tr-clube">
                                    @if (treinador.Time != null)
                                    {
                                        @if (!string.IsNullOrEmpty(treinador.Time.EscudoUrl))
                                        {
                                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = treinador.Time.EscudoUrl })" alt="" loading="lazy" decoding="async" />
                                        }
                                        <span class="tr-clube-nome">@treinador.Time.Nome</span>
                                        @if (stat.DesdeDoHistorico && stat.Desde.HasValue)
                                        {
                                            <span class="tr-clube-desde">desde @stat.Desde.Value.ToString("MMM yyyy", ptBR)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="tr-clube-desde">Sem clube</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="tr-base">
                            @if (stat.TotalJogos > 0)
                            {
                                <div class="tr-campanha" title="Aproveitamento: pontos ganhos sobre os disputados">
                                    <span class="tr-aprov">@stat.PercentualAproveitamento%</span>
                                    <span class="tr-campanha-txt">
                                        em @(stat.TotalJogos == 1 ? "1 jogo" : $"{stat.TotalJogos} jogos")<br />
                                        @stat.Vitorias V, @stat.Empates E, @stat.Derrotas D
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="tr-campanha-vazia">Sem jogos no cargo atual</span>
                            }

                            <div class="tr-card-acoes">
                                <a asp-action="ConsultarHistorico" asp-route-id="@treinador.Id" class="tr-acao">Histórico</a>
                                <details class="tr-menu">
                                    <summary class="tr-acao" aria-label="Mais ações para @treinador.Nome">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg>
                                    </summary>
                                    <div class="tr-menu-lista">
                                        <a asp-action="Edit" asp-route-id="@treinador.Id" class="tr-menu-item">Editar</a>
                                        <a asp-controller="AnotacoesTreinador" asp-action="Index" asp-route-treinadorId="@treinador.Id" class="tr-menu-item">Anotações</a>
                                        <form asp-action="BuscarFoto" asp-route-id="@treinador.Id" method="post"
                                              onsubmit="return confirm(this.dataset.confirmar)" data-confirmar="Atualizar os dados de @treinador.Nome pela api-football?">
                                            <input type="hidden" name="page" value="@paginaAtual" />
                                            @if (!string.IsNullOrWhiteSpace(Model.NomeFiltro))
                                            {
                                                <input type="hidden" name="nome" value="@Model.NomeFiltro" />
                                            }
                                            @foreach (var cid in compSel)
                                            {
                                                <input type="hidden" name="competicaoIds" value="@cid" />
                                            }
                                            @foreach (var tid in timeSel)
                                            {
                                                <input type="hidden" name="timeIds" value="@tid" />
                                            }
                                            @foreach (var nn in nacSel)
                                            {
                                                <input type="hidden" name="nacionalidades" value="@nn" />
                                            }
                                            <button type="submit" class="tr-menu-item">
                                                Atualizar dados pela API
                                                <small>Foto, idade e nacionalidade</small>
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@treinador.Id" class="tr-menu-item perigo">Excluir</a>
                                    </div>
                                </details>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (totalPaginas > 1)
        {
            int janela = 2;
            int inicio = Math.Max(1, paginaAtual - janela);
            int fim = Math.Min(totalPaginas, paginaAtual + janela);

            <nav aria-label="Páginas de treinadores" class="tr-pagination">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(paginaAtual <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@linkPagina(paginaAtual - 1)" aria-label="Página anterior">‹</a>
                    </li>

                    @if (inicio > 1)
                    {
                        <li class="page-item"><a class="page-link" href="@linkPagina(1)">1</a></li>
                        @if (inicio > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (int p = inicio; p <= fim; p++)
                    {
                        <li class="page-item @(p == paginaAtual ? "active" : "")">
                            <a class="page-link" href="@linkPagina(p)" aria-current="@(p == paginaAtual ? "page" : null)">@p</a>
                        </li>
                    }

                    @if (fim < totalPaginas)
                    {
                        @if (fim < totalPaginas - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item"><a class="page-link" href="@linkPagina(totalPaginas)">@totalPaginas</a></li>
                    }

                    <li class="page-item @(paginaAtual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@linkPagina(paginaAtual + 1)" aria-label="Próxima página">›</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
