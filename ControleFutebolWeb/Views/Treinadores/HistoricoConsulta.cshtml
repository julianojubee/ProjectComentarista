@model IEnumerable<ControleFutebolWeb.Models.TreinadorHistorico>
@using ControleFutebolWeb.Helpers
<partial name="_HistoricoEstilos" />
<div class="estat-page">
    <div class="container" style="max-width:860px;">

        <a href="javascript:history.back()" class="btn-voltar">← Voltar</a>

        @if (TempData["Sucesso"] != null)
        {
            <div class="aviso-box aviso-ok">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="aviso-box aviso-erro">@TempData["Erro"]</div>
        }
        @if (TempData["Avisos"] != null)
        {
            <div class="aviso-box">⚠️ @TempData["Avisos"]</div>
        }

        @{
            // Detalhe item a item de um salvamento via API (formato "STATUS|time|motivo",
            // separados por "~~" — ver SalvarHistoricoApi). Mostra exatamente o que aconteceu
            // com cada passagem da pré-visualização, em vez de deixar só um total agregado.
            var detalhesRaw = TempData["HistoricoDetalhes"] as string;
        }
        @if (!string.IsNullOrEmpty(detalhesRaw))
        {
            var linhas = detalhesRaw.Split("~~", StringSplitOptions.RemoveEmptyEntries);
            <div class="jogos-titulo" style="font-size:1.1rem;">O que aconteceu ao salvar</div>
            <div style="margin-bottom:1.5rem;">
                @foreach (var linha in linhas)
                {
                    var partes = linha.Split('|');
                    var status = partes[0];
                    var nomeTime = partes.Length > 1 ? partes[1] : "";
                    var motivo = partes.Length > 2 ? partes[2] : "";
                    <div class="jogo-item" style="grid-template-columns:1fr auto; padding:.55rem .9rem; margin-bottom:.35rem;">
                        <div class="jogo-adversario" style="font-size:.85rem;">
                            @nomeTime
                            @if (status == "SALVO" && !string.IsNullOrEmpty(motivo))
                            {
                                <span style="font-size:.7rem; color:var(--muted); font-weight:400; margin-left:.4rem;">(@motivo)</span>
                            }
                        </div>
                        @if (status == "SALVO")
                        {
                            <span class="tag-badge ok">✅ salvo</span>
                        }
                        else if (status == "JASALVO")
                        {
                            <span class="tag-badge info">já estava salvo</span>
                        }
                        else
                        {
                            <span class="tag-badge aviso">ignorado — @motivo</span>
                        }
                    </div>
                }
            </div>
        }

        <!-- Header -->
        <div class="jogador-header">
            @if (!string.IsNullOrWhiteSpace(ViewBag.Treinador.FotoUrl))
            {
                <img src="@Url.FotoSrc((string)ViewBag.Treinador.FotoUrl)" class="jogador-foto" />
            }
            else
            {
                <img src="/images/placeholder-treinador.png" class="jogador-foto" />
            }

            <div>
                <h1 class="jogador-nome">@ViewBag.Treinador.Nome</h1>
                <div class="jogador-meta">
                    @if (ViewBag.Treinador.Time != null)
                    {
                        <span style="display:inline-flex; align-items:center; gap:6px;">
                            @if (!string.IsNullOrEmpty(ViewBag.Treinador.Time.EscudoUrl))
                            {
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = (string)ViewBag.Treinador.Time.EscudoUrl })"
                                     alt="@ViewBag.Treinador.Time.Nome"
                                     style="width:20px;height:20px;object-fit:contain;border-radius:50%;border:0.5px solid #e5e7eb;background:#fff;" />
                            }
                            <span>🏟️ @ViewBag.Treinador.Time.Nome</span>
                        </span>
                    }

                    @if (ViewBag.Treinador.Nacionalidade != null)
                    {
                        <span style="display:inline-flex; align-items:center; gap:6px;">
                            <span title="@ViewBag.Treinador.Nacionalidade.Nome">
                                @FlagHelper.GetFlagEmoji(ViewBag.Treinador.Nacionalidade.Nome)
                            </span>
                            <span>🌍 @ViewBag.Treinador.Nacionalidade.Nome</span>
                        </span>
                    }
                </div>
            </div>

        </div>

        <!-- Histórico -->
        <div class="jogos-titulo">
            Histórico Salvo
            @if (Model.Any())
            {
                <span style="font-size:.8rem; font-weight:400; color:var(--muted); text-transform:none;">
                    (@Model.Count() passagem(ns))
                </span>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="sem-dados">Nenhum histórico salvo para este treinador.</div>
        }
        else
        {
            foreach (var h in Model)
            {
                <div class="jogo-item">
                    <div style="display:flex; align-items:center; gap:10px;">
                        @if (!string.IsNullOrEmpty(h.Time?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = h.Time.EscudoUrl })"
                                 alt="@h.Time.Nome"
                                 style="width:24px;height:24px;object-fit:contain;
                                            border-radius:50%;border:1px solid #e5e7eb;
                                            background:#fff;" />
                        }
                        <div>
                            <div class="jogo-adversario">@h.Time.Nome</div>
                            <div class="jogo-data">
                                @h.DtInicio.ToString("dd/MM/yyyy")
                                até @(h.DtFim?.ToString("dd/MM/yyyy") ?? "Atual")
                            </div>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="LimparHistorico" asp-route-id="@(((ControleFutebolWeb.Models.Treinador)ViewBag.Treinador).Id)" method="post" style="margin-top:1.2rem;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm cf-small-btn"
                        title="Apagar todo o histórico salvo"
                        onclick="return confirm('Apagar todas as @Model.Count() passagem(ns) do histórico de @(((ControleFutebolWeb.Models.Treinador)ViewBag.Treinador).Nome)? Essa ação não pode ser desfeita.')">
                    🗑️ Limpar Histórico
                </button>
            </form>
        }

    </div>
</div>
