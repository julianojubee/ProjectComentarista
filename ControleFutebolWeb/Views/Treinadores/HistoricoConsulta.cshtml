@model IEnumerable<ControleFutebolWeb.Models.TreinadorHistorico>
@using ControleFutebolWeb.Models.ViewModels
@{
    var treinador = (ControleFutebolWeb.Models.Treinador)ViewBag.Treinador;
    ViewData["Title"] = $"Histórico — {treinador.Nome}";

    var passagens = Model.ToList();
    var clubesDistintos = passagens.Select(h => h.TimeId).Distinct().Count();
    var totalDias = passagens.Sum(h => h.Dias);

    // Detalhe item a item de um salvamento via API (formato "STATUS|time|motivo",
    // separados por "~~" — ver SalvarHistoricoApi). Mostra exatamente o que aconteceu
    // com cada passagem da pré-visualização, em vez de deixar só um total agregado.
    var detalhesRaw = TempData["HistoricoDetalhes"] as string;

    var hero = new TreinadorHeroViewModel
    {
        Treinador = treinador,
        Kicker = "Histórico",
        Acoes = new List<TreinadorHeroAcao>
        {
            new() { Texto = "Voltar ao treinador", Icone = "voltar", Url = Url.Action("Details", new { id = treinador.Id })! },
            new() { Texto = "Importar da API", Icone = "importar", Destaque = true, Url = Url.Action("PreVisualizarHistoricoApi", new { id = treinador.Id })! }
        }
    };
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/anotacoes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/treinador-historico.css" asp-append-version="true" />

<div class="an">

    <partial name="_TreinadorHero" model="hero" />

    @if (TempData["Sucesso"] != null)
    {
        <div class="an-alert-ok m-3">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="th-alerta th-alerta-erro m-3">@TempData["Erro"]</div>
    }
    @if (TempData["Avisos"] != null)
    {
        <div class="th-alerta th-alerta-aviso m-3">⚠️ @TempData["Avisos"]</div>
    }

    <div class="an-grid">

        <!-- ── Esquerda: passagens ──────────────────── -->
        <div>
            @if (!string.IsNullOrEmpty(detalhesRaw))
            {
                <div class="th-sec-title">
                    <span class="lbl">O que aconteceu ao salvar</span>
                    <div class="line"></div>
                </div>

                @foreach (var linha in detalhesRaw.Split("~~", StringSplitOptions.RemoveEmptyEntries))
                {
                    var partes = linha.Split('|');
                    var status = partes[0];
                    var nomeTime = partes.Length > 1 ? partes[1] : "";
                    var motivo = partes.Length > 2 ? partes[2] : "";

                    <div class="th-linha th-linha-compacta">
                        <span class="th-linha-nome">
                            @nomeTime
                            @if (status == "SALVO" && !string.IsNullOrEmpty(motivo))
                            {
                                <span class="th-obs">(@motivo)</span>
                            }
                        </span>
                        @if (status == "SALVO")
                        {
                            <span class="th-tag th-tag-ok">✅ salvo</span>
                        }
                        else if (status == "JASALVO")
                        {
                            <span class="th-tag th-tag-info">já estava salvo</span>
                        }
                        else
                        {
                            <span class="th-tag th-tag-aviso">ignorado — @motivo</span>
                        }
                    </div>
                }
            }

            <div class="th-sec-title" style="@(string.IsNullOrEmpty(detalhesRaw) ? "" : "margin-top:32px;")">
                <span class="lbl">Histórico Salvo</span>
                <div class="line"></div>
                @if (passagens.Any())
                {
                    <span class="badge">@passagens.Count passagem(ns)</span>
                }
            </div>

            @if (!passagens.Any())
            {
                <div class="an-empty">
                    <div>Nenhum histórico salvo para este treinador.</div>
                    <a asp-action="PreVisualizarHistoricoApi" asp-route-id="@treinador.Id"
                       class="an-btn gold" style="display:inline-flex;margin-top:1rem;">
                        Importar da API
                    </a>
                </div>
            }
            else
            {
                @foreach (var h in passagens)
                {
                    <div class="th-linha">
                        @if (!string.IsNullOrEmpty(h.Time?.EscudoUrl))
                        {
                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = h.Time.EscudoUrl })" alt="@h.Time.Nome" />
                        }
                        <div class="th-linha-info">
                            <div class="th-linha-nome">@h.Time?.Nome</div>
                            <div class="th-linha-data">
                                @h.DtInicio.ToString("dd/MM/yyyy") até @(h.DtFim?.ToString("dd/MM/yyyy") ?? "hoje")
                                · @h.Dias dia(s)
                            </div>
                        </div>
                        @if (h.DtFim == null)
                        {
                            <span class="th-tag th-tag-ok">Atual</span>
                        }
                    </div>
                }
            }
        </div>

        <!-- ── Direita: resumo + ações ──────────────── -->
        <div class="an-sidebar">
            <div class="an-resumo" style="margin-top:0;">
                <div class="an-resumo-title">Resumo</div>
                <div class="an-resumo-row">
                    <div class="an-resumo-label"><span>Passagens</span></div>
                    <span class="an-resumo-count">@passagens.Count</span>
                </div>
                <div class="an-resumo-row">
                    <div class="an-resumo-label"><span>Clubes distintos</span></div>
                    <span class="an-resumo-count">@clubesDistintos</span>
                </div>
                <div class="an-resumo-row">
                    <div class="an-resumo-label"><span>Dias somados</span></div>
                    <span class="an-resumo-count">@totalDias</span>
                </div>
            </div>

            @if (passagens.Any())
            {
                <div class="th-acoes">
                    <form asp-action="LimparHistorico" asp-route-id="@treinador.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="th-btn-perigo"
                                onclick="return confirm('Apagar todas as @passagens.Count passagem(ns) do histórico de @treinador.Nome? Essa ação não pode ser desfeita.')">
                            🗑️ Limpar Histórico
                        </button>
                    </form>
                </div>
            }
        </div>

    </div>
</div>
