@model ControleFutebolWeb.Models.Treinador
@{ ViewData["Title"] = "Novo treinador"; }

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/select-buscavel.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Index" class="af-voltar">Treinadores</a>
        <h1 class="af-title">Novo treinador</h1>
        <div class="af-sub">
            Depois de cadastrar, a ficha do treinador permite importar as passagens e a foto pela api-football.
        </div>

        <div asp-validation-summary="All" class="af-validation" style="margin-bottom:1rem;"></div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="af-field">
                <label class="af-label" for="Nome">Nome</label>
                <input asp-for="Nome" class="af-input" placeholder="Abel Ferreira" required autofocus />
                <span asp-validation-for="Nome" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="DataNascimento">Data de nascimento <small>(opcional)</small></label>
                <input asp-for="DataNascimento" type="date" class="af-input" />
                <div class="af-hint">A importação pela API costuma preencher depois.</div>
            </div>

            <div class="af-field">
                <label class="af-label" for="NacionalidadeId">Nacionalidade <small>(opcional)</small></label>
                @Html.DropDownList("NacionalidadeId", (SelectList)ViewBag.Nacionalidades, "Selecione",
                    new { @class = "af-select", data_buscavel = "Buscar nacionalidade" })
            </div>

            <div class="af-field">
                <label class="af-label" for="TimeId">Time atual</label>
                @Html.DropDownList("TimeId", (SelectList)ViewBag.Times, "Selecione",
                    new { @class = "af-select", data_buscavel = "Buscar time" })
                <span asp-validation-for="TimeId" class="af-validation"></span>
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">Cadastrar treinador</button>
                <a asp-action="Index" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
