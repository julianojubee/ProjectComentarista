@model ControleFutebolWeb.Models.Treinador
@using ControleFutebolWeb.Helpers
@{ ViewData["Title"] = $"Excluir {Model.Nome}"; }

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Details" asp-route-id="@Model.Id" class="af-voltar">@Model.Nome</a>
        <h1 class="af-title">Excluir treinador</h1>

        <div class="af-alerta">
            O histórico de passagens e as anotações de <strong>@Model.Nome</strong> serão apagados junto.
            Essa ação não pode ser desfeita.
        </div>

        <div class="af-resumo">
            <img src="@(Url.FotoSrc(Model.FotoUrl) ?? Url.Content("~/images/placeholder-treinador.png"))" alt="" />
            <div>
                <div class="af-resumo-nome">@Model.Nome</div>
                <div class="af-resumo-meta">
                    @string.Join(", ", new[] { Model.Time?.Nome, Model.Nacionalidade?.Nome, Model.Idade > 0 ? $"{Model.Idade} anos" : null }
                        .Where(x => !string.IsNullOrEmpty(x)))
                </div>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="af-actions">
                <button type="submit" class="af-danger">Excluir treinador</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
