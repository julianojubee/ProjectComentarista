@model ControleFutebolWeb.Models.ViewModels.TreinadorHistoricoApiViewModel
@using ControleFutebolWeb.Models.ViewModels
@{
    ViewData["Title"] = $"Importar histórico de {Model.Treinador.Nome}";
    string Qtd(int n, string um, string varios) => n == 1 ? $"1 {um}" : $"{n} {varios}";
    var novas = Model.Itens.Count(i => i.StatusPrevisto == "nova");
    var jaSalvas = Model.Itens.Count(i => i.StatusPrevisto == "ja-salva");
    var ignoradas = Model.Itens.Count(i => i.StatusPrevisto == "ignorada");
    var naoCadastrados = Model.Itens.Count(i => i.ClubeNaoCadastrado);

    // Homônimos na API e nenhum escolhido ainda: a tela vira um seletor e o histórico
    // (e o botão de salvar) só aparecem depois da escolha.
    var escolhaPendente = Model.Ambiguo && Model.Candidatos.Any();

    var hero = new TreinadorHeroViewModel
    {
        Treinador = Model.Treinador,
        Kicker = "Importar histórico",
        MetaExtra = "dados da api-football"
    };
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/anotacoes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/treinador-historico.css" asp-append-version="true" />

<div class="an">

    <partial name="_TreinadorHero" model="hero" />

    <div class="an-grid">

        <!-- ── Esquerda: o que vem da API ───────────── -->
        <div>
            @if (Model.RegistroCompletoEncontrado)
            {
                <div class="th-alerta th-alerta-ok">
                    Registro completo do técnico localizado. A API tinha um cadastro parcial ligado ao
                    time atual, sem idade e nacionalidade confirmadas, e a lista abaixo já une as
                    passagens dos dois registros.
                </div>
            }

            @if (escolhaPendente)
            {
                <!-- Homônimos na API (ex.: os dois "Luís Castro" portugueses): em vez de importar
                     só a passagem do time atual, o usuário escolhe de quem é a carreira. -->
                <div class="th-alerta th-alerta-aviso">
                    A API tem <b>@Model.Candidatos.Count técnicos</b> com o nome de @Model.Treinador.Nome.
                    Escolha o certo: o histórico dele será importado e o cadastro (idade, nacionalidade
                    e foto) atualizado. O time atual
                    @if (Model.Treinador.Time != null)
                    {
                        <text>(<b>@Model.Treinador.Time.Nome</b>)</text>
                    }
                    não muda.
                </div>

                <div class="th-sec-title">
                    <h2>Qual deles é o @Model.Treinador.Nome?</h2>
                    <div class="line"></div>
                </div>

                @foreach (var c in Model.Candidatos)
                {
                    <div class="th-candidato">
                        <img src="@(!string.IsNullOrWhiteSpace(c.FotoUrl) ? Url.Action("Imagem", "MediaProxy", new { url = c.FotoUrl }) : Url.Content("~/images/placeholder-treinador.png"))"
                             alt="" loading="lazy" />

                        <div class="th-candidato-info">
                            <div class="th-candidato-nome">
                                @(c.NomeCompleto ?? c.Nome)
                                @if (c.Idade.HasValue)
                                {
                                    <span class="th-tag th-tag-info">@c.Idade anos</span>
                                }
                            </div>
                            <div class="th-candidato-meta">
                                @if (!string.IsNullOrWhiteSpace(c.Nacionalidade))
                                {
                                    <span>@c.Nacionalidade</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.TimeAtual))
                                {
                                    <span>hoje em @c.TimeAtual</span>
                                }
                                <span>@Qtd(c.TotalPassagens, "passagem", "passagens")</span>
                                @if (!string.IsNullOrWhiteSpace(c.PeriodoCarreira))
                                {
                                    <span>de @c.PeriodoCarreira.Replace(" – ", " a ")</span>
                                }
                            </div>
                            @if (c.ClubesResumo.Any())
                            {
                                <div class="th-candidato-clubes">
                                    @string.Join(", ", c.ClubesResumo)@(c.TotalPassagens > c.ClubesResumo.Count ? " e outros" : "")
                                </div>
                            }
                        </div>

                        <a asp-action="PreVisualizarHistoricoApi" asp-route-id="@Model.Treinador.Id"
                           asp-route-coachApiId="@c.Id" class="th-btn-escolher">Escolher este</a>
                    </div>
                }
            }
            else if (Model.Ambiguo)
            {
                <div class="th-alerta th-alerta-aviso">
                    A API tem mais de um técnico com nome parecido com @Model.Treinador.Nome e só achou
                    um cadastro parcial, sem idade e nacionalidade confirmadas. Não deu para confirmar o
                    registro completo, então a lista abaixo pode ter só a passagem atual.
                </div>
            }

            @if (Model.Escolhido != null)
            {
                <!-- Registro escolhido entre homônimos: deixa explícito de quem são os dados que
                     serão gravados e permite trocar sem sair da tela. -->
                <div class="th-alerta th-alerta-ok" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                    <div style="flex:1; min-width:220px;">
                        Usando o registro de <b>@(Model.Escolhido.NomeCompleto ?? Model.Escolhido.Nome)</b>@if (Model.Escolhido.Idade.HasValue)
                        {<text>, @Model.Escolhido.Idade anos</text>}@if (!string.IsNullOrWhiteSpace(Model.Escolhido.Nacionalidade))
                        {<text>, @Model.Escolhido.Nacionalidade</text>}.
                        Ao salvar, esses dados vão para o cadastro e o time atual
                        @if (Model.Treinador.Time != null)
                        {
                            <text>(<b>@Model.Treinador.Time.Nome</b>)</text>
                        }
                        é mantido.
                    </div>
                    <a asp-action="PreVisualizarHistoricoApi" asp-route-id="@Model.Treinador.Id"
                       asp-route-escolher="true" class="th-trocar">
                        Trocar de técnico
                    </a>
                </div>
            }

            <!-- Histórico. Com escolha pendente entre homônimos ele nem é montado — só aparece
                 depois que o usuário disser qual técnico é o certo. -->
            @if (!escolhaPendente)
            {
                <div class="th-sec-title">
                    <h2>Passagens na api-football</h2>
                    <div class="line"></div>
                    @if (Model.Itens.Any())
                    {
                        <span class="badge">@Qtd(Model.Itens.Count, "passagem", "passagens")</span>
                    }
                </div>

                @if (!Model.Itens.Any())
                {
                    <div class="an-empty">Nenhum histórico encontrado para este treinador na API.</div>
                }
                else
                {
                    @foreach (var item in Model.Itens)
                    {
                        <div class="th-linha @(item.ClubeNaoCadastrado ? "nao-cadastrado" : item.JaSalva ? "ja-salva" : "")">
                            <div class="th-linha-info">
                                <div class="th-linha-nome">@(item.TimeLocalNome ?? item.NomeTime)</div>
                                <div class="th-linha-data">
                                    @(item.DtInicio?.ToString("dd/MM/yyyy") ?? "início desconhecido")
                                    a @(item.DtFim?.ToString("dd/MM/yyyy") ?? "hoje")
                                </div>
                            </div>
                            @if (item.ClubeNaoCadastrado)
                            {
                                <span class="th-tag th-tag-aviso">Clube não cadastrado</span>
                            }
                            else if (item.JaSalva)
                            {
                                <span class="th-tag th-tag-info">Já salva</span>
                            }
                            else
                            {
                                <span class="th-tag th-tag-ok">Nova</span>
                            }
                        </div>
                    }
                }
            }
        </div>

        <!-- ── Direita: previsão + salvar ───────────── -->
        <div class="an-sidebar">
            @if (!escolhaPendente)
            {
                <div class="an-form-card">
                    <div class="an-form-head">
                        <h2>Salvar histórico</h2>
                    </div>
                    <div class="an-form-body">
                        <!-- Prevê exatamente o resultado do clique em "Salvar Histórico" — mesma regra de
                             dedupe usada em SalvarHistoricoApi — pra fechar o ciclo preview → salvar sem
                             surpresa nenhuma. -->
                        <div class="th-previsao">
                            Das <b>@Model.Itens.Count</b> passagens da API:
                            <ul style="margin:.4rem 0 0;padding-left:1.1rem">
                                <li><b>@novas</b> @(novas == 1 ? "será salva" : "serão salvas")</li>
                                @if (jaSalvas > 0) { <li><b>@jaSalvas</b> @(jaSalvas == 1 ? "já estava salva" : "já estavam salvas")</li> }
                                @if (ignoradas > 0) { <li><b>@ignoradas</b> @(ignoradas == 1 ? "será ignorada" : "serão ignoradas")</li> }
                            </ul>
                            @if (naoCadastrados > 0)
                            {
                                <p style="margin:.6rem 0 0">@(naoCadastrados == 1 ? "1 delas tem o clube" : $"{naoCadastrados} delas têm o clube") fora do sistema. Marque a opção abaixo para cadastrar.</p>
                            }
                        </div>

                        <form asp-action="SalvarHistoricoApi" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="treinadorId" value="@Model.Treinador.Id" />
                            @if (Model.EscolhidoId.HasValue)
                            {
                                <!-- Carrega a escolha do preview até o salvamento, senão o servidor voltaria
                                     a considerar a resolução ambígua. -->
                                <input type="hidden" name="coachApiId" value="@Model.EscolhidoId" />
                            }

                            @if (naoCadastrados > 0)
                            {
                                <label class="th-check">
                                    <input type="checkbox" name="criarClubes" value="true" />
                                    <span>
                                        Cadastrar @(naoCadastrados == 1 ? "o clube que falta" : $"os {naoCadastrados} clubes que faltam")
                                        só com nome e escudo, para completar depois em Times
                                    </span>
                                </label>
                            }

                            <button type="submit" class="th-btn-salvar"
                                    disabled="@(novas == 0 && naoCadastrados == 0 ? "disabled" : null)">
                                @if (novas == 0 && naoCadastrados == 0)
                                {
                                    <text>Nada novo para salvar</text>
                                }
                                else
                                {
                                    <text>Salvar histórico</text>
                                }
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

    </div>
</div>
