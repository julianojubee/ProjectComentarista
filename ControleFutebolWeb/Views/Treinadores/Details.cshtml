@model ControleFutebolWeb.Models.Treinador
@{
    ViewData["Title"] = $"Detalhes — {Model.Nome}";
}

<partial name="_HistoricoEstilos" />

<div class="estat-page">
    <div class="container" style="max-width:860px;">

        <a href="javascript:history.back()" class="btn-voltar">← Voltar</a>

        @if (TempData["Sucesso"] != null)
        {
            <div class="aviso-box aviso-ok">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="aviso-box aviso-erro">@TempData["Erro"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="aviso-box">@TempData["Info"]</div>
        }
        @if (TempData["Avisos"] != null)
        {
            <div class="aviso-box">⚠️ @TempData["Avisos"]</div>
        }

        <!-- Header -->
        <div class="jogador-header">
            @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
            {
                <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.FotoUrl })" class="jogador-foto" />
            }
            else
            {
                <img src="/images/placeholder-treinador.png" class="jogador-foto" />
            }

            <div>
                <h1 class="jogador-nome">@Model.Nome</h1>
                <div class="jogador-meta">
                    <span>📅 @Model.Idade anos</span>
                    @if (Model.Time != null)
                    {
                        <span>🏟️ @Model.Time.Nome</span>
                    }
                    @if (Model.Nacionalidade != null)
                    {
                        <span>🌍 @Model.Nacionalidade.Nome</span>
                    }
                </div>
            </div>
        </div>

        <!-- Histórico atual: só um resumo — a lista completa vive em ConsultarHistorico,
             pra não duplicar a mesma informação em duas telas diferentes. -->
        <div class="jogos-titulo">
            Histórico no Banco
            @if (Model.Historicos.Any())
            {
                <span style="font-size:.8rem; font-weight:400; color:var(--muted); text-transform:none;">
                    (@Model.Historicos.Count() passagem(ns))
                </span>
            }
        </div>
        @if (!Model.Historicos.Any())
        {
            <div class="sem-dados">Nenhum histórico salvo ainda — use uma das opções abaixo para importar.</div>
        }
        else
        {
            foreach (var h in Model.Historicos.OrderByDescending(h => h.DtInicio).Take(3))
            {
                <div class="jogo-item">
                    <div>
                        <div class="jogo-adversario">@h.Time.Nome</div>
                        <div class="jogo-data">
                            @h.DtInicio.ToString("dd/MM/yyyy")
                            até @(h.DtFim != null ? h.DtFim.Value.ToString("dd/MM/yyyy") : "Atual")
                        </div>
                    </div>
                </div>
            }
            <a asp-action="ConsultarHistorico" asp-route-id="@Model.Id"
               style="display:inline-block; margin:.2rem 0 .5rem; font-size:.8rem; color:var(--verde2); text-decoration:none;">
                Ver histórico completo →
            </a>
        }

        <!-- Ações: importar busca os dados numa tela de pré-visualização — nada é salvo até
             clicar em "Salvar Histórico" lá. Limpar Histórico é imediato (com confirmação). -->
        <div class="resumo-contagem" style="margin-top:1.5rem;">
            "Importar Histórico" abre uma <b>pré-visualização</b> antes de salvar — nada é
            gravado até você confirmar lá. "Limpar Histórico" apaga na hora.
        </div>
        <div class="cf-card-actions">
            <form asp-action="BuscarFoto" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="voltarParaDetalhes" value="true" />
                <button type="submit" class="btn btn-outline-secondary btn-sm cf-small-btn"
                        title="Buscar foto"
                        onclick="return confirm('Buscar foto de @Model.Nome ?')">
                    📷 Buscar Foto
                </button>
            </form>

            <a asp-action="PreVisualizarHistoricoApi" asp-route-id="@Model.Id"
               class="btn btn-primary btn-sm cf-small-btn">
                📊 Importar Histórico (API)
            </a>

            @if (Model.Historicos.Any())
            {
                <form asp-action="LimparHistorico" asp-route-id="@Model.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm cf-small-btn"
                            title="Apagar todo o histórico salvo"
                            onclick="return confirm('Apagar todas as @Model.Historicos.Count() passagem(ns) do histórico de @Model.Nome? Essa ação não pode ser desfeita.')">
                        🗑️ Limpar Histórico
                    </button>
                </form>
            }
        </div>
    </div>
</div>
