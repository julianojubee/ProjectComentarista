@model ControleFutebolWeb.Models.Treinador
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models.ViewModels
@{
    ViewData["Title"] = Model.Nome;

    var historicos = Model.Historicos.OrderByDescending(h => h.DtInicio).ToList();
    var totalAnotacoes = (int)(ViewBag.TotalAnotacoes ?? 0);
    var ultimasAnotacoes = ViewBag.UltimasAnotacoes as List<ControleFutebolWeb.Models.AnotacaoTreinador>
        ?? new List<ControleFutebolWeb.Models.AnotacaoTreinador>();
    var campanha = ViewBag.Campanha as TreinadorCardStats ?? new TreinadorCardStats();

    var hoje = DateTime.Today;
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
    string MesAno(DateTime d) => d.ToString("MMM yyyy", ptBR);

    // Clubes distintos por onde passou — mais informativo que contar passagens,
    // porque uma volta ao mesmo clube gera duas passagens.
    var clubesDistintos = historicos.Select(h => h.TimeId).Distinct().Count();
    var mesesCarreira = historicos.Sum(h => DuracaoHelper.MesesCompletos(h.DtInicio, h.DtFim ?? hoje));
    var inicioCarreira = historicos.Any() ? historicos.Min(h => h.DtInicio) : (DateTime?)null;

    var hero = new TreinadorHeroViewModel
    {
        Treinador = Model,
        Acoes = new List<TreinadorHeroAcao>
        {
            new() { Texto = "Editar", Icone = "editar", Url = Url.Action("Edit", new { id = Model.Id })! },
            new()
            {
                Texto = totalAnotacoes > 0 ? $"Anotações ({totalAnotacoes})" : "Anotações",
                Icone = "anotacoes",
                Destaque = true,
                Url = Url.Action("Index", "AnotacoesTreinador", new { treinadorId = Model.Id })!
            }
        },
        Menu = new List<TreinadorHeroAcao>
        {
            new()
            {
                Texto = "Atualizar dados pela API", Detalhe = "Foto, idade e nacionalidade da api-football",
                Url = Url.Action("BuscarFoto", new { id = Model.Id })!, Post = true,
                Campos = new() { ["voltarParaDetalhes"] = "true" }
            },
            new()
            {
                Texto = "Importar histórico da API", Detalhe = "Mostra uma prévia antes de salvar",
                Url = Url.Action("PreVisualizarHistoricoApi", new { id = Model.Id })!
            },
            new() { Texto = "Ver histórico completo", Url = Url.Action("ConsultarHistorico", new { id = Model.Id })! },
        }
    };
    if (historicos.Any())
    {
        hero.Menu.Add(new()
        {
            Texto = "Limpar histórico", Detalhe = "Apaga todas as passagens salvas",
            Url = Url.Action("LimparHistorico", new { id = Model.Id })!, Post = true, Perigo = true,
            Confirmar = $"Apagar as {historicos.Count} passagens do histórico de {Model.Nome}? Essa ação não pode ser desfeita."
        });
    }
    hero.Menu.Add(new() { Texto = "Excluir treinador", Url = Url.Action("Delete", new { id = Model.Id })!, Perigo = true });
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/anotacoes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/treinador-historico.css" asp-append-version="true" />

<style>
    /* Reaproveita o hero e o grid de .an (css/anotacoes.css) e a linha do tempo de
       css/treinador-historico.css; aqui só o que é específico da ficha. */
    .td-bloco { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; margin-bottom: 18px; }
    .td-bloco > h2 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--text-strong); margin: 0; }
    .td-bloco-sub { font-size: .86rem; color: var(--text-dim); margin: 2px 0 14px; }

    /* Campanha no clube atual: aproveitamento grande, V/E/D ao lado */
    .td-campanha { display: flex; align-items: center; gap: 12px 32px; flex-wrap: wrap; }
    .td-aprov { display: flex; align-items: baseline; gap: 8px; }
    .td-aprov strong { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 3.2rem; font-weight: 800; color: var(--gold-ink); line-height: .9; }
    .td-aprov span { font-size: .86rem; color: var(--text-dim); }
    .td-ved { display: flex; gap: 22px; margin: 0; }
    .td-ved div { display: flex; flex-direction: column-reverse; }
    .td-ved dt { font-size: .8rem; font-weight: 500; color: var(--text-dim); }
    .td-ved dd { margin: 0; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--text-strong); line-height: 1; font-variant-numeric: tabular-nums; }
    .td-barra { display: flex; height: 8px; border-radius: 4px; overflow: hidden; gap: 2px; margin-top: 14px; }
    .td-barra i { display: block; }
    .td-barra .v { background: var(--ok); }
    .td-barra .e { background: var(--text-dimmer); }
    .td-barra .d { background: var(--bad); }
    .td-vazio { font-size: .9rem; color: var(--text-dim); margin: 0; }

    .an .td-link { display: inline-flex; align-items: center; gap: 4px; font-size: .86rem; font-weight: 600; color: var(--text-muted); margin-top: 12px; }
    .an .td-link:hover { color: var(--gold-ink); }

    /* Prévia das anotações */
    .td-anot { list-style: none; margin: 0; padding: 0; }
    .td-anot li { padding: 10px 0; border-bottom: 1px solid var(--line-soft); }
    .td-anot li:last-child { border-bottom: none; }
    .td-anot-titulo { font-size: .92rem; font-weight: 600; color: var(--text-strong); margin-bottom: 2px; }
    .td-anot-meta { font-size: .78rem; color: var(--text-dim); }
    .an .td-btn { display: inline-flex; margin-top: 12px; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line-strong); font-size: .86rem; font-weight: 600; color: var(--text-strong); }
    .an .td-btn:hover { border-color: #d4a520; color: var(--gold-ink); }

    .td-alerta { margin: 18px 2.5rem 0; border-radius: 10px; padding: 10px 14px; font-size: .88rem; }
    .td-alerta.ok { background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3); color: var(--ok); }
    .td-alerta.erro { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.3); color: var(--bad); }
    .td-alerta.info { background: var(--p-1); border: 1px solid var(--line); color: var(--text-muted); }
    .td-alerta.aviso { background: rgba(245,158,11,.12); border: 1px solid rgba(245,158,11,.3); color: var(--warn); }
    @@media (max-width: 640px) {
        .td-alerta { margin-left: 1.2rem; margin-right: 1.2rem; }
        .td-aprov strong { font-size: 2.6rem; }
    }
</style>

<div class="an">

    <partial name="_TreinadorHero" model="hero" />

    @if (TempData["Sucesso"] != null) { <div class="td-alerta ok" role="status">@TempData["Sucesso"]</div> }
    @if (TempData["Erro"] != null) { <div class="td-alerta erro" role="alert">@TempData["Erro"]</div> }
    @if (TempData["Info"] != null) { <div class="td-alerta info" role="status">@TempData["Info"]</div> }
    @if (TempData["Avisos"] != null) { <div class="td-alerta aviso" role="status">@TempData["Avisos"]</div> }

    <div class="an-grid">

        <div>
            <!-- Campanha no clube atual -->
            <section class="td-bloco">
                <h2>Campanha atual</h2>
                <p class="td-bloco-sub">
                    @if (Model.Time != null) { <text>@Model.Time.Nome, </text> }
                    @if (campanha.DesdeDoHistorico && campanha.Desde.HasValue)
                    {
                        <text>desde @MesAno(campanha.Desde.Value) (@DuracaoHelper.Formatar(campanha.Desde.Value, null, hoje) no cargo)</text>
                    }
                    else if (campanha.Desde.HasValue)
                    {
                        <text>jogos desde o cadastro no site, em @campanha.Desde.Value.ToString("dd/MM/yyyy"). Importe o histórico para contar desde a chegada ao clube.</text>
                    }
                </p>
                @if (campanha.TotalJogos == 0)
                {
                    <p class="td-vazio">Nenhum jogo com placar nesse período.</p>
                }
                else
                {
                    <div class="td-campanha">
                        <div class="td-aprov">
                            <strong>@campanha.PercentualAproveitamento%</strong>
                            <span>de aproveitamento<br />@campanha.Pontos pontos em @(campanha.TotalJogos == 1 ? "1 jogo" : $"{campanha.TotalJogos} jogos")</span>
                        </div>
                        <dl class="td-ved">
                            <div><dt>vitórias</dt><dd>@campanha.Vitorias</dd></div>
                            <div><dt>empates</dt><dd>@campanha.Empates</dd></div>
                            <div><dt>derrotas</dt><dd>@campanha.Derrotas</dd></div>
                        </dl>
                    </div>
                    <div class="td-barra" role="img" aria-label="@campanha.Vitorias vitórias, @campanha.Empates empates, @campanha.Derrotas derrotas">
                        <i class="v" style="flex:@campanha.Vitorias"></i>
                        <i class="e" style="flex:@campanha.Empates"></i>
                        <i class="d" style="flex:@campanha.Derrotas"></i>
                    </div>
                }
            </section>

            <!-- Carreira: só as passagens mais recentes; a lista inteira fica no histórico -->
            <section class="td-bloco">
                <h2>Carreira</h2>
                @if (!historicos.Any())
                {
                    <p class="td-bloco-sub">Nenhuma passagem salva ainda.</p>
                    <a asp-action="PreVisualizarHistoricoApi" asp-route-id="@Model.Id" class="td-btn">Importar histórico da API</a>
                }
                else
                {
                    <p class="td-bloco-sub">
                        @(historicos.Count == 1 ? "1 passagem" : $"{historicos.Count} passagens")
                        por @(clubesDistintos == 1 ? "1 clube" : $"{clubesDistintos} clubes")
                        desde @inicioCarreira!.Value.Year, @DuracaoHelper.Formatar(mesesCarreira) como técnico
                    </p>
                    <ol class="th-tempo">
                        @foreach (var h in historicos.Take(4))
                        {
                            <li class="@(h.DtFim == null ? "atual" : "")">
                                <span class="th-tempo-ano">@h.DtInicio.Year</span>
                                <span>
                                    @if (!string.IsNullOrEmpty(h.Time?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = h.Time.EscudoUrl })" alt="" loading="lazy" />
                                    }
                                </span>
                                <span class="th-linha-info">
                                    <span class="th-linha-nome"><a asp-controller="Times" asp-action="Details" asp-route-id="@h.TimeId">@h.Time?.Nome</a></span>
                                    <span class="th-linha-data" style="display:block">
                                        @MesAno(h.DtInicio) a @(h.DtFim.HasValue ? MesAno(h.DtFim.Value) : "hoje")
                                    </span>
                                </span>
                                <span class="th-tempo-dur">
                                    @if (h.DtFim == null) { <span class="th-tag th-tag-gold">Atual</span> }
                                    else { @DuracaoHelper.Formatar(h.DtInicio, h.DtFim, hoje) }
                                </span>
                            </li>
                        }
                    </ol>
                    <a asp-action="ConsultarHistorico" asp-route-id="@Model.Id" class="td-link">
                        @(historicos.Count > 4 ? $"Ver as {historicos.Count} passagens" : "Ver histórico completo")
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                    </a>
                }
            </section>
        </div>

        <!-- Lateral: anotações -->
        <div class="an-sidebar">
            <section class="td-bloco">
                <h2>Anotações</h2>
                @if (!ultimasAnotacoes.Any())
                {
                    <p class="td-bloco-sub" style="margin-bottom:0">
                        Registre estilo de jogo, contrato, desempenho e o que mais achar relevante sobre o treinador.
                    </p>
                    <a asp-controller="AnotacoesTreinador" asp-action="Index" asp-route-treinadorId="@Model.Id" class="td-btn">Escrever a primeira</a>
                }
                else
                {
                    <p class="td-bloco-sub">@(totalAnotacoes == 1 ? "1 anotação" : $"{totalAnotacoes} anotações"), as mais recentes primeiro</p>
                    <ul class="td-anot">
                        @foreach (var a in ultimasAnotacoes)
                        {
                            <li>
                                <div class="td-anot-titulo">@a.Titulo</div>
                                <div class="td-anot-meta">
                                    @if (!string.IsNullOrEmpty(a.Categoria))
                                    {
                                        <text>@a.Categoria, </text>
                                    }
                                    @DateHelper.FormatarData(a.DtInc, "dd/MM/yyyy")
                                </div>
                            </li>
                        }
                    </ul>
                    <a asp-controller="AnotacoesTreinador" asp-action="Index" asp-route-treinadorId="@Model.Id" class="td-link">
                        Ver todas as anotações
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                    </a>
                }
            </section>
        </div>

    </div>
</div>
