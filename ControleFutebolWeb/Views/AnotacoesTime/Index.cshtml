@model List<ControleFutebolWeb.Models.AnotacaoTime>
@using ControleFutebolWeb.Helpers
@{
    var time = (ControleFutebolWeb.Models.Time)ViewBag.Time;
    var q    = (string?)ViewBag.Q;
    ViewData["Title"] = $"Anotações sobre {time.Nome}";

    var obsJogos = ViewBag.ObservacoesJogos as List<ControleFutebolWeb.Models.ViewModels.ObservacaoJogoTimeViewModel>
        ?? new List<ControleFutebolWeb.Models.ViewModels.ObservacaoJogoTimeViewModel>();
    var contagemCategorias = ViewBag.ContagemCategorias as Dictionary<string, int> ?? new Dictionary<string, int>();
    var novaAnotacao = ViewBag.NovaAnotacao as ControleFutebolWeb.Models.AnotacaoTime ?? new ControleFutebolWeb.Models.AnotacaoTime { TimeId = time.Id };

    int TotalAnotacoes() => contagemCategorias.Values.Sum();

    (string bg, string border, string text, string line) CorCategoria(string? categoria) => categoria switch
    {
        "Sondagem"    => ("rgba(168,85,247,0.12)", "rgba(168,85,247,0.3)", "var(--purple)", "#a855f7"),
        "Demissão"    => ("rgba(239,68,68,0.12)",  "rgba(239,68,68,0.3)",  "var(--bad)", "#ef4444"),
        "Curiosidade" => ("rgba(245,158,11,0.12)", "rgba(245,158,11,0.3)", "var(--warn)", "#f59e0b"),
        "Informação"  => ("rgba(34,197,94,0.12)",  "rgba(34,197,94,0.3)",  "var(--ok)", "#22c55e"),
        _             => ("rgba(107,114,128,0.12)","rgba(107,114,128,0.3)","var(--text-muted)", "var(--text-dim)")
    };

    // Destaca o termo pesquisado dentro de um texto (escapando o HTML).
    string Realcar(string texto)
    {
        if (string.IsNullOrWhiteSpace(q)) return System.Web.HttpUtility.HtmlEncode(texto);
        var idx = texto.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return System.Web.HttpUtility.HtmlEncode(texto);
        var sb = new System.Text.StringBuilder();
        int pos = 0;
        while (idx >= 0)
        {
            sb.Append(System.Web.HttpUtility.HtmlEncode(texto[pos..idx]));
            sb.Append($"<mark class='an-highlight'>{System.Web.HttpUtility.HtmlEncode(texto.Substring(idx, q.Length))}</mark>");
            pos = idx + q.Length;
            idx = texto.IndexOf(q, pos, StringComparison.OrdinalIgnoreCase);
        }
        sb.Append(System.Web.HttpUtility.HtmlEncode(texto[pos..]));
        return sb.ToString();
    }

    var jogadoresMencao = ViewBag.JogadoresMencao as List<ControleFutebolWeb.Models.ViewModels.JogadorMencaoViewModel>
        ?? new List<ControleFutebolWeb.Models.ViewModels.JogadorMencaoViewModel>();

    // Transforma "@Nome do Jogador" em link para o perfil dele. Recebe o HTML já
    // escapado (saída de Realcar), então os nomes também são escapados antes de
    // virarem padrão. Numa passada só e com os nomes mais longos primeiro, para
    // "@João Silva" não ser cortado no meio por um "@João".
    string ComMencoes(string html)
    {
        if (jogadoresMencao.Count == 0) return html;

        var idPorNome = new Dictionary<string, int>();
        foreach (var j in jogadoresMencao)
        {
            var nomeEsc = System.Web.HttpUtility.HtmlEncode(j.Nome);
            if (!idPorNome.ContainsKey(nomeEsc)) idPorNome[nomeEsc] = j.Id;
        }

        var alternativas = idPorNome.Keys
            .OrderByDescending(n => n.Length)
            .Select(System.Text.RegularExpressions.Regex.Escape);
        var regex = new System.Text.RegularExpressions.Regex("@(" + string.Join("|", alternativas) + ")");

        return regex.Replace(html, m =>
            $"<a class=\"obs-mencao\" href=\"/Jogadores/Estatisticas/{idPorNome[m.Groups[1].Value]}\">@{m.Groups[1].Value}</a>");
    }

    string Formatar(string texto) => ComMencoes(Realcar(texto));

    string[] categorias = { "Sondagem", "Informação", "Curiosidade", "Demissão" };
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/anotacoes.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mencao-jogador.css" asp-append-version="true" />

<style>
    /* O resto (hero, busca, cards, formulário) vem de css/anotacoes.css, o mesmo das
       anotações de treinador e de competição. Aqui só o que é do time. */
    .an-badge {
        width: 62px; height: 62px; border-radius: 50%;
        background: rgba(255,255,255,.08); border: 2px solid rgba(255,255,255,.14);
        display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;
    }
    .an-badge img { width: 78%; height: 78%; object-fit: contain; }
    .an-badge span { font-size: 1.05rem; font-weight: 700; color: rgba(255,255,255,.7); }

    /* Observações escritas na análise dos jogos */
    .an-obs { margin-top: 32px; }
    .an-obs > summary {
        list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 10px;
        padding-bottom: 12px; margin-bottom: 16px; border-bottom: 1px solid var(--line);
    }
    .an-obs > summary::-webkit-details-marker { display: none; }
    .an-obs > summary h2 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--text-strong); margin: 0; }
    .an-obs > summary span { font-size: .84rem; color: var(--text-dim); }
    .an-obs > summary::after { content: ""; margin-left: auto; align-self: center; width: 8px; height: 8px; border-right: 2px solid var(--text-dim); border-bottom: 2px solid var(--text-dim); transform: rotate(45deg); }
    .an-obs[open] > summary::after { transform: rotate(-135deg); }

    .an-game-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; margin-bottom: 12px; }
    .an-game-head { display: flex; align-items: center; gap: 8px 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .an-game-teams { display: flex; align-items: center; gap: 7px; flex: 1; flex-wrap: wrap; min-width: 0; }
    .an-game-teams img { width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; }
    .an-game-teams span.time { font-size: .88rem; font-weight: 500; color: var(--text-muted); }
    .an-game-teams span.time.atual { font-weight: 700; color: var(--text-strong); }
    .an-game-score { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .an-game-pen { font-size: .78rem; color: var(--text-dim); }
    .an-game-meta { font-size: .8rem; color: var(--text-dim); }

    .an-game-obs-list { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0 0 0 1.1rem; }
    .an-game-obs-list li { font-size: .9rem; color: var(--text-muted); line-height: 1.6; }
    .an-game-obs-list li::marker { color: #d4a520; }

    .an-game-footer { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-soft); display: flex; justify-content: flex-end; }
    .an .an-analisar-link { font-size: .84rem; color: var(--text-muted); font-weight: 600; }
    .an .an-analisar-link:hover { color: var(--gold-ink); }

    .an-mencao-hint { font-size: .78rem; color: var(--text-dim); margin-top: 6px; line-height: 1.5; }
    .an-mencao-hint kbd { background: var(--p-3); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; color: var(--text-strong); font-weight: 700; }
</style>

<div class="an">

    <div class="an-hero theme-dark-zone">
        <img class="an-hero-pattern" src="~/Images/banner/escudos-pattern.svg" alt="" />
        <div class="an-hero-stripe"></div>
        <div class="an-hero-row">
            <div class="an-badge">
                @if (!string.IsNullOrEmpty(time.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = time.EscudoUrl })" alt="" />
                }
                else
                {
                    <span>@(time.Nome?.Length >= 3 ? time.Nome.Substring(0, 3).ToUpper() : time.Nome)</span>
                }
            </div>
            <div class="an-hero-info">
                <nav class="an-hero-kicker" aria-label="Trilha">
                    <a asp-controller="Times" asp-action="Index">Times</a>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                    <span>Anotações</span>
                </nav>
                <h1><a asp-controller="Times" asp-action="Details" asp-route-id="@time.Id" class="an-hero-nome">@time.Nome</a></h1>
                <p>Sondagens, informações, curiosidades e demissões, junto com as observações das análises de jogo</p>
            </div>
            <div class="an-hero-actions">
                <a href="#nova-titulo" class="an-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Nova anotação
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="an-alert-ok" role="status" style="margin:18px 2.5rem 0">@TempData["Sucesso"]</div>
    }

    <div class="an-grid">

        <!-- ── Esquerda: lista ──────────────────────── -->
        <div>
            <form method="get" id="form-search" class="an-search-box">
                <input type="hidden" name="timeId" value="@time.Id" />
                <span class="icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                </span>
                <input id="inp-search" type="search" name="q" value="@q" placeholder="Buscar no título ou no texto" autocomplete="off" aria-label="Buscar anotações" />
                @if (!string.IsNullOrWhiteSpace(q))
                {
                    <a href="@Url.Action("Index", new { timeId = time.Id })" class="limpar" aria-label="Limpar busca">×</a>
                }
                <span class="cnt">@(Model.Count == 1 ? "1 resultado" : $"{Model.Count} resultados")</span>
                <button type="submit" class="buscar">Buscar</button>
            </form>
            <div class="an-shortcut"><kbd>Ctrl</kbd>+<kbd>F</kbd> leva para a busca</div>

            <!-- Chips de categoria (reaproveita a busca por texto, que já casa com a categoria) -->
            <div class="an-chips">
                <a href="@Url.Action("Index", new { timeId = time.Id })" class="an-chip @(string.IsNullOrWhiteSpace(q) ? "ativo" : "")">
                    Todas <span class="cnt">(@TotalAnotacoes())</span>
                </a>
                @foreach (var cat in categorias)
                {
                    <a href="@Url.Action("Index", new { timeId = time.Id, q = cat })" class="an-chip @(string.Equals(q, cat, StringComparison.OrdinalIgnoreCase) ? "ativo" : "")">
                        @cat <span class="cnt">(@(contagemCategorias.TryGetValue(cat, out var qtd) ? qtd : 0))</span>
                    </a>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="an-empty">
                    @if (!string.IsNullOrWhiteSpace(q))
                    {
                        <div>Nenhuma anotação encontrada para "<strong>@q</strong>".</div>
                    }
                    else
                    {
                        <div>Nenhuma anotação cadastrada ainda.</div>
                        <div style="margin-top:.5rem;font-size:.86rem;">Escreva a primeira no formulário ao lado.</div>
                    }
                </div>
            }
            else
            {
                @foreach (var a in Model)
                {
                    var cor = CorCategoria(a.Categoria);

                    <div class="an-card">
                        <div class="an-card-inner">
                            <div class="an-bar" style="background:@cor.line;"></div>
                            <div class="an-card-body">
                                <div class="an-card-head">
                                    <div class="an-card-title">@Html.Raw(Formatar(a.Titulo))</div>
                                    @if (!string.IsNullOrEmpty(a.Categoria))
                                    {
                                        <span class="an-card-cat" style="background:@cor.bg;border:1px solid @cor.border;color:@cor.text;">@a.Categoria</span>
                                    }
                                </div>
                                <div class="an-card-content">@Html.Raw(Formatar(a.Conteudo))</div>
                                <div class="an-card-footer">
                                    <span class="an-card-date">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                        @DateHelper.FormatarData(a.DtInc, "dd/MM/yyyy HH:mm")
                                        @if (a.DtAlt.HasValue)
                                        {
                                            <span>, editada em @DateHelper.FormatarData(a.DtAlt, "dd/MM/yyyy HH:mm")</span>
                                        }
                                    </span>
                                    <div class="an-card-actions">
                                        <a asp-action="Editar" asp-route-id="@a.Id">Editar</a>
                                        <form asp-action="Excluir" asp-route-id="@a.Id" method="post" style="display:inline;" onsubmit="return confirm('Excluir esta anotação?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="del">Excluir</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (obsJogos.Any())
            {
                <details class="an-obs" open>
                    <summary>
                        <h2>Observações das análises</h2>
                        <span>@(obsJogos.Count == 1 ? "1 jogo" : $"{obsJogos.Count} jogos")</span>
                    </summary>
                    @foreach (var oj in obsJogos)
                    {
                        var j = oj.Jogo;
                        <div class="an-game-card">
                            <div class="an-game-head">
                                <div class="an-game-teams">
                                    @if (!string.IsNullOrEmpty(j.TimeCasa?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = j.TimeCasa.EscudoUrl })" alt="" loading="lazy" />
                                    }
                                    <span class="time @(oj.TimeEhCasa ? "atual" : "")">@j.TimeCasa?.Nome</span>
                                    <span class="an-game-score">@(j.PlacarCasa?.ToString() ?? "-") x @(j.PlacarVisitante?.ToString() ?? "-")</span>
                                    <span class="time @(!oj.TimeEhCasa ? "atual" : "")">@j.TimeVisitante?.Nome</span>
                                    @if (!string.IsNullOrEmpty(j.TimeVisitante?.EscudoUrl))
                                    {
                                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = j.TimeVisitante.EscudoUrl })" alt="" loading="lazy" />
                                    }
                                    @if (j.PenaltisCasa.HasValue && j.PenaltisVisitante.HasValue)
                                    {
                                        <span class="an-game-pen">(@j.PenaltisCasa x @j.PenaltisVisitante nos pênaltis)</span>
                                    }
                                </div>
                                <div class="an-game-meta">
                                    @string.Join(", ", new[] { j.Competicao?.Nome, j.Data.HasValue ? DateHelper.FormatarData(j.Data, "dd/MM/yyyy") : null }.Where(x => !string.IsNullOrEmpty(x)))
                                </div>
                            </div>
                            <ul class="an-game-obs-list">
                                @foreach (var linha in oj.Observacoes)
                                {
                                    <li>@Html.Raw(Formatar(linha))</li>
                                }
                            </ul>
                            <div class="an-game-footer">
                                <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@j.Id" class="an-analisar-link">Ver análise do jogo</a>
                            </div>
                        </div>
                    }
                </details>
            }
        </div>

        <!-- ── Direita: nova anotação + resumo ──────── -->
        <div class="an-sidebar">
            <div class="an-form-card" id="form-nova-anotacao">
                <div class="an-form-head">
                    <h2>Nova anotação</h2>
                </div>
                <form asp-action="Nova" asp-controller="AnotacoesTime" method="post" class="an-form-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TimeId" value="@time.Id" />

                    <div class="an-field">
                        <label for="nova-titulo">Título</label>
                        <input type="text" id="nova-titulo" name="Titulo" placeholder="Interesse em atacante" autocomplete="off" required />
                    </div>

                    <div class="an-field">
                        <label for="nova-categoria">Categoria</label>
                        <select id="nova-categoria" name="Categoria">
                            <option value="">Sem categoria</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <div class="an-field">
                        <label for="nova-conteudo">Conteúdo</label>
                        <textarea id="nova-conteudo" name="Conteudo" placeholder="Escreva a anotação" required></textarea>
                        <div class="an-mencao-hint">Digite <kbd>@@</kbd> para mencionar um jogador do elenco. A anotação também aparece no perfil dele.</div>
                    </div>

                    <button type="submit" class="an-form-save">Salvar anotação</button>
                </form>
            </div>

            <div class="an-resumo">
                <h2 class="an-resumo-title">Por categoria</h2>
                @foreach (var cat in categorias)
                {
                    var cor = CorCategoria(cat);
                    <div class="an-resumo-row">
                        <div class="an-resumo-label">
                            <div class="an-resumo-dot" style="background:@cor.line;"></div>
                            <span>@cat</span>
                        </div>
                        <span class="an-resumo-count">@(contagemCategorias.TryGetValue(cat, out var qtd) ? qtd : 0)</span>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<script src="~/js/mencao-jogador.js" asp-append-version="true"></script>
<script>
    // Ctrl+F foca na busca em vez de abrir o browser
    document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
            e.preventDefault();
            const inp = document.getElementById('inp-search');
            inp.focus();
            inp.select();
        }
    });

    // "@@" no formulário de nova anotação sugere jogadores do elenco deste time.
    (function () {
        const jogadores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jogadoresMencao));
        window.MencaoJogador.ativar(document.getElementById('nova-titulo'), () => jogadores);
        window.MencaoJogador.ativar(document.getElementById('nova-conteudo'), () => jogadores);
    })();
</script>
