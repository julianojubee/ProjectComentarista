@model ControleFutebolWeb.Models.AnotacaoTime
@{
    var time = (ControleFutebolWeb.Models.Time)ViewBag.Time;
    var isEdicao = Model.Id > 0;
    var action = isEdicao ? "Editar" : "Nova";
    var jogadoresMencao = ViewBag.JogadoresMencao as List<ControleFutebolWeb.Models.ViewModels.JogadorMencaoViewModel>
        ?? new List<ControleFutebolWeb.Models.ViewModels.JogadorMencaoViewModel>();
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mencao-jogador.css" asp-append-version="true" />

<div class="af">
    <div class="af-card">
        <a asp-action="Index" asp-route-timeId="@Model.TimeId" class="af-voltar">Voltar às anotações</a>
        <h1 class="af-title">@(isEdicao ? "Editar anotação" : "Nova anotação")</h1>

        <form asp-action="@action" asp-route-id="@(isEdicao ? Model.Id : null)" method="post">
            <div asp-validation-summary="ModelOnly" class="af-validation" style="margin-bottom:1rem;"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TimeId" />

            <div class="af-field">
                <label class="af-label" for="Titulo">Título</label>
                <input asp-for="Titulo" class="af-input" placeholder="Sondagem por atacante, demissão do técnico" required autofocus />
                <span asp-validation-for="Titulo" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="Categoria">Categoria <small>(opcional)</small></label>
                <select asp-for="Categoria" class="af-select">
                    <option value="">Sem categoria</option>
                    <option value="Sondagem">Sondagem</option>
                    <option value="Demissão">Demissão</option>
                    <option value="Informação">Informação</option>
                    <option value="Curiosidade">Curiosidade</option>
                </select>
            </div>

            <div class="af-field">
                <label class="af-label" for="Conteudo">Conteúdo</label>
                <textarea asp-for="Conteudo" class="af-textarea" placeholder="Escreva livremente" required></textarea>
                <div class="af-hint">As quebras de linha são mantidas. Digite <strong>@@</strong> para mencionar um jogador do elenco.</div>
                <span asp-validation-for="Conteudo" class="af-validation"></span>
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">@(isEdicao ? "Salvar alterações" : "Salvar anotação")</button>
                <a asp-action="Index" asp-route-timeId="@Model.TimeId" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script src="~/js/mencao-jogador.js" asp-append-version="true"></script>
<script>
    (function () {
        const jogadores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jogadoresMencao));
        window.MencaoJogador.ativar(document.getElementById('Titulo'), () => jogadores);
        window.MencaoJogador.ativar(document.getElementById('Conteudo'), () => jogadores);
    })();
</script>
