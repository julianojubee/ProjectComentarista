@model ControleFutebolWeb.Models.ViewModels.CreatorsHubViewModel
@{
    Layout = "_LayoutCreators";
    ViewData["Title"] = "Creators";
}

<div class="cr-wrap">
    <div class="crh-topo">
        <div>
            <h1 class="cr-titulo">Ferramentas para creators</h1>
            <p class="cr-sub">
                Escalações, tabelas, jogos do dia e simulações prontos para virar conteúdo.
                Tudo aberto, sem cadastro, e o que você monta fica só na sua tela.
            </p>
        </div>

        @* Faixa de hoje: o atalho mais quente da área quando tem bola rolando *@
        <a class="crh-hoje theme-dark-zone" href="/creators/jogos-hoje">
            @if (Model.JogosHoje == 0)
            {
                <span class="crh-hoje-num">Nenhum jogo hoje</span>
                <span class="crh-hoje-txt">Veja os jogos de outros dias</span>
            }
            else
            {
                <span class="crh-hoje-num">@Model.JogosHoje @(Model.JogosHoje == 1 ? "jogo hoje" : "jogos hoje")</span>
                <span class="crh-hoje-txt">
                    @if (Model.AoVivo > 0)
                    {
                        <span class="crh-vivo"><span class="crh-ponto" aria-hidden="true"></span>@Model.AoVivo ao vivo agora</span>
                    }
                    else if (Model.ProximoJogo != null)
                    {
                        <span>Próximo às @Model.ProximoJogo</span>
                    }
                    else
                    {
                        <span>Todos já encerrados</span>
                    }
                </span>
            }
            <span class="crh-hoje-link">Ver jogos do dia</span>
        </a>
    </div>

    <div class="crh-grade">
        @* Ferramenta principal: o campo com os dois times, a que mais vira vídeo *@
        <a class="crh-destaque" href="/creators/escalacao">
            <div class="crh-campo theme-dark-zone" aria-hidden="true">
                <span class="crh-meio"></span><span class="crh-circulo"></span>
                @foreach (var (x, y) in new[] { (6, 50), (16, 20), (15, 40), (15, 60), (16, 80), (28, 30), (30, 50), (28, 70), (39, 20), (41, 50), (39, 80) })
                {
                    <span class="crh-j casa" style="left:@(x)%; top:@(y)%"></span>
                    <span class="crh-j fora" style="left:@(100 - x)%; top:@(y)%"></span>
                }
            </div>
            <div class="crh-destaque-txt">
                <h2>Escalações</h2>
                <p>
                    Escolha dois times e o campo aparece com a última escalação de cada um.
                    Arraste, troque pelo elenco, desenhe setas e áreas, e ponha em tela cheia para gravar.
                </p>
                <span class="crh-abrir">Montar um confronto</span>
            </div>
        </a>

        <nav class="crh-lista" aria-label="Outras ferramentas">
            <a class="crh-item" href="/creators/selecao">
                <span class="crh-item-nome">Seleção da competição</span>
                <span class="crh-item-txt">Os 11 que você escolher numa competição, na formação que quiser.</span>
            </a>
            <a class="crh-item" href="/creators/tabelas">
                <span class="crh-item-nome">Tabelas</span>
                <span class="crh-item-txt">Classificação, grupos e chaveamento de cada competição e temporada.</span>
            </a>
            <a class="crh-item" href="/creators/simulador">
                <span class="crh-item-nome">Simulador de tabela</span>
                <span class="crh-item-txt">Preencha os jogos que faltam e veja a classificação mudar na hora.</span>
            </a>
            <a class="crh-item" href="/creators/jogos-hoje">
                <span class="crh-item-nome">Jogos do dia</span>
                <span class="crh-item-txt">Placar ao vivo, gols, estádio e transmissão de qualquer dia.</span>
            </a>
        </nav>
    </div>
</div>
