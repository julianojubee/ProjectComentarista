@* ControleFutebolWeb/Views/Relatorios/Index.cshtml *@
@model ControleFutebolWeb.Models.ViewModels.RelatoriosViewModel
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models.ViewModels
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Relatórios";
}

@functions {
    // Retorna nome e escudo do time a exibir: seleção quando a competição filtrada é de seleções, senão o clube
    (string Nome, string? Escudo) TimeExibicao(ControleFutebolWeb.Models.Jogador? j)
    {
        if (j == null) return ("", null);
        if (Model.ExibirSelecao && j.Selecao != null)
            return (j.Selecao.Nome, j.Selecao.EscudoUrl);
        return (j.Time?.Nome ?? "", j.Time?.EscudoUrl);
    }

    // Percentual em % para width de CSS: sempre com ponto decimal. Com a cultura
    // pt-BR do servidor, @w% renderizava "45,3" — CSS inválido (barra some).
    string Coord(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    static readonly System.Globalization.CultureInfo PtBR = new("pt-BR");
    string Milhar(int n) => n.ToString("N0", PtBR);
    string Dec(double v, string formato = "0.#") => v.ToString(formato, PtBR);
    string Img(string? url) => Url.Action("Imagem", "MediaProxy", new { url })!;
    string Iniciais(string nome) => nome.Length >= 2 ? nome.Substring(0, 2).ToUpper() : "?";
    string Plural(int n, string um, string varios) => n == 1 ? $"1 {um}" : $"{Milhar(n)} {varios}";
}

@{
    var baseAtual = Model.BaseFiltro switch
    {
        BaseEstatistica.Total => "total",
        BaseEstatistica.Por90 => "90",
        _ => "jogo"
    };
    var mandoAtual = Model.MandoFiltro switch
    {
        MandoJogador.Casa => "casa",
        MandoJogador.Fora => "fora",
        _ => "todos"
    };
    // Ajustes que só mexem nos rankings individuais ficam recolhidos; o número
    // no resumo avisa quando algum está fora do padrão.
    int ajustesAtivos = (Model.MinJogos > 1 ? 1 : 0) + (baseAtual != "jogo" ? 1 : 0) + (mandoAtual != "todos" ? 1 : 0);
    bool temFiltro = Model.CompeticaoIdsFiltro.Any() || Model.TimeIdsFiltro.Any() || Model.IncluirNaoAnalisados || ajustesAtivos > 0;

    // Resumo do recorte, em texto corrido, para o cabeçalho
    var compsSel = Model.Competicoes.Where(c => Model.CompeticaoIdsFiltro.Contains(c.Id)).Select(c => c.Nome).ToList();
    var timesSel = Model.Times.Where(t => Model.TimeIdsFiltro.Contains(t.Id)).Select(t => t.Nome).ToList();
    string Lista(List<string> nomes, string todos, string plural) =>
        nomes.Count == 0 ? todos : nomes.Count <= 2 ? string.Join(" e ", nomes) : $"{nomes.Count} {plural}";
    var partesResumo = new List<string>();
    if (Model.TemporadaFiltro.HasValue) partesResumo.Add($"Temporada {Model.TemporadaFiltro}");
    partesResumo.Add(Lista(compsSel, "todas as competições", "competições"));
    if (timesSel.Any()) partesResumo.Add(Lista(timesSel, "", "times"));
    partesResumo.Add(Model.IncluirNaoAnalisados ? "todos os jogos com placar" : "só jogos analisados");
    var resumo = string.Join(", ", partesResumo);
    resumo = char.ToUpper(resumo[0]) + resumo[1..];

    // Gols por jogo conta também os gols contra (são gols do placar)
    var golsPlacar = Model.TotalGols + Model.TotalGolsContra;

    // Atalho do estado vazio: mesma URL, ligando "Incluir jogos não analisados"
    var qsAtual = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value + "&" : "?";
    var urlComNaoAnalisados = Context.Request.Path + qsAtual + "incluirNaoAnalisados=true";

    // ── Peças de lista reaproveitadas por todos os cards de ranking ──
    void Cab(string titulo, string? sub)
    {
        <header class="rpt-card-header">
            <div>
                <h3 class="rpt-card-title">@titulo</h3>
                @if (!string.IsNullOrEmpty(sub)) { <p class="rpt-card-sub">@sub</p> }
            </div>
        </header>
    }

    void Vazio(string msg)
    {
        <p class="rpt-vazio">@msg</p>
    }

    void Avatar(ControleFutebolWeb.Models.Jogador j)
    {
        <span class="rpt-avatar">
            @if (!string.IsNullOrEmpty(j.FotoUrl))
            {
                <img src="@Img(j.FotoUrl)" alt="" loading="lazy" />
            }
            else
            {
                <text>@Iniciais(j.Nome)</text>
            }
        </span>
    }

    // Linha de jogador: posição, foto, nome com time, barra relativa ao líder e valor.
    // pct null = sem barra (rankings em que "mais" não é melhor nem pior).
    void LinhaJogador(int i, ControleFutebolWeb.Models.Jogador j, string valor, string? unidade, double? pct, string? cor = null)
    {
        var te = TimeExibicao(j);
        var sigla = PosicaoJogadorHelper.Sigla(j.Posicao);
        <li class="rpt-row @(i == 0 ? "lider" : "")">
            <span class="rpt-rank">@(i + 1)</span>
            @{ Avatar(j); }
            <span class="rpt-name">
                <a href="@Url.Action("Estatisticas", "Jogadores", new { id = j.Id })">@j.Nome</a>
                <small>
                    @if (!string.IsNullOrEmpty(sigla)) { <span class="rpt-sigla">@sigla</span> }
                    @if (!string.IsNullOrEmpty(te.Escudo)) { <img src="@Img(te.Escudo)" alt="" loading="lazy" /> }
                    @te.Nome
                </small>
            </span>
            @if (pct.HasValue)
            {
                <span class="rpt-bar" aria-hidden="true"><i style="width:@Coord(pct.Value)%"></i></span>
            }
            <span class="rpt-val" style="@(cor != null ? "color:" + cor : null)">@(valor)@if (!string.IsNullOrEmpty(unidade)) {<small>@unidade</small>}</span>
        </li>
    }

    void LinhaTime(int i, ControleFutebolWeb.Models.Time t, string valor, string? unidade, double? pct, string sub)
    {
        <li class="rpt-row @(i == 0 ? "lider" : "")">
            <span class="rpt-rank">@(i + 1)</span>
            <span class="rpt-escudo">
                @if (!string.IsNullOrEmpty(t.EscudoUrl)) { <img src="@Img(t.EscudoUrl)" alt="" loading="lazy" /> }
            </span>
            <span class="rpt-name">
                <a href="@Url.Action("Details", "Times", new { id = t.Id })">@t.Nome</a>
                <small>@sub</small>
            </span>
            @if (pct.HasValue)
            {
                <span class="rpt-bar" aria-hidden="true"><i style="width:@Coord(pct.Value)%"></i></span>
            }
            <span class="rpt-val">@(valor)@if (!string.IsNullOrEmpty(unidade)) {<small>@unidade</small>}</span>
        </li>
    }

    // Card de ranking de jogadores com valor inteiro (gols, cartões, presenças...)
    void CardJogadores(string titulo, string sub, List<JogadorEstatistica> lista, string um, string varios, string vazio, bool barra = true)
    {
        var max = lista.Any() ? Math.Max(1, lista.Max(x => x.Valor)) : 1;
        <section class="rpt-card">
            @{ Cab(titulo, sub); }
            @if (!lista.Any())
            {
                Vazio(vazio);
            }
            else
            {
                <ol class="rpt-lista">
                    @for (int i = 0; i < lista.Count; i++)
                    {
                        var x = lista[i];
                        LinhaJogador(i, x.Jogador, Milhar(x.Valor), x.Valor == 1 ? um : varios, barra ? (double)x.Valor / max * 100 : null);
                    }
                </ol>
            }
        </section>
    }

    void CardNotas(string titulo, List<RankingNotaItem> lista)
    {
        <section class="rpt-card">
            @{ Cab(titulo, "Os 10 com melhor nota média"); }
            <ol class="rpt-lista">
                @for (int i = 0; i < lista.Count; i++)
                {
                    var item = lista[i];
                    LinhaJogador(i, item.Jogador, Dec(item.NotaFinal, "0.0"), Plural(item.Partidas, "jogo", "jogos"), null, item.NotaColor);
                }
            </ol>
        </section>
    }
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/estatisticas-jogadores.css" asp-append-version="true" />
<style>
    .rpt-root, .rpt-root *, .rpt-root *::before, .rpt-root *::after { box-sizing: border-box; }

    .rpt-root {
        margin: 0 -12px;
        background: var(--p-0);
        border-radius: 14px;
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        --hover-warm: rgba(212, 165, 32, .07);
    }
    .rpt-root a { color: inherit; text-decoration: none; }
    .rpt-root :is(a, button, input, select, summary, [tabindex]):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Cabeçalho compacto (cores fixas: sempre escuro) ── */
    .rl-cab {
        padding: 1.5rem 2.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520; border-radius: 14px 14px 0 0;
        display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    }
    .rl-cab h1 {
        font-family: 'Barlow Condensed', Arial, sans-serif;
        font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1;
    }
    .rl-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.72); }
    .rpt-root .rl-cab-btn {
        display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 8px;
        border: 1px solid rgba(255,255,255,.25); color: #e8edf5; font-size: .88rem; font-weight: 600; white-space: nowrap;
    }
    .rpt-root .rl-cab-btn:hover { border-color: #d4a520; color: #f3d27a; }

    /* ── Filtros ── */
    .rl-filtros { background: var(--p-1); border-bottom: 1px solid var(--line); padding: 14px 2.5rem; }
    .rl-filtros form { display: flex; align-items: flex-end; gap: 10px 14px; flex-wrap: wrap; margin: 0; }
    .rl-campo { display: flex; flex-direction: column; gap: 4px; }
    .rl-campo > .rl-rot { font-size: .78rem; font-weight: 600; color: var(--text-muted); }
    .rl-filtros select, .rl-filtros input[type=number] {
        height: 38px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 10px;
        font-family: inherit; font-size: .86rem; color: var(--text); background: var(--p-2);
    }
    .rl-filtros select:focus, .rl-filtros input:focus { border-color: #d4a520; outline: none; }
    .rl-filtros input[type=number] { width: 72px; }
    .rl-check {
        display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px;
        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--p-2);
        font-size: .84rem; font-weight: 600; color: var(--text-2); cursor: pointer; user-select: none;
    }
    .rl-check:hover { border-color: #d4a520; }
    .rl-check input { accent-color: #d4a520; width: 15px; height: 15px; margin: 0; }
    .rl-acoes { display: flex; align-items: center; gap: 8px; margin-left: auto; }
    .rl-aplicar {
        height: 38px; padding: 0 18px; border-radius: 8px; border: none; cursor: pointer;
        background: #d4a520; color: #141414; font-family: inherit; font-size: .88rem; font-weight: 700;
    }
    .rl-aplicar:hover { background: #e2b532; }
    .rpt-root .rl-limpar { font-size: .84rem; font-weight: 600; color: var(--text-muted); padding: 0 4px; }
    .rpt-root .rl-limpar:hover { color: var(--text-strong); text-decoration: underline; }

    /* "Mais filtros": ajustes dos rankings individuais */
    .rl-mais { position: relative; }
    .rl-mais > summary {
        list-style: none; display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px;
        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--p-2);
        font-size: .84rem; font-weight: 600; color: var(--text-2); cursor: pointer;
    }
    .rl-mais > summary::-webkit-details-marker { display: none; }
    .rl-mais > summary:hover, .rl-mais[open] > summary { border-color: #d4a520; }
    .rl-mais-n { background: #d4a520; color: #141414; border-radius: 999px; font-size: .72rem; font-weight: 800; padding: 1px 7px; }
    .rl-mais-painel {
        position: absolute; left: 0; top: calc(100% + 6px); z-index: 120; width: min(360px, calc(100vw - 32px));
        display: flex; flex-direction: column; gap: 14px; padding: 14px;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 12px; box-shadow: 0 12px 28px rgba(0,0,0,.22);
    }
    .rl-mais-painel p { margin: 0; font-size: .78rem; color: var(--text-dim); }
    .rl-seg { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .rl-seg legend { font-size: .8rem; font-weight: 700; color: var(--text-strong); margin: 0; float: none; padding: 0; }
    .rl-seg-opcoes { display: flex; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
    .rl-seg-opcoes label { flex: 1; margin: 0; }
    .rl-seg-opcoes input { position: absolute; opacity: 0; pointer-events: none; }
    .rl-seg-opcoes span {
        display: block; text-align: center; padding: 7px 6px; font-size: .82rem; font-weight: 600;
        color: var(--text-muted); cursor: pointer; border-left: 1px solid var(--line-strong);
    }
    .rl-seg-opcoes label:first-child span { border-left: none; }
    .rl-seg-opcoes input:checked + span { background: var(--text-strong); color: var(--p-0); }
    .rl-seg-opcoes input:focus-visible + span { outline: 2px solid #d4a520; outline-offset: -2px; }
    .rl-seg small { font-size: .74rem; color: var(--text-dim); }
    .rl-linha-num { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .rl-linha-num label { font-size: .8rem; font-weight: 700; color: var(--text-strong); margin: 0; }

    /* Multi-select de competições/times */
    .ms-wrap { position: relative; min-width: 220px; }
    .ms-box {
        display: flex; flex-wrap: wrap; gap: 5px; align-items: center;
        min-height: 38px; padding: 4px 30px 4px 8px; cursor: pointer;
        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--p-2); font-size: .86rem;
    }
    .ms-box:hover { border-color: #d4a520; }
    .ms-box::after {
        content: ""; position: absolute; right: 12px; top: 50%; width: 7px; height: 7px; margin-top: -5px;
        border-right: 1.5px solid var(--text-muted); border-bottom: 1.5px solid var(--text-muted); transform: rotate(45deg);
        pointer-events: none;
    }
    .ms-placeholder { color: var(--text-muted); }
    .ms-chip {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.35);
        border-radius: 6px; padding: 1px 6px; font-size: .8rem; font-weight: 600;
    }
    .ms-chip-x { cursor: pointer; font-weight: 700; line-height: 1; opacity: .7; }
    .ms-chip-x:hover { opacity: 1; }
    .ms-panel {
        position: absolute; top: calc(100% + 4px); left: 0; min-width: 100%; width: max-content; max-width: min(360px, calc(100vw - 32px));
        z-index: 120; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0,0,0,.22); max-height: 300px; overflow-y: auto; display: none; padding: 4px;
    }
    .ms-panel.open { display: block; }
    .ms-opt {
        display: flex; align-items: center; gap: 8px; padding: 7px 10px; margin: 0;
        border-radius: 6px; cursor: pointer; font-size: .86rem; color: var(--text);
    }
    .ms-opt:hover { background: var(--p-4); }
    .ms-opt input { cursor: pointer; accent-color: #d4a520; }
    .ms-search {
        width: 100%; padding: 7px 10px; margin-bottom: 4px;
        border: 1px solid var(--line-strong); border-radius: 6px; font-size: .86rem; outline: none;
        position: sticky; top: 0; background: var(--p-1); color: var(--text);
    }
    .ms-search:focus { border-color: #d4a520; }

    /* ── Totais do recorte ── */
    .rl-totais {
        display: flex; flex-wrap: wrap; gap: 6px 28px; padding: 16px 2.5rem; margin: 0;
        border-bottom: 1px solid var(--line-soft); list-style: none;
    }
    .rl-totais li { display: flex; align-items: baseline; gap: 6px; }
    .rl-totais strong {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.7rem; font-weight: 800;
        color: var(--text-strong); line-height: 1; font-variant-numeric: tabular-nums;
    }
    .rl-totais span { font-size: .86rem; color: var(--text-muted); }

    .rl-aviso {
        margin: 20px 2.5rem 0; padding: 14px 16px; border-radius: 12px;
        border: 1px solid rgba(212,165,32,.4); background: rgba(212,165,32,.08);
        display: flex; align-items: center; justify-content: space-between; gap: 10px 18px; flex-wrap: wrap;
    }
    .rl-aviso strong { display: block; color: var(--text-strong); font-size: .95rem; }
    .rl-aviso span { font-size: .86rem; color: var(--text-muted); }
    .rpt-root .rl-aviso a {
        padding: 8px 14px; border-radius: 8px; background: #d4a520; color: #141414; font-size: .86rem; font-weight: 700; white-space: nowrap;
    }
    .rl-alerta {
        margin: 16px 2.5rem 0; padding: .8rem 1.1rem; border-radius: 10px; font-size: .88rem;
        background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: var(--ok);
        display: flex; justify-content: space-between; gap: 1rem;
    }
    .rl-alerta button { background: none; border: none; color: inherit; cursor: pointer; opacity: .7; }

    /* ── Abas ── */
    .rpt-tabs-bar {
        background: var(--p-0); border-bottom: 1px solid var(--line); padding: 0 2.5rem;
        position: sticky; top: 0; z-index: 50;
    }
    .rpt-tabs { display: flex; overflow-x: auto; scrollbar-width: none; max-width: 1500px; margin: 0 auto; }
    .rpt-tabs::-webkit-scrollbar { display: none; }
    .rpt-tab {
        padding: 13px 14px; border: none; background: transparent; border-bottom: 2px solid transparent;
        font-family: inherit; font-size: .9rem; font-weight: 600; color: var(--text-muted);
        cursor: pointer; white-space: nowrap;
    }
    .rpt-tab:hover { color: var(--text-strong); }
    .rpt-tab[aria-selected="true"] { color: var(--gold-ink); border-bottom-color: #d4a520; font-weight: 700; }
    .rpt-tab[aria-disabled="true"] { opacity: .45; cursor: help; }
    .rpt-tab[aria-disabled="true"]:hover { color: var(--text-muted); }

    /* ── Conteúdo ── */
    .rpt-main { padding: 24px 2.5rem 56px; max-width: 1500px; margin: 0 auto; }
    .rpt-section[hidden] { display: none; }
    .rl-grupo { margin-bottom: 28px; }
    .rl-grupo > h2 {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.35rem; font-weight: 700;
        color: var(--text-strong); margin: 0 0 4px;
    }
    .rl-grupo > p { margin: 0 0 12px; font-size: .84rem; color: var(--text-dim); }
    .rl-largo { grid-column: 1 / -1; }

    /* Tabela do ranking geral de notas */
    .rl-tabela { width: 100%; border-collapse: collapse; font-size: .88rem; }
    .rl-tabela th {
        padding: 8px 10px; font-size: .78rem; font-weight: 600; color: var(--text-dim);
        text-align: center; border-bottom: 1px solid var(--line); white-space: nowrap;
    }
    .rl-rank th:nth-child(2) { text-align: left; }
    .rl-tabela td { padding: 8px 10px; text-align: center; border-bottom: 1px solid var(--line-soft); font-variant-numeric: tabular-nums; }
    .rl-tabela tr:last-child td { border-bottom: none; }
    .rl-tabela tbody tr:hover { background: var(--hover-warm); }
    .rl-rank td:first-child { width: 40px; color: var(--text-dim); font-weight: 700; }
    .rl-rank tbody tr:first-child td:first-child { color: var(--gold-ink); }
    .rl-tabela .rl-jog { text-align: left; }
    .rl-jog-in { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .rl-jog-in .rpt-name a { font-weight: 600; }
    .rl-nota { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; }
    .rl-nota b { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.3rem; font-weight: 800; }
    .rl-nota small { font-size: .7rem; font-weight: 600; opacity: .85; margin-top: 2px; }
    .rl-v { color: var(--ok); font-weight: 600; }
    .rl-d { color: var(--bad); font-weight: 600; }
    .rl-zero { color: var(--text-dimmer); }

    /* Média por posição */
    .rl-media { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 4px 12px; padding: 12px 16px; }
    .rl-media dt { font-size: .86rem; font-weight: 600; color: var(--text-2); }
    .rl-media dd { margin: 0; }
    .rl-media .rpt-bar { flex: none; width: 100%; }
    .rl-media-val { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text-strong); text-align: right; }
    .rl-media-val small { font-family: 'Barlow', Arial, sans-serif; font-size: .74rem; font-weight: 500; color: var(--text-dim); margin-left: 6px; }

    /* ── Rodadas ── */
    .rodada-chart { padding: 16px; overflow-x: auto; }
    .rodada-bars { display: flex; gap: 4px; align-items: flex-end; height: 120px; min-width: max-content; }
    .rodada-bar-col { flex: 1 0 22px; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .rodada-bar { width: 100%; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--text-dimmer); }
    .rodada-bar-col.topo .rodada-bar { background: #d4a520; }
    .rodada-bar-label { font-size: .68rem; color: var(--text-dim); }
    .rodada-bar-val { font-size: .74rem; font-weight: 700; color: var(--text-2); font-variant-numeric: tabular-nums; }

    /* ── Competições ── */
    .rl-comp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 14px; }
    .rl-comp { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
    .rl-comp h3 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--text-strong); margin: 0; line-height: 1.1; }
    .rl-comp-sub { font-size: .82rem; color: var(--text-dim); margin-top: 2px; }
    .rl-comp-nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 14px; margin: 0; }
    .rl-comp-nums div { display: flex; flex-direction: column-reverse; }
    .rl-comp-nums dt { font-size: .76rem; font-weight: 500; color: var(--text-dim); }
    .rl-comp-nums dd { margin: 0; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--text-strong); line-height: 1.1; font-variant-numeric: tabular-nums; }
    .rl-res-barra { display: flex; height: 10px; border-radius: 5px; overflow: hidden; gap: 2px; }
    .rl-res-barra i { display: block; min-width: 4px; }
    .rl-res-m { background: #d4a520; }
    .rl-res-e { background: var(--text-dimmer); }
    .rl-res-v { background: var(--text-muted); }
    .rl-res-leg { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 6px; font-size: .8rem; color: var(--text-muted); }
    .rl-res-leg span { display: inline-flex; align-items: center; gap: 6px; }
    .rl-res-leg i { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
    .rl-res-leg b { color: var(--text-strong); font-weight: 700; }
    .rl-dest { margin: 0; border-top: 1px solid var(--line-soft); }
    .rl-dest > div { display: grid; grid-template-columns: 150px 1fr auto; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line-soft); }
    .rl-dest > div:last-child { border-bottom: none; padding-bottom: 0; }
    .rl-dest dt { font-size: .82rem; font-weight: 500; color: var(--text-dim); }
    .rl-dest dd { margin: 0; display: flex; align-items: center; gap: 7px; min-width: 0; font-weight: 600; color: var(--text-strong); font-size: .9rem; }
    .rl-dest dd span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rl-dest dd img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
    .rl-dest .rl-dest-val { font-size: .82rem; font-weight: 600; color: var(--text-muted); white-space: nowrap; }
    .rpt-root .rl-dest a:hover { color: var(--gold-ink); }

    /* ── Seleção: campinho vertical único (mesmo estilo do campo de
       /Jogos/Analisar), com o jogador de melhor nota em cada posição. ── */
    .sel-header { text-align: center; margin-bottom: 1rem; }
    .sel-formacao-nome { font-family: 'Barlow Condensed', sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--text-strong); }
    .sel-formacao-sub { font-size: .86rem; color: var(--text-dim); margin-top: 2px; }
    .sel-campo-wrap { max-width: 420px; margin: 0 auto; }
    .sel-campo {
        position: relative; width: 100%; aspect-ratio: 2 / 3;
        background: linear-gradient(180deg, #14532d 0%, #166534 100%);
        border: 2px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden;
    }
    .sel-linha-meio { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(255,255,255,.22); pointer-events: none; }
    .sel-circulo { position: absolute; left: 50%; top: 50%; width: 22%; aspect-ratio: 1; border: 1.5px solid rgba(255,255,255,.2); border-radius: 50%; transform: translate(-50%,-50%); pointer-events: none; }
    .sel-area-sup, .sel-area-inf { position: absolute; left: 20%; right: 20%; height: 14%; border: 1.5px solid rgba(255,255,255,.2); pointer-events: none; }
    .sel-area-sup { top: -1px; border-top: none; }
    .sel-area-inf { bottom: -1px; border-bottom: none; }
    .sel-gol-sup, .sel-gol-inf { position: absolute; left: 30%; right: 30%; height: 6%; border: 1.5px solid rgba(255,255,255,.2); background: rgba(255,255,255,.04); pointer-events: none; }
    .sel-gol-sup { top: -1px; border-top: none; }
    .sel-gol-inf { bottom: -1px; border-bottom: none; }
    .sel-slot {
        position: absolute; text-align: center; color: #fff; width: 70px;
        font-size: 11px; text-shadow: 1px 1px 2px #000; transform: translate(-50%,-50%);
    }
    .rpt-root .sel-slot a { color: #fff; }
    .sel-slot-sigla { font-size: 9px; font-weight: 700; color: #f3d27a; text-shadow: 1px 1px 2px #000; display: block; margin-bottom: 1px; }
    .sel-slot-nota { font-size: 10px; font-weight: 700; margin-top: 1px; }
    .player-circle-sel { background: #d4a520; color: #111; }
    .sel-slot.sel-vazio .player-circle { background: rgba(255,255,255,.08); border: 2px dashed rgba(255,255,255,.3); }
    .sel-slot.sel-vazio .player-name { color: rgba(255,255,255,.6); }
    .sel-lista { max-width: 640px; margin: 1.5rem auto 0; padding: 0; list-style: none; }
    .sel-lista-item {
        display: flex; align-items: center; gap: 10px; padding: 8px 10px;
        border-bottom: 1px solid var(--line-soft); font-size: .9rem;
    }
    .sel-lista-slot { flex: 0 0 150px; color: var(--text-dim); font-size: .82rem; }
    .rpt-root .sel-lista-nome { flex: 1 1 auto; font-weight: 600; color: var(--text-strong); }
    .rpt-root a.sel-lista-nome:hover { color: var(--gold-ink); }
    .sel-lista-vazio { flex: 1 1 auto; color: var(--text-dim); }
    .sel-lista-nota { flex: 0 0 auto; font-weight: 800; font-family: 'Barlow Condensed', sans-serif; font-size: 1.1rem; }

    /* ── Match Up: campo único na horizontal com os dois times frente a
       frente (estilo escalação de transmissão de TV). ── */
    .mu-header { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .mu-time-info { display: flex; align-items: center; gap: 10px; text-align: left; }
    .mu-time-info.mu-dir { text-align: right; flex-direction: row-reverse; }
    .mu-time-info img { width: 40px; height: 40px; object-fit: contain; flex-shrink: 0; }
    .mu-time-nome { font-family: 'Barlow Condensed', sans-serif; font-size: 1.3rem; font-weight: 800; color: var(--text-strong); }
    .mu-time-jogo { font-size: .8rem; color: var(--text-dim); margin-top: 2px; }
    .mu-vs { font-family: 'Barlow Condensed', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--text-dim); }

    .mu-campo {
        position: relative; width: 100%; aspect-ratio: 1.8 / 1;
        background: linear-gradient(90deg, #14532d 0%, #166534 50%, #14532d 100%);
        border: 2px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden;
    }
    .mu-linha-meio { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: rgba(255,255,255,.22); }
    .mu-circulo { position: absolute; left: 50%; top: 50%; height: 46%; aspect-ratio: 1; border: 1.5px solid rgba(255,255,255,.2); border-radius: 50%; transform: translate(-50%,-50%); }
    .mu-area-esq, .mu-area-dir { position: absolute; top: 18%; bottom: 18%; width: 11%; border: 1.5px solid rgba(255,255,255,.2); }
    .mu-area-esq { left: -1px; border-left: none; }
    .mu-area-dir { right: -1px; border-right: none; }
    .mu-gol-esq, .mu-gol-dir { position: absolute; top: 32%; bottom: 32%; width: 4.5%; border: 1.5px solid rgba(255,255,255,.2); background: rgba(255,255,255,.04); }
    .mu-gol-esq { left: -1px; border-left: none; }
    .mu-gol-dir { right: -1px; border-right: none; }

    .mu-slot {
        position: absolute; text-align: center; cursor: grab; color: #fff;
        font-size: 11px; text-shadow: 1px 1px 2px #000; transform: translate(-50%,-50%);
        width: 62px; user-select: none;
        /* pointer events cuidam do arrasto no campo; sem isto o navegador
           tentaria rolar/gesticular em touch em vez de mover o jogador */
        touch-action: none;
    }
    .mu-slot:active { cursor: grabbing; }
    /* Slot sendo arrastado: acima dos demais (o elementsFromPoint do soltar
       pula o próprio arrastado no JS para achar o alvo por baixo) */
    .mu-slot.mu-arrastando { z-index: 20; cursor: grabbing; opacity: .85; }
    /* Sem isto o dragover/drop (banco→campo) dispararia nos filhos (círculo/
       nome) e o slot nunca receberia o drop — mesmo truque do Analisar. */
    .mu-slot * { pointer-events: none; }
    /* Marcações do campo nunca participam de hit-test */
    .mu-linha-meio, .mu-circulo, .mu-area-esq, .mu-area-dir, .mu-gol-esq, .mu-gol-dir { pointer-events: none; }
    .mu-slot-sigla { font-size: 9px; font-weight: 700; color: #f3d27a; text-shadow: 1px 1px 2px #000; display: block; margin-bottom: 1px; }

    /* Layout: banco do time 1 | campo | banco do time 2 */
    .mu-layout { display: grid; grid-template-columns: 200px 1fr 200px; gap: 12px; align-items: start; }
    @@media (max-width: 900px) { .mu-layout { grid-template-columns: 1fr; } }

    .mu-banco { background: var(--p-1); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    .mu-banco-header {
        padding: 9px 10px; background: var(--p-2); border-bottom: 1px solid var(--line-soft);
        font-size: .84rem; font-weight: 700; color: var(--text-strong);
    }
    .mu-banco-lista { max-height: 520px; overflow-y: auto; }
    .mu-banco-item {
        display: flex; align-items: center; gap: 8px; padding: 6px 10px;
        font-size: .84rem; color: var(--text-2); cursor: grab; user-select: none;
        border-bottom: 1px solid var(--line-soft);
    }
    .mu-banco-item:hover { background: var(--hover-warm); }
    .mu-banco-item:active { cursor: grabbing; }
    .mu-banco-item * { pointer-events: none; }
    .mu-banco-num { flex: 0 0 24px; text-align: center; font-weight: 700; font-family: 'Barlow Condensed', sans-serif; color: var(--gold-ink); }
    .mu-banco-nome { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mu-banco-pos { flex: 0 0 auto; font-size: .72rem; font-weight: 700; color: var(--text-dim); }
    .mu-dica { text-align: center; color: var(--text-dim); font-size: .8rem; margin-top: 10px; }
    .rl-msg { text-align: center; color: var(--text-dim); padding: 2.5rem 1rem; margin: 0; }

    @@media (max-width: 760px) {
        .rl-cab, .rl-filtros, .rpt-main, .rpt-tabs-bar, .rl-totais { padding-left: 1rem; padding-right: 1rem; }
        .rl-aviso, .rl-alerta { margin-left: 1rem; margin-right: 1rem; }
        .rl-cab h1 { font-size: 2rem; }
        .rl-campo, .ms-wrap { flex: 1 1 100%; min-width: 0; }
        .rl-campo-curto { flex: 1 1 auto; }
        .rl-check { flex: 1 1 auto; }
        .rl-acoes { margin-left: 0; flex: 1 1 auto; }
        .rl-cab { padding-top: 1.1rem; padding-bottom: 1.1rem; }
        .rl-filtros { padding-top: 12px; padding-bottom: 12px; }
        .rl-filtros form { gap: 8px 10px; }
        .rl-aplicar { flex: 1; }
        .rl-totais { gap: 4px 18px; }
        .rl-totais strong { font-size: 1.4rem; }
        .rl-comp-grid { grid-template-columns: 1fr; }
        .rl-dest > div { grid-template-columns: 1fr auto; }
        .rl-dest dt { grid-column: 1 / -1; }
        .rl-tabela .rl-opc { display: none; }
        .sel-lista-slot { flex-basis: 110px; }
    }
</style>

<div class="rpt-root">

    <div class="rl-cab theme-dark-zone">
        <div>
            <h1>Relatórios</h1>
            <p>@resumo</p>
        </div>
        <a asp-action="Scout" asp-controller="Relatorios" class="rl-cab-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" /></svg>
            Scout de jogadores
        </a>
    </div>

    <div class="rl-filtros">
        <form method="get" asp-action="Index" asp-controller="Relatorios">
            <div class="rl-campo">
                <span class="rl-rot" id="rotComp">Competições</span>
                <div class="ms-wrap" id="compMulti">
                    <div class="ms-box" id="compBox" tabindex="0" role="button" aria-labelledby="rotComp" aria-haspopup="true"></div>
                    <div class="ms-panel" id="compPanel">
                        @foreach (var c in Model.Competicoes)
                        {
                            <label class="ms-opt">
                                <input type="checkbox" name="competicaoIds" value="@c.Id"
                                       data-nome="@c.Nome"
                                       @(Model.CompeticaoIdsFiltro.Contains(c.Id) ? "checked" : "") />
                                <span>@c.Nome</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="rl-campo">
                <span class="rl-rot" id="rotTimes">Times</span>
                <div class="ms-wrap" id="timeMulti">
                    <div class="ms-box" id="timeBox" tabindex="0" role="button" aria-labelledby="rotTimes" aria-haspopup="true"></div>
                    <div class="ms-panel" id="timePanel">
                        <input type="text" class="ms-search" id="timeSearch" placeholder="Buscar time" autocomplete="off" aria-label="Buscar time" />
                        <div id="timeOptions">
                            @foreach (var t in Model.Times)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="timeIds" value="@t.Id"
                                           data-nome="@t.Nome"
                                           @(Model.TimeIdsFiltro.Contains(t.Id) ? "checked" : "") />
                                    <span>@t.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.TemporadasDisponiveis.Any())
            {
                <div class="rl-campo rl-campo-curto">
                    <label class="rl-rot" for="temporadaFilter">Temporada</label>
                    <select id="temporadaFilter" name="temporada" onchange="this.form.submit()">
                        @foreach (var temp in Model.TemporadasDisponiveis)
                        {
                            <option value="@temp" @(Model.TemporadaFiltro == temp ? "selected" : "")>@temp</option>
                        }
                    </select>
                </div>
            }

            <label class="rl-check" title="Conta também jogos com placar que você ainda não analisou">
                <input type="checkbox" name="incluirNaoAnalisados" value="true"
                       @(Model.IncluirNaoAnalisados ? "checked" : "") />
                Incluir jogos não analisados
            </label>

            <details class="rl-mais">
                <summary>
                    Ajustes dos rankings
                    @if (ajustesAtivos > 0) { <span class="rl-mais-n">@ajustesAtivos</span> }
                </summary>
                <div class="rl-mais-painel">
                    <div class="rl-linha-num">
                        <label for="minJogos">Mínimo de jogos por jogador</label>
                        <input type="number" id="minJogos" name="minJogos" min="1" max="500" value="@Model.MinJogos" />
                    </div>
                    <fieldset class="rl-seg">
                        <legend>Números individuais</legend>
                        <div class="rl-seg-opcoes">
                            <label><input type="radio" name="baseEstat" value="jogo" @(baseAtual == "jogo" ? "checked" : "") /><span>Por jogo</span></label>
                            <label><input type="radio" name="baseEstat" value="total" @(baseAtual == "total" ? "checked" : "") /><span>Totais</span></label>
                            <label><input type="radio" name="baseEstat" value="90" @(baseAtual == "90" ? "checked" : "") /><span>Por 90 min</span></label>
                        </div>
                        <small>Por 90 min compara titular com reserva e exige 270 minutos em campo.</small>
                    </fieldset>
                    <fieldset class="rl-seg">
                        <legend>Mando</legend>
                        <div class="rl-seg-opcoes">
                            <label><input type="radio" name="mando" value="todos" @(mandoAtual == "todos" ? "checked" : "") /><span>Geral</span></label>
                            <label><input type="radio" name="mando" value="casa" @(mandoAtual == "casa" ? "checked" : "") /><span>Em casa</span></label>
                            <label><input type="radio" name="mando" value="fora" @(mandoAtual == "fora" ? "checked" : "") /><span>Fora</span></label>
                        </div>
                    </fieldset>
                    <p>Valem para a aba Estatísticas. O mínimo de jogos vale também para o ranking de notas.</p>
                </div>
            </details>

            <div class="rl-acoes">
                @if (temFiltro)
                {
                    <a asp-action="Index" asp-controller="Relatorios" class="rl-limpar">Limpar filtros</a>
                }
                <button type="submit" class="rl-aplicar">Aplicar filtros</button>
            </div>
        </form>
    </div>
    <script>
    (function () {
        // Tag selector genérico: renderiza chips a partir dos checkboxes de um painel
        function initMulti(wrapId, boxId, panelId, placeholder, onChange) {
            var wrap  = document.getElementById(wrapId);
            var box   = document.getElementById(boxId);
            var panel = document.getElementById(panelId);
            if (!wrap) return null;

            function render() {
                var checks = panel.querySelectorAll('input[type=checkbox]');
                var marcados = Array.prototype.filter.call(checks, function (c) { return c.checked; });
                box.innerHTML = '';
                if (marcados.length === 0) {
                    var ph = document.createElement('span');
                    ph.className = 'ms-placeholder';
                    ph.textContent = placeholder;
                    box.appendChild(ph);
                    return;
                }
                marcados.forEach(function (c) {
                    var chip = document.createElement('span');
                    chip.className = 'ms-chip';
                    var txt = document.createElement('span');
                    txt.textContent = c.dataset.nome;
                    var x = document.createElement('span');
                    x.className = 'ms-chip-x';
                    x.textContent = '×';
                    x.addEventListener('click', function (e) {
                        e.stopPropagation();
                        c.checked = false;
                        render();
                    });
                    chip.appendChild(txt);
                    chip.appendChild(x);
                    box.appendChild(chip);
                });
            }

            function bindChecks() {
                panel.querySelectorAll('input[type=checkbox]').forEach(function (c) {
                    c.addEventListener('change', function () { render(); if (onChange) onChange(); });
                });
            }

            box.addEventListener('click', function () { panel.classList.toggle('open'); });
            box.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); panel.classList.toggle('open'); }
            });
            document.addEventListener('click', function (e) {
                if (!wrap.contains(e.target)) panel.classList.remove('open');
            });

            bindChecks();
            render();
            return { render: render, bindChecks: bindChecks, panel: panel };
        }

        var timeCtl = initMulti('timeMulti', 'timeBox', 'timePanel', 'Todos os times');

        // Ao mudar as competições, recarrega os times disponíveis (união das competições selecionadas)
        function recarregarTimes() {
            var compChecks = document.querySelectorAll('#compPanel input[type=checkbox]:checked');
            var ids = Array.prototype.map.call(compChecks, function (c) { return c.value; });
            if (!timeCtl) return;

            // preserva seleção atual de times
            var selecionados = Array.prototype.map.call(
                timeCtl.panel.querySelectorAll('input[type=checkbox]:checked'),
                function (c) { return c.value; });

            var qs = ids.length ? ids.map(function (id) { return 'competicaoIds=' + id; }).join('&') : '';
            fetch('/Jogos/TimesPorCompeticoes?' + qs)
                .then(function (r) { return r.json(); })
                .then(function (times) {
                    var opts = document.getElementById('timeOptions');
                    opts.innerHTML = '';
                    times.forEach(function (t) {
                        var lbl = document.createElement('label');
                        lbl.className = 'ms-opt';
                        var inp = document.createElement('input');
                        inp.type = 'checkbox';
                        inp.name = 'timeIds';
                        inp.value = t.id;
                        inp.dataset.nome = t.nome;
                        if (selecionados.indexOf(String(t.id)) !== -1) inp.checked = true;
                        var sp = document.createElement('span');
                        sp.textContent = t.nome;
                        lbl.appendChild(inp);
                        lbl.appendChild(sp);
                        opts.appendChild(lbl);
                    });
                    timeCtl.bindChecks();
                    timeCtl.render();
                    filtrarBuscaTimes();
                });
        }

        // Busca/filtro de times pelo nome dentro do painel
        function filtrarBuscaTimes() {
            var input = document.getElementById('timeSearch');
            if (!input) return;
            var termo = input.value.trim().toLowerCase();
            document.querySelectorAll('#timeOptions .ms-opt').forEach(function (lbl) {
                var nome = (lbl.querySelector('span')?.textContent || '').toLowerCase();
                lbl.style.display = (termo === '' || nome.indexOf(termo) !== -1) ? '' : 'none';
            });
        }
        var timeSearchEl = document.getElementById('timeSearch');
        if (timeSearchEl) {
            timeSearchEl.addEventListener('input', filtrarBuscaTimes);
            // impede que clicar/digitar na busca feche o painel
            timeSearchEl.addEventListener('click', function (e) { e.stopPropagation(); });
        }

        initMulti('compMulti', 'compBox', 'compPanel', 'Todas as competições', recarregarTimes);
    })();
    </script>

    @if (TempData["Sucesso"] != null)
    {
        <div class="rl-alerta" role="status">
            <span>@TempData["Sucesso"]</span>
            <button type="button" aria-label="Fechar" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @if (Model.TotalJogos == 0)
    {
        <div class="rl-aviso">
            <div>
                <strong>Nenhum jogo neste recorte</strong>
                @if (!Model.IncluirNaoAnalisados)
                {
                    <span>Os relatórios contam só os jogos que você analisou. Inclua os demais jogos com placar para ver os números da temporada.</span>
                }
                else
                {
                    <span>Troque a temporada ou as competições para ver números.</span>
                }
            </div>
            @if (!Model.IncluirNaoAnalisados)
            {
                <a href="@urlComNaoAnalisados">Incluir jogos não analisados</a>
            }
        </div>
    }
    else
    {
        <ul class="rl-totais" aria-label="Totais do recorte">
            <li><strong>@Milhar(Model.TotalJogos)</strong><span>@(Model.TotalJogos == 1 ? "partida" : "partidas")</span></li>
            <li><strong>@Milhar(golsPlacar)</strong><span>gols</span></li>
            <li><strong>@Dec((double)golsPlacar / Model.TotalJogos, "0.0")</strong><span>gols por jogo</span></li>
            <li><strong>@Milhar(Model.TotalGolsContra)</strong><span>gols contra</span></li>
            <li><strong>@Milhar(Model.TotalCartaoAmarelo)</strong><span>amarelos</span></li>
            <li><strong>@Milhar(Model.TotalCartaoVermelho)</strong><span>vermelhos</span></li>
        </ul>
    }

    <div class="rpt-tabs-bar">
        <div class="rpt-tabs" role="tablist" aria-label="Relatórios">
            <button type="button" class="rpt-tab" role="tab" data-sec="notas" aria-selected="true">Notas</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="artilharia" aria-selected="false">Artilharia</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="presenca" aria-selected="false">Presença e cartões</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="times" aria-selected="false">Times</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="estatisticas" aria-selected="false">Estatísticas</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="competicoes" aria-selected="false">Competições</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="rodadas" aria-selected="false">Rodadas</button>
            <button type="button" class="rpt-tab" role="tab" data-sec="selecao" aria-selected="false">Seleção</button>
            @if (Model.TimeIdsFiltro.Count == 2)
            {
                <button type="button" class="rpt-tab" role="tab" data-sec="matchup" aria-selected="false">Match Up</button>
            }
            else
            {
                <button type="button" class="rpt-tab" role="tab" data-sec="matchup" aria-selected="false" aria-disabled="true"
                        title="Escolha exatamente 2 times no filtro para montar o Match Up">Match Up</button>
            }
        </div>
    </div>

    <div class="rpt-main">

    <!-- ══ NOTAS ═══════════════════════════════════════════════════════════ -->
    <div id="sec-notas" class="rpt-section" role="tabpanel">
        <div class="rpt-grid">
            <section class="rpt-card rl-largo">
                @{ Cab("Ranking de desempenho", Model.MinJogos > 1
                       ? $"Os 20 jogadores com melhor nota média, com pelo menos {Model.MinJogos} jogos"
                       : "Os 20 jogadores com melhor nota média no recorte"); }
                @if (!Model.RankingNotas.Any())
                {
                    Vazio("Nenhuma nota no recorte. As notas vêm das suas análises e, com jogos não analisados incluídos, da nota automática pela estatística.");
                }
                else
                {
                    <div style="overflow-x:auto">
                        <table class="rl-tabela rl-rank">
                            <thead>
                                <tr>
                                    <th scope="col"><span class="visually-hidden">Posição</span></th>
                                    <th scope="col">Jogador</th>
                                    <th scope="col">Nota</th>
                                    <th scope="col">Jogos</th>
                                    <th scope="col" class="rl-opc" title="Vitórias">V</th>
                                    <th scope="col" class="rl-opc" title="Empates">E</th>
                                    <th scope="col" class="rl-opc" title="Derrotas">D</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.RankingNotas.Count; i++)
                                {
                                    var item = Model.RankingNotas[i];
                                    var te = TimeExibicao(item.Jogador);
                                    var sigla = PosicaoJogadorHelper.Sigla(item.Jogador.Posicao);
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="rl-jog">
                                            <div class="rl-jog-in">
                                                @{ Avatar(item.Jogador); }
                                                <span class="rpt-name">
                                                    <a href="@Url.Action("Estatisticas", "Jogadores", new { id = item.Jogador.Id })">@item.Jogador.Nome</a>
                                                    <small>
                                                        @if (!string.IsNullOrEmpty(sigla)) { <span class="rpt-sigla">@sigla</span> }
                                                        @if (!string.IsNullOrEmpty(te.Escudo)) { <img src="@Img(te.Escudo)" alt="" loading="lazy" /> }
                                                        @te.Nome
                                                    </small>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="rl-nota" style="color:@item.NotaColor">
                                                <b>@Dec(item.NotaFinal, "0.0")</b>
                                                <small>@item.NotaLabel</small>
                                            </span>
                                        </td>
                                        <td>@item.Partidas</td>
                                        <td class="rl-opc @(item.Vitorias > 0 ? "rl-v" : "rl-zero")">@item.Vitorias</td>
                                        <td class="rl-opc @(item.Empates > 0 ? "" : "rl-zero")">@item.Empates</td>
                                        <td class="rl-opc @(item.Derrotas > 0 ? "rl-d" : "rl-zero")">@item.Derrotas</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (Model.RankingGoleiros.Any()) { CardNotas("Goleiros", Model.RankingGoleiros); }
            @if (Model.RankingDefensores.Any()) { CardNotas("Defensores", Model.RankingDefensores); }
            @if (Model.RankingMeias.Any()) { CardNotas("Meias", Model.RankingMeias); }
            @if (Model.RankingAtacantes.Any()) { CardNotas("Atacantes", Model.RankingAtacantes); }

            @if (Model.MediasPorPosicao.Any())
            {
                <section class="rpt-card">
                    @{ Cab("Média por posição", "Nota média de cada função no recorte"); }
                    <dl class="rl-media">
                        @foreach (var mp in Model.MediasPorPosicao)
                        {
                            <dt>@mp.Posicao</dt>
                            <dd><span class="rpt-bar" aria-hidden="true"><i style="width:@Coord(mp.Media / 10.0 * 100)%"></i></span></dd>
                            <dd class="rl-media-val">@Dec(mp.Media, "0.0")<small>@Plural(mp.TotalJogadores, "jogador", "jogadores")</small></dd>
                        }
                    </dl>
                </section>
            }

            @{ CardJogadores("Craques da partida", "Quem mais vezes teve a maior nota do jogo", Model.CraquesDaPartida, "vez", "vezes",
                   "Nenhum craque no recorte. Depende de nota ou estatística nos jogos."); }
        </div>
    </div>

    <!-- ══ ARTILHARIA ═════════════════════════════════════════════════════ -->
    <div id="sec-artilharia" class="rpt-section" role="tabpanel" hidden>
        <div class="rpt-grid">
            @{ CardJogadores("Artilheiros", "Mais gols marcados", Model.Artilheiros, "gol", "gols", "Nenhum gol no recorte."); }
            @{ CardJogadores("Assistências", "Mais passes para gol", Model.Assistencias, "assist.", "assist.", "Nenhuma assistência no recorte."); }
            @if (Model.GolsContraRanking.Any())
            {
                CardJogadores("Gols contra", "Gols marcados na própria rede", Model.GolsContraRanking, "gol", "gols", "", barra: false);
            }
        </div>
    </div>

    <!-- ══ PRESENÇA E CARTÕES ═════════════════════════════════════════════ -->
    <div id="sec-presenca" class="rpt-section" role="tabpanel" hidden>
        <div class="rpt-grid">
            @{ CardJogadores("Mais partidas", "Jogos como titular", Model.MaisPartidas, "jogo", "jogos", "Nenhuma escalação no recorte."); }
            @{ CardJogadores("Cartões amarelos", "Mais advertidos", Model.MaisCartoesAmarelos, "amarelo", "amarelos", "Nenhum cartão amarelo no recorte.", barra: false); }
            @{ CardJogadores("Cartões vermelhos", "Mais expulsos", Model.MaisCartoesVermelhos, "vermelho", "vermelhos", "Nenhuma expulsão no recorte.", barra: false); }
        </div>
    </div>

    <!-- ══ TIMES ══════════════════════════════════════════════════════════ -->
    <div id="sec-times" class="rpt-section" role="tabpanel" hidden>
        @{
            void CardTimes(string titulo, string sub, List<TimeEstatistica> lista, Func<TimeEstatistica, double> valor,
                           Func<TimeEstatistica, string> texto, string? unidade, Func<TimeEstatistica, string> linha, bool barra = true)
            {
                if (!lista.Any()) { return; }
                var max = Math.Max(1, lista.Max(valor));
                <section class="rpt-card">
                    @{ Cab(titulo, sub); }
                    <ol class="rpt-lista">
                        @for (int i = 0; i < lista.Count; i++)
                        {
                            var t = lista[i];
                            LinhaTime(i, t.Time, texto(t), unidade, barra ? valor(t) / max * 100 : null, linha(t));
                        }
                    </ol>
                </section>
            }
            string Jogos(TimeEstatistica t) => Plural(t.Jogos, "jogo", "jogos");
        }

        @if (!Model.TimesMaisPontos.Any() && !Model.TimesGols.Any())
        {
            <p class="rl-msg">Nenhum time com jogos no recorte.</p>
        }
        else
        {
            <div class="rl-grupo">
                <h2>Resultados</h2>
                <p>Pontos, gols e vitórias nos jogos do recorte.</p>
                <div class="rpt-grid">
                    @{
                        CardTimes("Mais pontos", "Soma de pontos no recorte", Model.TimesMaisPontos, t => t.Pontos, t => Milhar(t.Pontos), "pts",
                            t => $"{Jogos(t)}, {t.Vitorias} V, {t.Empates} E, {t.Derrotas} D");
                        CardTimes("Melhor aproveitamento", "Pontos ganhos sobre os possíveis, mínimo de 2 jogos", Model.TimesAproveitamento, t => t.Aproveitamento, t => Dec(t.Aproveitamento) + "%", null,
                            t => $"{t.Pontos} pts em {Jogos(t)}");
                        CardTimes("Mais vitórias", "Vitórias no recorte", Model.TimesVitorias, t => t.Vitorias, t => Milhar(t.Vitorias), null,
                            t => $"{Jogos(t)}, {Dec(t.Aproveitamento)}% de aproveitamento");
                        CardTimes("Mais gols marcados", "Ataques mais produtivos", Model.TimesGols, t => t.GolsPro, t => Milhar(t.GolsPro), "gols",
                            t => $"Saldo {(t.SaldoGols > 0 ? "+" : "")}{t.SaldoGols}, {Jogos(t)}");
                        CardTimes("Menos gols sofridos", "Defesas mais sólidas, mínimo de 2 jogos", Model.TimesMenosGolsSofridos, t => t.GolsContra, t => Milhar(t.GolsContra), "sofridos",
                            t => $"{Dec(t.Jogos > 0 ? (double)t.GolsContra / t.Jogos : 0)} por jogo, {Jogos(t)}", barra: false);
                        CardTimes("Mais vitórias em casa", "Vitórias como mandante", Model.TimesVitoriasCasa, t => t.VitoriasCasa, t => Milhar(t.VitoriasCasa), null,
                            t => Jogos(t) + " no total");
                        CardTimes("Mais vitórias fora", "Vitórias como visitante", Model.TimesVitoriasVisitante, t => t.VitoriasVisitante, t => Milhar(t.VitoriasVisitante), null,
                            t => Jogos(t) + " no total");
                    }
                </div>
            </div>
        }

        @{
            var statsCards = new (string titulo, string sub, string unidade, List<TimeStatJogo> lista)[]
            {
                ("Finalizações",          "Chutes por jogo",                                     "",   Model.TimesFinalizacoes),
                ("Chutes no gol",         "Finalizações certas por jogo",                        "",   Model.TimesFinalizacoesNoGol),
                ("Chutes de dentro da área", "Finalizações da área por jogo",                    "",   Model.TimesChutesArea),
                ("Chutes de fora da área",   "Finalizações de longe por jogo",                   "",   Model.TimesChutesForaArea),
                ("Gols esperados (xG)",   "xG médio por jogo",                                   "",   Model.TimesExpectedGoals),
                ("Escanteios",            "Escanteios a favor por jogo",                         "",   Model.TimesEscanteios),
                ("Posse de bola",         "Posse média por jogo",                                "%",  Model.TimesPosseBola),
                ("Passes tentados",       "Volume de passes por jogo",                           "",   Model.TimesPasses),
                ("Passes certos",         "Passes concluídos por jogo",                          "",   Model.TimesPassesCertos),
                ("Precisão de passe",     "Passes concluídos sobre os tentados",                 "%",  Model.TimesPrecisaoPasses),
                ("Defesas do goleiro",    "Defesas por jogo: goleiro bom ou defesa exposta",     "",   Model.TimesDefesasGoleiro),
                ("Gols evitados",         "xG sofrido menos gols sofridos, por jogo",            "",   Model.TimesGolsEvitados),
                ("Faltas cometidas",      "Faltas por jogo",                                     "",   Model.TimesFaltas),
                ("Impedimentos",          "Impedimentos por jogo",                               "",   Model.TimesImpedimentos),
            };
        }
        @if (statsCards.Any(s => s.lista.Any()))
        {
            <div class="rl-grupo">
                <h2>Números por jogo</h2>
                <p>Médias das estatísticas importadas. Cada time entra só com os jogos que têm estatística.</p>
                <div class="rpt-grid">
                    @foreach (var sc in statsCards)
                    {
                        if (!sc.lista.Any()) { continue; }
                        var maxVal = sc.lista.Max(x => x.Valor);
                        <section class="rpt-card">
                            @{ Cab(sc.titulo, sc.sub); }
                            <ol class="rpt-lista">
                                @for (int i = 0; i < sc.lista.Count; i++)
                                {
                                    var s = sc.lista[i];
                                    LinhaTime(i, s.Time, Dec(s.Valor, "0.##") + sc.unidade, null,
                                        maxVal > 0 ? s.Valor / maxVal * 100 : 0,
                                        Plural(s.Jogos, "jogo com estatística", "jogos com estatística"));
                                }
                            </ol>
                        </section>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ══ ESTATÍSTICAS DOS JOGADORES ═════════════════════════════════════ -->
    <div id="sec-estatisticas" class="rpt-section" role="tabpanel" hidden>
        <partial name="_EstatisticasJogadores" model="Model" />
    </div>

    <!-- ══ COMPETIÇÕES ════════════════════════════════════════════════════ -->
    <div id="sec-competicoes" class="rpt-section" role="tabpanel" hidden>
        @if (!Model.EstatisticasCompeticoes.Any())
        {
            <p class="rl-msg">Nenhuma competição com jogos no recorte.</p>
        }
        else
        {
            <div class="rl-comp-grid">
                @foreach (var ec in Model.EstatisticasCompeticoes)
                {
                    <article class="rl-comp">
                        <div>
                            <h3>@ec.Competicao.Nome</h3>
                            <div class="rl-comp-sub">@Plural(ec.TotalJogos, "jogo", "jogos"), @Plural(ec.JogosAnalisados, "analisado", "analisados")</div>
                        </div>

                        <dl class="rl-comp-nums">
                            <div><dt>gols</dt><dd>@Milhar(ec.TotalGols + ec.TotalGolsContra)</dd></div>
                            <div><dt>gols por jogo</dt><dd>@Dec(ec.MediaGolsPorJogo, "0.00")</dd></div>
                            <div><dt>gols contra</dt><dd>@Milhar(ec.TotalGolsContra)</dd></div>
                            <div><dt>amarelos</dt><dd>@Milhar(ec.TotalCartaoAmarelo)</dd></div>
                            <div><dt>vermelhos</dt><dd>@Milhar(ec.TotalCartaoVermelho)</dd></div>
                            <div><dt>cartões por jogo</dt><dd>@Dec(ec.MediaCartoesPorJogo, "0.00")</dd></div>
                        </dl>

                        @if (ec.TotalJogos > 0)
                        {
                            <div>
                                <div class="rl-res-barra" role="img"
                                     aria-label="Mandante venceu @Dec(ec.PctVitoriasMandante)%, empates @Dec(ec.PctEmpates)%, visitante venceu @Dec(ec.PctVitoriasVisitante)%">
                                    <i class="rl-res-m" style="flex:@Coord(ec.PctVitoriasMandante)"></i>
                                    <i class="rl-res-e" style="flex:@Coord(ec.PctEmpates)"></i>
                                    <i class="rl-res-v" style="flex:@Coord(ec.PctVitoriasVisitante)"></i>
                                </div>
                                <div class="rl-res-leg">
                                    <span><i class="rl-res-m"></i>Mandante venceu <b>@ec.VitoriasMandante</b> (@Dec(ec.PctVitoriasMandante)%)</span>
                                    <span><i class="rl-res-e"></i>Empates <b>@ec.Empates</b></span>
                                    <span><i class="rl-res-v"></i>Visitante venceu <b>@ec.VitoriasVisitante</b></span>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ec.ArtilheiroNome) || !string.IsNullOrEmpty(ec.AssistenteNome)
                             || !string.IsNullOrEmpty(ec.TimeMaisVitorias) || !string.IsNullOrEmpty(ec.JogoMaisGols))
                        {
                            <dl class="rl-dest">
                                @if (!string.IsNullOrEmpty(ec.ArtilheiroNome))
                                {
                                    <div>
                                        <dt>Artilheiro</dt>
                                        <dd>
                                            @if (!string.IsNullOrEmpty(ec.ArtilheiroEscudoUrl)) { <img src="@Img(ec.ArtilheiroEscudoUrl)" alt="" loading="lazy" /> }
                                            <a href="@Url.Action("Estatisticas", "Jogadores", new { id = ec.ArtilheiroId })"><span>@ec.ArtilheiroNome</span></a>
                                        </dd>
                                        <dd class="rl-dest-val">@Plural(ec.ArtilheiroGols, "gol", "gols")</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ec.AssistenteNome))
                                {
                                    <div>
                                        <dt>Mais assistências</dt>
                                        <dd>
                                            @if (!string.IsNullOrEmpty(ec.AssistenteEscudoUrl)) { <img src="@Img(ec.AssistenteEscudoUrl)" alt="" loading="lazy" /> }
                                            <a href="@Url.Action("Estatisticas", "Jogadores", new { id = ec.AssistenteId })"><span>@ec.AssistenteNome</span></a>
                                        </dd>
                                        <dd class="rl-dest-val">@Plural(ec.AssistenciasTotal, "assistência", "assistências")</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ec.TimeMaisVitorias))
                                {
                                    <div>
                                        <dt>Mais vitórias</dt>
                                        <dd>
                                            @if (!string.IsNullOrEmpty(ec.TimeMaisVitoriasEscudoUrl)) { <img src="@Img(ec.TimeMaisVitoriasEscudoUrl)" alt="" loading="lazy" /> }
                                            <span>@ec.TimeMaisVitorias</span>
                                        </dd>
                                        <dd class="rl-dest-val">@Plural(ec.TimeMaisVitoriasQtd, "vitória", "vitórias")</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ec.JogoMaisGols))
                                {
                                    <div>
                                        <dt>Jogo com mais gols</dt>
                                        <dd><span>@ec.JogoMaisGols</span></dd>
                                        <dd class="rl-dest-val">@Plural(ec.JogoMaisGolsTotal, "gol", "gols")</dd>
                                    </div>
                                }
                            </dl>
                        }
                    </article>
                }
            </div>
        }
    </div>

    <!-- ══ RODADAS ════════════════════════════════════════════════════════ -->
    <div id="sec-rodadas" class="rpt-section" role="tabpanel" hidden>
        @if (!Model.GolsPorRodada.Any())
        {
            <p class="rl-msg">Nenhuma rodada no recorte.</p>
        }
        else
        {
            var maxGR = Math.Max(1, Model.GolsPorRodada.Max(r => r.TotalGols));
            <section class="rpt-card">
                @{ Cab("Gols por rodada", "A rodada com mais gols fica em destaque"); }
                <div class="rodada-chart">
                    <div class="rodada-bars">
                        @foreach (var r in Model.GolsPorRodada)
                        {
                            var alt = (double)r.TotalGols / maxGR * 96;
                            <div class="rodada-bar-col @(r.TotalGols == maxGR ? "topo" : "")">
                                <div class="rodada-bar-val">@r.TotalGols</div>
                                <div class="rodada-bar" style="height:@Coord(Math.Max(4, alt))px" title="Rodada @r.Rodada: @Plural(r.TotalGols, "gol", "gols") em @Plural(r.Jogos, "jogo", "jogos")"></div>
                                <div class="rodada-bar-label">@r.Rodada</div>
                            </div>
                        }
                    </div>
                </div>
                <div style="overflow-x:auto">
                    <table class="rl-tabela">
                        <thead>
                            <tr>
                                <th scope="col">Rodada</th>
                                <th scope="col">Jogos</th>
                                <th scope="col">Gols</th>
                                <th scope="col">Gols por jogo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.GolsPorRodada)
                            {
                                <tr>
                                    <td style="color:var(--text-strong);font-weight:600">@r.Rodada</td>
                                    <td>@r.Jogos</td>
                                    <td style="font-weight:700;color:var(--text-strong)">@r.TotalGols</td>
                                    <td>@Dec(r.MediaGols, "0.0#")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>

    <!-- ══ SELEÇÃO ═════════════════════════════════════════════════════════ -->
    <div id="sec-selecao" class="rpt-section" role="tabpanel" hidden>
        @if (Model.Selecao == null)
        {
            <p class="rl-msg">Nenhum jogo do recorte tem formação registrada, então não dá para montar a seleção.</p>
        }
        else
        {
            var sel = Model.Selecao;

            void SelSlot(ControleFutebolWeb.Models.ViewModels.SelecaoSlotViewModel slot)
            {
                var vazio = slot.Jogador == null;
                <div class="sel-slot @(vazio ? "sel-vazio" : "")"
                     style="left:@Coord(slot.PosicaoX)%; top:@Coord(slot.PosicaoY)%;">
                    <span class="sel-slot-sigla">@PosicaoJogadorHelper.Sigla(slot.NomePosicao)</span>
                    @if (slot.Jogador != null)
                    {
                        <a href="@Url.Action("Estatisticas", "Jogadores", new { id = slot.Jogador.Jogador.Id })"
                           style="text-decoration:none;color:inherit;display:block;">
                            <div class="player-circle player-circle-sel">@(slot.Jogador.Jogador.NumeroCamisa?.ToString() ?? "")</div>
                            <div class="player-name">@slot.Jogador.Jogador.Nome</div>
                            <div class="sel-slot-nota" style="color:@slot.Jogador.NotaColor;">@slot.Jogador.NotaFinal.ToString("0.0")</div>
                        </a>
                    }
                    else
                    {
                        <div class="player-circle player-circle-empty"></div>
                        <div class="player-name">—</div>
                    }
                </div>
            }

            <div class="sel-header">
                <div class="sel-formacao-nome">@sel.Formacao.Nome</div>
                <div class="sel-formacao-sub">Formação mais usada no recorte, com a melhor nota em cada posição</div>
            </div>

            <div class="sel-campo-wrap">
                <div class="sel-campo theme-dark-zone">
                    <div class="sel-linha-meio"></div>
                    <div class="sel-circulo"></div>
                    <div class="sel-area-sup"></div>
                    <div class="sel-area-inf"></div>
                    <div class="sel-gol-sup"></div>
                    <div class="sel-gol-inf"></div>

                    @foreach (var slot in sel.Slots) { SelSlot(slot); }
                </div>
            </div>

            <ul class="sel-lista">
                @foreach (var slot in sel.Slots)
                {
                    <li class="sel-lista-item">
                        <div class="sel-lista-slot">@slot.NomePosicao</div>
                        @if (slot.Jogador != null)
                        {
                            <a asp-controller="Jogadores" asp-action="Estatisticas" asp-route-id="@slot.Jogador.Jogador.Id" class="sel-lista-nome" style="text-decoration:none;">@slot.Jogador.Jogador.Nome</a>
                            <div class="sel-lista-nota" style="color:@slot.Jogador.NotaColor;">@slot.Jogador.NotaFinal.ToString("0.0")</div>
                        }
                        else
                        {
                            <div class="sel-lista-vazio">Sem jogador elegível</div>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <!-- ══ MATCH UP ═════════════════════════════════════════════════════════ -->
    <div id="sec-matchup" class="rpt-section" role="tabpanel" hidden>
        @if (Model.TimeIdsFiltro.Count != 2)
        {
            <p class="rl-msg">Escolha exatamente 2 times no filtro para montar o Match Up com a última escalação de cada um.</p>
        }
        else if (Model.MatchUpTime1 == null || Model.MatchUpTime2 == null)
        {
            var nomesSemEscalacao = new List<string>();
            if (Model.MatchUpTime1 == null) nomesSemEscalacao.Add(Model.Times.FirstOrDefault(t => t.Id == Model.TimeIdsFiltro[0])?.Nome ?? "1º time");
            if (Model.MatchUpTime2 == null) nomesSemEscalacao.Add(Model.Times.FirstOrDefault(t => t.Id == Model.TimeIdsFiltro[1])?.Nome ?? "2º time");
            <p class="rl-msg">Sem escalação titular registrada para @string.Join(" e ", nomesSemEscalacao).</p>
        }
        else
        {
            var t1 = Model.MatchUpTime1;
            var t2 = Model.MatchUpTime2;
            var adv1 = t1.JogoOrigemEhCasa ? t1.JogoOrigem?.TimeVisitante?.Nome : t1.JogoOrigem?.TimeCasa?.Nome;
            var adv2 = t2.JogoOrigemEhCasa ? t2.JogoOrigem?.TimeVisitante?.Nome : t2.JogoOrigem?.TimeCasa?.Nome;
            var data1 = t1.JogoOrigem?.Data?.ToString("dd/MM/yyyy") ?? "data desconhecida";
            var data2 = t2.JogoOrigem?.Data?.ToString("dd/MM/yyyy") ?? "data desconhecida";

            <div class="mu-header">
                <div class="mu-time-info">
                    @if (!string.IsNullOrEmpty(t1.Time.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = t1.Time.EscudoUrl })" alt="" />
                    }
                    <div>
                        <div class="mu-time-nome">@t1.Time.Nome</div>
                        <div class="mu-time-jogo">Última escalação contra @adv1, em @data1</div>
                    </div>
                </div>
                <div class="mu-vs">x</div>
                <div class="mu-time-info mu-dir">
                    @if (!string.IsNullOrEmpty(t2.Time.EscudoUrl))
                    {
                        <img src="@Url.Action("Imagem", "MediaProxy", new { url = t2.Time.EscudoUrl })" alt="" />
                    }
                    <div>
                        <div class="mu-time-nome">@t2.Time.Nome</div>
                        <div class="mu-time-jogo">Última escalação contra @adv2, em @data2</div>
                    </div>
                </div>
            </div>

            // Renderiza um slot de titular no campo. Os dados do jogador ficam em
            // data-attributes: a substituição via banco troca só esses dados + o
            // conteúdo visual, mantendo o slot (e a posição) no lugar.
            void MuSlot(int time, int idx, ControleFutebolWeb.Models.ViewModels.MatchUpJogadorViewModel esc)
                {
                    var circle = time == 1 ? "player-circle-casa" : "player-circle-vis";
                    <div id="mu-slot-@time-@idx" class="mu-slot"
                         data-jogadorid="@esc.Jogador.Id"
                         data-numero="@(esc.Jogador.NumeroCamisa?.ToString() ?? "")"
                         data-nome="@esc.Jogador.Nome"
                         data-sigla="@PosicaoJogadorHelper.Sigla(esc.Posicao)"
                         style="left:@(esc.PosicaoX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; top:@(esc.PosicaoY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%;"
                         onpointerdown="muPointerDown(event, @time)"
                         ondragover="event.preventDefault()"
                         ondrop="muDropSlot(event, @time)">
                        <span class="mu-slot-sigla">@PosicaoJogadorHelper.Sigla(esc.Posicao)</span>
                        <div class="player-circle @circle">@(esc.Jogador.NumeroCamisa?.ToString() ?? "")</div>
                        <div class="player-name">@esc.Jogador.Nome</div>
                    </div>
                }

                // Item do banco (demais jogadores do elenco), arrastável para os slots.
                void MuBancoItem(int time, ControleFutebolWeb.Models.Jogador j)
                {
                    <div class="mu-banco-item" draggable="true"
                         data-jogadorid="@j.Id"
                         data-numero="@(j.NumeroCamisa?.ToString() ?? "")"
                         data-nome="@j.Nome"
                         data-sigla="@PosicaoJogadorHelper.Sigla(j.Posicao)"
                         ondragstart="muDragStart(event, @time, 'banco')">
                        <span class="mu-banco-num">@(j.NumeroCamisa?.ToString() ?? "–")</span>
                        <span class="mu-banco-nome">@j.Nome</span>
                        <span class="mu-banco-pos">@PosicaoJogadorHelper.Sigla(j.Posicao)</span>
                    </div>
                }

            <div class="mu-layout">
                <div class="mu-banco">
                    <div class="mu-banco-header">Elenco, @t1.Time.Nome</div>
                    <div id="muBanco1" class="mu-banco-lista">
                        @foreach (var j in t1.Elenco) { MuBancoItem(1, j); }
                    </div>
                </div>

                <div id="muCampo" class="mu-campo theme-dark-zone">
                    <div class="mu-linha-meio"></div>
                    <div class="mu-circulo"></div>
                    <div class="mu-area-esq"></div>
                    <div class="mu-area-dir"></div>
                    <div class="mu-gol-esq"></div>
                    <div class="mu-gol-dir"></div>

                    @{
                        int idxMu1 = 0;
                        foreach (var esc in t1.Escalacao) { MuSlot(1, idxMu1, esc); idxMu1++; }
                        int idxMu2 = 0;
                        foreach (var esc in t2.Escalacao) { MuSlot(2, idxMu2, esc); idxMu2++; }
                    }
                </div>

                <div class="mu-banco">
                    <div class="mu-banco-header">Elenco, @t2.Time.Nome</div>
                    <div id="muBanco2" class="mu-banco-lista">
                        @foreach (var j in t2.Elenco) { MuBancoItem(2, j); }
                    </div>
                </div>
            </div>
            <p class="mu-dica">
                Arraste um jogador para qualquer ponto do campo, solte sobre um companheiro para trocar as posições
                ou arraste alguém do elenco sobre um titular para substituí-lo. É só uma simulação: nada é salvo.
            </p>
        }
    </div>

    </div><!-- /.rpt-main -->
</div><!-- /.rpt-root -->

<script src="~/js/estatisticas-jogadores.js" asp-append-version="true"></script>
<script>
    // Abas: o painel ativo fica no hash (#times, #rodadas...), então recarregar
    // depois de aplicar um filtro ou voltar do perfil de um jogador mantém a aba.
    (function () {
        const abas = Array.from(document.querySelectorAll('.rpt-tab'));
        const filtro = document.querySelector('.rl-filtros form');

        function mostrar(nome, atualizarHash) {
            const aba = abas.find(a => a.dataset.sec === nome && a.getAttribute('aria-disabled') !== 'true');
            if (!aba) return false;
            abas.forEach(a => a.setAttribute('aria-selected', a === aba ? 'true' : 'false'));
            document.querySelectorAll('.rpt-section').forEach(s => s.hidden = s.id !== 'sec-' + nome);
            if (atualizarHash) {
                history.replaceState(null, '', '#' + nome);
                // Trocando de aba lá embaixo, volta para o começo do painel novo
                const barra = document.querySelector('.rpt-tabs-bar');
                const inicio = document.getElementById('sec-' + nome).getBoundingClientRect().top + scrollY - barra.offsetHeight - 12;
                if (scrollY > inicio) window.scrollTo({ top: inicio });
            }
            if (filtro) filtro.action = filtro.action.split('#')[0] + '#' + nome;
            aba.scrollIntoView({ block: 'nearest', inline: 'nearest' });
            return true;
        }

        abas.forEach(a => a.addEventListener('click', () => mostrar(a.dataset.sec, true)));
        mostrar(location.hash.slice(1), false) || mostrar('notas', false);
    })();

    // Cards com seletor de métrica da aba Estatísticas (js/estatisticas-jogadores.js).
    iniciarPickersEstatJogadores(document);

    // ── Match Up: arrasto 100% client-side, só para simulação visual.
    // Três gestos, sempre dentro do mesmo time (mesmo espírito do Analisar):
    //   campo → outro jogador: troca a posição (left/top) dos dois (swap);
    //   campo → área vazia:    reposiciona o jogador ali (limitado à metade do
    //                          campo do time dele);
    //   banco → campo:         o jogador do elenco substitui o titular, que
    //                          volta pro banco.
    // O arrasto no campo usa POINTER EVENTS (não HTML5 drag-and-drop): o círculo
    // segue o cursor de verdade, sem depender do dragstart nativo — o DnD do
    // HTML5 fica só no banco→campo, onde funciona bem.
    // Nada é enviado ao servidor: sem persistência, sem endpoint novo.

    // ── Campo: arrasto por pointer events ─────────────────────────────────
    let muPtr = null; // { el, time, pointerId, startX, startY, origLeft, origTop, moved }

    function muPointerDown(ev, time) {
        if (ev.button !== 0 && ev.pointerType === 'mouse') return; // só botão esquerdo
        const el = ev.target.closest('.mu-slot');
        if (!el) return;
        ev.preventDefault(); // evita seleção de texto/drag nativo
        // Captura o ponteiro (mantém o fluxo de eventos em touch mesmo saindo do
        // elemento); os listeners de move/up ficam no document, então falhar aqui
        // não quebra o arrasto com mouse.
        try { el.setPointerCapture(ev.pointerId); } catch { }
        muPtr = { el, time, pointerId: ev.pointerId, startX: ev.clientX, startY: ev.clientY,
                  origLeft: el.style.left, origTop: el.style.top, moved: false };
    }

    // Converte a posição do cursor para % do campo, preso apenas às bordas —
    // qualquer jogador pode ser movido por todo o campo, inclusive no lado adversário.
    function muPosNoCampo(time, clientX, clientY) {
        const rect = document.getElementById('muCampo').getBoundingClientRect();
        let x = (clientX - rect.left) / rect.width * 100;
        let y = (clientY - rect.top) / rect.height * 100;
        // Faixa vertical 10-90%: mesmo limite da renderização inicial, para o
        // círculo/nome do jogador não serem cortados pelo overflow do campo.
        return { x: Math.min(Math.max(x, 2), 98), y: Math.min(Math.max(y, 10), 90) };
    }

    document.addEventListener('pointermove', ev => {
        if (!muPtr || ev.pointerId !== muPtr.pointerId) return;
        // pequeno limiar para diferenciar clique de arrasto
        if (!muPtr.moved && Math.hypot(ev.clientX - muPtr.startX, ev.clientY - muPtr.startY) < 4) return;
        muPtr.moved = true;
        muPtr.el.classList.add('mu-arrastando');
        const pos = muPosNoCampo(muPtr.time, ev.clientX, ev.clientY);
        muPtr.el.style.left = pos.x + '%';
        muPtr.el.style.top = pos.y + '%';
    });

    document.addEventListener('pointerup', ev => {
        if (!muPtr || ev.pointerId !== muPtr.pointerId) return;
        const drag = muPtr;
        muPtr = null;
        drag.el.classList.remove('mu-arrastando');
        if (!drag.moved) return; // foi só um clique

        // Soltou sobre outro jogador DO MESMO TIME? → swap: o arrastado assume a
        // posição do alvo e o alvo vai para a posição ORIGINAL do arrastado.
        // (elementsFromPoint ignora o próprio arrastado, que está sob o cursor)
        const alvo = document.elementsFromPoint(ev.clientX, ev.clientY)
            .find(e => e !== drag.el && e.classList && e.classList.contains('mu-slot'));
        if (alvo && alvo.id.startsWith(`mu-slot-${drag.time}-`)) {
            drag.el.style.left = alvo.style.left;
            drag.el.style.top = alvo.style.top;
            alvo.style.left = drag.origLeft;
            alvo.style.top = drag.origTop;
        }
        // Área vazia (ou adversário): fica onde soltou — o left/top já foi
        // aplicado no pointermove, com o clamp da metade do time.
    });

    document.addEventListener('pointercancel', ev => {
        if (!muPtr || ev.pointerId !== muPtr.pointerId) return;
        // arrasto abortado (ex.: gesto do sistema): volta pra posição original
        muPtr.el.classList.remove('mu-arrastando');
        muPtr.el.style.left = muPtr.origLeft;
        muPtr.el.style.top = muPtr.origTop;
        muPtr = null;
    });

    // ── Banco → campo: HTML5 drag-and-drop ────────────────────────────────
    let muDrag = null; // { time, el } — item do banco sendo arrastado

    function muDragStart(ev, time, tipo) {
        // closest: garante o container certo mesmo se o dragstart nascer num filho
        const el = ev.target.closest('.mu-banco-item');
        if (!el) return;
        muDrag = { time, el };
        ev.dataTransfer.setData('text/plain', 'matchup'); // exigido por alguns navegadores p/ permitir o drag
        ev.dataTransfer.effectAllowed = 'move';
    }

    function muDropSlot(ev, time) {
        ev.preventDefault();
        ev.stopPropagation();
        const alvo = ev.target.closest('.mu-slot');
        const drag = muDrag;
        muDrag = null;
        if (!drag || !alvo || drag.time !== time) return;

        // Substituição: guarda os dados do titular que sai, aplica o novo
        // jogador no slot e devolve o removido pro banco.
        const removido = { ...alvo.dataset };
        muAplicarNoSlot(alvo, drag.el.dataset);
        muCriarItemBanco(time, removido);
        drag.el.remove();
    }

    // Atualiza data-attributes e o visual (número/nome/sigla) de um slot do campo
    function muAplicarNoSlot(slot, d) {
        slot.dataset.jogadorid = d.jogadorid;
        slot.dataset.numero = d.numero;
        slot.dataset.nome = d.nome;
        slot.dataset.sigla = d.sigla;
        slot.querySelector('.mu-slot-sigla').textContent = d.sigla;
        slot.querySelector('.player-circle').textContent = d.numero;
        slot.querySelector('.player-name').textContent = d.nome;
    }

    // Recria a linha do banco para o titular que saiu do campo (textContent, não
    // innerHTML: nome de jogador nunca deve virar markup)
    function muCriarItemBanco(time, d) {
        const item = document.createElement('div');
        item.className = 'mu-banco-item';
        item.draggable = true;
        item.dataset.jogadorid = d.jogadorid;
        item.dataset.numero = d.numero;
        item.dataset.nome = d.nome;
        item.dataset.sigla = d.sigla;

        const num = document.createElement('span');
        num.className = 'mu-banco-num';
        num.textContent = d.numero || '–';
        const nome = document.createElement('span');
        nome.className = 'mu-banco-nome';
        nome.textContent = d.nome;
        const pos = document.createElement('span');
        pos.className = 'mu-banco-pos';
        pos.textContent = d.sigla;
        item.append(num, nome, pos);

        item.addEventListener('dragstart', ev => muDragStart(ev, time, 'banco'));

        const banco = document.getElementById('muBanco' + time);
        banco.prepend(item); // no topo: é o jogador que o usuário acabou de tirar
    }
</script>
