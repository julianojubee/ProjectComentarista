            <div class="sc-table-wrap">
                <table class="sc-table" id="sc-tabela">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Jogador</th>
                            <th>Pos.</th>
                            <th>Idade</th>
                            <th>Time</th>
                            <th title="Jogos">JG</th>
                            <th title="Minutos jogados">MIN</th>
                            @foreach (var c in colunasScout)
                            {
                                <th title="@c.Titulo" data-grupo="@c.Grupo"
                                    class="@(gruposPadrao.Contains(c.Grupo) ? "" : "sc-col-off")">@c.Sigla</th>
                            }
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 0; }
                        @foreach (var r in Model.Resultados)
                        {
                            idx++;
                            var j = r.Jogador;
                            var notaColor = r.NotaMedia switch
                            {
                                >= 8.5 => "#f59e0b",
                                >= 7.5 => "#22c55e",
                                >= 6.5 => "#3b82f6",
                                >= 5.5 => "var(--text-dim)",
                                >= 4.5 => "#f97316",
                                _ => "#ef4444"
                            };
                            @* jogos e minutos ficam na linha: são os denominadores da reescala *@
                            <tr data-jogos="@r.Jogos" data-min="@r.Minutos">
                                <td style="color:var(--text-muted);font-size:12px">@idx</td>
                                <td>
                                    <div class="sc-player-cell">
                                        <div class="sc-photo">
                                            @if (!string.IsNullOrEmpty(j.FotoUrl))
                                            {
                                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = j.FotoUrl })" alt="@j.Nome" />
                                            }
                                            else
