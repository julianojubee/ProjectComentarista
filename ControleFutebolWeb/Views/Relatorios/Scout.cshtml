@model ControleFutebolWeb.Models.ViewModels.ScoutViewModel
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models.ViewModels
@{
    ViewData["Title"] = "Scout de Jogadores";
    var f = Model.Filtro;

    // Colunas da tabela de resultados, agrupadas como no construtor de
    // estatísticas do Sofascore. Tudo aqui já vem de EstatisticaJogador — o
    // cabeçalho, as células e o seletor de grupos saem desta única lista.
    // Pct = percentual, que o seletor "Acumulado" não reescala.
    var colunasScout = new (string Grupo, string Sigla, string Titulo, Func<ScoutResultItem, double?> Valor, bool Pct)[]
    {
        ("Ataque",     "G",    "Gols",                     r => r.Gols,              false),
        ("Ataque",     "FIN",  "Finalizações",             r => r.FinalizacoesTotal, false),
        ("Ataque",     "FNG",  "Finalizações no gol",      r => r.FinalizacoesNoGol, false),
        ("Ataque",     "CNV%", "Conversão de gols",        r => r.Conversao,         true),
        ("Ataque",     "DRC",  "Dribles certos",           r => r.DrilesCertos,      false),
        ("Ataque",     "DRT",  "Dribles tentados",         r => r.DriblesTentados,   false),
        ("Ataque",     "DRI%", "Acerto no drible",         r => r.PctDribles,        true),
        ("Ataque",     "PSF",  "Pênaltis sofridos",        r => r.PenaltiSofrido,    false),
        ("Ataque",     "GPN",  "Gols de pênalti",          r => r.PenaltiConvertido, false),
        ("Ataque",     "PPE",  "Pênaltis perdidos",        r => r.PenaltiPerdido,    false),

        ("Passe",      "ASS",  "Assistências",             r => r.Assistencias,      false),
        ("Passe",      "PCH",  "Passes-chave",             r => r.PassesChave,       false),
        ("Passe",      "PAS",  "Passes tentados",          r => r.PassesTotal,       false),
        ("Passe",      "PAC",  "Passes certos",            r => r.PassesCertos,      false),
        ("Passe",      "PAS%", "Precisão de passe",        r => r.PrecisaoPasses,    true),

        ("Defesa",     "DSR",  "Desarmes",                 r => r.Desarmes,          false),
        ("Defesa",     "INT",  "Interceptações",           r => r.Interceptacoes,    false),
        ("Defesa",     "BLQ",  "Bloqueios",                r => r.Bloqueios,         false),
        ("Defesa",     "DUV",  "Duelos vencidos",          r => r.DuelosVencidos,    false),
        ("Defesa",     "DUT",  "Duelos disputados",        r => r.DuelosTotal,       false),
        ("Defesa",     "DUE%", "Duelos vencidos %",        r => r.PctDuelos,         true),
        ("Defesa",     "DBD",  "Driblado (foi passado)",   r => r.DriblesSofridos,   false),
        ("Defesa",     "PCM",  "Pênaltis cometidos",       r => r.PenaltiCometido,   false),

        ("Goleiro",    "DEF",  "Defesas",                  r => r.Defesas,           false),
        ("Goleiro",    "GS",   "Gols sofridos",            r => r.GolsSofridos,      false),
        ("Goleiro",    "PDF",  "Pênaltis defendidos",      r => r.PenaltiDefendido,  false),

        ("Disciplina", "🟨",   "Cartões amarelos",         r => r.CartaoAmarelo,     false),
        ("Disciplina", "🟥",   "Cartões vermelhos",        r => r.CartaoVermelho,    false),
        ("Disciplina", "FCM",  "Faltas cometidas",         r => r.FaltasCometidas,   false),
        ("Disciplina", "FSF",  "Faltas sofridas",          r => r.FaltasSofridas,    false),
        ("Disciplina", "IMP",  "Impedimentos",             r => r.Impedimentos,      false),

        ("Uso",        "TIT",  "Jogos como titular",       r => r.Titularidades,     false),
        ("Uso",        "RES",  "Jogos entrando do banco",  r => r.VezesReserva,      false),
    };

    // Goleiro fica fora por padrão: são 3 colunas vazias para 90% do elenco.
    var gruposScout = new[] { "Ataque", "Passe", "Defesa", "Goleiro", "Disciplina", "Uso" };
    var gruposPadrao = new[] { "Ataque", "Passe", "Defesa", "Disciplina" };
}

<style>
    /* ── Tag selector ────────────────────────────────────────────── */
    .ms-wrap { position: relative; }
    .ms-box {
        display: flex; flex-wrap: wrap; gap: 5px; align-items: center;
        min-height: 38px; padding: 4px 30px 4px 8px; cursor: pointer;
        border: 1px solid var(--border-strong); border-radius: 8px; background: var(--input-bg);
        font-size: 13px; transition: border-color .15s;
    }
    .ms-box:focus { outline: none; border-color: #8b5cf6; }
    .ms-placeholder { color: var(--text-muted); }
    .ms-chip {
        display: inline-flex; align-items: center; gap: 4px;
        background: #ede9fe; color: #5b21b6;
        border-radius: 999px; padding: 2px 8px; font-size: 12px; font-weight: 600;
    }
    .ms-chip-x { cursor: pointer; font-size: 14px; line-height: 1; }
    .ms-arrow {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        pointer-events: none; color: var(--text-muted); font-size: 10px;
    }
    .ms-panel {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 200;
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 260px; overflow-y: auto;
        display: none; padding: 4px;
    }
    .ms-panel.open { display: block; }
    .ms-opt {
        display: flex; align-items: center; gap: 8px; padding: 7px 10px;
        border-radius: 6px; cursor: pointer; font-size: 13px; color: var(--text);
    }
    .ms-opt:hover { background: var(--surface-3); }
    .ms-opt input { cursor: pointer; accent-color: #7c3aed; }
    .ms-search {
        width: 100%; box-sizing: border-box; padding: 7px 10px; margin-bottom: 4px;
        border: 1px solid var(--border-strong); border-radius: 6px; font-size: 13px; outline: none;
        position: sticky; top: 0; background: var(--input-bg);
    }
</style>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800;900&family=Barlow:wght@400;500;600&display=swap');

    .sc-root * { box-sizing: border-box; }

    /* Hero */
    .sc-hero {
        background: linear-gradient(135deg, #0a1628 0%, #111e35 55%, #0a1628 100%);
        border-radius: 16px; padding: 2.2rem 2rem 1.8rem;
        margin-bottom: 1.4rem; text-align: center;
    }
    .sc-badge {
        display: inline-block; margin-bottom: .6rem;
        background: rgba(139,92,246,.18); color: #c4b5fd;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
        padding: 4px 14px; border-radius: 999px; border: 1px solid rgba(139,92,246,.35);
    }
    .sc-hero h1 {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2.2rem; font-weight: 900; color: #fff; margin: 0 0 .3rem;
    }
    .sc-hero p { color: rgba(255,255,255,.5); margin: 0; font-size: .88rem; }

    /* Painel de filtros */
    .sc-panel {
        background: var(--surface); border: .5px solid var(--border);
        border-radius: 14px; padding: 1.2rem 1.4rem; margin-bottom: 1.2rem;
    }
    .sc-panel-title {
        font-size: 12px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .8px; color: var(--text-muted); margin-bottom: .9rem;
        padding-bottom: .5rem; border-bottom: 1px solid var(--border-subtle);
    }
    .sc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 10px 14px;
    }
    .sc-field label {
        display: block; font-size: 11px; font-weight: 600;
        color: var(--text-2); margin-bottom: 4px;
    }
    .sc-field input, .sc-field select {
        width: 100%; border: 1px solid var(--border-strong); border-radius: 8px;
        padding: 7px 10px; font-size: 13px; color: var(--text);
        background: var(--input-bg); outline: none;
        transition: border-color .15s;
    }
    .sc-field input:focus, .sc-field select:focus { border-color: #8b5cf6; background: var(--surface); }

    .sc-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 1.1rem; }
    .sc-btn-search {
        padding: 9px 22px; border-radius: 9px; border: none; cursor: pointer;
        background: #7c3aed; color: #fff;
        font-size: 13px; font-weight: 700; letter-spacing: .2px;
        transition: background .15s;
    }
    .sc-btn-search:hover { background: #6d28d9; }
    .sc-btn-clear {
        padding: 9px 16px; border-radius: 9px; border: 1px solid var(--border);
        background: var(--surface-2); color: var(--text-2); font-size: 13px; font-weight: 600;
        text-decoration: none; transition: background .15s;
    }
    .sc-btn-clear:hover { background: var(--surface-3); }
    .sc-back { margin-left: auto; font-size: 13px; color: var(--text-muted); text-decoration: none; }
    .sc-back:hover { color: var(--text-2); }

    /* Resultado */
    .sc-result-header {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: .8rem;
    }
    .sc-result-count {
        font-size: 13px; color: var(--text-muted);
    }
    .sc-result-count strong { color: var(--text); }

    /* Tabela compacta: com 18 colunas, padding/fonte reduzidos e nomes com
       reticências para caber tudo na largura da tela sem rolagem horizontal
       (o overflow-x fica só como salvaguarda para telas muito estreitas). */
    .sc-table-wrap { overflow-x: auto; border-radius: 12px; border: .5px solid var(--border); }
    table.sc-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; background: var(--surface);
    }
    .sc-table thead tr { background: var(--surface-2); }
    .sc-table th {
        padding: 8px 6px; text-align: left;
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .4px; color: var(--text-muted);
        border-bottom: 1px solid var(--border); white-space: nowrap;
    }
    .sc-table th.sc-th-sortable { cursor: pointer; user-select: none; }
    .sc-table th.sc-th-sortable:hover { color: #7c3aed; }
    .sc-table th.sc-sort-asc::after  { content: " ▲"; font-size: 9px; }
    .sc-table th.sc-sort-desc::after { content: " ▼"; font-size: 9px; }
    .sc-table td {
        padding: 6px 6px; border-bottom: .5px solid var(--border-subtle);
        vertical-align: middle; white-space: nowrap;
    }
    .sc-table tbody tr:last-child td { border-bottom: none; }
    .sc-table tbody tr:hover td { background: var(--surface-2); }

    .sc-player-cell { display: flex; align-items: center; gap: 8px; }
    .sc-photo {
        width: 28px; height: 28px; border-radius: 50%;
        background: var(--surface-3); border: .5px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        overflow: hidden; flex-shrink: 0;
    }
    .sc-photo img { width: 100%; height: 100%; object-fit: cover; }
    .sc-pname {
        font-weight: 600; color: var(--text); display: block; text-decoration: none;
        max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    a.sc-pname:hover { color: #7c3aed; text-decoration: underline; }
    .sc-pmeta {
        font-size: 10px; color: var(--text-muted);
        max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sc-tname {
        display: inline-block; max-width: 120px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        vertical-align: middle;
    }

    .sc-nota {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 22px; border-radius: 6px;
        font-size: 11px; font-weight: 700; color: #fff;
    }
    .sc-tag-pos {
        display: inline-block; padding: 2px 6px; border-radius: 999px;
        font-size: 10px; font-weight: 600;
        background: var(--surface-3); color: var(--text-2);
    }

    .sc-empty {
        text-align: center; padding: 3rem 1rem; color: var(--text-muted); font-size: 14px;
    }

    @@media (max-width: 640px) {
        .sc-grid { grid-template-columns: 1fr 1fr; }
        .sc-hero h1 { font-size: 1.6rem; }
    }

    /* ── Abas Buscar / Comparar ─────────────────────────────────────── */
    .sc-tabs { display: flex; align-items: flex-end; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 1.2rem; }
    .sc-tab-btn {
        padding: 10px 16px; font-size: 13px; font-weight: 700; font-family: inherit;
        cursor: pointer; background: none; border: none; border-bottom: 2px solid transparent;
        color: var(--text-muted);
    }
    .sc-tab-btn.active { color: #7c3aed; border-bottom-color: #7c3aed; }
    .sc-tab-btn:hover:not(.active) { color: var(--text-2); }

    /* ── Aba Comparar ────────────────────────────────────────────────── */
    .cmp-panel-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: .9rem; padding-bottom: .5rem; border-bottom: 1px solid var(--border-subtle); }
    .cmp-hint { font-size: 11px; color: var(--text-muted); }
    .cmp-select-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; align-items: end; }
    .cmp-busca-wrap { position: relative; }
    .cmp-busca-panel {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 200;
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 260px; overflow-y: auto; padding: 4px;
        display: none;
    }
    .cmp-busca-panel.open { display: block; }
    .cmp-busca-opt { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; cursor: pointer; font-size: 13px; color: var(--text); }
    .cmp-busca-opt:hover { background: var(--surface-3); }
    .cmp-busca-opt small { color: var(--text-muted); font-weight: 400; }

    .cmp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-bottom: 1rem; }
    .cmp-card { background: var(--surface); border: .5px solid var(--border); border-top: 3px solid; border-radius: 12px; padding: .9rem 1rem; display: flex; gap: .8rem; align-items: flex-start; }
    .cmp-card-photo {
        width: 54px; height: 54px; border-radius: 10px; flex-shrink: 0; overflow: hidden;
        background: var(--surface-3); border: .5px solid var(--border);
        display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 22px;
    }
    .cmp-card-photo img { width: 100%; height: 100%; object-fit: cover; }
    .cmp-card-nome { font-family: 'Barlow Condensed', sans-serif; font-size: 1.25rem; font-weight: 800; color: var(--text); line-height: 1.1; display: block; }
    .cmp-card-meta { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
    .cmp-card-clube { font-size: 12px; color: var(--text-2); font-weight: 600; margin-top: 2px; }
    .cmp-card-stats { display: flex; gap: 12px; margin-top: .55rem; }
    .cmp-card-stat-v { font-family: 'Barlow Condensed', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text); line-height: 1; }
    .cmp-card-stat-l { font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); }
    .cmp-card-remove { background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); width: 26px; height: 26px; border-radius: 7px; cursor: pointer; font-size: 12px; flex-shrink: 0; }
    .cmp-card-placeholder {
        background: var(--surface-2); border: 1px dashed var(--border-strong); border-radius: 12px; padding: 1rem;
        color: var(--text-muted); font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center;
        text-align: center; min-height: 96px;
    }

    .cmp-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .cmp-chip { background: #ede9fe; color: #5b21b6; border-radius: 999px; padding: 3px 10px; font-size: 11px; font-weight: 600; }

    .cmp-graficos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; margin-bottom: 1rem; }
    .cmp-chart-wrap { height: 300px; position: relative; }
    .cmp-panel-subtitle { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--text-muted); }
    .cmp-legenda { display: flex; gap: 12px; margin-left: auto; flex-wrap: wrap; }
    .cmp-legenda-item { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; color: var(--text-2); }
    .cmp-legenda-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

    .cmp-divisao-row { margin-bottom: .7rem; }
    .cmp-divisao-head { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-bottom: 3px; }
    .cmp-divisao-head strong { color: var(--text-2); font-weight: 600; }
    .cmp-divisao-bar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--surface-3); }

    .cmp-grupo-titulo { font-size: 11px; font-weight: 700; letter-spacing: .14em; color: var(--text-muted); text-transform: uppercase; margin-bottom: .6rem; padding-bottom: .4rem; border-bottom: 1px solid var(--border-subtle); }
    .cmp-metrica-row { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: 14px; align-items: center; padding: .35rem 0; }
    .cmp-metrica-label { font-size: 12px; color: var(--text-2); }
    .cmp-metrica-linhas { display: grid; gap: 4px; }
    .cmp-metrica-linha { display: grid; grid-template-columns: 1fr 56px; gap: 8px; align-items: center; }
    .cmp-metrica-track { height: 8px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
    .cmp-metrica-fill { height: 100%; border-radius: 999px; }
    .cmp-metrica-valor { font-size: 12px; font-weight: 700; text-align: right; }

    @@media (max-width: 640px) {
        .cmp-select-grid { grid-template-columns: 1fr 1fr; }
        .cmp-graficos-grid { grid-template-columns: 1fr; }
    }

    /* ── Responsivo (celular): a tabela rola na horizontal dentro do
       .sc-table-wrap; a coluna do jogador fica fixa (sticky) para não perder
       de vista de quem é a linha enquanto rola as estatísticas. ── */
    @@media (max-width: 767.98px) {
        .sc-hero { padding: 1.4rem 1rem 1.1rem; }
        .sc-panel { padding: 1rem .9rem; }

        .sc-table th:nth-child(2), .sc-table td:nth-child(2) {
            position: sticky; left: 0; z-index: 2;
            background: var(--surface);
        }
        .sc-table thead th:nth-child(2) { background: var(--surface-2); z-index: 3; }
        .sc-table tbody tr:hover td:nth-child(2) { background: var(--surface-2); }
        /* sombra na borda direita da coluna fixa indicando conteúdo rolando atrás */
        .sc-table th:nth-child(2)::after, .sc-table td:nth-child(2)::after {
            content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 6px;
            transform: translateX(100%);
            background: linear-gradient(90deg, rgba(0,0,0,.14), transparent);
            pointer-events: none;
        }
        /* nomes longos não alargam a coluna fixa */
        .sc-pname { max-width: 132px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .sc-pmeta { max-width: 132px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    }

    .sc-acumulado { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 10px; font-size: 12px; color: var(--text-muted); }
    .sc-seg { display: inline-flex; border: .5px solid var(--border); border-radius: 8px; overflow: hidden; }
    .sc-seg button {
        border: none; cursor: pointer; background: transparent; color: var(--text-muted);
        font-family: inherit; font-size: 12px; font-weight: 600; padding: .35rem .8rem;
    }
    .sc-seg button + button { border-left: .5px solid var(--border); }
    .sc-seg button.active { background: var(--surface-3); color: var(--text); }
    .sc-acumulado-nota { font-size: 11px; }
    .sc-grupos { display: inline-flex; gap: 10px; flex-wrap: wrap; }
    .sc-grupos label { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; cursor: pointer; }
    /* coluna desligada some da tabela inteira (cabeçalho + células) */
    .sc-col-off { display: none; }
</style>

<div class="sc-root">

    <div class="sc-hero theme-dark-zone">
        <div class="sc-badge">Relatórios</div>
        <h1>🔍 Scout de Jogadores</h1>
        <p>Encontre jogadores por critérios combinados de desempenho e perfil.</p>
    </div>

    <div class="sc-tabs">
        <button type="button" id="tabBuscarBtn" class="sc-tab-btn active">🔍 Buscar</button>
        <button type="button" id="tabCompararBtn" class="sc-tab-btn">⚖️ Comparar</button>
    </div>

    <div id="abaBuscar">
    <form method="get" asp-action="Scout">
        <input type="hidden" name="pesquisou" value="true" />

        <!-- Dados do Jogador -->
        <div class="sc-panel">
            <div class="sc-panel-title">Perfil do Jogador</div>
            <div class="sc-grid">

                <!-- Posição (tag selector) -->
                <div class="sc-field" style="grid-column: span 2;">
                    <label>Posição</label>
                    <div class="ms-wrap" id="posWrap">
                        <div class="ms-box" id="posBox" tabindex="0"></div>
                        <span class="ms-arrow">▼</span>
                        <div class="ms-panel" id="posPanel">
                            @foreach (var p in Model.Posicoes)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="posicoes" value="@p"
                                           data-nome="@p"
                                           @(f.Posicoes.Contains(p) ? "checked" : "") />
                                    <span>@p</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Time (tag selector) -->
                <div class="sc-field" style="grid-column: span 2;">
                    <label>Time</label>
                    <div class="ms-wrap" id="timeWrap">
                        <div class="ms-box" id="timeBox" tabindex="0"></div>
                        <span class="ms-arrow">▼</span>
                        <div class="ms-panel" id="timePanel">
                            <input type="text" class="ms-search" id="timeSearch" placeholder="Buscar time…" autocomplete="off" />
                            @foreach (var t in Model.Times)
