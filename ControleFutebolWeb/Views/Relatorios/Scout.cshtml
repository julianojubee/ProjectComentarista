@model ControleFutebolWeb.Models.ViewModels.ScoutViewModel
@using ControleFutebolWeb.Helpers
@using ControleFutebolWeb.Models.ViewModels
@{
    ViewData["Title"] = "Scout de jogadores";
    var f = Model.Filtro;

    // Colunas da tabela de resultados, agrupadas como no construtor de
    // estatísticas do Sofascore. Tudo aqui já vem de EstatisticaJogador — o
    // cabeçalho, as células e o seletor de grupos saem desta única lista.
    // Pct = percentual, que o seletor "Acumulado" não reescala.
    var colunasScout = new (string Grupo, string Sigla, string Titulo, Func<ScoutResultItem, double?> Valor, bool Pct)[]
    {
        ("Ataque",     "G",    "Gols",                     r => r.Gols,              false),
        ("Ataque",     "FIN",  "Finalizações",             r => r.FinalizacoesTotal, false),
        ("Ataque",     "FNG",  "Finalizações no gol",      r => r.FinalizacoesNoGol, false),
        ("Ataque",     "CNV%", "Conversão de gols",        r => r.Conversao,         true),
        ("Ataque",     "DRC",  "Dribles certos",           r => r.DrilesCertos,      false),
        ("Ataque",     "DRT",  "Dribles tentados",         r => r.DriblesTentados,   false),
        ("Ataque",     "DRI%", "Acerto no drible",         r => r.PctDribles,        true),
        ("Ataque",     "PSF",  "Pênaltis sofridos",        r => r.PenaltiSofrido,    false),
        ("Ataque",     "GPN",  "Gols de pênalti",          r => r.PenaltiConvertido, false),
        ("Ataque",     "PPE",  "Pênaltis perdidos",        r => r.PenaltiPerdido,    false),

        ("Passe",      "ASS",  "Assistências",             r => r.Assistencias,      false),
        ("Passe",      "PCH",  "Passes-chave",             r => r.PassesChave,       false),
        ("Passe",      "PAS",  "Passes tentados",          r => r.PassesTotal,       false),
        ("Passe",      "PAC",  "Passes certos",            r => r.PassesCertos,      false),
        ("Passe",      "PAS%", "Precisão de passe",        r => r.PrecisaoPasses,    true),

        ("Defesa",     "DSR",  "Desarmes",                 r => r.Desarmes,          false),
        ("Defesa",     "INT",  "Interceptações",           r => r.Interceptacoes,    false),
        ("Defesa",     "BLQ",  "Bloqueios",                r => r.Bloqueios,         false),
        ("Defesa",     "DUV",  "Duelos vencidos",          r => r.DuelosVencidos,    false),
        ("Defesa",     "DUT",  "Duelos disputados",        r => r.DuelosTotal,       false),
        ("Defesa",     "DUE%", "Duelos vencidos %",        r => r.PctDuelos,         true),
        ("Defesa",     "DBD",  "Driblado (foi passado)",   r => r.DriblesSofridos,   false),
        ("Defesa",     "PCM",  "Pênaltis cometidos",       r => r.PenaltiCometido,   false),

        ("Goleiro",    "DEF",  "Defesas",                  r => r.Defesas,           false),
        ("Goleiro",    "GS",   "Gols sofridos",            r => r.GolsSofridos,      false),
        ("Goleiro",    "PDF",  "Pênaltis defendidos",      r => r.PenaltiDefendido,  false),

        ("Disciplina", "CA",   "Cartões amarelos",         r => r.CartaoAmarelo,     false),
        ("Disciplina", "CV",   "Cartões vermelhos",        r => r.CartaoVermelho,    false),
        ("Disciplina", "FCM",  "Faltas cometidas",         r => r.FaltasCometidas,   false),
        ("Disciplina", "FSF",  "Faltas sofridas",          r => r.FaltasSofridas,    false),
        ("Disciplina", "IMP",  "Impedimentos",             r => r.Impedimentos,      false),

        ("Uso",        "TIT",  "Jogos como titular",       r => r.Titularidades,     false),
        ("Uso",        "RES",  "Jogos entrando do banco",  r => r.VezesReserva,      false),
    };

    // Goleiro fica fora por padrão: são 3 colunas vazias para 90% do elenco.
    var gruposScout = new[] { "Ataque", "Passe", "Defesa", "Goleiro", "Disciplina", "Uso" };
    var gruposPadrao = new[] { "Ataque", "Passe", "Defesa", "Disciplina" };

    // Quantos critérios de desempenho estão preenchidos: com algum, o bloco abre sozinho
    var criteriosDesempenho = new object?[]
    {
        f.MinJogos, f.MinGols, f.MinAssistencias, f.MinPassesChave, f.MinDesarmes, f.MinBloqueios,
        f.MinInterceptacoes, f.MinDuelosVencidos, f.MinFinalizacoesNoGol, f.MinDrilesCertos, f.MinNota,
        f.MediaPassesChave, f.MediaDesarmes, f.MediaBloqueios, f.MediaInterceptacoes, f.MediaDuelosVencidos,
        f.MediaFinalizacoesNoGol, f.MediaDrilesCertos, f.MaxCartaoAmarelo, f.MaxCartaoVermelho
    }.Count(v => v != null);

    void CampoNumero(string nome, string rotulo, int? valor, string exemplo)
    {
        <div class="sc-field">
            <label for="@nome">@rotulo</label>
            <input type="number" id="@nome" name="@nome" min="0" value="@valor" />
        </div>
    }

    void CampoMedia(string nome, string rotulo, double? valor, string exemplo)
    {
        <div class="sc-field">
            <label for="@nome">@rotulo</label>
            <input type="number" id="@nome" name="@nome" min="0" step="0.1" value="@(valor?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        </div>
    }
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />

<style>
    .sc-root, .sc-root *, .sc-root *::before, .sc-root *::after { box-sizing: border-box; }
    .sc-root {
        margin: 0 -12px; background: var(--p-0); border-radius: 14px; color: var(--text);
        font-family: 'Barlow', Arial, sans-serif; padding-bottom: 1.5rem;
    }
    .sc-root a { color: inherit; text-decoration: none; }
    .sc-root :is(a, button, input, select, summary, [tabindex]):focus-visible { outline: 2px solid #d4a520; outline-offset: 2px; }

    /* ── Cabeçalho compacto, igual ao de Relatórios (cores fixas: sempre escuro) ── */
    .sc-cab {
        padding: 1.5rem 2.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2040 55%, #0a1628 100%);
        border-left: 4px solid #d4a520; border-radius: 14px 14px 0 0;
        display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap;
    }
    .sc-cab h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 2.4rem; font-weight: 800; color: #f2f5fa; margin: 0; line-height: 1; }
    .sc-cab p { margin: 6px 0 0; font-size: .92rem; color: rgba(255,255,255,.72); max-width: 62ch; }
    .sc-root .sc-cab-btn {
        display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 8px;
        border: 1px solid rgba(255,255,255,.25); color: #e8edf5; font-size: .88rem; font-weight: 600; white-space: nowrap;
    }
    .sc-root .sc-cab-btn:hover { border-color: #d4a520; color: #f3d27a; }

    /* ── Abas Buscar / Comparar ── */
    .sc-tabs { display: flex; gap: 4px; padding: 0 2.5rem; background: var(--p-1); border-bottom: 1px solid var(--line); }
    .sc-tab-btn {
        padding: 12px 14px 10px; font-size: .95rem; font-weight: 600; font-family: inherit; cursor: pointer;
        background: none; border: none; border-bottom: 2px solid transparent; color: var(--text-muted);
    }
    .sc-tab-btn:hover { color: var(--text-strong); }
    .sc-tab-btn.active { color: var(--gold-ink); border-bottom-color: #d4a520; font-weight: 700; }

    .sc-corpo { padding: 1.25rem 2.5rem 0; }

    /* ── Filtros ── */
    .sc-panel { background: var(--p-1); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
    .sc-panel-title { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--text-strong); margin: 0 0 .8rem; }
    .sc-subtitulo { font-size: .86rem; font-weight: 700; color: var(--text-2); margin: 1.1rem 0 .55rem; }
    .sc-subtitulo small { font-weight: 400; color: var(--text-muted); margin-left: .35rem; }
    .sc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px 14px; }
    .sc-field { min-width: 0; }
    .sc-field.largo { grid-column: span 2; }
    /* Perfil: quatro colunas fixas, as listas ocupam duas cada */
    .sc-grid.sc-perfil { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sc-field > label, .sc-rot { display: block; font-size: .8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
    .sc-field input, .sc-field select {
        width: 100%; height: 38px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 10px;
        font-family: inherit; font-size: .88rem; color: var(--text); background: var(--p-2); outline: none;
    }
    .sc-field input:focus, .sc-field select:focus { border-color: #d4a520; }
    .sc-field input::placeholder { color: var(--text-dimmer); opacity: 1; }
    /* Faixa "de / até" num campo só */
    .sc-faixa { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 6px; }
    .sc-faixa span { font-size: .8rem; color: var(--text-muted); }

    /* Desempenho: recolhido, abre sozinho quando há critério preenchido */
    .sc-desempenho > summary {
        list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px;
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--text-strong);
    }
    .sc-desempenho > summary::-webkit-details-marker { display: none; }
    .sc-desempenho > summary::after {
        content: ""; width: 8px; height: 8px; margin-left: 2px; border-right: 2px solid var(--text-muted); border-bottom: 2px solid var(--text-muted);
        transform: rotate(45deg) translateY(-3px); transition: transform .15s;
    }
    .sc-desempenho[open] > summary::after { transform: rotate(225deg) translateY(-1px); }
    .sc-desempenho > summary small { font-family: 'Barlow', Arial, sans-serif; font-size: .82rem; font-weight: 600; color: var(--text-muted); }
    .sc-desempenho[open] > summary { margin-bottom: .2rem; }

    .sc-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin: 0 0 1.5rem; }
    .sc-btn-search {
        height: 40px; padding: 0 22px; border-radius: 8px; border: none; cursor: pointer;
        background: #d4a520; color: #141414; font-family: inherit; font-size: .92rem; font-weight: 700;
    }
    .sc-btn-search:hover { background: #e2b532; }
    .sc-root .sc-btn-clear { font-size: .86rem; font-weight: 600; color: var(--text-muted); }
    .sc-root .sc-btn-clear:hover { color: var(--text-strong); text-decoration: underline; }
    .sc-btn-sec {
        height: 34px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line-strong); background: var(--p-2);
        color: var(--text-2); font-family: inherit; font-size: .84rem; font-weight: 600; cursor: pointer;
    }
    .sc-btn-sec:hover { border-color: #d4a520; color: var(--text-strong); }

    /* ── Seletor de várias opções (mesmo de Relatórios) ── */
    .ms-wrap { position: relative; }
    .ms-box {
        display: flex; flex-wrap: wrap; gap: 5px; align-items: center;
        min-height: 38px; padding: 4px 30px 4px 8px; cursor: pointer;
        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--p-2); font-size: .88rem;
    }
    .ms-box:hover { border-color: #d4a520; }
    .ms-box::after {
        content: ""; position: absolute; right: 12px; top: 19px; width: 7px; height: 7px; margin-top: -5px;
        border-right: 1.5px solid var(--text-muted); border-bottom: 1.5px solid var(--text-muted); transform: rotate(45deg);
        pointer-events: none;
    }
    .ms-placeholder { color: var(--text-muted); }
    .ms-chip {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.35);
        border-radius: 6px; padding: 1px 6px; font-size: .8rem; font-weight: 600;
    }
    .ms-chip-x { cursor: pointer; font-weight: 700; line-height: 1; opacity: .7; }
    .ms-chip-x:hover { opacity: 1; }
    .ms-panel {
        position: absolute; top: calc(100% + 4px); left: 0; min-width: 100%; width: max-content; max-width: min(360px, calc(100vw - 32px));
        z-index: 120; background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0,0,0,.22); max-height: 300px; overflow-y: auto; display: none; padding: 4px;
    }
    .ms-panel.open { display: block; }
    .ms-opt { display: flex; align-items: center; gap: 8px; padding: 7px 10px; margin: 0; border-radius: 6px; cursor: pointer; font-size: .86rem; color: var(--text); }
    .ms-opt:hover { background: var(--p-4); }
    .ms-opt input { cursor: pointer; accent-color: #d4a520; width: auto; height: auto; }
    .ms-search {
        width: 100%; height: auto !important; padding: 7px 10px !important; margin-bottom: 4px;
        border: 1px solid var(--line-strong); border-radius: 6px; font-size: .86rem; outline: none;
        position: sticky; top: 0; background: var(--p-1) !important; color: var(--text);
    }

    /* ── Resultado ── */
    .sc-result-header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 0 0 .7rem; scroll-margin-top: 12px; }
    .sc-result-count { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--text-strong); margin: 0; }
    .sc-result-dica { font-size: .84rem; color: var(--text-muted); }

    .sc-acumulado { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; margin: 0 0 10px; font-size: .84rem; color: var(--text-muted); }
    .sc-seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
    .sc-seg button {
        border: none; cursor: pointer; background: var(--p-2); color: var(--text-muted);
        font-family: inherit; font-size: .84rem; font-weight: 600; padding: .38rem .8rem;
    }
    .sc-seg button + button { border-left: 1px solid var(--line-strong); }
    .sc-seg button.active { background: var(--p-4); color: var(--text-strong); }
    .sc-acumulado-nota { font-size: .8rem; }
    .sc-grupos { display: inline-flex; gap: 6px 12px; flex-wrap: wrap; margin-left: auto; align-items: center; }
    .sc-grupos label { display: inline-flex; align-items: center; gap: 5px; font-size: .84rem; font-weight: 600; color: var(--text-2); cursor: pointer; }
    .sc-grupos input { accent-color: #d4a520; }
    .sc-col-off { display: none; }

    .sc-table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
    table.sc-table { width: 100%; border-collapse: collapse; font-size: .84rem; background: var(--p-1); font-variant-numeric: tabular-nums; }
    .sc-table thead tr { background: var(--p-2); }
    .sc-table th {
        padding: 9px 7px; text-align: right; font-size: .76rem; font-weight: 700; color: var(--text-muted);
        border-bottom: 1px solid var(--line); white-space: nowrap;
    }
    .sc-table th.sc-txt, .sc-table td.sc-txt { text-align: left; }
    .sc-table th.sc-th-sortable { cursor: pointer; user-select: none; }
    .sc-table th.sc-th-sortable:hover { color: var(--text-strong); }
    .sc-table th.sc-sort-asc, .sc-table th.sc-sort-desc { color: var(--gold-ink); }
    .sc-table th.sc-sort-asc::after  { content: " ▲"; font-size: .6rem; }
    .sc-table th.sc-sort-desc::after { content: " ▼"; font-size: .6rem; }
    .sc-table td { padding: 7px 7px; border-bottom: 1px solid var(--line-soft); vertical-align: middle; white-space: nowrap; text-align: right; color: var(--text-2); }
    .sc-table tbody tr:last-child td { border-bottom: none; }
    .sc-table tbody tr:hover td { background: var(--p-2); }
    .sc-table td.sc-zero { color: var(--text-dimmer); }
    .sc-pos-n { color: var(--text-dimmer); }

    .sc-player-cell { display: flex; align-items: center; gap: 8px; }
    .sc-photo { width: 30px; height: 30px; border-radius: 50%; background: var(--p-3); overflow: hidden; flex-shrink: 0; }
    .sc-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .sc-root .sc-pname { font-weight: 700; color: var(--text-strong); display: block; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sc-root a.sc-pname:hover { color: var(--gold-ink); text-decoration: underline; }
    .sc-pmeta { font-size: .76rem; color: var(--text-muted); max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sc-time { display: inline-flex; align-items: center; gap: 6px; }
    .sc-time img { width: 18px; height: 18px; object-fit: contain; }
    .sc-tname { display: inline-block; max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
    .sc-nota { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 22px; border-radius: 6px; font-size: .78rem; font-weight: 700; color: #fff; }
    .sc-tag-pos { display: inline-block; padding: 1px 7px; border-radius: 5px; font-size: .74rem; font-weight: 700; background: var(--p-3); color: var(--text-2); }

    .sc-empty { text-align: center; padding: 2.5rem 1rem; color: var(--text-muted); font-size: .92rem; line-height: 1.6; background: var(--p-1); border: 1px dashed var(--line-strong); border-radius: 12px; }
    .sc-empty b { display: block; color: var(--text-strong); font-size: 1rem; }

    /* ── Aba Comparar ── */
    .cmp-panel-head { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; margin-bottom: .9rem; }
    .cmp-panel-head .sc-panel-title { margin: 0; }
    .cmp-hint { font-size: .84rem; color: var(--text-muted); }
    .cmp-acoes { margin-left: auto; display: flex; gap: 8px; align-items: center; }
    .cmp-acoes select { height: 34px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 9px; font-size: .84rem; background: var(--p-2); color: var(--text); font-family: inherit; }
    .cmp-select-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; align-items: end; }
    .cmp-busca-wrap { position: relative; }
    .cmp-busca-panel {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 200;
        background: var(--p-2); border: 1px solid var(--line-strong); border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0,0,0,.22); max-height: 260px; overflow-y: auto; padding: 4px; display: none;
    }
    .cmp-busca-panel.open { display: block; }
    .cmp-busca-opt { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; cursor: pointer; font-size: .86rem; color: var(--text); }
    .cmp-busca-opt:hover, .cmp-busca-opt:focus { background: var(--p-4); outline: none; }
    .cmp-busca-opt small { color: var(--text-muted); font-weight: 400; }

    .cmp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-bottom: 1rem; }
    .cmp-card { background: var(--p-1); border: 1px solid var(--line); border-top: 3px solid; border-radius: 12px; padding: .9rem 1rem; display: flex; gap: .8rem; align-items: flex-start; }
    .cmp-card-photo { width: 54px; height: 54px; border-radius: 10px; flex-shrink: 0; overflow: hidden; background: var(--p-3); }
    .cmp-card-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .sc-root .cmp-card-nome { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.25rem; font-weight: 800; color: var(--text-strong); line-height: 1.1; display: block; }
    .sc-root a.cmp-card-nome:hover { color: var(--gold-ink); }
    .cmp-card-meta { font-size: .8rem; color: var(--text-muted); margin-top: 2px; }
    .cmp-card-clube { font-size: .84rem; color: var(--text-2); font-weight: 600; margin-top: 2px; }
    .cmp-card-stats { display: flex; gap: 14px; margin-top: .55rem; }
    .cmp-card-stat-v { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--text-strong); line-height: 1; }
    .cmp-card-stat-l { font-size: .74rem; color: var(--text-muted); }
    .cmp-card-remove {
        background: transparent; border: 1px solid var(--line-strong); color: var(--text-muted);
        height: 28px; padding: 0 9px; border-radius: 7px; cursor: pointer; font-size: .78rem; font-weight: 600; flex-shrink: 0; font-family: inherit;
    }
    .cmp-card-remove:hover { color: var(--bad); border-color: var(--bad); }
    .cmp-card-placeholder {
        background: transparent; border: 1px dashed var(--line-strong); border-radius: 12px; padding: 1rem;
        color: var(--text-muted); font-size: .88rem; display: flex; align-items: center; justify-content: center; text-align: center; min-height: 96px;
    }

    .cmp-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .cmp-chip { background: rgba(212,165,32,.12); color: var(--gold-ink); border: 1px solid rgba(212,165,32,.3); border-radius: 6px; padding: 2px 9px; font-size: .8rem; font-weight: 600; }

    .cmp-graficos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; margin-bottom: 1rem; }
    .cmp-graficos-grid .sc-panel { margin-bottom: 0; }
    .cmp-chart-wrap { height: 300px; position: relative; }
    .cmp-panel-subtitle { font-family: 'Barlow', Arial, sans-serif; font-size: .84rem; font-weight: 400; color: var(--text-muted); }
    .cmp-legenda { display: flex; gap: 12px; margin-left: auto; flex-wrap: wrap; }
    .cmp-legenda-item { display: inline-flex; align-items: center; gap: 5px; font-size: .82rem; font-weight: 600; color: var(--text-2); }
    .cmp-legenda-dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

    .cmp-divisao-row { margin-bottom: .75rem; }
    .cmp-divisao-head { display: flex; justify-content: space-between; gap: 10px; font-size: .84rem; color: var(--text-2); margin-bottom: 4px; }
    .cmp-divisao-head strong { color: var(--text-strong); font-weight: 700; font-variant-numeric: tabular-nums; }
    .cmp-divisao-bar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--p-3); gap: 2px; }

    .cmp-grupo-titulo { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--text-strong); margin-bottom: .5rem; padding-bottom: .35rem; border-bottom: 1px solid var(--line-soft); }
    .cmp-metrica-row { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: 14px; align-items: center; padding: .35rem 0; }
    .cmp-metrica-label { font-size: .86rem; color: var(--text-2); }
    .cmp-metrica-linhas { display: grid; gap: 4px; }
    .cmp-metrica-linha { display: grid; grid-template-columns: 1fr 56px; gap: 8px; align-items: center; }
    .cmp-metrica-track { height: 8px; border-radius: 999px; background: var(--p-3); overflow: hidden; }
    .cmp-metrica-fill { height: 100%; border-radius: 999px; }
    .cmp-metrica-valor { font-size: .84rem; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
    .cmp-confrontos td { text-align: left; white-space: normal; }

    @@media (max-width: 767.98px) {
        .sc-cab, .sc-tabs, .sc-corpo { padding-left: 1rem; padding-right: 1rem; }
        .sc-cab { padding-top: 1.1rem; padding-bottom: 1.1rem; }
        .sc-cab h1 { font-size: 2rem; }
        .sc-panel { padding: 1rem .9rem; }
        .sc-grid, .sc-grid.sc-perfil { grid-template-columns: 1fr 1fr; }
        .sc-field.largo { grid-column: 1 / -1; }
        .sc-grupos { margin-left: 0; }
        .cmp-select-grid { grid-template-columns: 1fr 1fr; }
        .cmp-graficos-grid { grid-template-columns: 1fr; }
        .cmp-acoes { margin-left: 0; }

        /* A tabela rola na horizontal; a coluna do jogador fica presa à esquerda */
        .sc-table th:nth-child(2), .sc-table td:nth-child(2) { position: sticky; left: 0; z-index: 2; background: var(--p-1); }
        .sc-table thead th:nth-child(2) { background: var(--p-2); z-index: 3; }
        .sc-table tbody tr:hover td:nth-child(2) { background: var(--p-2); }
        .sc-table th:nth-child(2)::after, .sc-table td:nth-child(2)::after {
            content: ""; position: absolute; top: 0; right: 0; bottom: 0; width: 6px; transform: translateX(100%);
            background: linear-gradient(90deg, rgba(0,0,0,.14), transparent); pointer-events: none;
        }
        .sc-root .sc-pname, .sc-pmeta { max-width: 120px; }
    }

    @@media print {
        .sc-cab, .sc-tabs, #abaComparar > .sc-panel:first-child, .cmp-card-remove, .cmp-card-placeholder { display: none !important; }
    }
</style>

<div class="sc-root">

    <div class="sc-cab theme-dark-zone">
        <div>
            <h1>Scout de jogadores</h1>
            <p>Filtre por perfil e desempenho para encontrar jogadores, ou compare até três lado a lado.</p>
        </div>
        <a href="@Url.Action("Index", "Relatorios")" class="sc-cab-btn">Voltar para Relatórios</a>
    </div>

    <div class="sc-tabs" role="tablist">
        <button type="button" id="tabBuscarBtn" class="sc-tab-btn active" role="tab" aria-selected="true">Buscar</button>
        <button type="button" id="tabCompararBtn" class="sc-tab-btn" role="tab" aria-selected="false">Comparar</button>
    </div>

    <div class="sc-corpo">
    <div id="abaBuscar">
    <form method="get" asp-action="Scout">
        <input type="hidden" name="pesquisou" value="true" />

        <div class="sc-panel">
            <h2 class="sc-panel-title">Perfil</h2>
            <div class="sc-grid sc-perfil">

                <div class="sc-field largo">
                    <span class="sc-rot" id="rotPos">Posição</span>
                    <div class="ms-wrap" id="posWrap">
                        <div class="ms-box" id="posBox" tabindex="0" role="button" aria-haspopup="true" aria-labelledby="rotPos"></div>
                        <div class="ms-panel" id="posPanel">
                            @foreach (var p in Model.Posicoes)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="posicoes" value="@p"
                                           data-nome="@p"
                                           @(f.Posicoes.Contains(p) ? "checked" : "") />
                                    <span>@p</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <div class="sc-field largo">
                    <span class="sc-rot" id="rotTime">Time</span>
                    <div class="ms-wrap" id="timeWrap">
                        <div class="ms-box" id="timeBox" tabindex="0" role="button" aria-haspopup="true" aria-labelledby="rotTime"></div>
                        <div class="ms-panel" id="timePanel">
                            <input type="text" class="ms-search" id="timeSearch" placeholder="Buscar time" autocomplete="off" aria-label="Buscar time" />
                            @foreach (var t in Model.Times)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="timeIds" value="@t.Id"
                                           data-nome="@t.Nome"
                                           @(f.TimeIds.Contains(t.Id) ? "checked" : "") />
                                    <span>@t.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <div class="sc-field largo">
                    <span class="sc-rot" id="rotComp">Competição</span>
                    <div class="ms-wrap" id="compWrap">
                        <div class="ms-box" id="compBox" tabindex="0" role="button" aria-haspopup="true" aria-labelledby="rotComp"></div>
                        <div class="ms-panel" id="compPanel">
                            <input type="text" class="ms-search" id="compSearch" placeholder="Buscar competição" autocomplete="off" aria-label="Buscar competição" />
                            @foreach (var c in Model.Competicoes)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="competicaoIds" value="@c.Id"
                                           data-nome="@c.Nome"
                                           @(f.CompeticaoIds.Contains(c.Id) ? "checked" : "") />
                                    <span>@c.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>


                <div class="sc-field largo">
                    <span class="sc-rot" id="rotNac">Nacionalidade</span>
                    <div class="ms-wrap" id="nacWrap">
                        <div class="ms-box" id="nacBox" tabindex="0" role="button" aria-haspopup="true" aria-labelledby="rotNac"></div>
                        <div class="ms-panel" id="nacPanel">
                            <input type="text" class="ms-search" id="nacSearch" placeholder="Buscar nacionalidade" autocomplete="off" aria-label="Buscar nacionalidade" />
                            @foreach (var n in Model.Nacionalidades)
                            {
                                <label class="ms-opt">
                                    <input type="checkbox" name="nacionalidadeIds" value="@n.Id"
                                           data-nome="@n.Nome"
                                           @(f.NacionalidadeIds.Contains(n.Id) ? "checked" : "") />
                                    <span>@n.Nome</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <div class="sc-field">
                    <label for="scTemporada">Temporada</label>
                    <select name="temporada" id="scTemporada">
                        <option value="">Todas</option>
                        @foreach (var t in Model.Temporadas)
                        {
                            <option value="@t" selected="@(f.Temporada == t ? "selected" : null)">@t</option>
                        }
                    </select>
                </div>

                <div class="sc-field">
                    <span class="sc-rot">Idade</span>
                    <div class="sc-faixa">
                        <input type="number" name="idadeMin" min="15" max="50" value="@f.IdadeMin" placeholder="mín." aria-label="Idade mínima" />
                        <span>a</span>
                        <input type="number" name="idadeMax" min="15" max="50" value="@f.IdadeMax" placeholder="máx." aria-label="Idade máxima" />
                    </div>
                </div>
                <div class="sc-field">
                    <span class="sc-rot">Altura <small>(cm)</small></span>
                    <div class="sc-faixa">
                        <input type="number" name="alturaMin" min="140" max="220" value="@f.AlturaMin" placeholder="mín." aria-label="Altura mínima em centímetros" />
                        <span>a</span>
                        <input type="number" name="alturaMax" min="140" max="220" value="@f.AlturaMax" placeholder="máx." aria-label="Altura máxima em centímetros" />
                    </div>
                </div>
                <div class="sc-field">
                    <span class="sc-rot">Peso <small>(kg)</small></span>
                    <div class="sc-faixa">
                        <input type="number" name="pesoMin" min="50" max="120" value="@f.PesoMin" placeholder="mín." aria-label="Peso mínimo em quilos" />
                        <span>a</span>
                        <input type="number" name="pesoMax" min="50" max="120" value="@f.PesoMax" placeholder="máx." aria-label="Peso máximo em quilos" />
                    </div>
                </div>
            </div>
        </div>

        <details class="sc-panel sc-desempenho" @(criteriosDesempenho > 0 ? "open" : "")>
            <summary>
                Desempenho
                <small>@(criteriosDesempenho == 0 ? "nenhum critério" : criteriosDesempenho == 1 ? "1 critério" : $"{criteriosDesempenho} critérios")</small>
            </summary>

            <div class="sc-subtitulo">Totais mínimos <small>somados nos jogos filtrados</small></div>
            <div class="sc-grid">
                @{ CampoNumero("minJogos", "Jogos", f.MinJogos, "10"); }
                @{ CampoNumero("minGols", "Gols", f.MinGols, "5"); }
                @{ CampoNumero("minAssistencias", "Assistências", f.MinAssistencias, "3"); }
                @{ CampoNumero("minPassesChave", "Passes-chave", f.MinPassesChave, "20"); }
                @{ CampoNumero("minDesarmes", "Desarmes", f.MinDesarmes, "15"); }
                @{ CampoNumero("minBloqueios", "Bloqueios", f.MinBloqueios, "10"); }
                @{ CampoNumero("minInterceptacoes", "Interceptações", f.MinInterceptacoes, "10"); }
                @{ CampoNumero("minDuelosVencidos", "Duelos vencidos", f.MinDuelosVencidos, "50"); }
                @{ CampoNumero("minFinalizacoesNoGol", "Finalizações no gol", f.MinFinalizacoesNoGol, "10"); }
                @{ CampoNumero("minDrilesCertos", "Dribles certos", f.MinDrilesCertos, "8"); }
                <div class="sc-field">
                    <label for="minNota">Nota média</label>
                    <input type="number" id="minNota" name="minNota" min="0" max="10" step="0.1" value="@(f.MinNota?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
            </div>

            <div class="sc-subtitulo">Médias por jogo mínimas</div>
            <div class="sc-grid">
                @{ CampoMedia("mediaPassesChave", "Passes-chave", f.MediaPassesChave, "1,5"); }
                @{ CampoMedia("mediaDesarmes", "Desarmes", f.MediaDesarmes, "2"); }
                @{ CampoMedia("mediaBloqueios", "Bloqueios", f.MediaBloqueios, "0,5"); }
                @{ CampoMedia("mediaInterceptacoes", "Interceptações", f.MediaInterceptacoes, "1"); }
                @{ CampoMedia("mediaDuelosVencidos", "Duelos vencidos", f.MediaDuelosVencidos, "4"); }
                @{ CampoMedia("mediaFinalizacoesNoGol", "Finalizações no gol", f.MediaFinalizacoesNoGol, "1"); }
                @{ CampoMedia("mediaDrilesCertos", "Dribles certos", f.MediaDrilesCertos, "1,5"); }
            </div>

            <div class="sc-subtitulo">Disciplina <small>no máximo</small></div>
            <div class="sc-grid">
                @{ CampoNumero("maxCartaoAmarelo", "Cartões amarelos", f.MaxCartaoAmarelo, "5"); }
                @{ CampoNumero("maxCartaoVermelho", "Cartões vermelhos", f.MaxCartaoVermelho, "1"); }
            </div>
        </details>

        <div class="sc-actions">
            <button type="submit" class="sc-btn-search">Buscar jogadores</button>
            <a href="@Url.Action("Scout", "Relatorios")" class="sc-btn-clear">Limpar filtros</a>
        </div>
    </form>

    @if (Model.Pesquisou)
    {
        <div class="sc-result-header" id="resultados">
            <h2 class="sc-result-count">
                @(Model.Resultados.Count == 0 ? "Nenhum jogador encontrado" : Model.Resultados.Count == 1 ? "1 jogador encontrado" : $"{Model.Resultados.Count} jogadores encontrados")
            </h2>
            @if (Model.Resultados.Any())
            {
                <span class="sc-result-dica">Ordenados pela nota média. Clique no nome de uma coluna para reordenar.</span>
            }
        </div>

        @if (!Model.Resultados.Any())
        {
            <div class="sc-empty">
                <b>Ninguém passa por todos os filtros ao mesmo tempo.</b>
                Afrouxe um critério de desempenho, tire uma posição ou escolha mais competições.
            </div>
        }
        else
        {
            @* Acumulado: reescala as colunas de contagem no cliente. Só é correto
               fazer isso aqui porque o Scout devolve todos os resultados — não há
               corte de top-N que a mudança de base tornaria inválido. *@
            <div class="sc-acumulado">
                <span>Mostrar</span>
                <div class="sc-seg" id="sc-base" role="group" aria-label="Base dos números">
                    <button type="button" data-b="total" class="active" aria-pressed="true">Totais</button>
                    <button type="button" data-b="jogo" aria-pressed="false">Por jogo</button>
                    <button type="button" data-b="90" aria-pressed="false">Por 90 min</button>
                </div>
                <span class="sc-acumulado-nota" id="sc-base-nota"></span>

                <div class="sc-grupos" id="sc-grupos">
                    <span>Colunas</span>
                    @foreach (var g in gruposScout)
                    {
                        <label><input type="checkbox" data-g="@g" @(gruposPadrao.Contains(g) ? "checked" : "") /> @g</label>
                    }
                </div>
            </div>

            <div class="sc-table-wrap">
                <table class="sc-table" id="sc-tabela">
                    <thead>
                        <tr>
                            <th class="sc-txt" title="Posição na ordenação atual">#</th>
                            <th class="sc-txt" data-tipo="texto">Jogador</th>
                            <th class="sc-txt" data-tipo="texto" title="Posição">Pos.</th>
                            <th data-tipo="num">Idade</th>
                            <th class="sc-txt" data-tipo="texto">Time</th>
                            <th data-tipo="num" title="Jogos em que entrou em campo">JG</th>
                            <th data-tipo="num" title="Minutos jogados">MIN</th>
                            @foreach (var c in colunasScout)
                            {
                                <th title="@c.Titulo" data-grupo="@c.Grupo" data-tipo="num"
                                    class="@(gruposPadrao.Contains(c.Grupo) ? "" : "sc-col-off")">@c.Sigla</th>
                            }
                            <th data-tipo="num" title="Nota média">Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 0; }
                        @foreach (var r in Model.Resultados)
                        {
                            idx++;
                            var j = r.Jogador;
                            var notaColor = r.NotaMedia switch
                            {
                                >= 8.5 => "#f59e0b",
                                >= 7.5 => "#22c55e",
                                >= 6.5 => "#3b82f6",
                                >= 5.5 => "var(--text-dim)",
                                >= 4.5 => "#f97316",
                                _ => "#ef4444"
                            };
                            @* jogos e minutos ficam na linha: são os denominadores da reescala *@
                            <tr data-jogos="@r.Jogos" data-min="@r.Minutos">
                                <td class="sc-txt sc-pos-n">@idx</td>
                                <td class="sc-txt">
                                    <div class="sc-player-cell">
                                        <div class="sc-photo">
                                            @if (!string.IsNullOrEmpty(j.FotoUrl))
                                            {
                                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = j.FotoUrl })" alt="" loading="lazy" onerror="this.remove()" />
                                            }
                                        </div>
                                        <div>
                                            <a class="sc-pname"
                                               href="@Url.Action("Estatisticas", "Jogadores", new { id = j.Id })"
                                               title="Ver perfil de @j.Nome">@j.Nome</a>
                                            <div class="sc-pmeta">@j.Nacionalidade?.Nome</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="sc-txt"><span class="sc-tag-pos" title="@j.Posicao">@PosicaoJogadorHelper.Sigla(j.Posicao)</span></td>
                                <td>@(j.Idade > 0 ? j.Idade.ToString() : "—")</td>
                                <td class="sc-txt">
                                    @if (j.Time != null)
                                    {
                                        <span class="sc-time">
                                            @if (!string.IsNullOrEmpty(j.Time.EscudoUrl))
                                            {
                                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = j.Time.EscudoUrl })" alt="" loading="lazy" />
                                            }
                                            <span class="sc-tname" title="@j.Time.Nome">@j.Time.Nome</span>
                                        </span>
                                    }
                                    else { <span>—</span> }
                                </td>
                                <td style="font-weight:700;color:var(--text-strong)">@r.Jogos</td>
                                <td>@(r.Minutos > 0 ? r.Minutos.ToString() : "—")</td>
                                @foreach (var c in colunasScout)
                                {
                                    var v = c.Valor(r);
                                    var oculta = gruposPadrao.Contains(c.Grupo) ? "" : " sc-col-off";
                                    if (c.Pct)
                                    {
                                        @* percentual não se divide por jogos nem por minutos *@
                                        <td class="sc-pct@(oculta)" data-grupo="@c.Grupo">@(v.HasValue ? v.Value.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) + "%" : "—")</td>
                                    }
                                    else
                                    {
                                        <td class="sc-num@(oculta)@((v ?? 0) == 0 ? " sc-zero" : "")" data-grupo="@c.Grupo" data-total="@((int)(v ?? 0))">@((int)(v ?? 0))</td>
                                    }
                                }
                                <td>
                                    @if (r.NotaMedia.HasValue)
                                    {
                                        <span class="sc-nota" style="background:@notaColor;">@r.NotaMedia.Value.ToString("F1")</span>
                                    }
                                    else { <span class="sc-zero">—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <script>
            // Reescala as colunas de contagem entre total, por jogo e por 90 min.
            // O valor original fica em data-total de cada célula, então alternar de
            // base não perde precisão nem depende de reconsultar o servidor.
            (function () {
                const seg = document.getElementById('sc-base');
                const tabela = document.getElementById('sc-tabela');
                const nota = document.getElementById('sc-base-nota');
                if (!seg || !tabela) return;

                // Piso igual ao dos rankings de Relatórios: dividir poucas ações por
                // um punhado de minutos infla o número a ponto de virar ruído.
                const MIN_MINUTOS_90 = 270;

                function aplicar(base) {
                    let ocultos = 0;
                    tabela.querySelectorAll('tbody tr').forEach((tr) => {
                        const jogos = +tr.dataset.jogos || 0;
                        const min = +tr.dataset.min || 0;
                        const semAmostra = base === '90' && min < MIN_MINUTOS_90;
                        if (semAmostra) ocultos++;
                        tr.style.opacity = semAmostra ? '.35' : '';

                        tr.querySelectorAll('td.sc-num').forEach((td) => {
                            const total = +td.dataset.total || 0;
                            let v;
                            if (base === 'jogo') v = jogos > 0 ? total / jogos : 0;
                            else if (base === '90') v = min > 0 ? total / min * 90 : 0;
                            else v = total;
                            td.textContent = base === 'total' ? String(total) : v.toFixed(2).replace('.', ',');
                        });
                    });
                    nota.textContent = base === '90'
                        ? `por 90 minutos em campo; ${ocultos === 1 ? '1 jogador' : ocultos + ' jogadores'} com menos de ${MIN_MINUTOS_90} min ficam apagados`
                        : base === 'jogo' ? 'divididos pelos jogos em que entrou' : '';
                }

                seg.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
                    seg.querySelectorAll('button').forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
                    b.classList.add('active');
                    b.setAttribute('aria-pressed', 'true');
                    aplicar(b.dataset.b);
                }));

                // Seletor de grupos de colunas: liga/desliga cabeçalho e células de
                // uma vez, pelo data-grupo que o servidor já escreveu em cada uma.
                const grupos = document.getElementById('sc-grupos');
                if (grupos) {
                    grupos.querySelectorAll('input[data-g]').forEach((cb) => cb.addEventListener('change', () => {
                        const g = cb.dataset.g;
                        tabela.querySelectorAll(`[data-grupo="${g}"]`).forEach((el) => {
                            el.classList.toggle('sc-col-off', !cb.checked);
                        });
                    }));
                }
            })();
            </script>
        }
    }
    </div>

    <div id="abaComparar" style="display:none;">

        <div class="sc-panel">
            <div class="cmp-panel-head">
                <h2 class="sc-panel-title">Escolher jogadores</h2>
                <span class="cmp-hint">Até três, pela competição e pelo time ou pelo nome.</span>
                <div class="cmp-acoes">
                    <select id="cmpTemporada" aria-label="Temporada da comparação">
                        <option value="">Todas as temporadas</option>
                        @foreach (var t in Model.Temporadas)
                        {
                            <option value="@t">Temporada @t</option>
                        }
                    </select>
                    <button type="button" id="cmpExportar" class="sc-btn-sec">Imprimir</button>
                </div>
            </div>
            <div class="cmp-select-grid">
                <div class="sc-field">
                    <label for="cmpLiga">Competição</label>
                    <select id="cmpLiga">
                        <option value="">Todas as competições</option>
                    </select>
                </div>
                <div class="sc-field">
                    <label for="cmpTime">Time</label>
                    <select id="cmpTime">
                        <option value="">Todos os times</option>
                    </select>
                </div>
                <div class="sc-field">
                    <label for="cmpJogador">Jogador</label>
                    <select id="cmpJogador">
                        <option value="">Adicionar jogador…</option>
                    </select>
                </div>
                <div class="sc-field cmp-busca-wrap">
                    <label for="cmpBusca">Ou busque pelo nome</label>
                    <input type="text" id="cmpBusca" placeholder="Nome do jogador" autocomplete="off" />
                    <div id="cmpBuscaPanel" class="cmp-busca-panel"></div>
                </div>
            </div>
        </div>

        <div id="cmpCards" class="cmp-cards"></div>

        <div id="cmpVazio" class="sc-empty"><b>Escolha pelo menos dois jogadores.</b>A comparação aparece aqui assim que o segundo for escolhido.</div>

        <div id="cmpResultado" style="display:none;">
            <div class="sc-panel">
                <h2 class="sc-panel-title">Prioridades da posição</h2>
                <div id="cmpTextoFuncoes" style="font-size:.9rem;color:var(--text-2);margin-bottom:.6rem;max-width:80ch;"></div>
                <div id="cmpChips" class="cmp-chips"></div>
            </div>

            <div class="cmp-graficos-grid">
                <div class="sc-panel">
                    <h2 class="sc-panel-title">Atributos-chave da posição</h2>
                    <div class="cmp-chart-wrap"><canvas id="cmpRadarCanvas"></canvas></div>
                </div>
                <div class="sc-panel">
                    <h2 class="sc-panel-title">Percentil na competição <span class="cmp-panel-subtitle">50 é a média</span></h2>
                    <div class="cmp-chart-wrap"><canvas id="cmpPercentilCanvas"></canvas></div>
                </div>
            </div>

            <div class="sc-panel">
                <div class="cmp-panel-head">
                    <h2 class="sc-panel-title">Divisão das métricas prioritárias</h2>
                    <div id="cmpLegenda" class="cmp-legenda"></div>
                </div>
                <div id="cmpDivisao"></div>
            </div>

            <div class="sc-panel" id="cmpGruposPanel"></div>

            <div class="sc-panel" id="cmpConfrontosPanel" style="display:none;">
                <h2 class="sc-panel-title">Confrontos diretos</h2>
                <div class="sc-table-wrap">
                    <table class="sc-table cmp-confrontos">
                        <thead>
                            <tr>
                                <th class="sc-txt">Data</th>
                                <th class="sc-txt">Competição</th>
                                <th class="sc-txt">Partida</th>
                                <th class="sc-txt">Gols e assistências</th>
                                <th style="text-align:right;">Notas <small style="font-weight:400">(na ordem dos cartões)</small></th>
                            </tr>
                        </thead>
                        <tbody id="cmpConfrontosBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div><!-- /.sc-corpo -->

</div>

<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script>
(function () {
    function initMulti(wrapId, boxId, panelId, placeholder) {
        var wrap  = document.getElementById(wrapId);
        var box   = document.getElementById(boxId);
        var panel = document.getElementById(panelId);
        if (!wrap) return;

        function render() {
            var checks  = panel.querySelectorAll('input[type=checkbox]');
            var marcados = Array.prototype.filter.call(checks, function (c) { return c.checked; });
            box.innerHTML = '';
            if (marcados.length === 0) {
                var ph = document.createElement('span');
                ph.className = 'ms-placeholder';
                ph.textContent = placeholder;
                box.appendChild(ph);
                return;
            }
            marcados.forEach(function (c) {
                var chip = document.createElement('span');
                chip.className = 'ms-chip';
                var txt = document.createElement('span');
                txt.textContent = c.dataset.nome;
                var x = document.createElement('span');
                x.className = 'ms-chip-x';
                x.textContent = '×';
                x.addEventListener('click', function (e) {
                    e.stopPropagation();
                    c.checked = false;
                    render();
                });
                chip.appendChild(txt);
                chip.appendChild(x);
                box.appendChild(chip);
            });
        }

        panel.querySelectorAll('input[type=checkbox]').forEach(function (c) {
            c.addEventListener('change', render);
        });

        box.addEventListener('click', function () { panel.classList.toggle('open'); });
        box.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); panel.classList.toggle('open'); }
        });
        document.addEventListener('click', function (e) {
            if (!wrap.contains(e.target)) panel.classList.remove('open');
        });

        render();
    }

    initMulti('posWrap',  'posBox',  'posPanel',  'Todas as posições');
    initMulti('timeWrap', 'timeBox', 'timePanel', 'Todos os times');
    initMulti('compWrap', 'compBox', 'compPanel', 'Todas as competições');
    initMulti('nacWrap',  'nacBox',  'nacPanel',  'Todas as nacionalidades');

    function bindSearch(inputId, panelSelector) {
        var el = document.getElementById(inputId);
        if (!el) return;
        el.addEventListener('input', function () {
            var termo = this.value.trim().toLowerCase();
            document.querySelectorAll(panelSelector + ' .ms-opt').forEach(function (lbl) {
                var nome = (lbl.querySelector('span')?.textContent || '').toLowerCase();
                lbl.style.display = (termo === '' || nome.indexOf(termo) !== -1) ? '' : 'none';
            });
        });
        el.addEventListener('click', function (e) { e.stopPropagation(); });
    }

    bindSearch('timeSearch', '#timePanel');
    bindSearch('compSearch', '#compPanel');
    bindSearch('nacSearch', '#nacPanel');
})();
</script>

<script>
// Ordenação da tabela de resultados: clicar num cabeçalho ordena as linhas por
// aquela coluna. Números começam do maior; texto, em ordem alfabética. Clicar de
// novo inverte. O tipo vem do data-tipo de cada <th> (as colunas variam de grupo).
(function () {
    var res0 = document.getElementById('resultados');
    var table = document.getElementById('sc-tabela');
    if (!table) { if (res0) res0.scrollIntoView({ block: 'start' }); return; }

    var tbody   = table.tBodies[0];
    var headers = table.tHead.rows[0].cells;
    var estado  = { col: -1, dir: 1 };

    function valor(row, col, tipo) {
        var cell = row.cells[col];
        if (!cell) return tipo === 'num' ? -Infinity : '';
        if (tipo === 'num') {
            var n = parseFloat(cell.textContent.trim().replace('%', '').replace(',', '.'));
            return isNaN(n) ? -Infinity : n; // "—" vai para o fim
        }
        var nome = cell.querySelector('.sc-pname');
        return (nome ? nome.textContent : cell.textContent).trim().toLowerCase();
    }

    function ordenar(col, tipo) {
        var dir = estado.col === col ? -estado.dir : (tipo === 'num' ? -1 : 1);
        estado = { col: col, dir: dir };

        Array.prototype.slice.call(tbody.rows)
            .sort(function (a, b) {
                var va = valor(a, col, tipo), vb = valor(b, col, tipo);
                return va < vb ? -dir : va > vb ? dir : 0;
            })
            .forEach(function (r, i) { tbody.appendChild(r); r.cells[0].textContent = i + 1; });

        Array.prototype.forEach.call(headers, function (h) {
            h.classList.remove('sc-sort-asc', 'sc-sort-desc');
            if (h.dataset.tipo) h.setAttribute('aria-sort', 'none');
        });
        headers[col].classList.add(dir > 0 ? 'sc-sort-asc' : 'sc-sort-desc');
        headers[col].setAttribute('aria-sort', dir > 0 ? 'ascending' : 'descending');
    }

    Array.prototype.forEach.call(headers, function (th, col) {
        var tipo = th.dataset.tipo;
        if (!tipo) return;
        th.classList.add('sc-th-sortable');
        th.tabIndex = 0;
        th.addEventListener('click', function () { ordenar(col, tipo); });
        th.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ordenar(col, tipo); }
        });
    });

    // Depois de buscar, a página abre já nos resultados (o formulário é longo)
    var res = document.getElementById('resultados');
    if (res) res.scrollIntoView({ block: 'start' });
})();
</script>

<script>
// ── Aba Comparar: seleção liga → time → jogador (ou busca por nome),
// até 3 jogadores, com radar/percentil/divisão/grupos/confrontos vindos
// de /Relatorios/ScoutCompararDados. ──────────────────────────────────
(function () {
    var mediaProxyBase = '@Url.Action("Imagem", "MediaProxy")';
    var estatisticasBase = '@Url.Action("Estatisticas", "Jogadores")';
    var ligasUrl = '@Url.Action("CompararLigas", "Jogadores")';
    var timesUrl = '@Url.Action("CompararTimes", "Jogadores")';
    var jogadoresListaUrl = '@Url.Action("CompararJogadoresLista", "Jogadores")';
    var compararDadosUrl = '@Url.Action("ScoutCompararDados", "Relatorios")';

    var CORES = ['#d4a520', '#38bdf8', '#f472b6']; // as mesmas do servidor
    var cmpIds = [];
    var cmpInfo = {};
    var cascataInit = false;
    var radarChart = null, percentilChart = null;
    var lastRadarData = null, lastPercentilData = null;

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
    }

    // ── Abas Buscar / Comparar ──────────────────────────────────────
    function showTab(nome) {
        var buscar = nome === 'buscar';
        document.getElementById('abaBuscar').style.display = buscar ? '' : 'none';
        document.getElementById('abaComparar').style.display = buscar ? 'none' : '';
        document.getElementById('tabBuscarBtn').classList.toggle('active', buscar);
        document.getElementById('tabCompararBtn').classList.toggle('active', !buscar);
        document.getElementById('tabBuscarBtn').setAttribute('aria-selected', buscar ? 'true' : 'false');
        document.getElementById('tabCompararBtn').setAttribute('aria-selected', buscar ? 'false' : 'true');
        if (!buscar) {
            initCascataOnce();
            if (radarChart) radarChart.resize();
            if (percentilChart) percentilChart.resize();
        }
    }
    document.getElementById('tabBuscarBtn').addEventListener('click', function () { showTab('buscar'); });
    document.getElementById('tabCompararBtn').addEventListener('click', function () { showTab('comparar'); });

    // ── Cascata liga → time → jogador ───────────────────────────────
    function initCascataOnce() {
        if (cascataInit) return;
        cascataInit = true;
        fetch(ligasUrl).then(function (r) { return r.json(); }).then(function (ligas) {
            var sel = document.getElementById('cmpLiga');
            (ligas || []).forEach(function (l) {
                var opt = document.createElement('option');
                opt.value = l.id; opt.textContent = l.nome;
                sel.appendChild(opt);
            });
        });
    }

    document.getElementById('cmpLiga').addEventListener('change', function () {
        var competicaoId = this.value;
        var timeSel = document.getElementById('cmpTime');
        timeSel.innerHTML = '<option value="">Todos os times</option>';
        document.getElementById('cmpJogador').innerHTML = '<option value="">Adicionar jogador…</option>';
        var url = timesUrl + (competicaoId ? ('?competicaoId=' + encodeURIComponent(competicaoId)) : '');
        fetch(url).then(function (r) { return r.json(); }).then(function (times) {
            (times || []).forEach(function (t) {
                var opt = document.createElement('option');
                opt.value = t.id; opt.textContent = t.nome;
                timeSel.appendChild(opt);
            });
        });
    });

    document.getElementById('cmpTime').addEventListener('change', function () {
        var timeId = this.value;
        var jogSel = document.getElementById('cmpJogador');
        jogSel.innerHTML = '<option value="">Adicionar jogador…</option>';
        if (!timeId) return;
        fetch(jogadoresListaUrl + '?timeId=' + encodeURIComponent(timeId)).then(function (r) { return r.json(); }).then(function (jogadores) {
            (jogadores || []).forEach(function (j) {
                var opt = document.createElement('option');
                opt.value = j.id;
                opt.textContent = j.nome + (j.posicao ? (' (' + j.posicao + ')') : '');
                opt.dataset.nome = j.nome;
                opt.dataset.posicao = j.posicao || '';
                opt.dataset.clube = j.clube || '';
                opt.dataset.fotoUrl = j.fotoUrl || '';
                opt.dataset.idade = j.idade || '';
                jogSel.appendChild(opt);
            });
        });
    });

    document.getElementById('cmpJogador').addEventListener('change', function () {
        var id = parseInt(this.value, 10);
        var opt = this.options[this.selectedIndex];
        var info = id ? {
            id: id, nome: opt.dataset.nome, posicao: opt.dataset.posicao, clube: opt.dataset.clube,
            fotoUrl: opt.dataset.fotoUrl, idade: opt.dataset.idade ? parseInt(opt.dataset.idade, 10) : undefined,
        } : null;
        this.value = '';
        if (info) addJogador(info);
    });

    // ── Busca por nome ───────────────────────────────────────────────
    var buscaInput = document.getElementById('cmpBusca');
    var buscaPanel = document.getElementById('cmpBuscaPanel');
    var buscaTimer = null;
    buscaInput.addEventListener('input', function () {
        var termo = this.value.trim();
        clearTimeout(buscaTimer);
        if (termo.length < 2) { buscaPanel.classList.remove('open'); buscaPanel.innerHTML = ''; return; }
        buscaTimer = setTimeout(function () {
            fetch(jogadoresListaUrl + '?nome=' + encodeURIComponent(termo)).then(function (r) { return r.json(); }).then(function (jogadores) {
                buscaPanel.innerHTML = '';
                if (!jogadores || !jogadores.length) { buscaPanel.classList.remove('open'); return; }
                jogadores.forEach(function (j) {
                    var opt = document.createElement('div');
                    opt.className = 'cmp-busca-opt';
                    opt.tabIndex = 0;
                    opt.setAttribute('role', 'button');
                    opt.innerHTML = '<span>' + escapeHtml(j.nome) + '</span>&nbsp;<small>' + escapeHtml(j.clube || '') + '</small>';
                    var escolher = function () {
                        addJogador(j);
                        buscaInput.value = '';
                        buscaPanel.classList.remove('open');
                        buscaPanel.innerHTML = '';
                    };
                    opt.addEventListener('click', escolher);
                    opt.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); escolher(); } });
                    buscaPanel.appendChild(opt);
                });
                buscaPanel.classList.add('open');
            });
        }, 300);
    });
    document.addEventListener('click', function (e) {
        if (!buscaInput.contains(e.target) && !buscaPanel.contains(e.target)) buscaPanel.classList.remove('open');
    });

    // ── Estado dos selecionados (até 3, mínimo 2 para comparar) ──────
    function addJogador(info) {
        if (cmpIds.indexOf(info.id) !== -1 || cmpIds.length >= 3) return;
        cmpIds.push(info.id);
        cmpInfo[info.id] = info;
        atualizarComparacao();
    }
    function removeJogador(id) {
        if (cmpIds.length === 2) return; // mínimo de 2 para manter a comparação
        cmpIds = cmpIds.filter(function (x) { return x !== id; });
        delete cmpInfo[id];
        atualizarComparacao();
    }

    function statBlock(v, l, cor) {
        return '<div><div class="cmp-card-stat-v"' + (cor ? (' style="color:' + cor + ';"') : '') + '>' +
            (v === undefined || v === null ? '—' : escapeHtml(v)) + '</div><div class="cmp-card-stat-l">' + l + '</div></div>';
    }

    function renderCards() {
        var cards = document.getElementById('cmpCards');
        cards.innerHTML = '';
        cmpIds.forEach(function (id, i) {
            var info = cmpInfo[id] || {};
            var cor = CORES[i];
            var div = document.createElement('div');
            div.className = 'cmp-card';
            div.style.borderTopColor = cor;
            var fotoHtml = info.fotoUrl
                ? '<img src="' + mediaProxyBase + '?url=' + encodeURIComponent(info.fotoUrl) + '" alt="" onerror="this.remove()">'
                : '';
            var statsHtml = '';
            if (info.jogos !== undefined) {
                statsHtml = '<div class="cmp-card-stats">' +
                    statBlock(info.jogos, 'Jogos') +
                    statBlock(info.gols, 'Gols') +
                    statBlock(info.assistencias, 'Assist.') +
                    statBlock(info.notaFmt, 'Nota', cor) +
                    '</div>';
            }
            var removivel = cmpIds.length !== 2;
            div.innerHTML =
                '<div class="cmp-card-photo">' + fotoHtml + '</div>' +
                '<div style="min-width:0;flex:1;">' +
                    '<a class="cmp-card-nome" href="' + estatisticasBase + '?id=' + id + '">' + escapeHtml(info.nome || '') + '</a>' +
                    '<div class="cmp-card-meta">' + escapeHtml(info.posicao || '') +
                        (info.idade ? (', ' + info.idade + ' anos') : '') +
                        (info.pais ? (', ' + escapeHtml(info.pais)) : '') + '</div>' +
                    '<div class="cmp-card-clube">' + escapeHtml(info.clube || '') + '</div>' +
                    statsHtml +
                '</div>' +
                (removivel ? '<button type="button" class="cmp-card-remove" data-id="' + id + '" aria-label="Tirar ' + escapeHtml(info.nome || '') + ' da comparação">Remover</button>' : '');
            cards.appendChild(div);
        });

        if (cmpIds.length < 3) {
            var ph = document.createElement('div');
            ph.className = 'cmp-card-placeholder';
            ph.textContent = cmpIds.length < 2
                ? 'Escolha um jogador nos campos acima'
                : 'Escolha mais um jogador acima para comparar os três';
            cards.appendChild(ph);
        }

        cards.querySelectorAll('.cmp-card-remove').forEach(function (btn) {
            btn.addEventListener('click', function () { removeJogador(parseInt(btn.dataset.id, 10)); });
        });
    }

    function renderTextoFuncoes(texto, chips) {
        document.getElementById('cmpTextoFuncoes').textContent = texto || '';
        var wrap = document.getElementById('cmpChips');
        wrap.innerHTML = '';
        (chips || []).forEach(function (c) {
            var span = document.createElement('span');
            span.className = 'cmp-chip';
            span.textContent = c;
            wrap.appendChild(span);
        });
    }

    function renderLegenda(jogadores) {
        document.getElementById('cmpLegenda').innerHTML = (jogadores || []).map(function (j) {
            return '<span class="cmp-legenda-item"><span class="cmp-legenda-dot" style="background:' + j.cor + ';"></span>' + escapeHtml(j.nome) + '</span>';
        }).join('');
    }

    function renderDivisao(divisao) {
        var wrap = document.getElementById('cmpDivisao');
        wrap.innerHTML = '';
        (divisao || []).forEach(function (m) {
            var row = document.createElement('div');
            row.className = 'cmp-divisao-row';
            var head = document.createElement('div');
            head.className = 'cmp-divisao-head';
            head.innerHTML = '<span>' + escapeHtml(m.label) + '</span><strong>' + escapeHtml(m.resumo) + '</strong>';
            var bar = document.createElement('div');
            bar.className = 'cmp-divisao-bar';
            (m.segmentos || []).forEach(function (s) {
                var seg = document.createElement('div');
                seg.style.width = s.pct + '%';
                seg.style.background = s.cor;
                seg.style.opacity = s.opacidade;
                bar.appendChild(seg);
            });
            row.appendChild(head);
            row.appendChild(bar);
            wrap.appendChild(row);
        });
    }

    function renderGrupos(grupos) {
        var panel = document.getElementById('cmpGruposPanel');
        panel.innerHTML = '';
        (grupos || []).forEach(function (g) {
            var block = document.createElement('div');
            block.style.marginBottom = '1.1rem';
            var titulo = document.createElement('div');
            titulo.className = 'cmp-grupo-titulo';
            titulo.textContent = g.titulo;
            block.appendChild(titulo);
            (g.metricas || []).forEach(function (m) {
                var row = document.createElement('div');
                row.className = 'cmp-metrica-row';
                var label = document.createElement('div');
                label.className = 'cmp-metrica-label';
                label.textContent = m.label;
                var linhasWrap = document.createElement('div');
                linhasWrap.className = 'cmp-metrica-linhas';
                (m.linhas || []).forEach(function (l) {
                    var linha = document.createElement('div');
                    linha.className = 'cmp-metrica-linha';
                    var track = document.createElement('div');
                    track.className = 'cmp-metrica-track';
                    var fill = document.createElement('div');
                    fill.className = 'cmp-metrica-fill';
                    fill.style.width = l.w + '%';
                    fill.style.background = l.cor;
                    fill.style.opacity = l.opacidade;
                    track.appendChild(fill);
                    var valor = document.createElement('div');
                    valor.className = 'cmp-metrica-valor';
                    valor.style.color = l.corTexto;
                    valor.textContent = l.txt;
                    linha.appendChild(track);
                    linha.appendChild(valor);
                    linhasWrap.appendChild(linha);
                });
                row.appendChild(label);
                row.appendChild(linhasWrap);
                block.appendChild(row);
            });
            panel.appendChild(block);
        });
    }

    function renderConfrontos(confrontos) {
        var panel = document.getElementById('cmpConfrontosPanel');
        var body = document.getElementById('cmpConfrontosBody');
        if (!confrontos || !confrontos.length) {
            panel.style.display = 'none';
            body.innerHTML = '';
            return;
        }
        panel.style.display = '';
        body.innerHTML = confrontos.map(function (c) {
            return '<tr>' +
                '<td class="sc-txt" style="color:var(--text-muted);white-space:nowrap;">' + escapeHtml(c.data) + '</td>' +
                '<td class="sc-txt">' + escapeHtml(c.competicao) + '</td>' +
                '<td class="sc-txt" style="font-weight:600;color:var(--text-strong);">' + escapeHtml(c.partida) + '</td>' +
                '<td class="sc-txt" style="color:var(--text-2);">' + escapeHtml(c.participacoes) + '</td>' +
                '<td style="text-align:right;font-weight:700;color:var(--text-2);">' + escapeHtml(c.notas) + '</td>' +
                '</tr>';
        }).join('');
    }

    function temaAtual() {
        var escuro = document.documentElement.getAttribute('data-theme') === 'dark';
        return {
            grid: escuro ? '#333' : '#e5e7eb',
            gridFina: escuro ? '#2a2a2a' : '#f0f0f0',
            rotulo: escuro ? '#cbd5e1' : '#374151',
            tick: '#9ca3af',
        };
    }

    function renderCharts(radar, percentil) {
        lastRadarData = radar; lastPercentilData = percentil;
        if (typeof Chart === 'undefined') return;
        var c = temaAtual();
        if (radarChart) { radarChart.destroy(); radarChart = null; }
        if (percentilChart) { percentilChart.destroy(); percentilChart = null; }

        radarChart = new Chart(document.getElementById('cmpRadarCanvas'), {
            type: 'radar',
            data: {
                labels: radar.labels,
                datasets: radar.datasets.map(function (d) {
                    return { label: d.label, data: d.data, borderColor: d.cor, backgroundColor: d.cor + '26', pointBackgroundColor: d.cor, borderWidth: 2, pointRadius: 3 };
                }),
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: false,
                scales: { r: { min: 0, max: 100, ticks: { display: false, stepSize: 25 }, grid: { color: c.grid }, angleLines: { color: c.grid }, pointLabels: { color: c.rotulo, font: { size: 11, family: 'Barlow' } } } },
                plugins: { legend: { position: 'bottom', labels: { color: c.rotulo, boxWidth: 10, font: { size: 11, family: 'Barlow' } } } },
            },
        });

        percentilChart = new Chart(document.getElementById('cmpPercentilCanvas'), {
            type: 'bar',
            data: {
                labels: percentil.labels,
                datasets: percentil.datasets.map(function (d) {
                    return { label: d.label, data: d.data, backgroundColor: d.cor, borderRadius: 3, barPercentage: 0.8, categoryPercentage: 0.7 };
                }),
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false, animation: false,
                scales: {
                    x: { min: 0, max: 100, grid: { color: c.gridFina }, ticks: { color: c.tick, font: { size: 10, family: 'Barlow' } } },
                    y: { grid: { display: false }, ticks: { color: c.rotulo, font: { size: 11, family: 'Barlow' } } },
                },
                plugins: { legend: { position: 'bottom', labels: { color: c.rotulo, boxWidth: 10, font: { size: 11, family: 'Barlow' } } } },
            },
        });
    }

    function atualizarComparacao() {
        renderCards();
        if (cmpIds.length < 2) {
            document.getElementById('cmpVazio').style.display = '';
            document.getElementById('cmpResultado').style.display = 'none';
            return;
        }
        document.getElementById('cmpVazio').style.display = 'none';
        var qs = cmpIds.map(function (id) { return 'ids=' + id; }).join('&');
        var temporada = document.getElementById('cmpTemporada').value;
        if (temporada) qs += '&temporada=' + encodeURIComponent(temporada);
        fetch(compararDadosUrl + '?' + qs).then(function (r) { return r.json(); }).then(function (data) {
            if (data.error) { document.getElementById('cmpResultado').style.display = 'none'; return; }
            data.jogadores.forEach(function (j) {
                cmpInfo[j.id] = Object.assign({}, cmpInfo[j.id] || {}, j);
            });
            renderCards();
            document.getElementById('cmpResultado').style.display = '';
            renderTextoFuncoes(data.textoFuncoes, data.prioridades);
            renderLegenda(data.jogadores);
            renderDivisao(data.divisao);
            renderGrupos(data.grupos);
            renderConfrontos(data.confrontos);
            renderCharts(data.radar, data.percentil);
        });
    }

    document.getElementById('cmpExportar').addEventListener('click', function () { window.print(); });

    document.getElementById('cmpTemporada').addEventListener('change', function () { atualizarComparacao(); });

    new MutationObserver(function () {
        if (lastRadarData && lastPercentilData) renderCharts(lastRadarData, lastPercentilData);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>
