@model ControleFutebolWeb.Models.Time
@{ ViewData["Title"] = $"Editar {Model.Nome}"; }

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-card.css" asp-append-version="true" />

<style>
    .te-escudo { display: flex; align-items: center; gap: 16px; }
    .te-escudo-img {
        width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; background: #fff; padding: 6px;
        display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--line-strong);
    }
    .te-escudo-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .te-escudo-img span { font-size: .78rem; color: #888; text-align: center; }
    .te-escudo .af-input { padding: .5rem .6rem; }
</style>

<div class="af">
    <div class="af-card">
        <a asp-action="Details" asp-route-id="@Model.Id" class="af-voltar">@Model.Nome</a>
        <h1 class="af-title">Editar time</h1>
        <div class="af-sub">
            Os times chegam pela importação das competições. Aqui dá para corrigir nome e cidade,
            trocar o escudo e guardar o link do Transfermarkt.
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="af-alerta" style="margin-bottom:1rem;"></div>
            <input type="hidden" asp-for="Id" />

            <div class="af-field">
                <label class="af-label" for="Nome">Nome</label>
                <input asp-for="Nome" class="af-input" required autofocus />
                <span asp-validation-for="Nome" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="Cidade">Cidade</label>
                <input asp-for="Cidade" class="af-input" required />
                <span asp-validation-for="Cidade" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="LinkTransfermarket">Link do Transfermarkt <small>(opcional)</small></label>
                <input asp-for="LinkTransfermarket" class="af-input" placeholder="https://www.transfermarkt.com.br/..." />
                <span asp-validation-for="LinkTransfermarket" class="af-validation"></span>
            </div>

            <div class="af-field">
                <label class="af-label" for="escudoFile">Escudo</label>
                <div class="te-escudo">
                    <div class="te-escudo-img">
                        @if (!string.IsNullOrEmpty(Model.EscudoUrl))
                        {
                            <img id="escudoPreview" src="@Url.Action("Imagem", "MediaProxy", new { url = Model.EscudoUrl })" alt="Escudo atual" />
                        }
                        else
                        {
                            <img id="escudoPreview" alt="Novo escudo" style="display:none" />
                            <span id="escudoVazio">Sem escudo</span>
                        }
                    </div>
                    <div style="flex:1;min-width:0">
                        <input type="file" id="escudoFile" name="escudoFile" class="af-input" accept="image/*" />
                        <div class="af-hint">Escolha uma imagem só se quiser trocar o escudo atual.</div>
                    </div>
                </div>
            </div>

            <div class="af-actions">
                <button type="submit" class="af-save">Salvar alterações</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="af-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostra o escudo escolhido antes de salvar
        (function () {
            var input = document.getElementById('escudoFile');
            var img = document.getElementById('escudoPreview');
            var vazio = document.getElementById('escudoVazio');
            if (!input || !img) return;
            input.addEventListener('change', function () {
                var f = input.files && input.files[0];
                if (!f) return;
                img.src = URL.createObjectURL(f);
                img.style.display = '';
                if (vazio) vazio.remove();
            });
        })();
    </script>
}
