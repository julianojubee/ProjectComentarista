</div>

<!-- ══ TRANSFERÊNCIAS ═══════════════════════════════════════════════════════
     Chegadas e saídas do clube, vindas de /transfers?team=X da api-football
     (via /Times/TransferenciasApi). A API devolve o histórico inteiro do clube,
     sem filtro de data; o recorte por temporada é feito no servidor. A janela
     muda de país para país: no Brasil a temporada é o ano civil, na Europa vai
     de julho a junho — por isso os dois formatos ficam à escolha, com o padrão
     sugerido pelo país do clube na API. -->
@{
    // Países em que a temporada é o ano civil; o resto assume julho→junho.
    var paisesAnoCivil = new[] { "Brazil", "Argentina", "Colombia", "Chile", "Peru",
        "Ecuador", "Uruguay", "Paraguay", "Venezuela", "Bolivia", "USA", "Japan",
        "South-Korea", "China", "Norway", "Sweden", "Finland", "Ireland", "Iceland" };
    var janelaPadrao = string.IsNullOrWhiteSpace(Model.Time.PaisApi)
        || paisesAnoCivil.Contains(Model.Time.PaisApi, StringComparer.OrdinalIgnoreCase)
            ? "civil" : "europeia";
    var temporadaTransf = Model.CompeticoesApi.Any()
        ? Model.CompeticoesApi.First().Season
        : DateTime.Now.Year;
}
<style>
    .trf-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @@media (max-width: 900px) { .trf-cols { grid-template-columns: 1fr; } }
    .trf-col-head {
        display: flex; align-items: center; gap: .4rem; font-size: .75rem;
        font-weight: 800; text-transform: uppercase; letter-spacing: .04em;
        padding-bottom: .4rem; margin-bottom: .5rem; border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .trf-col-head .trf-qtd { margin-left: auto; color: var(--text-muted); font-weight: 700; }
    .trf-in  { color: #4ade80; }
    .trf-out { color: #f87171; }
    .trf-item {
        display: flex; align-items: center; gap: .55rem;
        padding: .45rem .3rem; border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .trf-foto {
        width: 30px; height: 30px; border-radius: 50%; object-fit: cover;
        background: rgba(255,255,255,.05); flex: 0 0 auto;
    }
    .trf-nome { font-size: .82rem; font-weight: 700; }
    .trf-nome a { color: inherit; text-decoration: none; }
    .trf-nome a:hover { color: var(--gold-ink); }
    .trf-sub { font-size: .7rem; color: var(--text-muted); display: flex; align-items: center; gap: .25rem; }
    .trf-sub img { width: 14px; height: 14px; object-fit: contain; }
    .trf-meta { margin-left: auto; text-align: right; flex: 0 0 auto; }
    .trf-tipo {
        display: inline-block; font-size: .66rem; font-weight: 800; padding: .1rem .4rem;
        border-radius: 4px; background: rgba(212,165,32,.14); color: var(--gold-ink);
    }
    .trf-data { display: block; font-size: .66rem; color: var(--text-muted); margin-top: .15rem; }
    .trf-vazio { color: var(--text-muted); font-size: .78rem; padding: .6rem .3rem; }
    /* Selo do que a sincronização fez com este movimento no cadastro. */
    .trf-selo { display: inline-block; font-size: .62rem; font-weight: 800; padding: .05rem .35rem; border-radius: 4px; }
    .trf-selo.aplicada { background: rgba(74,222,128,.16); color: #4ade80; }
    .trf-selo.pendente { background: rgba(248,113,113,.14); color: #f87171; }
    .trf-selo.anterior { background: rgba(255,255,255,.06); color: var(--text-muted); }
    .trf-item.aplicada { background: rgba(74,222,128,.06); }
    .trf-resumo { font-size: .75rem; color: var(--text-muted); margin-bottom: .7rem; }
    .trf-resumo b { color: var(--gold-ink); }
</style>
<div id="painel-transferencias" style="margin-top:1rem;">
    <div class="est-panel">
        <button type="button" class="acc-header" onclick="toggleAccordion(this)">
            <span class="acc-chevron">▸</span>
            <span class="acc-title">🔁 Transferências</span>
            <span class="acc-meta" id="trf-meta">chegadas e saídas da temporada</span>
        </button>
        <div class="acc-body" hidden>
            <!-- A busca sincroniza o cadastro (POST), por isso o token. -->
            <form id="trf-form" style="display:none;">@Html.AntiForgeryToken()</form>
            <div class="est-filtros">
                <div>
                    <label class="est-label" for="trf-season">Temporada</label>
                    <input id="trf-season" class="est-input" type="number" style="width:100px;" value="@temporadaTransf" />
                </div>
                <div>
                    <label class="est-label" for="trf-janela">Janela</label>
                    <select id="trf-janela" class="est-input" style="min-width:190px;">
                        <option value="civil" selected="@(janelaPadrao == "civil")">Ano civil (jan–dez)</option>
                        <option value="europeia" selected="@(janelaPadrao == "europeia")">Europeia (jul–jun)</option>
                    </select>
                </div>
                <button type="button" class="est-buscar" onclick="Transferencias.buscar()">🔍 Buscar e sincronizar</button>
            </div>

            <div id="trf-loading" style="display:none;color:var(--text-muted);text-align:center;padding:1rem">Buscando transferências...</div>
            <div id="trf-erro" style="display:none;color:var(--bad-2);padding:.5rem 0"></div>

            <div id="trf-result" style="display:none;">
                <div class="trf-resumo" id="trf-resumo"></div>
                <div class="trf-cols">
                    <div>
                        <div class="trf-col-head trf-in">⬅ Chegadas <span class="trf-qtd" id="trf-qtd-in"></span></div>
                        <div id="trf-lista-in"></div>
                    </div>
                    <div>
                        <div class="trf-col-head trf-out">➡ Saídas <span class="trf-qtd" id="trf-qtd-out"></span></div>
                        <div id="trf-lista-out"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Painel de transferências: uma chamada ao servidor por temporada/janela.
var Transferencias = (function () {
    const TIME_ID = @Model.Time.Id;

    function esc(t) {
        return String(t ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // "aplicada" = o cadastro acabou de mudar; "sem-cadastro"/"sem-clube" = não deu
    // para aplicar. O resto já batia com a API e fica só para conferência.
    function selo(t) {
        if (t.situacao === 'aplicada')
            return `<span class="trf-selo aplicada" title="${esc(t.motivo || '')}">✓ aplicada</span>`;
        if (t.situacao === 'sem-cadastro' || t.situacao === 'sem-clube')
            return `<span class="trf-selo pendente" title="${esc(t.motivo || '')}">não aplicada</span>`;
        if (t.situacao === 'criado')
            return `<span class="trf-selo aplicada" title="${esc(t.motivo || '')}">✓ jogador criado</span>`;
        if (t.situacao === 'anterior')
            return `<span class="trf-selo anterior" title="${esc(t.motivo || '')}">movimento anterior</span>`;
        return '';
    }

    function item(t, chegada) {
        const foto = t.fotoUrl
            ? `<img class="trf-foto" src="${esc(t.fotoUrl)}" alt="">`
            : `<div class="trf-foto"></div>`;
        const nome = t.jogadorId
            ? `<a href="/Jogadores/Estatisticas/${t.jogadorId}">${esc(t.jogador)}</a>`
            : esc(t.jogador);
        const logo = t.clubeLogo ? `<img src="${esc(t.clubeLogo)}" alt="">` : '';
        const seta = chegada ? 'de' : 'para';
        const destacar = t.situacao === 'aplicada' || t.situacao === 'criado';
        return `<div class="trf-item ${destacar ? 'aplicada' : ''}">
            ${foto}
            <div>
                <div class="trf-nome">${nome}${t.posicao ? ` <span class="trf-sub">· ${esc(t.posicao)}</span>` : ''}</div>
                <div class="trf-sub">${seta} ${logo} ${esc(t.clube)} ${selo(t)}</div>
            </div>
            <div class="trf-meta">
                <span class="trf-tipo">${esc(t.tipo)}</span>
                <span class="trf-data">${esc(t.data)}</span>
            </div>
        </div>`;
    }

    function lista(el, dados, chegada) {
        document.getElementById(el).innerHTML = dados.length
            ? dados.map(t => item(t, chegada)).join('')
            : '<div class="trf-vazio">Nenhum movimento registrado nesta janela.</div>';
    }

    async function buscar() {
        const season = document.getElementById('trf-season').value;
        const janela = document.getElementById('trf-janela').value;
        const loading = document.getElementById('trf-loading');
        const erro = document.getElementById('trf-erro');
        const resultado = document.getElementById('trf-result');

        loading.style.display = 'block';
        erro.style.display = 'none';
        resultado.style.display = 'none';

        try {
            const corpo = new FormData();
            corpo.append('timeId', TIME_ID);
            corpo.append('season', season);
            corpo.append('janela', janela);
            corpo.append('__RequestVerificationToken',
                document.querySelector('#trf-form input[name="__RequestVerificationToken"]').value);

            const res = await fetch('/Times/TransferenciasApi', { method: 'POST', body: corpo });
            const dados = await res.json();
            loading.style.display = 'none';

            if (dados.erro) {
                erro.textContent = dados.erro;
                erro.style.display = 'block';
                return;
            }

            lista('trf-lista-in', dados.chegadas, true);
            lista('trf-lista-out', dados.saidas, false);
            document.getElementById('trf-qtd-in').textContent = dados.chegadas.length;
            document.getElementById('trf-qtd-out').textContent = dados.saidas.length;
            document.getElementById('trf-meta').textContent =
                `${dados.periodo} · ${dados.chegadas.length} chegada(s), ${dados.saidas.length} saída(s)`;
            const mexeu = dados.aplicadas || dados.jogadoresCriados || dados.clubesCriados;
            document.getElementById('trf-resumo').innerHTML = mexeu
                ? `<b>${dados.aplicadas}</b> transferência(s) aplicada(s) no cadastro` +
                  (dados.jogadoresCriados ? ` · <b>${dados.jogadoresCriados}</b> jogador(es) criado(s)` : '') +
                  (dados.clubesCriados ? ` · <b>${dados.clubesCriados}</b> clube(s) criado(s)` : '') +
                  ` · veja o histórico na <a href="/Transferencias?timeId=${TIME_ID}">Janela de Transferências</a>.`
                : 'Cadastro já em dia com a API — nada a aplicar, só conferência.';
            resultado.style.display = 'block';
        } catch (e) {
            loading.style.display = 'none';
            erro.textContent = 'Erro ao buscar transferências.';
            erro.style.display = 'block';
        }
    }

    return { buscar };
})();
</script>

<!-- ══ ESTATÍSTICAS DO ELENCO ═══════════════════════════════════════════════
     Tudo o que EstatisticaJogador guarda (minutos, finalizações, passes-chave,
     duelos, dribles, desarmes/interceptações/bloqueios, faltas, cartões,
     defesas), agregado por jogador nos jogos já realizados do time, mais a nota
     média calculada pelo sistema (a coluna "Nota"). Quase todo
     ranking é normalizado por 90 minutos — é a única forma justa de comparar um
     titular absoluto com quem só entra no segundo tempo. Monta em
     TimesController.Details / MontarResumoElenco. -->
