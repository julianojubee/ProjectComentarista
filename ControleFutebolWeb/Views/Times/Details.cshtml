                    </select>
                </div>

                <button type="button" class="est-buscar" onclick="buscarEstatisticasApi()">🔍 Buscar</button>
            </div>

            <div id="estat-loading" style="display:none;color:var(--text-muted);text-align:center;padding:1rem">Buscando estatísticas...</div>
            <div id="estat-erro"    style="display:none;color:var(--bad-2);padding:.5rem 0"></div>

            <div id="estat-result" style="display:none;">
                <div class="est-tabs" id="est-tabs">
                    <button type="button" class="ativo" data-tab="resultados">Resultados</button>
                    <button type="button" data-tab="gols">Gols</button>
                    <button type="button" data-tab="disciplina">Disciplina</button>
                    <button type="button" data-tab="tatico">Tático</button>
