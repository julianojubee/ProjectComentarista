                        <button type="button" data-escopo="casa">🏠 Casa</button>
                        <button type="button" data-escopo="fora">✈️ Fora</button>
                    </div>
                </div>

                <div>
                    <label class="est-label" for="est-comparativo">Comparar com</label>
                    <select id="est-comparativo" class="est-input" style="min-width:170px;">
