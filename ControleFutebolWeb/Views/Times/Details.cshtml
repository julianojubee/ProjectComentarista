@model ControleFutebolWeb.Models.TimeDetalhesViewModel
@using ControleFutebolWeb.Helpers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = Model.Time.Nome;

    // Forma recente do time (últimos 5 jogos finalizados) — usada no hero.
    var formaTime = Model.Jogos
        .Where(j => j.PlacarCasa.HasValue && j.PlacarVisitante.HasValue && j.Data < DateTime.Now)
        .OrderByDescending(j => j.Data)
        .Take(5)
        .Select(j =>
        {
            bool vitoria = (Model.Time.Id == j.TimeCasaId && j.PlacarCasa > j.PlacarVisitante) ||
                           (Model.Time.Id == j.TimeVisitanteId && j.PlacarVisitante > j.PlacarCasa);
            bool empate = j.PlacarCasa == j.PlacarVisitante;
            return vitoria ? "V" : empate ? "E" : "D";
        })
        .ToList();

    string CorForma(string r) => r switch { "V" => "#22c55e", "D" => "#ef4444", _ => "var(--text-dim)" };

    int totalPartidas = Model.Jogos.Count(j => j.PlacarCasa.HasValue && j.PlacarVisitante.HasValue);
}

<link rel="stylesheet" href="~/fonts/barlow/barlow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/jogadas.css" asp-append-version="true" />

<style>
    body {
        background-image: url('@Url.Content(Model.Time.BackgroundUrl)');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.55);
        z-index: -1;
    }

    .ctd * { box-sizing: border-box; }

    .ctd {
        margin: 0 -12px;
        background: var(--p-0);
        color: var(--text);
        font-family: 'Barlow', Arial, sans-serif;
        border-radius: 14px;
        overflow: hidden;
    }

    .ctd a { text-decoration: none; color: inherit; }
    .ctd h1 { font-family: 'Barlow Condensed', Arial, sans-serif; }

    /* ── Hero ────────────────────────────────────── */
    .ctd-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #0a1628 0%, #1a2f4e 55%, #0a1628 100%);
        padding: 2.2rem 2.5rem 1.8rem;
    }

    .ctd-hero-pattern {
        position: absolute; inset: 0; width: 100%; height: 100%;
        object-fit: cover; opacity: 0.06; pointer-events: none;
    }

    .ctd-hero-stripe { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #d4a520; }

    .ctd-hero-row {
        position: relative; z-index: 1;
        display: flex; align-items: flex-start; gap: 24px; flex-wrap: wrap;
    }

    .ctd-badge-lg {
        width: 84px; height: 84px; border-radius: 50%;
        background: rgba(255,255,255,0.07); border: 2px solid rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;
    }

    .ctd-badge-lg img { width: 82%; height: 82%; object-fit: contain; }
    .ctd-badge-lg span { font-size: 1.4rem; font-weight: 700; color: var(--text-muted); }

    .ctd-info { flex: 1; min-width: 200px; padding-top: 2px; }

    .ctd-name-row { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; flex-wrap: wrap; }
    .ctd-name-row h1 { font-size: 2.4rem; font-weight: 800; color: var(--text-strong); margin: 0; line-height: 1; }

    .ctd-formacao-badge {
        background: rgba(212,165,32,0.16); border: 1px solid rgba(212,165,32,0.4);
        color: #eecb6c; font-size: 0.66rem; font-weight: 700; padding: 3px 10px;
        border-radius: 6px; letter-spacing: 0.08em;
    }

    .ctd-cidade { display: flex; align-items: center; gap: 5px; margin-bottom: 14px; }
    .ctd-cidade span { font-size: 0.8rem; color: var(--text-muted); }
    .ctd-estadio { display: inline-flex; align-items: center; gap: 5px; }
    .ctd-estadio::before { content: "·"; margin-right: 3px; color: var(--text-muted); }

    .ctd-meta-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .ctd-meta-label {
        font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em;
        color: var(--text-dim); text-transform: uppercase;
    }
    .ctd-forma-dot {
        display: inline-flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 4px; color: #fff;
        font-size: 9px; font-weight: 800; flex-shrink: 0;
    }
    .ctd-meta-sep { width: 1px; height: 16px; background: rgba(255,255,255,0.14); margin: 0 2px; }
    .ctd-meta-info { font-size: 0.75rem; color: var(--text-muted); }

    /* Troféus — uma taça por competição/temporada conquistada */
    .ctd-titulos { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
    .ctd-titulo {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
        background: rgba(212,165,32,0.14); border: 1px solid rgba(212,165,32,0.34);
        border-radius: 8px; font-size: 0.74rem; font-weight: 700; color: #eecb6c;
    }
    .ctd-titulo img { width: 16px; height: 16px; object-fit: contain; }
    .ctd-titulo-temporada { color: rgba(255,255,255,0.62); font-weight: 600; }

    .ctd-treinador {
        background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px; padding: 12px 16px; min-width: 190px; flex-shrink: 0;
    }
    .ctd-treinador-label {
        font-size: 0.58rem; font-weight: 700; letter-spacing: 0.16em;
        color: var(--text-dim); text-transform: uppercase; margin-bottom: 8px;
    }
    .ctd-treinador-row { display: flex; align-items: center; gap: 10px; }
    .ctd-treinador-foto {
        width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
        border: 2px solid rgba(255,255,255,0.3); flex-shrink: 0;
    }
    .ctd-treinador-placeholder {
        width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.1);
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;
    }
    .ctd-treinador-nome { font-size: 0.86rem; font-weight: 700; color: var(--text-strong); }
    .ctd-treinador-nac { font-size: 0.7rem; color: var(--text-muted); }
    .ctd-treinador-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .ctd-treinador-edit-btn {
        background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 0.8rem;
        padding: 0; line-height: 1;
    }
    .ctd-treinador-edit-btn:hover { color: var(--gold-ink); }
    .ctd-treinador-editar-link {
        display: block; margin-top: 6px; font-size: 0.66rem; color: var(--text-dim); font-weight: 700;
    }
    .ctd-treinador-editar-link:hover { color: var(--gold-ink); }
    .ctd-treinador-vazio { font-size: 0.78rem; color: var(--text-dim); padding: 4px 0 2px; }
    .ctd-treinador-vincular-btn {
        display: inline-block; margin-top: 6px; font-size: 0.7rem; font-weight: 700; color: var(--gold-ink);
        background: none; border: none; padding: 0; cursor: pointer;
    }
    .ctd-treinador-vincular-btn:hover { color: var(--gold-ink); }

    /* ── Modal treinador (sobrescreve tema claro do Bootstrap) ─── */
    #treinadorModal .modal-content { background: var(--p-1); color: var(--text); border: 1px solid var(--line); }
    #treinadorModal .modal-header, #treinadorModal .modal-footer { border-color: var(--line); }
    #treinadorModal .nav-tabs { border-color: var(--line); }
    #treinadorModal .nav-tabs .nav-link { color: var(--text-muted); border: none; }
    #treinadorModal .nav-tabs .nav-link.active { color: var(--gold-ink); background: transparent; border-bottom: 2px solid #d4a520; }
    #treinadorModal .form-label { font-size: 0.78rem; color: var(--text-muted); font-weight: 700; }
    #treinadorModal .form-control, #treinadorModal .form-select {
        background: var(--p-0); border: 1px solid var(--line); color: var(--text);
    }
    #treinadorModal .form-control:focus, #treinadorModal .form-select:focus {
        background: var(--p-0); color: var(--text); border-color: #d4a520; box-shadow: none;
    }

    .ctd-actions { display: flex; flex-direction: column; gap: 7px; flex-shrink: 0; }
    .ctd-action-btn {
        display: flex; align-items: center; gap: 7px; padding: 8px 14px;
        background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px; color: #c9c5bb; font-size: 0.78rem; font-weight: 700; white-space: nowrap;
    }
    .ctd-action-btn:hover { border-color: #d4a520; color: var(--gold-ink); }
    .ctd-action-btn.primary { background: rgba(212,165,32,0.14); border-color: rgba(212,165,32,0.32); color: var(--gold-ink); }
    .ctd-action-btn.primary:hover { background: rgba(212,165,32,0.24); color: var(--gold-ink); }

    /* ── Grid principal ──────────────────────────── */
    .ctd-grid {
        padding: 26px 2.5rem 3rem;
        display: grid;
        grid-template-columns: 280px 1fr 320px;
        gap: 22px;
        align-items: start;
    }

    @@media (max-width: 1100px) {
        .ctd-grid { grid-template-columns: 1fr; }
    }

    .ctd-col-title { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .ctd-col-title span {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 0.72rem; font-weight: 700;
        letter-spacing: 0.16em; color: var(--text-dim); text-transform: uppercase; white-space: nowrap;
    }
    .ctd-col-title .line { flex: 1; height: 1px; background: var(--p-3); }
    .ctd-col-title .cnt { font-size: 0.68rem; color: var(--text-dimmer); font-weight: 600; }
    .ctd-col-title a { font-size: 0.7rem; color: var(--gold-ink); font-weight: 700; white-space: nowrap; }
    .ctd-col-title a:hover { color: var(--gold-ink); }

    /* ── Elenco ──────────────────────────────────── */
    .ctd-elenco-panel {
        background: var(--p-1); border: 1px solid var(--line); border-radius: 12px;
        overflow: hidden; max-height: 560px; overflow-y: auto;
    }

    .jogador-row {
        display: flex; align-items: center; gap: 10px; padding: 9px 14px;
        border-bottom: 1px solid var(--line-soft); cursor: grab; transition: background 0.12s;
    }
    .jogador-row:hover { background: var(--p-3); }
    .jogador-row.usado { display: none; }
    /* Escondido pela busca/filtro de posição — separado de .usado (escalação) para
       que os dois critérios não se atrapalhem. */
    .jogador-row.filtrado { display: none; }

    .ctd-elenco-filtros { display: flex; gap: 8px; margin-bottom: 10px; }
    .ctd-elenco-filtros .busca { flex: 1; min-width: 0; }
    .ctd-elenco-input {
        width: 100%; background: var(--p-2); border: 1px solid var(--line); border-radius: 8px;
        color: var(--text); font-size: 0.8rem; padding: 8px 11px; outline: none;
    }
    .ctd-elenco-input:focus { border-color: var(--line-strong); }
    .ctd-elenco-input::placeholder { color: var(--text-dimmer); }
    .ctd-elenco-vazio {
        padding: 18px 14px; text-align: center; font-size: 0.78rem; color: var(--text-dim);
    }

    .ctd-num {
        width: 28px; height: 28px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0;
    }

    .ctd-jog-foto {
        width: 30px; height: 30px; border-radius: 50%; object-fit: cover;
        background: var(--p-0); border: 1px solid var(--line-strong); flex-shrink: 0;
    }

    .ctd-jog-info { flex: 1; min-width: 0; }
    .ctd-jog-nome {
        font-size: 0.82rem; font-weight: 600; color: var(--text);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ctd-jog-pos {
        font-size: 0.62rem; color: var(--text-dim); font-weight: 700;
        letter-spacing: 0.08em; text-transform: uppercase; margin-top: 1px;
        display: flex; align-items: center; gap: 5px;
    }
    .ctd-jog-clube { display: inline-flex; align-items: center; gap: 4px; color: rgba(255,255,255,0.5); }
    .ctd-jog-clube img { width: 13px; height: 13px; object-fit: contain; }

    .ctd-stats-link {
        font-size: 0.62rem; padding: 3px 8px; background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.22); color: var(--ok); border-radius: 5px;
        font-weight: 700; flex-shrink: 0;
    }
    .ctd-stats-link:hover { background: rgba(34,197,94,0.2); color: var(--ok); }

    /* ── Escalação ───────────────────────────────── */
    .ctd-form-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
    .ctd-select {
        appearance: none; background: var(--p-2); border: 1px solid var(--line); border-radius: 8px;
        color: var(--text); font-size: 0.84rem; padding: 9px 12px; cursor: pointer; outline: none;
    }
    .ctd-btn {
        padding: 9px 16px; border-radius: 8px; font-size: 0.82rem; font-weight: 700;
        border: none; cursor: pointer; letter-spacing: 0.02em;
    }
    .ctd-btn-gold { background: #d4a520; color: #141414; }
    .ctd-btn-gold:hover { background: #c49918; }
    .ctd-btn-green { background: #16a34a; color: #fff; }
    .ctd-btn-green:hover { background: #15803d; }

    .ctd-campo-wrap { max-width: 320px; margin: 0 auto; }

    /* Campo desenhado (linhas em CSS), em vez da imagem /images/campo.png usada
       nas outras telas — só nesta página, por isso a classe própria .ctd-campo. */
    .ctd-campo {
        position: relative; aspect-ratio: 2/3; max-width: 100%; height: auto;
        background: linear-gradient(180deg, #14532d 0%, #166534 100%);
        border: 2px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden;
    }
    .ctd-campo-linha-meio { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(255,255,255,.22); pointer-events: none; }
    .ctd-campo-circulo {
        position: absolute; left: 50%; top: 50%; width: 22%; aspect-ratio: 1;
        border: 1.5px solid rgba(255,255,255,.2); border-radius: 50%;
        transform: translate(-50%, -50%); pointer-events: none;
    }
    .ctd-campo-area { position: absolute; left: 20%; right: 20%; height: 14%; border: 1.5px solid rgba(255,255,255,.2); pointer-events: none; }
    .ctd-campo-area.topo { border-top: none; top: -1px; }
    .ctd-campo-area.base { border-bottom: none; bottom: -1px; }
    .ctd-campo-gol {
        position: absolute; left: 30%; right: 30%; height: 6%;
        border: 1.5px solid rgba(255,255,255,.2); background: rgba(255,255,255,.04); pointer-events: none;
    }
    .ctd-campo-gol.topo { border-top: none; top: -1px; }
    .ctd-campo-gol.base { border-bottom: none; bottom: -1px; }

    .posicao-drop {
        position: absolute; text-align: center; cursor: grab; color: white;
        font-size: 11px; text-shadow: 1px 1px 2px black; transform: translate(-50%, -50%);
    }
    .posicao-drop * { pointer-events: none; }

    /* ── Partidas ────────────────────────────────── */
    .ctd-partidas-list { display: flex; flex-direction: column; gap: 10px; max-height: 560px; overflow-y: auto; }

    .ctd-match-card {
        background: var(--p-1); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px;
        transition: border-color 0.15s;
    }
    .ctd-match-card:hover { border-color: #383838; }

    .ctd-match-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; }
    .ctd-match-comp {
        display: flex; align-items: center; gap: 5px; font-size: 0.64rem; font-weight: 700;
        color: var(--gold-ink); text-transform: uppercase; letter-spacing: 0.06em;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
    }
    .ctd-match-comp img { width: 14px; height: 14px; object-fit: contain; border-radius: 50%; flex-shrink: 0; }
    .ctd-match-date { font-size: 0.64rem; color: var(--text-dimmer); flex-shrink: 0; white-space: nowrap; }

    .ctd-match-teams { display: flex; align-items: center; gap: 8px; }
    .ctd-match-team { display: flex; align-items: center; gap: 5px; flex: 1; min-width: 0; }
    .ctd-match-team img { width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; }
    .ctd-match-team span {
        font-size: 0.78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .ctd-match-team.right { justify-content: flex-end; }

    .ctd-match-score {
        font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.2rem; font-weight: 800;
        color: var(--text-strong); background: var(--p-0); padding: 2px 10px; border-radius: 6px;
        flex-shrink: 0; letter-spacing: 0.06em; white-space: nowrap;
    }

    .ctd-match-footer {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--line-soft);
    }
    .ctd-result-badge {
        color: #fff; border-radius: 4px; width: 20px; height: 20px; display: inline-flex;
        align-items: center; justify-content: center; font-size: 9px; font-weight: 800; flex-shrink: 0;
    }
    .ctd-status-badge {
        font-size: 0.62rem; font-weight: 700; padding: 2px 8px; border-radius: 999px;
        white-space: nowrap;
    }
    .ctd-status-ok { background: rgba(34,197,94,0.14); color: var(--ok); border: 1px solid rgba(34,197,94,0.3); }
    .ctd-status-pending { background: rgba(255,255,255,0.08); color: var(--text-muted); border: 1px solid rgba(255,255,255,0.15); }

    .ctd-analisar-link {
        font-size: 0.65rem; color: var(--text-dim); font-weight: 600; display: flex; align-items: center; gap: 3px;
        flex-shrink: 0;
    }
    .ctd-analisar-link:hover { color: var(--gold-ink); }

    .ctd-empty { text-align: center; padding: 1.5rem 1rem; color: var(--text-dim); font-size: 0.82rem; }

    /* ── Painéis recolhíveis (acordeão) ─────────────── */
    .acc-header {
        display: flex; align-items: center; gap: 12px; width: 100%;
        padding: 1.1rem 1.5rem; background: none; border: none; cursor: pointer;
        text-align: left; font-family: 'Barlow', Arial, sans-serif;
    }
    .acc-chevron { color: var(--text-dim); font-size: 13px; width: 14px; flex-shrink: 0; }
    .acc-title { color: var(--text-strong); font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 20px; font-weight: 800; }
    .acc-meta { font-size: 11px; color: #475569; margin-left: auto; }
    .acc-body { padding: 0 1.5rem 1.5rem; }
    .acc-body[hidden] { display: none; }

    /* ── Estatísticas da temporada ────────────────── */
    .est-panel { background: var(--p-alt); border: 1px solid var(--p-alt-2); border-radius: 16px; overflow: hidden; }

    .est-filtros {
        display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;
        padding-bottom: 1.1rem; border-bottom: 1px solid var(--p-alt-2);
    }
    .est-label {
        font-size: 11px; color: var(--text-muted); text-transform: uppercase;
        letter-spacing: 1px; display: block; margin-bottom: 0.3rem;
    }
    .est-input {
        background: var(--p-alt-2); color: var(--text-strong); border: 1px solid var(--p-alt-3);
        border-radius: 8px; padding: 0.45rem 0.75rem; font-size: 13px;
    }

    .est-seg { display: flex; background: var(--p-alt-2); border: 1px solid var(--p-alt-3); border-radius: 8px; padding: 3px; gap: 3px; }
    .est-seg button {
        border: none; cursor: pointer; font-family: 'Barlow', sans-serif; font-size: 12px;
        font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 6px;
        background: transparent; color: var(--text-muted);
    }
    .est-seg button.ativo { background: var(--p-alt-3); color: var(--text-strong); }

    .est-buscar {
        background: #3b82f6; color: #fff; border: none; border-radius: 8px;
        padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 700; cursor: pointer;
        align-self: flex-end; font-family: 'Barlow', sans-serif;
    }
    .est-buscar:hover { background: #2563eb; }

    .est-tabs { display: flex; gap: 2px; margin: 1.1rem 0 1.25rem; border-bottom: 1px solid var(--p-alt-2); flex-wrap: wrap; }
    .est-tabs button {
        border: none; background: none; cursor: pointer; font-family: 'Barlow Condensed', sans-serif;
        font-size: 15px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
        padding: 0.55rem 1.1rem; border-bottom: 2px solid transparent; color: var(--text-muted);
    }
    .est-tabs button.ativo { color: var(--gold-ink); border-bottom-color: #d4a520; }

    .est-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem; }
    .est-kpi { background: var(--p-alt-2); border-radius: 10px; padding: 0.8rem 0.95rem; }
    .est-kpi-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
    .est-kpi-valor { font-family: 'Barlow Condensed', sans-serif; font-size: 30px; font-weight: 800; line-height: 1.1; }
    .est-kpi-sub { font-size: 11px; color: var(--text-dim); }

    .est-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
    .est-card { background: var(--p-alt-2); border-radius: 10px; padding: 1rem 1.1rem; }
    .est-card.full { grid-column: 1 / -1; }
    .est-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .est-card-title { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
    .est-card-title .leve { text-transform: none; letter-spacing: 0; color: var(--text-dim); }
    .est-card-nota { font-size: 10px; color: var(--text-dim); }

    /* min-width:0 — sem isso o track do grid não encolhe abaixo do tamanho do
       canvas (min-width:auto = min-content) e o gráfico estoura o card ao
       voltar do modo ampliado. */
    .est-chart { position: relative; height: 230px; min-width: 0; }
    .est-chart.alto { height: 260px; }
    .est-chart.radar { height: 340px; }
    .est-cards > * { min-width: 0; }

    /* ── Ampliar card de gráfico (tela cheia) ──────────────────────────────
       O card é movido para um overlay em document.body (position:fixed puro
       quebraria dentro de qualquer ancestral com transform), com um
       placeholder guardando o lugar original no grid. */
    .est-zoom {
        margin-left: auto; flex-shrink: 0; cursor: pointer; align-self: center;
        background: var(--p-alt); border: 1px solid var(--p-alt-3); color: var(--text-muted); border-radius: 8px;
        font-family: 'Barlow', Arial, sans-serif; font-size: 11px; font-weight: 700;
        padding: .25rem .6rem; display: inline-flex; align-items: center; gap: 5px;
    }
    .est-zoom:hover { color: var(--text-strong); border-color: #475569; }

    .est-overlay { position: fixed; inset: 0; z-index: 2000; background: rgba(2,6,23,.94); padding: 2.5vh 2.5vw; overflow: auto; }
    .est-card.est-ampliado { margin: 0; height: 95vh; display: flex; flex-direction: column; }
    .est-ampliado > .est-card-head { flex-shrink: 0; }
    .est-ampliado > .est-chart,
    .est-ampliado > .est-chart.alto,
    .est-ampliado > .est-chart.radar { height: auto; flex: 1 1 auto; min-height: 0; }

    @@media (max-width: 768px) {
        .est-overlay { padding: 1rem .6rem; }
        .est-card.est-ampliado { height: calc(100vh - 2rem); }
    }

    .est-forma { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 1rem; }
    .est-forma span {
        width: 24px; height: 24px; line-height: 24px; text-align: center;
        border-radius: 4px; font-size: 11px; font-weight: 700; color: #fff;
    }

    .est-mini { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem; }
    .est-mini-box { background: var(--p-alt); border-radius: 8px; padding: 0.75rem 0.9rem; }
    .est-mini-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.35rem; }
    .est-mini-valor { font-size: 13px; color: var(--text-strong); }

    .est-vazio { color: var(--text-dim); font-size: 12px; text-align: center; padding: 2rem 1rem; line-height: 1.5; }

    /* ── Tabela "Elenco em números" ────────────────── */
    .elenco-tab { width: 100%; border-collapse: collapse; font-size: 12px; white-space: nowrap; }
    .elenco-tab th {
        position: sticky; top: 0; background: var(--p-alt-2); color: var(--text-muted); cursor: pointer;
        font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700;
        padding: 0.5rem 0.55rem; text-align: right; border-bottom: 1px solid var(--p-alt-3); user-select: none;
    }
    .elenco-tab th.txt, .elenco-tab td.txt { text-align: left; }
    .elenco-tab th:hover { color: var(--text-strong); }
    .elenco-tab th.ativo { color: var(--gold-ink); }
    .elenco-tab td { padding: 0.45rem 0.55rem; text-align: right; color: var(--text-2); border-bottom: 1px solid #16202e; }
    .elenco-tab tbody tr:hover { background: #172033; }
    .elenco-tab td.txt a { color: var(--text-strong); text-decoration: none; }
    .elenco-tab td.txt a:hover { color: var(--gold-ink); }
    .elenco-setor {
        display: inline-block; font-size: 9px; font-weight: 800; letter-spacing: 0.06em;
        padding: 1px 6px; border-radius: 4px; color: #0f172a;
    }
    .elenco-tab td.zero { color: #475569; }
    /* Pouca amostra: por 90' esses números disparam (1 gol em 20' = 4,5/90). */
    .elenco-tab tr.pouca-amostra { opacity: 0.5; }
</style>

<div class="ctd">

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            @TempData["Mensagem"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Hero -->
    <div class="ctd-hero theme-dark-zone">
        <img class="ctd-hero-pattern" src="~/Images/banner/escudos-pattern.svg" alt="" />
        <div class="ctd-hero-stripe"></div>

        <div class="ctd-hero-row">
            <div class="ctd-badge-lg">
                @if (!string.IsNullOrEmpty(Model.Time.EscudoUrl))
                {
                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = Model.Time.EscudoUrl })" alt="@Model.Time.Nome" />
                }
                else
                {
                    <span>@(Model.Time.Nome?.Length >= 3 ? Model.Time.Nome.Substring(0, 3).ToUpper() : Model.Time.Nome)</span>
                }
            </div>

            <div class="ctd-info">
                <div class="ctd-name-row">
                    <h1>@Model.Time.Nome</h1>
                    @if (Model.Time.FormacaoPadrao != null)
                    {
                        <span class="ctd-formacao-badge">@Model.Time.FormacaoPadrao.Nome</span>
                    }
                </div>
                <div class="ctd-cidade">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    <span>@Model.Time.Cidade</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Time.EstadioNome))
                    {
                        var tituloEstadio = "Estádio do clube";
                        if (!string.IsNullOrWhiteSpace(Model.Time.EstadioGramado))
                        {
                            tituloEstadio += " · gramado: " + Model.Time.EstadioGramado;
                        }
                        var capacidadeEstadio = Model.Time.EstadioCapacidade > 0
                            ? " · " + Model.Time.EstadioCapacidade.Value.ToString("N0") + " lugares"
                            : "";
                        <span class="ctd-estadio" title="@tituloEstadio">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="4" /><line x1="12" y1="6" x2="12" y2="18" /><circle cx="12" cy="12" r="2.5" /></svg>
                            @(Model.Time.EstadioNome + capacidadeEstadio)
                        </span>
                    }
                </div>
                <div class="ctd-meta-row">
                    @if (formaTime.Any())
                    {
                        <span class="ctd-meta-label">Forma recente</span>
                        @foreach (var r in formaTime)
                        {
                            <span class="ctd-forma-dot" style="background:@CorForma(r);">@r</span>
                        }
                        <div class="ctd-meta-sep"></div>
                    }
                    <span class="ctd-meta-info">@Model.Elenco.Count jogadores</span>
                    <span class="ctd-meta-info">·</span>
                    <span class="ctd-meta-info">@totalPartidas partidas</span>
                </div>
                @if (Model.Titulos.Any())
                {
                    <div class="ctd-meta-row ctd-titulos">
                        <span class="ctd-meta-label">@(Model.Titulos.Count == 1 ? "Título" : "Títulos")</span>
                        @foreach (var titulo in Model.Titulos)
                        {
                            <a class="ctd-titulo" asp-controller="Competicoes" asp-action="Detalhes"
                               asp-route-id="@titulo.CompeticaoId" asp-route-temporada="@titulo.Temporada"
                               title="Campeão — @titulo.Competicao @titulo.TemporadaRotulo">
                                @* A taça é o que identifica o chip; o logo da competição
                                   entra junto quando está cadastrado. *@
                                <span>🏆</span>
                                @if (!string.IsNullOrEmpty(titulo.LogoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = titulo.LogoUrl })" alt="" />
                                }
                                <span>@titulo.Competicao</span>
                                <span class="ctd-titulo-temporada">@titulo.TemporadaRotulo</span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="ctd-treinador">
                <div class="ctd-treinador-head">
                    <div class="ctd-treinador-label" style="margin-bottom:0;">Treinador</div>
                    <button type="button" class="ctd-treinador-edit-btn" data-bs-toggle="modal" data-bs-target="#treinadorModal" title="Vincular, cadastrar ou trocar treinador">✏️</button>
                </div>
                @if (Model.Treinador != null)
                {
                    <div class="ctd-treinador-row" style="margin-top:8px;">
                        @if (!string.IsNullOrWhiteSpace(Model.Treinador.FotoUrl))
                        {
                            <img class="ctd-treinador-foto" src="@Url.FotoSrc(Model.Treinador.FotoUrl)" alt="@Model.Treinador.Nome" />
                        }
                        else
                        {
                            <div class="ctd-treinador-placeholder">🧑‍💼</div>
                        }
                        <div>
                            <div class="ctd-treinador-nome">@Model.Treinador.Nome</div>
                            @if (Model.Treinador.Nacionalidade != null)
                            {
                                <div class="ctd-treinador-nac">@Model.Treinador.Nacionalidade.Nome</div>
                            }
                        </div>
                    </div>
                    <a asp-controller="Treinadores" asp-action="Edit" asp-route-id="@Model.Treinador.Id" class="ctd-treinador-editar-link">Editar dados do treinador →</a>
                }
                else
                {
                    <div class="ctd-treinador-vazio">Nenhum treinador vinculado.</div>
                }
            </div>

            <div class="ctd-actions">
                <a asp-controller="Relatorios" asp-action="Index" asp-route-timeId="@Model.Time.Id" class="ctd-action-btn primary">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                    Relatórios
                </a>
                <a asp-controller="AnotacoesTime" asp-action="Index" asp-route-timeId="@Model.Time.Id" class="ctd-action-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    Anotações
                </a>
                <a asp-controller="Times" asp-action="Edit" asp-route-id="@Model.Time.Id" class="ctd-action-btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                    Editar time
                </a>
                <form method="post" asp-action="AtualizarDadosJogadores" asp-controller="Times" asp-route-id="@Model.Time.Id" style="display:inline;"
                      onsubmit="return confirm('Buscar idade, altura e peso na API para os jogadores do elenco que ainda não têm esses dados?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ctd-action-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6" /><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M3 22v-6h6" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /></svg>
                        Atualizar dados jogadores
                    </button>
                </form>
                <form method="post" asp-action="AtualizarEstadio" asp-controller="Times" asp-route-id="@Model.Time.Id" style="display:inline;"
                      onsubmit="return confirm('Buscar o estádio deste clube na api-football e salvar no perfil do time?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ctd-action-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="4" /><line x1="12" y1="6" x2="12" y2="18" /><circle cx="12" cy="12" r="2.5" /></svg>
                        Atualizar estádio
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: vincular / cadastrar treinador -->
    <div class="modal fade" id="treinadorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Treinador de @Model.Time.Nome</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-vincular-btn" data-bs-toggle="tab" data-bs-target="#tab-vincular" type="button" role="tab">Vincular existente</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-criar-btn" data-bs-toggle="tab" data-bs-target="#tab-criar" type="button" role="tab">Cadastrar novo</button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tab-vincular" role="tabpanel">
                            <form method="post" asp-action="VincularTreinador" asp-controller="Times">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Time.Id" />
                                <div class="mb-2">
                                    <label class="form-label">Treinador</label>
                                    <select name="treinadorId" class="form-select" required>
                                        <option value="">Selecione...</option>
                                        @foreach (var t in Model.TodosTreinadores)
                                        {
                                            <option value="@t.Id" selected="@(Model.Treinador != null && t.Id == Model.Treinador.Id)">
                                                @t.Nome @(t.Time != null ? $"({t.Time.Nome})" : "")
                                            </option>
                                        }
                                    </select>
                                    <div class="form-text" style="color:var(--text-dim)">O time atual de cada treinador aparece entre parênteses — ao vincular, ele deixa de ser o treinador do time anterior.</div>
                                </div>
                                <button type="submit" class="ctd-btn ctd-btn-gold">Vincular a @Model.Time.Nome</button>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="tab-criar" role="tabpanel">
                            <form method="post" asp-action="CriarTreinador" asp-controller="Times">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Time.Id" />
                                <div class="mb-2">
                                    <label class="form-label">Nome</label>
                                    <input type="text" name="nome" class="form-control" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Nacionalidade</label>
                                    <select name="nacionalidadeId" class="form-select">
                                        <option value="">(não informado)</option>
                                        @foreach (var n in Model.Nacionalidades)
                                        {
                                            <option value="@n.Id">@n.Nome</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Data de nascimento</label>
                                    <input type="date" name="dataNascimento" class="form-control" />
                                </div>
                                <button type="submit" class="ctd-btn ctd-btn-green">Cadastrar e vincular</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid principal -->
    <div class="ctd-grid">

        <!-- ── Elenco ──────────────────────────────── -->
        <div>
            <div class="ctd-col-title">
                <span>Elenco</span>
                <div class="line"></div>
                <span class="cnt" id="elenco-contador">@Model.Elenco.Count jog.</span>
            </div>

            @{
                // Opções do filtro: as siglas que realmente existem neste elenco, na
                // ordem do campo (GOL → DEF → MEI → ATA). Quem tem duas posições
                // ("LD/VOL") entra nas duas.
                var ordemSetor = new[] { "GOL", "DEF", "MEI", "ATA" };
                var posicoesElenco = Model.Elenco
                    .SelectMany(j => PosicaoJogadorHelper.Sigla(j.Posicao).Split('/'))
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .Distinct()
                    .OrderBy(s => { var i = Array.IndexOf(ordemSetor, PosicaoJogadorHelper.Setor(s) ?? ""); return i < 0 ? 99 : i; })
                    .ThenBy(s => s)
                    .ToList();
            }
            <div class="ctd-elenco-filtros">
                <div class="busca">
                    <input type="text" id="elenco-busca" class="ctd-elenco-input"
                           placeholder="Buscar jogador por nome..." autocomplete="off" />
                </div>
                <select id="elenco-filtro-posicao" class="ctd-elenco-input" style="width:auto;cursor:pointer;">
                    <option value="">Todas as posições</option>
                    @foreach (var p in posicoesElenco)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <div class="ctd-elenco-panel" id="listaJogadores">
                @foreach (var jogador in Model.Elenco)
                {
                    bool ehConvocado = jogador.TimeId != Model.Time.Id;
                    <div class="jogador-row"
                         id="jogador-@jogador.Id"
                         data-nome="@($"{jogador.Nome} {jogador.NomeExibicao}".Trim())"
                         data-posicoes="@PosicaoJogadorHelper.Sigla(jogador.Posicao)"
                         draggable="true"
                         ondragstart="dragJogador(event, @jogador.Id, '@jogador.Nome', '@(jogador.NumeroCamisa?.ToString() ?? "")')">
                        <div class="ctd-num player-circle-team">@(jogador.NumeroCamisa?.ToString() ?? "")</div>
                        @if (!string.IsNullOrWhiteSpace(jogador.FotoUrl))
                        {
                            <img class="ctd-jog-foto" src="@Url.FotoSrc(jogador.FotoUrl)" alt="@jogador.Nome" />
                        }
                        else
                        {
                            <img class="ctd-jog-foto" src="~/Images/placeholder-jogador.png" alt="" />
                        }
                        <div class="ctd-jog-info">
                            <div class="ctd-jog-nome">@jogador.Nome</div>
                            <div class="ctd-jog-pos">
                                @PosicaoJogadorHelper.Sigla(jogador.Posicao)
                                @if (ehConvocado && jogador.Time != null)
                                {
                                    <span class="ctd-jog-clube">
                                        @if (!string.IsNullOrEmpty(jogador.Time.EscudoUrl))
                                        {
                                            <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogador.Time.EscudoUrl })" alt="" />
                                        }
                                        @jogador.Time.Nome
                                    </span>
                                }
                            </div>
                        </div>
                        <a href="/Jogadores/Estatisticas/@jogador.Id" class="ctd-stats-link" title="Ver estatísticas de @jogador.Nome">Stats</a>
                    </div>
                }
                <div class="ctd-elenco-vazio" id="elenco-sem-resultado" hidden>Nenhum jogador encontrado.</div>
            </div>

            <script>
                // Busca por nome + filtro de posição da lista do elenco. Só mostra/esconde
                // as linhas já renderizadas — a classe .filtrado é independente da .usado,
                // que a escalação padrão usa para tirar da lista quem já está em campo.
                (function () {
                    const busca = document.getElementById('elenco-busca');
                    const filtro = document.getElementById('elenco-filtro-posicao');
                    const linhas = Array.from(document.querySelectorAll('#listaJogadores .jogador-row'));
                    const vazio = document.getElementById('elenco-sem-resultado');
                    const contador = document.getElementById('elenco-contador');

                    // Sem acento e em minúsculas: "Julián" acha com "julian".
                    const normalizar = (s) => (s || '')
                        .normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

                    function aplicar() {
                        const termo = normalizar(busca.value);
                        const pos = filtro.value;
                        let visiveis = 0;

                        linhas.forEach(linha => {
                            const casaNome = !termo || normalizar(linha.dataset.nome).includes(termo);
                            const casaPos = !pos ||
                                (linha.dataset.posicoes || '').split('/').includes(pos);
                            const mostra = casaNome && casaPos;
                            linha.classList.toggle('filtrado', !mostra);
                            if (mostra) visiveis++;
                        });

                        vazio.hidden = visiveis > 0;
                        contador.textContent = visiveis === linhas.length
                            ? `${linhas.length} jog.`
                            : `${visiveis} de ${linhas.length} jog.`;
                    }

                    busca.addEventListener('input', aplicar);
                    filtro.addEventListener('change', aplicar);
                })();
            </script>
        </div>

        <!-- ── Escalação padrão ────────────────────── -->
        <div>
            <div class="ctd-col-title">
                <span>Escalação Padrão</span>
                <div class="line"></div>
            </div>

            <form method="post" asp-action="DefinirFormacao" asp-controller="Times" class="ctd-form-row">
                <input type="hidden" name="id" value="@Model.Time.Id" />
                <select id="formacaoPadrao" name="formacaoPadraoId" class="ctd-select">
                    @foreach (var formacao in Model.Formacoes)
                    {
                        <option value="@formacao.Id" @(formacao.Id == Model.Time.FormacaoPadraoId ? "selected" : "")>
                            @formacao.Nome
                        </option>
                    }
                </select>
                <button type="submit" class="ctd-btn ctd-btn-gold">Definir Formação</button>
            </form>

            <form id="formEscalacao" method="post" asp-action="SalvarEscalacaoPadrao" asp-controller="Times">
                <input type="hidden" name="id" value="@Model.Time.Id" />

                <div class="ctd-campo-wrap">
                    <div id="campo" class="ctd-campo theme-dark-zone"
                         ondrop="dropNoCampo(event)" ondragover="allowDrop(event)">

                        <div class="ctd-campo-linha-meio"></div>
                        <div class="ctd-campo-circulo"></div>
                        <div class="ctd-campo-area topo"></div>
                        <div class="ctd-campo-area base"></div>
                        <div class="ctd-campo-gol topo"></div>
                        <div class="ctd-campo-gol base"></div>

                        @{
                            var index = 0;
                        }
                        @foreach (var esc in Model.TimeEscalacaoPadrao)
                        {
                            <div class="posicao-drop"
                                 data-index="@index"
                                 data-posicao="@PosicaoJogadorHelper.Sigla(esc.Posicao)"
                                 draggable="true"
                                 ondragstart="dragPosicao(event, @index)"
                                 ondrop="dropEscalacao(event, @index)"
                                 ondragover="allowDrop(event)"
                                 style="left:@esc.PosicaoX%; top:@esc.PosicaoY%;">

                                <span>@PosicaoJogadorHelper.Sigla(esc.Posicao)</span>

                                @if (esc.Jogador != null)
                                {
                                    <div class="player-circle player-circle-team">@(esc.Jogador.NumeroCamisa?.ToString() ?? "")</div>
                                    <div class="player-name">@esc.Jogador.Nome</div>
                                }
                            </div>

                            <input type="hidden" name="escalacao[@index].Id" value="@esc.Id" />
                            <input type="hidden" name="escalacao[@index].PosicaoId" value="@esc.PosicaoId" />
                            <input type="hidden" id="escalacao_@(index)__JogadorId" name="escalacao[@index].JogadorId" value="@esc.JogadorId" />
                            <input type="hidden" id="escalacao_@(index)__PosicaoX" name="escalacao[@index].PosicaoX" value="@esc.PosicaoX" />
                            <input type="hidden" id="escalacao_@(index)__PosicaoY" name="escalacao[@index].PosicaoY" value="@esc.PosicaoY" />
                            index++;
                        }
                    </div>
                </div>

                <div class="mt-3 text-center">
                    <button type="submit" class="ctd-btn ctd-btn-green">Salvar Escalação Padrão</button>
                </div>
            </form>
        </div>

        <!-- ── Partidas ────────────────────────────── -->
        <div>
            <div class="ctd-col-title">
                <span>Partidas</span>
                <div class="line"></div>
            </div>

            <div class="ctd-partidas-list">
                @if (!Model.JogosPassados.Any() && !Model.JogosFuturos.Any())
                {
                    <div class="ctd-empty">Nenhuma partida registrada ainda.</div>
                }

                @foreach (var jogo in Model.JogosPassados)
                {
                    bool vitoria = (Model.Time.Id == jogo.TimeCasaId && jogo.PlacarCasa > jogo.PlacarVisitante) ||
                                   (Model.Time.Id == jogo.TimeVisitanteId && jogo.PlacarVisitante > jogo.PlacarCasa);
                    bool empate = jogo.PlacarCasa == jogo.PlacarVisitante;
                    string resLetra = vitoria ? "V" : empate ? "E" : "D";
                    string resCor = vitoria ? "#22c55e" : empate ? "var(--text-dim)" : "#ef4444";
                    bool casaVenceu = jogo.PlacarCasa > jogo.PlacarVisitante;
                    bool visVenceu = jogo.PlacarVisitante > jogo.PlacarCasa;
                    var logoComp = CompeticaoHelper.GetLogoCompeticao(jogo.CompeticaoId);
                    var nomeComp = CompeticaoHelper.GetNomeCompeticao(jogo.CompeticaoId);

                    <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="ctd-match-card" style="display:block;">
                        <div class="ctd-match-top">
                            <span class="ctd-match-comp">
                                @if (!string.IsNullOrEmpty(logoComp))
                                {
                                    <img src="@logoComp" alt="" />
                                }
                                @nomeComp
                            </span>
                            <span class="ctd-match-date">@DateHelper.FormatarData(jogo.Data, "dd/MM")</span>
                        </div>
                        <div class="ctd-match-teams">
                            <div class="ctd-match-team">
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeCasa?.EscudoUrl })" alt="" />
                                <span style="font-weight:@(casaVenceu ? "700" : "500"); color:@(casaVenceu ? "var(--text-strong)" : "var(--text-dim)");">@jogo.TimeCasa?.Nome</span>
                            </div>
                            <span class="ctd-match-score">@jogo.PlacarCasa &ndash; @jogo.PlacarVisitante</span>
                            <div class="ctd-match-team right">
                                <span style="font-weight:@(visVenceu ? "700" : "500"); color:@(visVenceu ? "var(--text-strong)" : "var(--text-dim)");">@jogo.TimeVisitante?.Nome</span>
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeVisitante?.EscudoUrl })" alt="" />
                            </div>
                        </div>
                        @if (jogo.PenaltisCasa.HasValue && jogo.PenaltisVisitante.HasValue)
                        {
                            <div style="text-align:center; font-size:0.62rem; color:var(--text-dim); margin-top:4px">(@jogo.PenaltisCasa-@jogo.PenaltisVisitante pên.)</div>
                        }
                        <div class="ctd-match-footer">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span class="ctd-result-badge" style="background:@resCor;">@resLetra</span>
                                @if (jogo.Analisado == 1)
                                {
                                    <span class="ctd-status-badge ctd-status-ok">✅ Analisado</span>
                                }
                                else
                                {
                                    <span class="ctd-status-badge ctd-status-pending">⏳ Pendente</span>
                                }
                            </div>
                            <span class="ctd-analisar-link">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                @(jogo.Analisado == 1 ? "Ver análise" : "Analisar")
                            </span>
                        </div>
                    </a>
                }

                @foreach (var jogo in Model.JogosFuturos)
                {
                    var logoComp = CompeticaoHelper.GetLogoCompeticao(jogo.CompeticaoId);
                    var nomeComp = CompeticaoHelper.GetNomeCompeticao(jogo.CompeticaoId);

                    <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@jogo.Id" class="ctd-match-card" style="display:block;">
                        <div class="ctd-match-top">
                            <span class="ctd-match-comp">
                                @if (!string.IsNullOrEmpty(logoComp))
                                {
                                    <img src="@logoComp" alt="" />
                                }
                                @nomeComp
                            </span>
                            <span class="ctd-match-date">@DateHelper.FormatarData(jogo.Data, "dd/MM")</span>
                        </div>
                        <div class="ctd-match-teams">
                            <div class="ctd-match-team">
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeCasa?.EscudoUrl })" alt="" />
                                <span style="color:var(--text-muted)">@jogo.TimeCasa?.Nome</span>
                            </div>
                            <span class="ctd-match-score" style="color:var(--text-dim)">vs</span>
                            <div class="ctd-match-team right">
                                <span style="color:var(--text-muted)">@jogo.TimeVisitante?.Nome</span>
                                <img src="@Url.Action("Imagem", "MediaProxy", new { url = jogo.TimeVisitante?.EscudoUrl })" alt="" />
                            </div>
                        </div>
                        <div class="ctd-match-footer">
                            <span class="ctd-status-badge ctd-status-pending">Agendado</span>
                            <span class="ctd-analisar-link">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                Analisar
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>

    </div>
</div>

<script>
    // ── Estado global (igual ao Analisar) ──────────────────────────────────
    const usados = new Set();
    let dragData          = {};
    let draggingPosicao   = false;
    let posicaoArrastando = null;


    // ── Inicializa jogadores já posicionados ───────────────────────────────
    function initUsados() {
        document.querySelectorAll('[id^="escalacao_"][id$="__JogadorId"]').forEach(el => {
            if (el.value) usados.add(el.value);
        });
        atualizarLista();
    }

    function atualizarLista() {
        usados.forEach(id => {
            const row = document.getElementById('jogador-' + id);
            if (row) row.classList.add('usado');
        });
    }

    function marcarUsado(jogadorId) {
        usados.add(String(jogadorId));
        const row = document.getElementById('jogador-' + jogadorId);
        if (row) row.classList.add('usado');
    }

    function desmarcarUsado(jogadorId) {
        usados.delete(String(jogadorId));
        const row = document.getElementById('jogador-' + jogadorId);
        if (row) row.classList.remove('usado');
    }

    // ── Drag helpers ───────────────────────────────────────────────────────
    function allowDrop(ev) { ev.preventDefault(); }

    // Arrastar jogador da lista lateral
    function dragJogador(ev, jogadorId, jogadorNome, jogadorNumero) {
        draggingPosicao = false;
        dragData = { jogadorId: String(jogadorId), jogadorNome, jogadorNumero };
        ev.dataTransfer.setData("text/plain", String(jogadorId));
    }

    // ── Soltar jogador em slot do campo ───────────────────────────────────
    function dropEscalacao(ev, index) {
        ev.preventDefault();
        ev.stopPropagation();
        if (draggingPosicao) return;

        const { jogadorId, jogadorNome, jogadorNumero } = dragData;
        if (!jogadorId) return;

        if (usados.has(jogadorId)) {
            alert("Esse jogador já está em campo!");
            return;
        }

        const hidden    = document.getElementById(`escalacao_${index}__JogadorId`);
        if (!hidden) return;

        const antigoId  = hidden.value;
        if (antigoId) desmarcarUsado(antigoId);

        hidden.value = jogadorId;
        marcarUsado(jogadorId);

        const posEl      = document.querySelector(`.posicao-drop[data-index='${index}']`);
        const nomePosicao = posEl.dataset.posicao;

        posEl.innerHTML = `
            <span>${nomePosicao}</span>
            <div class="player-circle player-circle-team">${jogadorNumero}</div>
            <div class="player-name">${jogadorNome}</div>`;
    }

    // ── Arrastar posição já no campo (reposicionar) ────────────────────────
    function dragPosicao(ev, index) {
        draggingPosicao   = true;
        posicaoArrastando = index;
        ev.dataTransfer.setData("text/plain", String(index));
    }

    // Drop no fundo do campo para reposicionar slot
    function dropNoCampo(ev) {
        ev.preventDefault();
        ev.stopPropagation();

        if (!draggingPosicao || posicaoArrastando === null) return;

        const index = posicaoArrastando;
        const campo = document.getElementById("campo");
        const rect  = campo.getBoundingClientRect();

        const newX = Math.round(((ev.clientX - rect.left)  / rect.width)  * 100);
        const newY = Math.round(((ev.clientY - rect.top)   / rect.height) * 100);

        if (newX < 0 || newX > 100 || newY < 0 || newY > 100) return;

        const el = document.querySelector(`.posicao-drop[data-index='${index}']`);
        if (!el) return;

        el.style.left = newX + "%";
        el.style.top  = newY + "%";

        document.getElementById(`escalacao_${index}__PosicaoX`).value = newX;
        document.getElementById(`escalacao_${index}__PosicaoY`).value = newY;

        draggingPosicao   = false;
        posicaoArrastando = null;
    }

    // Inicializa ao carregar
    initUsados();
</script>

<!-- ══ ESTATÍSTICAS DA TEMPORADA ════════════════════════════════════════════
     Duas fontes: /Times/EstatisticasApi (API-Football, temporada completa) e
     /Times/EstatisticasLocaisApi (jogos cadastrados aqui — rodada a rodada,
     recorte casa × fora nos intervalos e comparativo com a liga). Cada bloco
     diz de onde veio o número quando as duas divergem em cobertura. -->
