    </div>
</div>

<!-- ══ ARSENAL DE JOGADAS ═══════════════════════════════════════════════════
     As jogadas nascem dentro da análise de um jogo (modal 🎬 Jogadas), mas são
     gravadas com o TimeId — aqui elas se juntam no acervo do time, de todas as
     partidas. Só reprodução: editar é no jogo de origem (link "Editar"). -->
<div id="painel-jogadas-time" style="margin-top:1rem;">
    <div class="est-panel">
        <button type="button" class="acc-header" onclick="toggleAccordion(this)">
            <span class="acc-chevron">▸</span>
            <span class="acc-title">🎬 Arsenal de Jogadas</span>
            <span class="acc-meta">jogadas desenhadas nas análises</span>
        </button>
