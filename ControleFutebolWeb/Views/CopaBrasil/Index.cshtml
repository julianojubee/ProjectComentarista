@using ControleFutebolWeb.Controllers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Copa do Brasil";
    var vm = ViewBag.Vm as CopaBrasilViewModel ?? new CopaBrasilViewModel();
    var temporadasCb = ViewBag.TemporadasDisponiveis as List<int> ?? new List<int>();
    var temporadaCbSel = ViewBag.Temporada as int?;
    var estatisticasTimes = ViewBag.EstatisticasTimes as List<ControleFutebolWeb.Models.ViewModels.EstatisticaTimeViewModel> ?? new();
}

<style>
    /* Identidade da Copa do Brasil: laranja da competição com as curvas verde /
       amarelo / laranja-claro da arte oficial. O acento do resto da tela deixou
       de ser dourado e virou o mesmo laranja, em duas intensidades (uma escura
       para texto sobre fundo claro, outra clara para o tema escuro). */
    :root {
        --cb-orange: #ef6316;
        --cb-orange-ink: #c2410c; /* laranja como TEXTO no tema claro */
        --cb-orange-soft: rgba(239,99,22,0.10);
        --cb-orange-line: #f6c3a2;
        --cb-green: #00a94f;
        --cb-yellow: #ffd200;
    }

    [data-theme="dark"] {
        --cb-orange-ink: #fb923c;
        --cb-orange-soft: rgba(239,99,22,0.16);
        --cb-orange-line: #7c3a12;
    }

    .cb-root, .cb-root *, .cb-root *::before, .cb-root *::after { box-sizing: border-box; }
    .cb-root { margin: 0 -12px; background: var(--p-0); border-radius: 14px; overflow: hidden; color: var(--text); font-family: 'Barlow', Arial, sans-serif; }
    .cb-root a { text-decoration: none; color: inherit; }

    /* ── Hero ── */
    .cb-hero { position: relative; overflow: hidden; background: linear-gradient(160deg, #f4741f 0%, #ef6316 55%, #e2560c 100%); padding: 46px 2.5rem 40px; }
    .cb-hero-fade { position: absolute; bottom: 0; left: 0; right: 0; height: 46px; background: linear-gradient(to top, var(--page-bg), transparent); pointer-events: none; z-index: 2; }

    /* Curvas da arte oficial: blocos verde/amarelo/laranja saindo dos cantos,
       com leques de linhas finas atrás deles. */
    .cb-hero-art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .cb-shape { position: absolute; border-radius: 50%; }
    .cb-lines { position: absolute; border-radius: 50%; background: repeating-radial-gradient(circle at center, rgba(255,255,255,.42) 0 1px, transparent 1px 11px); }

    .cb-shape-green { width: 300px; height: 300px; top: -190px; left: -70px; background: linear-gradient(150deg, #00b355 0%, #009247 55%, #00713a 100%); }
    .cb-lines-green { width: 420px; height: 420px; top: -240px; left: -130px; opacity: .5; }
    .cb-shape-yellow { width: 190px; height: 190px; top: -128px; right: -66px; background: linear-gradient(200deg, #ffdd33, #f5c400); }
    .cb-shape-amber { width: 340px; height: 340px; bottom: -215px; right: -60px; background: linear-gradient(320deg, #ffb43d 0%, #f79420 60%, #ee7a12 100%); }
    .cb-lines-amber { width: 470px; height: 470px; bottom: -265px; right: -120px; opacity: .45; }

    .cb-hero-inner { position: relative; z-index: 1; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .cb-hero-icon { width: 78px; height: 78px; border-radius: 50%; background: rgba(255,255,255,.14); border: 2px solid rgba(255,255,255,.45); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
    /* a taça oficial é colorida; na arte do hero ela aparece em branco */
    .cb-hero-icon img { width: 74%; height: 74%; object-fit: contain; filter: brightness(0) invert(1); }
    .cb-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .cb-kicker-line { height: 2px; width: 24px; background: #fff; }
    .cb-kicker span { font-size: .86rem; font-weight: 600; color: rgba(255,255,255,.92); }
    .cb-hero h1 { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 3.2rem; font-weight: 800; color: #fff; margin: 0 0 6px; line-height: .95; text-shadow: 0 2px 12px rgba(120,45,0,.25); }
    .cb-hero-sub { color: rgba(255,255,255,.9); font-size: .92rem; margin: 0; }
    .cb-hero-temporada { display: flex; align-items: center; gap: 6px; margin-left: auto; }
    .cb-hero-temporada label { color: rgba(255,255,255,.9); font-size: .84rem; font-weight: 600; }
    .cb-hero-temporada select { appearance: none; padding: 5px 10px; border-radius: 7px; border: 1px solid rgba(255,255,255,.5); background: rgba(255,255,255,.16); color: #fff; font-size: .8rem; font-weight: 600; cursor: pointer; }
    .cb-hero-temporada select option { color: #111827; background: #fff; }

    @@media (max-width: 700px) {
        .cb-hero { padding: 32px 1.2rem 30px; }
        .cb-hero h1 { font-size: 2.2rem; }
        .cb-shape-green { width: 200px; height: 200px; top: -130px; left: -50px; }
        .cb-shape-amber { width: 230px; height: 230px; bottom: -150px; right: -50px; }
    }

    /* ── Conteúdo ── */
    .cb-content { padding: 24px 2.5rem 64px; max-width: 1500px; margin: 0 auto; }

    /* ── Navegação de fases ── */
    .cb-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem; }
    .cb-nav-btn { font-size: .84rem; padding: 6px 14px; background: var(--p-1); border: 1px solid var(--line); border-radius: 999px; color: var(--text-muted); font-weight: 600; transition: border-color .15s, color .15s; }
    .cb-nav-btn:hover { border-color: var(--cb-orange); color: var(--cb-orange-ink); }
    .cb-nav-btn.active { background: var(--cb-orange-soft); border-color: var(--cb-orange); color: var(--cb-orange-ink); font-weight: 700; }

    /* ── Cabeçalho da fase ── */
    .cb-fase-header { display: flex; align-items: center; gap: 10px; margin-bottom: 1.2rem; }
    .cb-fase-title { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--text-strong); margin: 0; }
    .cb-fase-badge { color: var(--text-dim); font-size: .88rem; font-weight: 500; }

    /* ── Grid de confrontos ── */
    .cb-confrontos { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; }

    /* ── Card de confronto ── */
    .cb-card { background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; transition: border-color .15s; }
    .cb-card:hover { border-color: var(--cb-orange); }
    .cb-card-header { background: var(--p-0); border-bottom: 1px solid var(--line-soft); padding: 8px 14px; display: flex; justify-content: space-between; align-items: center; }
    .cb-card-header-left { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .95rem; font-weight: 700; color: var(--cb-orange-ink); }
    .cb-card-header-right { font-size: .78rem; color: var(--text-dim); }
    .cb-card-header-right .ok { color: var(--ok-2); }

    /* Agregado */
    .cb-agregado { padding: 12px 14px; display: flex; justify-content: center; align-items: center; gap: 14px; border-bottom: 1px solid var(--line-soft); }
    .cb-agg-time { display: flex; align-items: center; gap: 7px; flex: 1; min-width: 0; }
    .cb-agg-time.right { justify-content: flex-end; flex-direction: row-reverse; }
    .cb-agg-time img { width: 28px; height: 28px; object-fit: contain; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--p-0); flex-shrink: 0; }
    .cb-agg-name { font-size: .88rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cb-agg-name:hover { text-decoration: underline; }
    .cb-agg-score { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .cb-agg-num { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 1.7rem; font-weight: 800; line-height: 1; color: var(--text-strong); min-width: 22px; text-align: center; }
    .cb-agg-num.leader { color: var(--ok-2); }
    .cb-agg-num.loser { color: var(--text-dimmer); }
    .cb-agg-sep { font-size: 18px; color: var(--line-strong); font-weight: 300; line-height: 1; }
    .cb-agg-vs { font-size: .8rem; color: var(--text-dim); font-weight: 600; }

    /* Classificado */
    .cb-classificado-wrap { padding: 6px 14px; text-align: center; border-bottom: 1px solid var(--line-soft); }
    .cb-classificado { font-size: .8rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--cb-orange-soft); border: 1px solid var(--cb-orange-line); color: var(--cb-orange-ink); white-space: nowrap; }
    .cb-classificado.pendente { background: var(--p-3); border-color: var(--line); color: var(--text-muted); }

    /* Jogos ida/volta */
    .cb-jogos { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; }
    .cb-jogo-row { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 8px; background: var(--p-0); border: 1px solid var(--line-soft); font-size: .82rem; transition: border-color .15s; }
    .cb-jogo-row:hover { border-color: var(--cb-orange-line); }
    .cb-jogo-label { font-size: .72rem; font-weight: 700; color: #fff; background: var(--cb-orange); padding: 2px 7px; border-radius: 4px; flex-shrink: 0; }
    .cb-jogo-label.volta { background: var(--p-4); color: var(--text); }
    .cb-jogo-date { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: .82rem; font-weight: 700; color: var(--text-dim); flex-shrink: 0; }
    .cb-jogo-times { display: flex; align-items: center; gap: 5px; flex: 1; justify-content: center; color: var(--text-muted); min-width: 0; }
    .cb-jogo-times .nome { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cb-jogo-result { font-family: 'Barlow Condensed', Arial, sans-serif; font-weight: 700; font-size: .85rem; background: var(--p-4); color: var(--text-strong); padding: 1px 8px; border-radius: 5px; flex-shrink: 0; }
    .cb-jogo-pen { font-size: .74rem; color: var(--text-muted); font-weight: 500; }
    .cb-jogo-pending { font-size: .74rem; color: var(--text-dim); background: var(--p-2); padding: 2px 8px; border-radius: 5px; flex-shrink: 0; }
    .cb-jogo-analisar { font-size: .78rem; color: var(--cb-orange-ink); font-weight: 700; flex-shrink: 0; border: 1px solid var(--cb-orange-line); padding: 2px 9px; border-radius: 5px; transition: background .15s, color .15s; }
    .cb-jogo-analisar:hover { background: var(--cb-orange); color: #fff; border-color: var(--cb-orange); }
    .cb-jogo-vazio { justify-content: flex-start; color: var(--text-dim); }
    .cb-jogo-vazio span.txt { font-size: .8rem; margin-left: 4px; }

    /* Sem dados */
    .cb-empty { text-align: center; padding: 3.5rem 1rem; color: var(--text-dim); font-size: .92rem; background: var(--p-1); border: 1px solid var(--line); border-radius: 14px; }

    /* ── Abas (Confrontos / Estatísticas) ── */
    .cb-tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; }
    .cb-tab {
        flex: 0 0 auto; background: var(--p-1); border: 1px solid var(--line); border-radius: 999px;
        padding: 7px 16px; font-size: .86rem; font-weight: 700; color: var(--text-muted); cursor: pointer; white-space: nowrap;
        font-family: 'Barlow', Arial, sans-serif; transition: border-color .15s, color .15s;
    }
    .cb-tab:hover { border-color: var(--cb-orange); color: var(--cb-orange-ink); }
    .cb-tab.active { background: var(--cb-orange-soft); border-color: var(--cb-orange); color: var(--cb-orange-ink); }
    .cb-panel { display: none; }
    .cb-panel.active { display: block; }
</style>

<div class="cb-root">

    <!-- ── Hero ── -->
    <div class="cb-hero theme-dark-zone">
        <div class="cb-hero-art">
            <span class="cb-lines cb-lines-green"></span>
            <span class="cb-shape cb-shape-green"></span>
            <span class="cb-shape cb-shape-yellow"></span>
            <span class="cb-lines cb-lines-amber"></span>
            <span class="cb-shape cb-shape-amber"></span>
        </div>
        <div class="cb-hero-fade"></div>
        <div class="cb-hero-inner">
            <div class="cb-hero-icon">
                <img src="~/images/background/copadobrasil.png" alt=""
                     onerror="this.parentElement.style.display='none'" />
            </div>
            <div>
                <div class="cb-kicker">
                    <div class="cb-kicker-line"></div>
                    <span>Competição nacional, mata-mata</span>
                </div>
                <h1>Copa do Brasil</h1>
                <p class="cb-hero-sub">@(string.IsNullOrEmpty(vm.FaseChaveAtual) ? "Confrontos de ida e volta" : $"{vm.FaseAtual}, {(vm.JogoUnico ? "jogo único" : "jogos de ida e volta")}")</p>
                <div style="margin-top:10px;">
                    @await Html.PartialAsync("_BotaoSincronizarJogos", 3)
                </div>
            </div>
            @if (temporadasCb.Count > 1)
            {
                <form method="get" class="cb-hero-temporada">
                    <label>Temporada</label>
                    <select name="temporada" onchange="this.form.submit()">
                        @foreach (var temp in temporadasCb)
                        {
                            <option value="@temp" @(temporadaCbSel == temp ? "selected" : "")>@temp</option>
                        }
                    </select>
                </form>
            }
        </div>
    </div>

    <div class="cb-content">

        <div class="cb-tabs" role="tablist">
            <button type="button" class="cb-tab active" data-cb-tab="confrontos">Confrontos</button>
            <button type="button" class="cb-tab" data-cb-tab="estatisticas">Estatísticas</button>
            <button type="button" class="cb-tab" data-cb-tab="estat-jogadores">Jogadores</button>
        </div>

        <div class="cb-panel active" data-cb-panel="confrontos">
        @if (vm.FaseAtual == "Sem dados" || !vm.Confrontos.Any())
        {
            <div class="cb-empty">
                Nenhum jogo da Copa do Brasil nesta temporada.<br />
                <small>Use "Sincronizar jogos" acima para importar os confrontos.</small>
            </div>
        }
        else
        {
            <!-- ── Navegação de fases ── -->
            @if (vm.Fases.Count > 1)
            {
                <nav class="cb-nav" aria-label="Fases">
                    @foreach (var f in vm.Fases)
                    {
                        <a asp-action="Index" asp-controller="CopaBrasil"
                           asp-route-fase="@f.Chave"
                           asp-route-temporada="@temporadaCbSel"
                           class="cb-nav-btn @(f.Chave == vm.FaseChaveAtual ? "active" : "")"
                           aria-current="@(f.Chave == vm.FaseChaveAtual ? "page" : null)">
                            @f.Rotulo
                        </a>
                    }
                </nav>
            }

            <!-- ── Cabeçalho da fase ── -->
            <div class="cb-fase-header">
                <h3 class="cb-fase-title">@vm.FaseAtual</h3>
                <span class="cb-fase-badge">@(vm.Confrontos.Count == 1 ? "1 confronto" : $"{vm.Confrontos.Count} confrontos"), @(vm.JogoUnico ? "jogo único" : "ida e volta")</span>
            </div>

            <!-- ── Confrontos ── -->
            <div class="cb-confrontos">
                @foreach (var c in vm.Confrontos)
                {
                    bool idaRealizada = c.JogoIda?.PlacarCasa.HasValue == true;
                    bool voltaRealizada = c.JogoVolta?.PlacarCasa.HasValue == true;
                    // Em jogo único, o confronto acaba no primeiro (e único) jogo
                    bool ambosRealizados = idaRealizada && (vm.JogoUnico || voltaRealizada);
                    var vencedor = c.Vencedor(vm.JogoUnico);

                    bool aLiderando = c.GolsTimeA > c.GolsTimeB;
                    bool bLiderando = c.GolsTimeB > c.GolsTimeA;

                    <div class="cb-card">
                        <!-- Header do card -->
                        <div class="cb-card-header">
                            <span class="cb-card-header-left">@c.FaseName</span>
                            <span class="cb-card-header-right">
                                @if (ambosRealizados)
                                {
                                    <span class="ok">Encerrado</span>
                                }
                                else if (idaRealizada)
                                {
                                    <span>Aguardando volta</span>
                                }
                                else
                                {
                                    <span>A realizar</span>
                                }
                            </span>
                        </div>

                        <!-- Placar agregado -->
                        <div class="cb-agregado">
                            <!-- Time A -->
                            <div class="cb-agg-time">
                                @if (!string.IsNullOrEmpty(c.TimeA.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = c.TimeA.EscudoUrl })" alt="" loading="lazy" />
                                }
                                <a class="cb-agg-name" title="@c.TimeA.Nome"
                                   href="@Url.Action("Details", "Times", new { id = c.TimeA.Id })">@c.TimeA.Nome</a>
                            </div>

                            <!-- Placar agregado central -->
                            <div class="cb-agg-score">
                                @if (idaRealizada)
                                {
                                    <span class="cb-agg-num @(aLiderando ? "leader" : (bLiderando ? "loser" : ""))">
                                        @c.GolsTimeA
                                    </span>
                                    <span class="cb-agg-sep">x</span>
                                    <span class="cb-agg-num @(bLiderando ? "leader" : (aLiderando ? "loser" : ""))">
                                        @c.GolsTimeB
                                    </span>
                                }
                                else
                                {
                                    <span class="cb-agg-vs">vs</span>
                                }
                            </div>

                            <!-- Time B -->
                            <div class="cb-agg-time right">
                                @if (!string.IsNullOrEmpty(c.TimeB.EscudoUrl))
                                {
                                    <img src="@Url.Action("Imagem", "MediaProxy", new { url = c.TimeB.EscudoUrl })" alt="" loading="lazy" />
                                }
                                <a class="cb-agg-name" title="@c.TimeB.Nome"
                                   href="@Url.Action("Details", "Times", new { id = c.TimeB.Id })">@c.TimeB.Nome</a>
                            </div>
                        </div>

                        <!-- Badge classificado (se encerrado) -->
                        @if (vencedor != null)
                        {
                            <div class="cb-classificado-wrap">
                                <span class="cb-classificado">@vencedor.Nome avançou</span>
                            </div>
                        }
                        else if (ambosRealizados && c.GolsTimeA == c.GolsTimeB)
                        {
                            <div class="cb-classificado-wrap">
                                <span class="cb-classificado pendente">Empate, falta registrar os pênaltis</span>
                            </div>
                        }

                        <!-- Jogos de ida e volta -->
                        <div class="cb-jogos">

                            @* ── Jogo de Ida ── *@
                            @if (c.JogoIda != null)
                            {
                                <div class="cb-jogo-row">
                                    <span class="cb-jogo-label">@(vm.JogoUnico ? "Jogo" : "Ida")</span>
                                    <span class="cb-jogo-date">
                                        @ControleFutebolWeb.Helpers.DateHelper.FormatarData(c.JogoIda.Data, "dd/MM HH:mm")
                                    </span>

                                    <div class="cb-jogo-times">
                                        <span class="nome">@c.JogoIda.TimeCasa?.Nome</span>
                                        @if (c.JogoIda.PlacarCasa.HasValue)
                                        {
                                            <span class="cb-jogo-result">
                                                @c.JogoIda.PlacarCasa x @c.JogoIda.PlacarVisitante
                                                @if (c.JogoIda.PenaltisCasa.HasValue && c.JogoIda.PenaltisVisitante.HasValue)
                                                {
                                                    <span class="cb-jogo-pen">(@c.JogoIda.PenaltisCasa x @c.JogoIda.PenaltisVisitante nos pênaltis)</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="cb-jogo-pending">vs</span>
                                        }
                                        <span class="nome">@c.JogoIda.TimeVisitante?.Nome</span>
                                    </div>
                                    <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@c.JogoIda.Id"
                                       class="cb-jogo-analisar">Analisar</a>
                                </div>
                            }
                            else
                            {
                                <div class="cb-jogo-row cb-jogo-vazio">
                                    <span class="cb-jogo-label">Ida</span>
                                    <span class="txt">Jogo de ida não cadastrado</span>
                                </div>
                            }

                            @* ── Jogo de Volta ── *@
                            @if (c.JogoVolta != null)
                            {
                                <div class="cb-jogo-row">
                                    <span class="cb-jogo-label volta">Volta</span>
                                    <span class="cb-jogo-date">
                                        @ControleFutebolWeb.Helpers.DateHelper.FormatarData(c.JogoVolta.Data, "dd/MM HH:mm")
                                    </span>

                                    <div class="cb-jogo-times">
                                        <span class="nome">@c.JogoVolta.TimeCasa?.Nome</span>
                                        @if (c.JogoVolta.PlacarCasa.HasValue)
                                        {
                                            <span class="cb-jogo-result">
                                                @c.JogoVolta.PlacarCasa x @c.JogoVolta.PlacarVisitante
                                                @if (c.JogoVolta.PenaltisCasa.HasValue && c.JogoVolta.PenaltisVisitante.HasValue)
                                                {
                                                    <span class="cb-jogo-pen">(@c.JogoVolta.PenaltisCasa x @c.JogoVolta.PenaltisVisitante nos pênaltis)</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="cb-jogo-pending">A jogar</span>
                                        }
                                        <span class="nome">@c.JogoVolta.TimeVisitante?.Nome</span>
                                    </div>
                                    <a asp-controller="Jogos" asp-action="Analisar" asp-route-id="@c.JogoVolta.Id"
                                       class="cb-jogo-analisar">Analisar</a>
                                </div>
                            }
                            else if (!vm.JogoUnico)
                            {
                                <div class="cb-jogo-row cb-jogo-vazio">
                                    <span class="cb-jogo-label volta">Volta</span>
                                    <span class="txt">Jogo de volta ainda não cadastrado</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        </div>

        <div class="cb-panel" data-cb-panel="estatisticas">
            @await Html.PartialAsync("_LinksEstatisticasCompeticao", (3, temporadaCbSel))
            @await Html.PartialAsync("_PainelEstatisticas", estatisticasTimes)
        </div>

        <div class="cb-panel" data-cb-panel="estat-jogadores">
            @await Html.PartialAsync("_AbaEstatisticasJogadores", (3, temporadaCbSel))
        </div>
    </div>
    @await Html.PartialAsync("_ArtilheirosAssistencias", (3, temporadaCbSel))
</div>

<script>
    (function () {
        var tabs = document.querySelectorAll('.cb-tab');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                tabs.forEach(function (t) { t.classList.remove('active'); });
                document.querySelectorAll('.cb-panel').forEach(function (p) { p.classList.remove('active'); });
                tab.classList.add('active');
                var alvo = document.querySelector('[data-cb-panel="' + tab.dataset.cbTab + '"]');
                if (alvo) alvo.classList.add('active');
            });
        });
    })();
</script>
