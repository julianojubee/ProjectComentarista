@model ControleFutebolWeb.Models.ViewModels.CampeonatoDetalhesViewModel
@* Partidas por rodada. Editável (placar inline + súmula) na tela do dono;
   somente leitura no link público (ViewData["SoLeitura"] = true). *@
@{
    var soLeitura = ViewData["SoLeitura"] as bool? == true;
    var c = Model.Campeonato;
    var rodadas = c.Partidas.OrderBy(p => p.Rodada).ThenBy(p => p.Grupo).ThenBy(p => p.ChaveOrdem).ThenBy(p => p.Id)
        .GroupBy(p => p.Rodada).ToList();
    var pendentes = c.Partidas.Count(p => !(p.PlacarCasa.HasValue && p.PlacarVisitante.HasValue));
    var jogadas = c.Partidas.Count - pendentes;
    // O dono abre nas pendentes (é onde lança placar); o público vê tudo
    var comecaPendentes = !soLeitura && pendentes > 0 && jogadas > 0;
}

@if (!rodadas.Any())
{
    <div class="cp-vazio">Nenhuma partida gerada ainda.</div>
}
else
{
    @if (pendentes > 0 && jogadas > 0)
    {
        <div class="cp-filtro" role="group" aria-label="Mostrar partidas">
            <button type="button" data-filtro="pendentes" aria-pressed="@(comecaPendentes ? "true" : "false")">Pendentes <span>@pendentes</span></button>
            <button type="button" data-filtro="todas" aria-pressed="@(comecaPendentes ? "false" : "true")">Todas <span>@c.Partidas.Count</span></button>
        </div>
    }

    <div class="cp-partidas @(comecaPendentes ? "so-pendentes" : "")" id="cpPartidas">
        @foreach (var rodada in rodadas)
        {
            <section class="cp-rodada">
                <h3 class="cp-rodada-titulo">Rodada @rodada.Key</h3>
                @foreach (var p in rodada)
                {
                    @await Html.PartialAsync("~/Views/Campeonatos/_Partida.cshtml", (Model, p, soLeitura, false, (string?)null))
                }
            </section>
        }
    </div>

    <script>
        (function () {
            var lista = document.getElementById('cpPartidas');
            var botoes = document.querySelectorAll('.cp-filtro [data-filtro]');

            // Esconde a rodada inteira quando todas as partidas dela estão escondidas
            function rodadas() {
                lista.querySelectorAll('.cp-rodada').forEach(function (r) {
                    var visivel = Array.prototype.some.call(r.querySelectorAll('.cp-partida'), function (p) { return p.offsetParent !== null; });
                    r.hidden = !visivel;
                });
            }
            function filtrar(tipo) {
                lista.classList.toggle('so-pendentes', tipo === 'pendentes');
                botoes.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.filtro === tipo ? 'true' : 'false'); });
                lista.querySelectorAll('.cp-rodada').forEach(function (r) { r.hidden = false; });
                rodadas();
            }
            botoes.forEach(function (b) { b.addEventListener('click', function () { filtrar(b.dataset.filtro); }); });

            // Voltando de um "Salvar", a partida do #âncora já está jogada: mostra todas
            var alvo = location.hash ? document.getElementById(location.hash.slice(1)) : null;
            if (alvo && alvo.classList.contains('jogada') && lista.classList.contains('so-pendentes')) {
                filtrar('todas');
                alvo.scrollIntoView({ block: 'center' });
            } else {
                rodadas();
            }
        })();
    </script>
}
