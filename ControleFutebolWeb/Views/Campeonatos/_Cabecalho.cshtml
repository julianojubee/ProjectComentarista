@model ControleFutebolWeb.Models.ViewModels.CampeonatoDetalhesViewModel
@using ControleFutebolWeb.Models.Campeonatos
@* Cabeçalho do campeonato — tela do dono (ViewData["Dono"] = true: volta para a
   lista, Compartilhar e Mais) e link público (só a identificação). *@
@{
    var c = Model.Campeonato;
    var dono = ViewData["Dono"] as bool? == true;

    string Modalidade(ModalidadeCampeonato m) => m switch
    {
        ModalidadeCampeonato.VideoGame => "Videogame",
        ModalidadeCampeonato.Amador => "Amador",
        _ => "Outro"
    };
    string TipoFase(string tipo) => tipo switch { "GRUPOS" => "grupos", "MATA_MATA" => "mata-mata", _ => "pontos corridos" };
    string DescFase(CampeonatoFase f) => TipoFase(f.Tipo)
        + (f.IdaEVolta ? (f.FinalJogoUnico ? " em ida e volta, final única" : " em ida e volta") : "")
        + (f.DisputaTerceiro ? ", com disputa de 3º lugar" : "");

    var fases = c.Fases.OrderBy(f => f.Ordem).Select(DescFase).ToList();
    var formato = string.Join(" e ", fases);
    if (formato.Length > 0) formato = char.ToUpper(formato[0]) + formato[1..];
    var qtd = c.Participantes.Count;
    var origem = Modalidade(c.Modalidade) + (string.IsNullOrWhiteSpace(c.Plataforma) ? "" : $", {c.Plataforma}");
    var linha = $"{origem}. {formato}{(formato.Length > 0 ? ", " : "")}{qtd} {(qtd == 1 ? "participante" : "participantes")}";
}
<div class="cp-cab theme-dark-zone">
    <div class="cp-cab-id">
        @await Html.PartialAsync("~/Views/Campeonatos/_Escudo.cshtml", (c.LogoUrl, c.Nome, (string?)null))
        <div>
            @if (dono)
            {
                <a class="cp-cab-volta" asp-controller="Campeonatos" asp-action="Index">Meus campeonatos</a>
            }
            <h1>@c.Nome</h1>
            <p>@linha</p>
        </div>
    </div>
    @if (dono)
    {
        <div class="cp-cab-acoes">
        <details class="cp-menu">
            <summary class="cp-cab-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                Compartilhar
            </summary>
            <div class="cp-menu-lista">
                @if (Model.LinkPublico != null)
                {
                    <p>Quem tem o link vê a tabela, as partidas e a artilharia, sem poder mudar nada.</p>
                    <div class="cp-link-campo">
                        <input class="cp-input" value="@Model.LinkPublico" readonly aria-label="Link público" onfocus="this.select()" />
                        <button type="button" class="cp-btn" data-copiar="@Model.LinkPublico">Copiar</button>
                    </div>
                    <form asp-action="Compartilhar" asp-route-id="@c.Id" method="post"
                          onsubmit="return confirm('Desativar o link? Quem já tem o endereço perde o acesso.');">
                        <input type="hidden" name="revogar" value="true" />
                        <button type="submit" class="cp-menu-item perigo">Desativar link</button>
                    </form>
                }
                else
                {
                    <p>Crie um link só de leitura para os participantes acompanharem a tabela e as partidas.</p>
                    <form asp-action="Compartilhar" asp-route-id="@c.Id" method="post">
                        <button type="submit" class="cp-btn ouro">Criar link público</button>
                    </form>
                }
            </div>
        </details>
        <details class="cp-menu">
            <summary class="cp-cab-btn" aria-label="Mais ações">Mais</summary>
            <div class="cp-menu-lista">
                <form asp-action="Excluir" asp-route-id="@c.Id" method="post"
                      data-confirmar="Excluir o campeonato “@c.Nome” com todas as partidas e súmulas? Não dá para desfazer."
                      onsubmit="return confirm(this.dataset.confirmar);">
                    <button type="submit" class="cp-menu-item perigo">Excluir campeonato</button>
                </form>
            </div>
        </details>
        </div>
    }
</div>
