@model ControleFutebolWeb.Models.ViewModels.CampeonatoDetalhesViewModel
@using ControleFutebolWeb.Models.Campeonatos
@{
    var c = Model.Campeonato;
    ViewData["Title"] = c.Nome;
    var proxima = Model.ProximaFaseAGerar;
    var primeiraFase = c.Fases.OrderBy(f => f.Ordem).FirstOrDefault();
    var semGrupoDefinido = c.Participantes.Any(p => string.IsNullOrWhiteSpace(p.Grupo));

    string Aba(string nome) => Model.Aba == nome ? "cp-aba ativa" : "cp-aba";
    string? Atual(string nome) => Model.Aba == nome ? "page" : null;

    // Pendentes com os dois lados definidos: são as que dá para lançar agora
    var pendentes = c.Partidas
        .Where(p => !(p.PlacarCasa.HasValue && p.PlacarVisitante.HasValue)
                    && p.ParticipanteCasaId != null && p.ParticipanteVisitanteId != null)
        .OrderBy(p => p.Rodada).ThenBy(p => p.Grupo).ThenBy(p => p.ChaveOrdem).ThenBy(p => p.Id)
        .ToList();
}
@await Html.PartialAsync("_Head")

<div class="cp">
    @await Html.PartialAsync("_Cabecalho", Model, new ViewDataDictionary(ViewData) { ["Dono"] = true })

    @await Html.PartialAsync("_Campeao", Model)

    @* Próximo passo do campeonato: gerar a fase que está pronta para isso. *@
    @if (proxima != null && c.Participantes.Count >= 2)
    {
        var ehPrimeira = proxima.Id == primeiraFase?.Id;
        <form asp-action="GerarFase" asp-route-id="@c.Id" method="post" class="cp-secao cp-proximo">
            <input type="hidden" name="faseId" value="@proxima.Id" />
            <div>
                <strong>Próximo passo: gerar as partidas de “@proxima.Nome”</strong>
                <div class="cp-dica">
                    @if (ehPrimeira)
                    {
                        <text>Depois disso os participantes ficam travados.</text>
                    }
                    else
                    {
                        <text>Usa os classificados da fase anterior: todas as partidas dela precisam ter placar.</text>
                    }
                </div>
            </div>
            @if (proxima.Tipo == "GRUPOS" && (!ehPrimeira || semGrupoDefinido))
            {
                <div class="cp-campo estreito" style="flex-basis:150px;">
                    <label for="quantidadeGrupos">Quantos grupos</label>
                    <input id="quantidadeGrupos" name="quantidadeGrupos" type="number" min="1" max="16" class="cp-input"
                           value="@Math.Max(1, c.Participantes.Count / 4)" />
                </div>
            }
            <button type="submit" class="cp-btn ouro">Gerar partidas</button>
        </form>
    }
    else if (!Model.PrimeiraFaseGerada)
    {
        <div class="cp-secao cp-proximo">
            <div>
                <strong>Próximo passo: adicionar os participantes</strong>
                <div class="cp-dica">Com pelo menos dois, dá para gerar as partidas. @(c.Participantes.Count == 1 ? "Falta mais um." : "")</div>
            </div>
        </div>
    }

    <nav class="cp-abas" id="cpAbas" aria-label="Seções do campeonato">
        <a class="@Aba("tabela")" aria-current="@Atual("tabela")" asp-action="Detalhes" asp-route-id="@c.Id" asp-route-aba="tabela">Tabela</a>
        <a class="@Aba("partidas")" aria-current="@Atual("partidas")" asp-action="Detalhes" asp-route-id="@c.Id" asp-route-aba="partidas">Partidas<span class="conta">@c.Partidas.Count</span></a>
        <a class="@Aba("participantes")" aria-current="@Atual("participantes")" asp-action="Detalhes" asp-route-id="@c.Id" asp-route-aba="participantes">Participantes<span class="conta">@c.Participantes.Count</span></a>
        <a class="@Aba("artilharia")" aria-current="@Atual("artilharia")" asp-action="Detalhes" asp-route-id="@c.Id" asp-route-aba="artilharia">Artilharia</a>
    </nav>

    @switch (Model.Aba)
    {
        case "partidas":
            @await Html.PartialAsync("_Partidas", Model)
            break;
        case "artilharia":
            @await Html.PartialAsync("_Artilharia", Model)
            break;
        case "participantes":
            @await Html.PartialAsync("_Participantes", Model)
            break;
        default:
            @if (pendentes.Any())
            {
                <div class="cp-tabela-grade">
                    <div>@await Html.PartialAsync("_Painel", Model.Painel)</div>
                    <aside class="cp-secao cp-proximos" aria-label="Próximos jogos">
                        <h2>
                            Próximos jogos
                            <a asp-action="Detalhes" asp-route-id="@c.Id" asp-route-aba="partidas">Ver todas (@pendentes.Count)</a>
                        </h2>
                        @foreach (var p in pendentes.Take(4))
                        {
                            @await Html.PartialAsync("_Partida", (Model, p, false, true, (string?)"tabela"))
                        }
                    </aside>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_Painel", Model.Painel)
            }
            break;
    }
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-copiar]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var texto = btn.getAttribute('data-copiar');
                    navigator.clipboard.writeText(texto).then(function () {
                        var antes = btn.textContent;
                        btn.textContent = 'Copiado';
                        setTimeout(function () { btn.textContent = antes; }, 1800);
                    }, function () { window.prompt('Copie o link:', texto); });
                });
            });

            // Menus: fecham ao clicar fora ou com Esc
            document.addEventListener('click', function (e) {
                document.querySelectorAll('.cp-menu[open]').forEach(function (m) { if (!m.contains(e.target)) m.open = false; });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') document.querySelectorAll('.cp-menu[open]').forEach(function (m) { m.open = false; });
            });

            // Partidas: Editar/Cancelar na jogada; Salvar ganha destaque quando o placar muda
            document.querySelectorAll('.cp-partida.editavel').forEach(function (form) {
                var inputs = form.querySelectorAll('input[type=number]');
                var originais = Array.prototype.map.call(inputs, function (i) { return i.value; });
                function marcar() {
                    var mudou = Array.prototype.some.call(inputs, function (i, k) { return i.value !== originais[k]; });
                    form.classList.toggle('alterada', mudou);
                }
                inputs.forEach(function (i) { i.addEventListener('input', marcar); });
                var editar = form.querySelector('[data-editar]');
                if (editar) editar.addEventListener('click', function () {
                    form.classList.add('editando');
                    if (inputs[0]) inputs[0].focus();
                });
                var cancelar = form.querySelector('[data-cancelar]');
                if (cancelar) cancelar.addEventListener('click', function () {
                    inputs.forEach(function (i, k) { i.value = originais[k]; });
                    form.classList.remove('editando', 'alterada');
                });
            });

            // Abas: fade à direita quando há mais abas escondidas (celular)
            var abas = document.getElementById('cpAbas');
            function fade() { abas.classList.toggle('tem-mais', abas.scrollWidth - abas.clientWidth - abas.scrollLeft > 4); }
            abas.addEventListener('scroll', fade);
            window.addEventListener('resize', fade);
            fade();
            var ativa = abas.querySelector('.ativa');
            if (ativa && abas.scrollWidth > abas.clientWidth) ativa.scrollIntoView({ inline: 'nearest', block: 'nearest' });
        })();
    </script>
}
