@model ControleFutebolWeb.Models.ViewModels.CampeonatoDetalhesViewModel

@if (!Model.Artilharia.Any())
{
    <div class="cp-vazio">Nenhum gol ou cartão lançado ainda. Eles entram pela súmula de cada partida.</div>
}
else
{
    <div class="cp-secao" style="overflow-x:auto;">
        <table class="cp-tabela">
            <thead>
                <tr>
                    <th>#</th>
                    <th class="esq">Jogador</th>
                    <th class="esq">Por</th>
                    <th>Gols</th>
                    <th><abbr title="Assistências">Assist.</abbr></th>
                    <th>Amarelos</th>
                    <th>Vermelhos</th>
                </tr>
            </thead>
            <tbody>
                @{ var i = 0; }
                @foreach (var a in Model.Artilharia)
                {
                    i++;
                    <tr>
                        <td class="@(i <= 3 && a.Gols > 0 ? "cp-pos-top" : "")">@i</td>
                        <td class="esq"><strong>@a.Nome</strong></td>
                        <td class="esq" style="color:var(--text-dim)">@Model.NomeDe(a.ParticipanteId)</td>
                        <td class="destaque">@a.Gols</td>
                        <td>@a.Assistencias</td>
                        <td>@a.Amarelos</td>
                        <td>@a.Vermelhos</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
